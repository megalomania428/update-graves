+func TestBalancer_PickOutbound(t *testing.T) {
+	type fields struct {
+		status      []*observatory.OutboundStatus
+		tags        []string
+		fallbackTag string
+		override    string
+	}
+	tests := []struct {
+		name    string
+		fields  fields
+		want    string
+		wantErr bool
+	}{
+		{
+			name: "leastLoPi empty pool goes to fallbackTag",
+			fields: fields{
+				status:      []*observatory.OutboundStatus{plainStatus("a", false, 99999999)},
+				tags:        []string{"a"},
+				fallbackTag: "blocked",
+			},
+			want: "blocked",
+		},
+		{
+			name: "leastLoPi empty pool without fallbackTag is an error",
+			fields: fields{
+				tags: []string{"a"},
+			},
+			wantErr: true,
+		},
+		{
+			name: "override has priority over leastLoPi",
+			fields: fields{
+				status:      []*observatory.OutboundStatus{plainStatus("a", true, 50)},
+				tags:        []string{"a"},
+				fallbackTag: "blocked",
+				override:    "manual",
+			},
+			want: "manual",
+		},
+		{
+			name: "leastLoPi picks the alive candidate",
+			fields: fields{
+				status:      []*observatory.OutboundStatus{plainStatus("a", true, 50)},
+				tags:        []string{"a"},
+				fallbackTag: "blocked",
+			},
+			want: "a",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			b := &Balancer{
+				selectors:   []string{""},
+				strategy:    newTestLeastLoPi(t, &StrategyLeastLoPiConfig{}, tt.fields.status),
+				ohm:         &fakeHandlerSelector{tags: tt.fields.tags},
+				fallbackTag: tt.fields.fallbackTag,
+			}
+			if tt.fields.override != "" {
+				b.override.Put(tt.fields.override)
+			}
+			got, err := b.PickOutbound()
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Balancer.PickOutbound() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if got != tt.want {
+				t.Errorf("Balancer.PickOutbound() = %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
