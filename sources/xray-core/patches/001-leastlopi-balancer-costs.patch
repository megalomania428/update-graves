+// BalancerCostRule is a weight rule of the balancer strategy in the configured
+// order: value for leastLoad, cost_ping and cost_devi for leastLoPi.
+message BalancerCostRule {
+  string match = 1;
+  bool regexp = 2;
+  optional double value = 3;
+  optional double cost_ping = 4;
+  optional double cost_devi = 5;
+}
+
+// BalancerOutboundCost is the effective weight of a balancer candidate, not its
+// square root: cost for leastLoad, cost_ping and cost_devi for leastLoPi.
+message BalancerOutboundCost {
+  string outbound_tag = 1;
+  optional double cost = 2;
+  optional double cost_ping = 3;
+  optional double cost_devi = 4;
+}
