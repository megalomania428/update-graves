@@ -0,0 +1,83 @@
+package router
+
+import (
+	"testing"
+
+	"github.com/xtls/xray-core/common/serial"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestBalancingRule_Build(t *testing.T) {
+	type fields struct {
+		Tag              string
+		OutboundSelector []string
+		Strategy         string
+		StrategySettings *serial.TypedMessage
+		FallbackTag      string
+	}
+	tests := []struct {
+		name         string
+		fields       fields
+		wantSettings *StrategyLeastLoPiConfig
+		wantErr      bool
+	}{
+		{
+			name: "leastlopi without strategy settings takes the defaults",
+			fields: fields{
+				Tag:              "vl-w",
+				OutboundSelector: []string{"a"},
+				Strategy:         "leastlopi",
+				FallbackTag:      "blocked",
+			},
+			wantSettings: &StrategyLeastLoPiConfig{},
+		},
+		{
+			name: "leastLoPi with strategy settings",
+			fields: fields{
+				Tag:              "vl-w",
+				OutboundSelector: []string{"a"},
+				Strategy:         "leastLoPi",
+				StrategySettings: serial.ToTypedMessage(&StrategyLeastLoPiConfig{Expected: 2}),
+			},
+			wantSettings: &StrategyLeastLoPiConfig{Expected: 2},
+		},
+		{
+			name: "leastlopi with settings of another strategy",
+			fields: fields{
+				Tag:              "vl-w",
+				OutboundSelector: []string{"a"},
+				Strategy:         "leastlopi",
+				StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{}),
+			},
+			wantErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			br := &BalancingRule{
+				Tag:              tt.fields.Tag,
+				OutboundSelector: tt.fields.OutboundSelector,
+				Strategy:         tt.fields.Strategy,
+				StrategySettings: tt.fields.StrategySettings,
+				FallbackTag:      tt.fields.FallbackTag,
+			}
+			got, err := br.Build(nil, nil)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("BalancingRule.Build() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			strategy, ok := got.strategy.(*LeastLoPiStrategy)
+			if !ok {
+				t.Fatalf("BalancingRule.Build() strategy = %T, want *LeastLoPiStrategy", got.strategy)
+			}
+			if !proto.Equal(strategy.settings, tt.wantSettings) {
+				t.Errorf("BalancingRule.Build() settings = %v, want %v", strategy.settings, tt.wantSettings)
+			}
+			if got.fallbackTag != tt.fields.FallbackTag {
+				t.Errorf("BalancingRule.Build() fallbackTag = %q, want %q", got.fallbackTag, tt.fields.FallbackTag)
+			}
+		})
+	}
+}
