diff -ruN -x .git a/infra/conf/router_strategy_leastlopi.go b/infra/conf/router_strategy_leastlopi.go
--- a/infra/conf/router_strategy_leastlopi.go	1970-01-01 00:00:00.000000000 +0000
+++ b/infra/conf/router_strategy_leastlopi.go	2026-11-23 13:13:11.738357008 +0000
@@ -0,0 +1,78 @@
+package conf
+
+import (
+	"bytes"
+	"encoding/json"
+
+	"github.com/xtls/xray-core/app/router"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/infra/conf/cfgcommon/duration"
+	"google.golang.org/protobuf/proto"
+)
+
+// strategyLeastLoPiCost is a weight rule of the leastLoPi strategy, a nil weight is not set
+type strategyLeastLoPiCost struct {
+	Match    string   `json:"match"`
+	Regexp   bool     `json:"regexp"`
+	CostPing *float64 `json:"costPing"`
+	CostDevi *float64 `json:"costDevi"`
+}
+
+// UnmarshalJSON rejects unknown keys, such as value of the leastLoad rules
+func (c *strategyLeastLoPiCost) UnmarshalJSON(data []byte) error {
+	type plain strategyLeastLoPiCost
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.DisallowUnknownFields()
+	var v plain
+	if err := decoder.Decode(&v); err != nil {
+		return errors.New("invalid leastLoPi cost rule ", string(data)).Base(err)
+	}
+	*c = strategyLeastLoPiCost(v)
+	return nil
+}
+
+type strategyLeastLoPiConfig struct {
+	// weight settings, the first matched rule sets both weights
+	Costs []*strategyLeastLoPiCost `json:"costs,omitempty"`
+	// score baselines
+	Baselines []duration.Duration `json:"baselines,omitempty"`
+	// expected nodes count to select
+	Expected int32 `json:"expected,omitempty"`
+	// max acceptable rtt of the unweighted delay. default 0
+	MaxRTT duration.Duration `json:"maxRTT,omitempty"`
+}
+
+// Build implements Buildable.
+func (v *strategyLeastLoPiConfig) Build() (proto.Message, error) {
+	config := &router.StrategyLeastLoPiConfig{}
+	for i, c := range v.Costs {
+		if c == nil {
+			return nil, errors.New("leastLoPi: costs[", i, "]: empty rule")
+		}
+		config.Costs = append(config.Costs, &router.StrategyLeastLoPiWeight{
+			Regexp:   c.Regexp,
+			Match:    c.Match,
+			CostPing: c.CostPing,
+			CostDevi: c.CostDevi,
+		})
+	}
+	if err := config.Validate(); err != nil {
+		return nil, err
+	}
+	config.Expected = v.Expected
+	if config.Expected < 0 {
+		config.Expected = 0
+	}
+	config.MaxRTT = int64(v.MaxRTT)
+	if config.MaxRTT < 0 {
+		config.MaxRTT = 0
+	}
+	config.Baselines = make([]int64, 0)
+	for _, b := range v.Baselines {
+		if b <= 0 {
+			continue
+		}
+		config.Baselines = append(config.Baselines, int64(b))
+	}
+	return config, nil
+}
