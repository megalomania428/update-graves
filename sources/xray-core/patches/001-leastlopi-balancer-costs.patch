+func TestLeastLoPiStrategy_PickOutbound(t *testing.T) {
+	type fields struct {
+		settings *StrategyLeastLoPiConfig
+		status   []*observatory.OutboundStatus
+	}
+	type args struct {
+		candidates []string
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		wantOneOf []string
+	}{
+		{
+			name:      "empty pool returns no tag",
+			fields:    fields{settings: &StrategyLeastLoPiConfig{}},
+			args:      args{candidates: []string{"a"}},
+			wantOneOf: []string{""},
+		},
+		{
+			name: "single candidate",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{},
+				status:   []*observatory.OutboundStatus{plainStatus("a", true, 50)},
+			},
+			args:      args{candidates: []string{"a"}},
+			wantOneOf: []string{"a"},
+		},
+		{
+			name: "several candidates are picked from the pool only",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Expected: 2},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 50),
+					plainStatus("b", true, 60),
+					plainStatus("c", true, 70),
+				},
+			},
+			args:      args{candidates: []string{"a", "b", "c"}},
+			wantOneOf: []string{"a", "b"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := newTestLeastLoPi(t, tt.fields.settings, tt.fields.status)
+			picked := make(map[string]bool)
+			for i := 0; i < 100; i++ {
+				got := s.PickOutbound(tt.args.candidates)
+				found := false
+				for _, want := range tt.wantOneOf {
+					found = found || got == want
+				}
+				if !found {
+					t.Fatalf("LeastLoPiStrategy.PickOutbound() = %q, want one of %q", got, tt.wantOneOf)
+				}
+				picked[got] = true
+			}
+			for _, want := range tt.wantOneOf {
+				if !picked[want] {
+					t.Errorf("LeastLoPiStrategy.PickOutbound() never picked %q in 100 calls", want)
+				}
+			}
+		})
+	}
+}
