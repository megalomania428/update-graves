+package routing
+
+// BalancerCostRule is a weight rule of a balancing strategy in the configured order.
+// Value is set for the leastLoad strategy, CostPing and CostDevi for leastLoPi,
+// a nil weight is not configured.
+type BalancerCostRule struct {
+	Match    string
+	Regexp   bool
+	Value    *float64
+	CostPing *float64
+	CostDevi *float64
+}
+
+// BalancerOutboundCost is the effective weight of a balancer candidate.
+type BalancerOutboundCost struct {
+	OutboundTag string
+	Cost        *float64
+	CostPing    *float64
+	CostDevi    *float64
+}
+
+// BalancerCosts describes the strategy of a running balancer, its candidates and its
+// weights. Candidates are the outbounds of the balancer selectors sorted by tag for
+// any strategy, Rules and Outbounds are set for the strategies with weights.
+// OutboundsErr is set when the candidates could not be selected.
+type BalancerCosts struct {
+	Strategy     string
+	Rules        []BalancerCostRule
+	Candidates   []string
+	Outbounds    []BalancerOutboundCost
+	OutboundsErr error
+}
+
+// BalancerCostsReader reads the strategy and the weights of a balancer.
+type BalancerCostsReader interface {
+	GetBalancerCosts(tag string) (*BalancerCosts, error)
+}
+
+// BalancerLister lists the tags of the balancers of a router.
+type BalancerLister interface {
+	ListBalancers() []string
+}
