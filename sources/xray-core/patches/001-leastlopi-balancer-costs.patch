+func Test_routingServer_GetBalancerInfo(t *testing.T) {
+	tests := []struct {
+		name       string
+		balancer   string
+		tags       []string
+		noSelector bool
+		override   string
+		want       string
+	}{
+		{
+			name: "leastLoPi keeps explicit zeros from JSON to gRPC",
+			balancer: `{"tag": "vl-w", "selector": ["cg-", "mh-"], "strategy": {"type": "leastLoPi",
+				"settings": {"costs": [{"match": "^cg-", "regexp": true, "costPing": 0},
+				{"match": "mh-", "costDevi": 0.5}]}}}`,
+			tags: []string{"mh-1", "cg-1"},
+			want: `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "leastlopi",
+				"costRules": [{"match": "^cg-", "regexp": true, "costPing": 0}, {"match": "mh-", "costDevi": 0.5}],
+				"outboundCosts": [{"outboundTag": "cg-1", "costPing": 0, "costDevi": 1},
+				{"outboundTag": "mh-1", "costPing": 1, "costDevi": 0.5}],
+				"candidates": ["cg-1", "mh-1"]}`,
+		},
+		{
+			name: "leastLoad reports implicit and default weights",
+			balancer: `{"tag": "vl-w", "selector": ["cg-"], "strategy": {"type": "leastLoad",
+				"settings": {"costs": [{"match": "cg-(\\d+)", "regexp": true}, {"match": "vl", "value": 3}]}}}`,
+			tags: []string{"cg-16-vl", "cg-x"},
+			want: `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "leastload",
+				"costRules": [{"match": "cg-(\\d+)", "regexp": true, "value": 0}, {"match": "vl", "value": 3}],
+				"outboundCosts": [{"outboundTag": "cg-16-vl", "cost": 16}, {"outboundTag": "cg-x", "cost": 1}],
+				"candidates": ["cg-16-vl", "cg-x"]}`,
+		},
+		{
+			name:     "random has no weights",
+			balancer: `{"tag": "vl-w", "selector": ["cg-"]}`,
+			tags:     []string{"cg-1"},
+			want: `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "random",
+				"candidates": ["cg-1"]}`,
+		},
+		{
+			name: "roundRobin candidates without fallbackTag and override",
+			balancer: `{"tag": "vl-w", "selector": ["cg-"], "strategy": {"type": "roundRobin"},
+				"fallbackTag": "fb"}`,
+			tags:     []string{"cg-2", "cg-1", "cg-2"},
+			override: "ovr",
+			want: `{"override": {"target": "ovr"}, "principleTarget": {"tag": ["principle"]},
+				"strategy": "roundrobin", "candidates": ["cg-1", "cg-2"]}`,
+		},
+		{
+			name:     "leastPing candidates",
+			balancer: `{"tag": "vl-w", "selector": ["cg-"], "strategy": {"type": "leastPing"}}`,
+			tags:     []string{"cg-1"},
+			want: `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "leastping",
+				"candidates": ["cg-1"]}`,
+		},
+		{
+			name: "selector error drops only outboundCosts and candidates",
+			balancer: `{"tag": "vl-w", "selector": ["cg-"], "strategy": {"type": "leastLoad",
+				"settings": {"costs": [{"match": "vl", "value": 3}]}}}`,
+			noSelector: true,
+			want: `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "leastload",
+				"costRules": [{"match": "vl", "value": 3}]}`,
+		},
+		{
+			name:       "random selector error drops candidates",
+			balancer:   `{"tag": "vl-w", "selector": ["cg-"]}`,
+			noSelector: true,
+			want:       `{"override": {}, "principleTarget": {"tag": ["principle"]}, "strategy": "random"}`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			rule := new(conf.BalancingRule)
+			if err := json.Unmarshal([]byte(tt.balancer), rule); err != nil {
+				t.Fatalf("json.Unmarshal() error = %v", err)
+			}
+			balancer, err := rule.Build()
+			if err != nil {
+				t.Fatalf("BalancingRule.Build() error = %v", err)
+			}
+			mockCtl := gomock.NewController(t)
+			defer mockCtl.Finish()
+			var ohm outbound.Manager = mocks.NewOutboundManager(mockCtl)
+			if !tt.noSelector {
+				mockHs := mocks.NewOutboundHandlerSelector(mockCtl)
+				mockHs.EXPECT().Select(gomock.Any()).Return(tt.tags).Times(1)
+				ohm = &costsOutboundManager{Manager: ohm, HandlerSelector: mockHs}
+			}
+			r := new(router.Router)
+			config := &router.Config{BalancingRule: []*router.BalancingRule{balancer}}
+			if err := r.Init(context.TODO(), config, mocks.NewDNSClient(mockCtl), ohm, nil); err != nil {
+				t.Fatalf("Router.Init() error = %v", err)
+			}
+			if tt.override != "" {
+				if err := r.OverrideBalancer("vl-w", tt.override); err != nil {
+					t.Fatalf("Router.OverrideBalancer() error = %v", err)
+				}
+			}
+			resp, err := NewRoutingServer(&costsTestRouter{Router: r}, nil).GetBalancerInfo(
+				context.Background(), &GetBalancerInfoRequest{Tag: "vl-w"})
+			if err != nil {
+				t.Fatalf("GetBalancerInfo() error = %v", err)
+			}
+			data, err := protojson.Marshal(resp)
+			if err != nil {
+				t.Fatalf("protojson.Marshal() error = %v", err)
+			}
+			var got struct {
+				Balancer interface{} `json:"balancer"`
+			}
+			if err := json.Unmarshal(data, &got); err != nil {
+				t.Fatalf("json.Unmarshal() error = %v", err)
+			}
+			var want interface{}
+			if err := json.Unmarshal([]byte(tt.want), &want); err != nil {
+				t.Fatalf("json.Unmarshal() error = %v", err)
+			}
+			if diff := cmp.Diff(want, got.Balancer); diff != "" {
+				t.Errorf("GetBalancerInfo() balancer mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
