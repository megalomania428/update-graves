+package router
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/features/outbound"
+	"github.com/xtls/xray-core/features/routing"
+)
+
+func TestRouter_GetBalancerCosts(t *testing.T) {
+	type fields struct {
+		rule *BalancingRule
+		ohm  outbound.Manager
+	}
+	type args struct {
+		tag string
+	}
+	tests := []struct {
+		name             string
+		fields           fields
+		args             args
+		want             *routing.BalancerCosts
+		wantErr          bool
+		wantOutboundsErr bool
+	}{
+		{
+			name: "leastLoad reports the weights of its WeightManager for unmeasured candidates",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"ax", "cg-", "mh-", "pl"},
+					Strategy:         "leastLoad",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{
+						Costs: []*StrategyWeight{
+							{Match: "x5"},
+							{Regexp: true, Match: `^mh-\d+`},
+							{Match: "vl", Value: 2.5},
+							{Match: "zz", Value: 7},
+						},
+					}),
+				},
+				ohm: &fakeHandlerSelector{tags: []string{"ax5b", "cg-vl", "mh-16-vl", "other", "pl"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastload",
+				Rules: []routing.BalancerCostRule{
+					{Match: "x5", Value: costOf(0)},
+					{Match: `^mh-\d+`, Regexp: true, Value: costOf(0)},
+					{Match: "vl", Value: costOf(2.5)},
+					{Match: "zz", Value: costOf(7)},
+				},
+				Outbounds: []routing.BalancerOutboundCost{
+					{OutboundTag: "ax5b", Cost: costOf(5)},
+					{OutboundTag: "cg-vl", Cost: costOf(2.5)},
+					{OutboundTag: "mh-16-vl", Cost: costOf(16)},
+					{OutboundTag: "pl", Cost: costOf(1)},
+				},
+			},
+		},
+		{
+			name: "leastLoPi reports configured and effective weights",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"cg-", "mh-", "cb-", "zz"},
+					Strategy:         "LeastLoPi",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoPiConfig{
+						Costs: []*StrategyLeastLoPiWeight{
+							{Match: "cg", CostDevi: costOf(0)},
+							{Regexp: true, Match: "^mh-", CostPing: costOf(16)},
+							{Match: "-w", CostPing: costOf(4), CostDevi: costOf(4)},
+						},
+					}),
+				},
+				ohm: &fakeHandlerSelector{tags: []string{"cb-w", "cg-w", "mh-w", "other-w", "zz"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastlopi",
+				Rules: []routing.BalancerCostRule{
+					{Match: "cg", CostDevi: costOf(0)},
+					{Match: "^mh-", Regexp: true, CostPing: costOf(16)},
+					{Match: "-w", CostPing: costOf(4), CostDevi: costOf(4)},
+				},
+				Outbounds: []routing.BalancerOutboundCost{
+					{OutboundTag: "cb-w", CostPing: costOf(4), CostDevi: costOf(4)},
+					{OutboundTag: "cg-w", CostPing: costOf(1), CostDevi: costOf(0)},
+					{OutboundTag: "mh-w", CostPing: costOf(16), CostDevi: costOf(1)},
+					{OutboundTag: "zz", CostPing: costOf(1), CostDevi: costOf(1)},
+				},
+			},
+		},
+		{
+			name: "strategy without weights",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{Strategy: "random"},
+		},
+		{
+			name: "leastPing has no weights",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}, Strategy: "leastPing"},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{Strategy: "leastping"},
+		},
+		{
+			name: "unknown balancer",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args:    args{tag: "other"},
+			wantErr: true,
+		},
+		{
+			name: "selector error keeps the strategy and the rules",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"a"},
+					Strategy:         "leastload",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{
+						Costs: []*StrategyWeight{{Match: "a", Value: 3}},
+					}),
+				},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastload",
+				Rules:    []routing.BalancerCostRule{{Match: "a", Value: costOf(3)}},
+			},
+			wantOutboundsErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			b, err := tt.fields.rule.Build(tt.fields.ohm, nil)
+			if err != nil {
+				t.Fatalf("BalancingRule.Build() error = %v", err)
+			}
+			r := &Router{balancers: map[string]*Balancer{tt.fields.rule.Tag: b}}
+			got, err := r.GetBalancerCosts(tt.args.tag)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Router.GetBalancerCosts() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if (got.OutboundsErr != nil) != tt.wantOutboundsErr {
+				t.Fatalf("Router.GetBalancerCosts() OutboundsErr = %v, want error %v", got.OutboundsErr, tt.wantOutboundsErr)
+			}
+			got.OutboundsErr = nil
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("Router.GetBalancerCosts() = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
