+package router
+
+import (
+	"sort"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/features/routing"
+)
+
+// BalancingCostReporter is implemented by the strategies with weights
+type BalancingCostReporter interface {
+	// CostRules returns the weight rules in the configured order
+	CostRules() []routing.BalancerCostRule
+	// OutboundCosts returns the effective weights of the candidates sorted by tag
+	OutboundCosts(candidates []string) []routing.BalancerOutboundCost
+}
+
+// GetBalancerCosts implements routing.BalancerCostsReader
+func (r *Router) GetBalancerCosts(tag string) (*routing.BalancerCosts, error) {
+	r.mu.Lock()
+	b, ok := r.balancers[tag]
+	r.mu.Unlock()
+	if !ok {
+		return nil, errors.New("cannot find tag")
+	}
+	ret := &routing.BalancerCosts{Strategy: balancingStrategyName(b.strategy)}
+	reporter, ok := b.strategy.(BalancingCostReporter)
+	if !ok {
+		return ret, nil
+	}
+	ret.Rules = reporter.CostRules()
+	candidates, err := b.SelectOutbounds()
+	if err != nil {
+		ret.OutboundsErr = errors.New("unable to select outbounds").Base(err)
+		return ret, nil
+	}
+	ret.Outbounds = reporter.OutboundCosts(candidates)
+	return ret, nil
+}
+
+// balancingStrategyName returns the normalized configuration name of a strategy
+func balancingStrategyName(strategy BalancingStrategy) string {
+	switch strategy.(type) {
+	case *LeastLoadStrategy:
+		return "leastload"
+	case *LeastLoPiStrategy:
+		return "leastlopi"
+	case *LeastPingStrategy:
+		return "leastping"
+	case *RoundRobinStrategy:
+		return "roundrobin"
+	case *RandomStrategy:
+		return "random"
+	}
+	return ""
+}
+
+// CostRules implements BalancingCostReporter
+func (s *LeastLoadStrategy) CostRules() []routing.BalancerCostRule {
+	var ret []routing.BalancerCostRule
+	for _, w := range s.settings.GetCosts() {
+		value := float64(w.GetValue())
+		ret = append(ret, routing.BalancerCostRule{
+			Match:  w.GetMatch(),
+			Regexp: w.GetRegexp(),
+			Value:  &value,
+		})
+	}
+	return ret
+}
+
+// OutboundCosts implements BalancingCostReporter with the weights the ranking applies
+func (s *LeastLoadStrategy) OutboundCosts(candidates []string) []routing.BalancerOutboundCost {
+	var ret []routing.BalancerOutboundCost
+	for _, tag := range sortedCandidates(candidates) {
+		cost := s.costs.Get(tag)
+		ret = append(ret, routing.BalancerOutboundCost{OutboundTag: tag, Cost: &cost})
+	}
+	return ret
+}
+
+// sortedCandidates returns the unique candidates sorted by tag
+func sortedCandidates(candidates []string) []string {
+	tags := append([]string(nil), candidates...)
+	sort.Strings(tags)
+	ret := make([]string, 0, len(tags))
+	for i, tag := range tags {
+		if i > 0 && tag == tags[i-1] {
+			continue
+		}
+		ret = append(ret, tag)
+	}
+	return ret
+}
+
+// copyCost returns a copy of a configured weight
+func copyCost(cost *float64) *float64 {
+	if cost == nil {
+		return nil
+	}
+	v := *cost
+	return &v
+}
