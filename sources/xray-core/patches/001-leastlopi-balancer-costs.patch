+func TestLeastLoPiStrategy_GetPrincipleTarget(t *testing.T) {
+	ms := time.Millisecond
+	type fields struct {
+		settings *StrategyLeastLoPiConfig
+		status   []*observatory.OutboundStatus
+	}
+	type args struct {
+		candidates []string
+	}
+	tests := []struct {
+		name   string
+		fields fields
+		args   args
+		want   []string
+	}{
+		{
+			name: "weighted average beats a slow outbound without deviation",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected: 1,
+					Costs: []*StrategyLeastLoPiWeight{
+						{Regexp: true, Match: "^cg-vl-w$", CostPing: costOf(1), CostDevi: costOf(1)},
+						{Regexp: true, Match: "^mh-vl-w$", CostPing: costOf(16), CostDevi: costOf(1)},
+						{Regexp: true, Match: "^cb-vl-w$", CostPing: costOf(4096), CostDevi: costOf(4096)},
+					},
+				},
+				status: []*observatory.OutboundStatus{
+					burstStatus("cg-vl-w", 1500*ms, 0, 10, 0),
+					burstStatus("mh-vl-w", 150*ms, 45*ms, 10, 0),
+				},
+			},
+			args: args{candidates: []string{"cg-vl-w", "mh-vl-w"}},
+			want: []string{"mh-vl-w"},
+		},
+		{
+			name: "default weights add the average and the deviation",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{},
+				status: []*observatory.OutboundStatus{
+					burstStatus("a", 100*ms, 50*ms, 10, 0),
+					burstStatus("b", 120*ms, 10*ms, 10, 0),
+				},
+			},
+			args: args{candidates: []string{"a", "b"}},
+			want: []string{"b"},
+		},
+		{
+			name: "zero costPing keeps only the deviation",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Costs: []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(0)}},
+				},
+				status: []*observatory.OutboundStatus{
+					burstStatus("a", 1000*ms, 10*ms, 10, 0),
+					burstStatus("b", 100*ms, 50*ms, 10, 0),
+				},
+			},
+			args: args{candidates: []string{"a", "b"}},
+			want: []string{"a"},
+		},
+		{
+			name: "zero costDevi keeps only the average",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Costs: []*StrategyLeastLoPiWeight{{Match: "a", CostDevi: costOf(0)}},
+				},
+				status: []*observatory.OutboundStatus{
+					burstStatus("a", 100*ms, 900*ms, 10, 0),
+					burstStatus("b", 150*ms, 0, 10, 0),
+				},
+			},
+			args: args{candidates: []string{"a", "b"}},
+			want: []string{"a"},
+		},
+		{
+			name: "plain observatory has no deviation",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Costs: []*StrategyLeastLoPiWeight{{Match: "b", CostPing: costOf(4)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 300),
+					plainStatus("b", true, 200),
+				},
+			},
+			args: args{candidates: []string{"a", "b"}},
+			want: []string{"a"},
+		},
+		{
+			name: "zero costPing without HealthPing ties by the delay",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected: 2,
+					Costs:    []*StrategyLeastLoPiWeight{{Match: "-", CostPing: costOf(0)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a-1", true, 300),
+					plainStatus("b-1", true, 200),
+				},
+			},
+			args: args{candidates: []string{"a-1", "b-1"}},
+			want: []string{"b-1", "a-1"},
+		},
+		{
+			name: "dead, unmeasured and foreign outbounds take no part",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Expected: 3},
+				status: []*observatory.OutboundStatus{
+					burstStatus("a", 100*ms, 0, 5, 5),
+					burstStatus("b", 200*ms, 0, 5, 0),
+					plainStatus("d", false, 99999999),
+					plainStatus("x", true, 10),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c", "d"}},
+			want: []string{"b"},
+		},
+		{
+			name: "maxRTT is strict and limits the unweighted delay",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected: 3,
+					MaxRTT:   int64(200 * ms),
+					Costs:    []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(100)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 199),
+					plainStatus("b", true, 200),
+					burstStatus("c", 250*ms, 0, 5, 0),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c"}},
+			want: []string{"a"},
+		},
+		{
+			name: "expected selects several best outbounds",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Expected: 2},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 100),
+					plainStatus("b", true, 50),
+					plainStatus("c", true, 200),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c"}},
+			want: []string{"b", "a"},
+		},
+		{
+			name: "score equal to the baseline is not under it",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Baselines: []int64{int64(100 * ms)}},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 100),
+					plainStatus("b", true, 50),
+				},
+			},
+			args: args{candidates: []string{"a", "b"}},
+			want: []string{"b"},
+		},
+		{
+			name: "baselines compare the score in the configured order",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected:  2,
+					Baselines: []int64{int64(100 * ms), int64(210 * ms)},
+					Costs:     []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(0.25)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 400),
+					plainStatus("b", true, 50),
+					plainStatus("c", true, 250),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c"}},
+			want: []string{"b", "a"},
+		},
+		{
+			name: "a heavy weight puts the score over the baseline despite a low average",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Baselines: []int64{int64(150 * ms)},
+					Costs:     []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(16)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 50),
+					plainStatus("b", true, 120),
+					plainStatus("e", true, 130),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "e"}},
+			want: []string{"b", "e"},
+		},
+		{
+			name: "a light weight puts the score under the baseline despite a high average",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Baselines: []int64{int64(150 * ms)},
+					Costs:     []*StrategyLeastLoPiWeight{{Match: "c", CostPing: costOf(0.0625)}},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("c", true, 400),
+					plainStatus("d", true, 90),
+					plainStatus("e", true, 95),
+					plainStatus("f", true, 300),
+				},
+			},
+			args: args{candidates: []string{"c", "d", "e", "f"}},
+			want: []string{"d", "e", "c"},
+		},
+		{
+			name: "a wide first baseline takes more outbounds than expected",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected:  1,
+					Baselines: []int64{int64(100 * ms), int64(300 * ms)},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 10),
+					plainStatus("b", true, 20),
+					plainStatus("c", true, 30),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c"}},
+			want: []string{"a", "b", "c"},
+		},
+		{
+			name: "a later baseline widens the pool up to its count",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected:  2,
+					Baselines: []int64{int64(10 * ms), int64(100 * ms)},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 5),
+					plainStatus("b", true, 50),
+					plainStatus("c", true, 60),
+					plainStatus("d", true, 150),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c", "d"}},
+			want: []string{"a", "b", "c"},
+		},
+		{
+			name: "baselines not in ascending order keep the configured order",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Baselines: []int64{int64(60 * ms), int64(20 * ms)},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 5),
+					plainStatus("b", true, 50),
+					plainStatus("c", true, 150),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c"}},
+			want: []string{"a", "b"},
+		},
+		{
+			name: "expected fills the pool when the baselines take fewer outbounds",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{
+					Expected:  3,
+					Baselines: []int64{int64(20 * ms)},
+				},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a", true, 5),
+					plainStatus("b", true, 50),
+					plainStatus("c", true, 150),
+					plainStatus("d", true, 250),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c", "d"}},
+			want: []string{"a", "b", "c"},
+		},
+		{
+			name: "no score under the baselines without expected gives an empty pool",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Baselines: []int64{int64(10 * ms)}},
+				status:   []*observatory.OutboundStatus{plainStatus("a", true, 50)},
+			},
+			args: args{candidates: []string{"a"}},
+			want: nil,
+		},
+		{
+			name: "equal scores go by the average, failures, probes and tag",
+			fields: fields{
+				settings: &StrategyLeastLoPiConfig{Expected: 5},
+				status: []*observatory.OutboundStatus{
+					burstStatus("e", 100*ms, 0, 10, 1),
+					burstStatus("d", 100*ms, 0, 10, 0),
+					burstStatus("c", 100*ms, 0, 20, 0),
+					burstStatus("b", 100*ms, 0, 20, 0),
+					burstStatus("a", 90*ms, 10*ms, 10, 0),
+				},
+			},
+			args: args{candidates: []string{"a", "b", "c", "d", "e"}},
+			want: []string{"a", "b", "c", "d", "e"},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := newTestLeastLoPi(t, tt.fields.settings, tt.fields.status)
+			if got := s.GetPrincipleTarget(tt.args.candidates); !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("LeastLoPiStrategy.GetPrincipleTarget() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
