+)
+
+func leastLoPiWeight(v float64) *float64 { return &v }
+
+func TestBalancingRule_Build(t *testing.T) {
+	tests := []struct {
+		name    string
+		input   string
+		want    *router.StrategyLeastLoPiConfig
+		wantErr string
+	}{
+		{
+			name: "task example",
+			input: `{"tag": "vl-w", "selector": ["cg-", "mh-", "cb-"], "strategy": {"type": "leastLoPi",
+				"settings": {"expected": 1, "costs": [
+				{"match": "^cg-vl-w$", "regexp": true, "costPing": 1, "costDevi": 1},
+				{"match": "^mh-vl-w$", "regexp": true, "costPing": 16, "costDevi": 1},
+				{"match": "^cb-vl-w$", "regexp": true, "costPing": 4096, "costDevi": 4096}]}}}`,
+			want: &router.StrategyLeastLoPiConfig{
+				Expected: 1,
+				Costs: []*router.StrategyLeastLoPiWeight{
+					{Regexp: true, Match: "^cg-vl-w$", CostPing: leastLoPiWeight(1), CostDevi: leastLoPiWeight(1)},
+					{Regexp: true, Match: "^mh-vl-w$", CostPing: leastLoPiWeight(16), CostDevi: leastLoPiWeight(1)},
+					{Regexp: true, Match: "^cb-vl-w$", CostPing: leastLoPiWeight(4096), CostDevi: leastLoPiWeight(4096)},
+				},
+			},
+		},
+		{
+			name: "missing weights stay missing and explicit zeros stay zeros",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastlopi", "settings": {"costs": [
+				{"match": "a", "costPing": 0}, {"match": "b", "costDevi": 0}, {"match": "c"}]}}}`,
+			want: &router.StrategyLeastLoPiConfig{
+				Costs: []*router.StrategyLeastLoPiWeight{
+					{Match: "a", CostPing: leastLoPiWeight(0)},
+					{Match: "b", CostDevi: leastLoPiWeight(0)},
+					{Match: "c"},
+				},
+			},
+		},
+		{
+			name: "baselines, expected and maxRTT",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {
+				"baselines": ["100ms", "0s", "300ms"], "expected": 2, "maxRTT": "500ms"}}}`,
+			want: &router.StrategyLeastLoPiConfig{
+				Baselines: []int64{int64(100 * time.Millisecond), int64(300 * time.Millisecond)},
+				Expected:  2,
+				MaxRTT:    int64(500 * time.Millisecond),
+			},
+		},
+		{
+			name: "negative expected and maxRTT are 0",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {
+				"expected": -1, "maxRTT": "-1s"}}}`,
+			want: &router.StrategyLeastLoPiConfig{},
+		},
+		{
+			name: "both zeros",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				{"match": "a", "costPing": 0, "costDevi": 0}]}}}`,
+			wantErr: "costPing and costDevi are both 0",
+		},
+		{
+			name: "negative weight",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				{"match": "a", "costDevi": -1}]}}}`,
+			wantErr: "costDevi must not be negative",
+		},
+		{
+			name: "invalid regexp",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				{"match": "(", "regexp": true}]}}}`,
+			wantErr: "invalid regexp",
+		},
+		{
+			name: "empty match",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				{"costPing": 1}]}}}`,
+			wantErr: "empty match",
+		},
+		{
+			name: "value of leastLoad is unknown",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				{"match": "a", "value": 2}]}}}`,
+			wantErr: `unknown field "value"`,
+		},
+		{
+			name: "null rule",
+			input: `{"tag": "b", "selector": ["a"], "strategy": {"type": "leastLoPi", "settings": {"costs": [
+				null]}}}`,
+			wantErr: "empty rule",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			r := new(BalancingRule)
+			if err := json.Unmarshal([]byte(tt.input), r); err != nil {
+				t.Fatalf("json.Unmarshal() error = %v", err)
+			}
+			got, err := r.Build()
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("BalancingRule.Build() error = %v, want %q", err, tt.wantErr)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("BalancingRule.Build() error = %v", err)
+			}
+			if got.Strategy != "leastlopi" {
+				t.Errorf("BalancingRule.Build() strategy = %q, want leastlopi", got.Strategy)
+			}
+			settings, err := got.StrategySettings.GetInstance()
+			if err != nil {
+				t.Fatalf("TypedMessage.GetInstance() error = %v", err)
+			}
+			if !proto.Equal(settings, tt.want) {
+				t.Errorf("BalancingRule.Build() settings = %v, want %v", settings, tt.want)
+			}
+		})
+	}
+}
