+func TestStrategyLeastLoPiConfig_Validate(t *testing.T) {
+	type fields struct {
+		costs []*StrategyLeastLoPiWeight
+	}
+	tests := []struct {
+		name    string
+		fields  fields
+		wantErr string
+	}{
+		{name: "default weights", fields: fields{costs: []*StrategyLeastLoPiWeight{{Match: "a"}}}},
+		{name: "single zero costPing", fields: fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(0)}}}},
+		{name: "single zero costDevi", fields: fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostDevi: costOf(0)}}}},
+		{
+			name:    "both explicit zeros",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(0), CostDevi: costOf(0)}}},
+			wantErr: "costPing and costDevi are both 0",
+		},
+		{
+			name:    "negative costPing",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(-1)}}},
+			wantErr: "costPing must not be negative",
+		},
+		{
+			name:    "NaN costDevi",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostDevi: costOf(math.NaN())}}},
+			wantErr: "costDevi must be finite",
+		},
+		{
+			name:    "infinite costPing",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{Match: "a", CostPing: costOf(math.Inf(1))}}},
+			wantErr: "costPing must be finite",
+		},
+		{
+			name:    "invalid regexp",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{Match: "(", Regexp: true}}},
+			wantErr: "invalid regexp",
+		},
+		{
+			name:    "empty match",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{{CostPing: costOf(2)}}},
+			wantErr: "empty match",
+		},
+		{
+			name:    "nil rule",
+			fields:  fields{costs: []*StrategyLeastLoPiWeight{nil}},
+			wantErr: "empty match",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := &StrategyLeastLoPiConfig{Costs: tt.fields.costs}
+			err := c.Validate()
+			if tt.wantErr == "" {
+				if err != nil {
+					t.Fatalf("StrategyLeastLoPiConfig.Validate() error = %v", err)
+				}
+				return
+			}
+			if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+				t.Fatalf("StrategyLeastLoPiConfig.Validate() error = %v, want %q", err, tt.wantErr)
+			}
+		})
+	}
+}
+
+func TestLeastLoPiStrategy_getCost(t *testing.T) {
+	type args struct {
+		tag string
+	}
+	tests := []struct {
+		name string
+		args args
+		want leastLoPiCost
+	}{
+		{name: "first matched rule sets both weights", args: args{tag: "mh-vl"}, want: leastLoPiCost{ping: 4, devi: 1}},
+		{name: "regexp rule", args: args{tag: "mh-1"}, want: leastLoPiCost{ping: 1, devi: 9}},
+		{name: "explicit zero", args: args{tag: "zero-1"}, want: leastLoPiCost{ping: 0, devi: 1}},
+		{name: "no matched rule", args: args{tag: "other"}, want: leastLoPiCost{ping: 1, devi: 1}},
+	}
+	settings := &StrategyLeastLoPiConfig{
+		Costs: []*StrategyLeastLoPiWeight{
+			{Match: "vl", CostPing: costOf(4)},
+			{Regexp: true, Match: "^mh-", CostDevi: costOf(9)},
+			{Match: "zero", CostPing: costOf(0)},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			s := newTestLeastLoPi(t, settings, nil)
+			if got := s.getCost(tt.args.tag); got != tt.want {
+				t.Errorf("LeastLoPiStrategy.getCost() = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func newCoreContext(t *testing.T) (context.Context, *core.Instance) {
+	t.Helper()
+	instance, err := core.New(&core.Config{})
+	if err != nil {
+		t.Fatalf("core.New() error = %v", err)
+	}
+	return context.WithValue(context.Background(), core.XrayKey(1), instance), instance
+}
+
+func newObservatoryLeastLoPi(t *testing.T, ctx context.Context) *LeastLoPiStrategy {
+	t.Helper()
+	s, err := NewLeastLoPiStrategy(&StrategyLeastLoPiConfig{Expected: 1})
+	if err != nil {
+		t.Fatalf("NewLeastLoPiStrategy() error = %v", err)
+	}
+	s.InjectContext(ctx)
+	return s
+}
+
+func runConcurrently(n int, f func(i int)) {
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			<-start
+			f(i)
+		}(i)
+	}
+	close(start)
+	wg.Wait()
+}
+
+func TestLeastLoPiStrategy_getObserver(t *testing.T) {
+	candidates := []string{"a-vl-w", "b-vl-w"}
+	type fields struct {
+		withCore        bool
+		strategies      int
+		registered      bool
+		registeredLater bool
+		upstream        bool
+	}
+	tests := []struct {
+		name         string
+		fields       fields
+		wantObserver bool
+		wantPool     []string
+	}{
+		{
+			name:         "parallel first calls with the observatory registered",
+			fields:       fields{withCore: true, strategies: 1, registered: true},
+			wantObserver: true,
+			wantPool:     []string{"a-vl-w"},
+		},
+		{
+			name:         "several strategies of one core with the observatory registered",
+			fields:       fields{withCore: true, strategies: 4, registered: true},
+			wantObserver: true,
+			wantPool:     []string{"a-vl-w"},
+		},
+		{
+			name:         "observatory registered after the first calls",
+			fields:       fields{withCore: true, strategies: 1, registeredLater: true},
+			wantObserver: true,
+			wantPool:     []string{"a-vl-w"},
+		},
+		{
+			name:         "several strategies of one core with the observatory registered later",
+			fields:       fields{withCore: true, strategies: 4, registeredLater: true},
+			wantObserver: true,
+			wantPool:     []string{"a-vl-w"},
+		},
+		{
+			name:         "several strategies of one core without observatory",
+			fields:       fields{withCore: true, strategies: 4},
+			wantObserver: false,
+			wantPool:     nil,
+		},
+		{
+			name:         "without observatory next to the first call of an upstream strategy",
+			fields:       fields{withCore: true, strategies: 4, upstream: true},
+			wantObserver: false,
+			wantPool:     nil,
+		},
+		{
+			name:         "no observatory gives an empty pool",
+			fields:       fields{withCore: true, strategies: 1},
+			wantObserver: false,
+			wantPool:     nil,
+		},
+		{
+			name:         "context without core gives an empty pool",
+			fields:       fields{strategies: 1},
+			wantObserver: false,
+			wantPool:     nil,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			ctx := context.Background()
+			var instance *core.Instance
+			if tt.fields.withCore {
+				ctx, instance = newCoreContext(t)
+			}
+			fake := &fakeObservatory{status: []*observatory.OutboundStatus{
+				burstStatus("a-vl-w", 100*time.Millisecond, 0, 3, 0),
+				burstStatus("b-vl-w", 200*time.Millisecond, 0, 3, 0),
+			}}
+			register := func() {
+				if err := instance.AddFeature(fake); err != nil {
+					t.Fatalf("AddFeature() error = %v", err)
+				}
+			}
+			if tt.fields.registered {
+				register()
+			}
+			strategies := make([]*LeastLoPiStrategy, tt.fields.strategies)
+			for i := range strategies {
+				strategies[i] = newObservatoryLeastLoPi(t, ctx)
+			}
+			callAll := func(wantPool []string) {
+				lopiCalls := len(strategies) * 8
+				upstreamCalls := 0
+				if tt.fields.upstream {
+					upstreamCalls = 1
+				}
+				runConcurrently(lopiCalls+upstreamCalls, func(i int) {
+					if i >= lopiCalls {
+						upstream := &RandomStrategy{FallbackTag: "fallback"}
+						upstream.InjectContext(ctx)
+						upstream.PickOutbound(candidates)
+						return
+					}
+					s := strategies[i%len(strategies)]
+					s.getObserver()
+					if got := s.GetPrincipleTarget(candidates); !reflect.DeepEqual(got, wantPool) {
+						t.Errorf("GetPrincipleTarget() = %v, want %v", got, wantPool)
+					}
+					want := ""
+					if len(wantPool) > 0 {
+						want = wantPool[0]
+					}
+					if got := s.PickOutbound(candidates); got != want {
+						t.Errorf("PickOutbound() = %q, want %q", got, want)
+					}
+				})
+			}
+			if tt.fields.registeredLater {
+				callAll(nil)
+				register()
+			}
+			callAll(tt.wantPool)
+			for _, s := range strategies {
+				got := s.getObserver()
+				if (got != nil) != tt.wantObserver {
+					t.Errorf("LeastLoPiStrategy.getObserver() = %v, want observer %v", got, tt.wantObserver)
+				}
+				if tt.wantObserver && got != extension.Observatory(fake) {
+					t.Errorf("LeastLoPiStrategy.getObserver() = %v, want the registered one", got)
+				}
+			}
+		})
+	}
+}
