diff -ruN -x .git a/app/router/strategy_leastlopi.go b/app/router/strategy_leastlopi.go
--- a/app/router/strategy_leastlopi.go	1970-01-01 00:00:00.000000000 +0000
+++ b/app/router/strategy_leastlopi.go	2026-11-24 14:13:24.485709736 +0000
@@ -0,0 +1,328 @@
+package router
+
+import (
+	"context"
+	"math"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+	"github.com/xtls/xray-core/common/dice"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/features/extension"
+	"github.com/xtls/xray-core/features/routing"
+)
+
+// LeastLoPiStrategy picks outbounds by the weighted sum of the average RTT and its
+// deviation: score = average * sqrt(costPing) + deviation * sqrt(costDevi)
+type LeastLoPiStrategy struct {
+	settings *StrategyLeastLoPiConfig
+	rules    []*leastLoPiRule
+
+	mu    sync.Mutex
+	cache map[string]leastLoPiCost
+
+	observerMu sync.Mutex
+	observer   extension.Observatory
+
+	ctx context.Context
+}
+
+// leastLoPiRule is a compiled weight rule, a nil weight is not configured
+type leastLoPiRule struct {
+	match    string
+	re       *regexp.Regexp
+	costPing *float64
+	costDevi *float64
+}
+
+// leastLoPiCost holds the effective weights of an outbound
+type leastLoPiCost struct {
+	ping float64
+	devi float64
+}
+
+// lopiNode is a snapshot of an outbound status with its score in nanoseconds
+type lopiNode struct {
+	Tag       string
+	CountAll  int64
+	CountFail int64
+	Average   float64
+	Score     float64
+}
+
+// NewLeastLoPiStrategy creates a new LeastLoPiStrategy with settings
+func NewLeastLoPiStrategy(settings *StrategyLeastLoPiConfig) (*LeastLoPiStrategy, error) {
+	rules, err := compileLeastLoPiRules(settings.GetCosts())
+	if err != nil {
+		return nil, err
+	}
+	return &LeastLoPiStrategy{
+		settings: settings,
+		rules:    rules,
+		cache:    make(map[string]leastLoPiCost),
+	}, nil
+}
+
+// Validate checks the weight rules of the settings
+func (c *StrategyLeastLoPiConfig) Validate() error {
+	_, err := compileLeastLoPiRules(c.GetCosts())
+	return err
+}
+
+func compileLeastLoPiRules(costs []*StrategyLeastLoPiWeight) ([]*leastLoPiRule, error) {
+	rules := make([]*leastLoPiRule, 0, len(costs))
+	for i, w := range costs {
+		if w.GetMatch() == "" {
+			return nil, errors.New("leastLoPi: costs[", i, "]: empty match")
+		}
+		rule := &leastLoPiRule{match: w.Match, costPing: w.CostPing, costDevi: w.CostDevi}
+		if w.Regexp {
+			re, err := regexp.Compile(w.Match)
+			if err != nil {
+				return nil, errors.New("leastLoPi: costs[", i, "]: invalid regexp ", strconv.Quote(w.Match)).Base(err)
+			}
+			rule.re = re
+		}
+		if problem := leastLoPiCostProblem(w.CostPing); problem != "" {
+			return nil, errors.New("leastLoPi: costs[", i, "]: costPing ", problem)
+		}
+		if problem := leastLoPiCostProblem(w.CostDevi); problem != "" {
+			return nil, errors.New("leastLoPi: costs[", i, "]: costDevi ", problem)
+		}
+		if w.CostPing != nil && w.CostDevi != nil && *w.CostPing == 0 && *w.CostDevi == 0 {
+			return nil, errors.New("leastLoPi: costs[", i, "]: costPing and costDevi are both 0")
+		}
+		rules = append(rules, rule)
+	}
+	return rules, nil
+}
+
+// leastLoPiCostProblem describes why a configured weight is invalid, "" if it is valid
+func leastLoPiCostProblem(cost *float64) string {
+	switch {
+	case cost == nil:
+		return ""
+	case math.IsNaN(*cost) || math.IsInf(*cost, 0):
+		return "must be finite"
+	case *cost < 0:
+		return "must not be negative"
+	}
+	return ""
+}
+
+func (s *LeastLoPiStrategy) InjectContext(ctx context.Context) {
+	s.ctx = ctx
+}
+
+// GetPrincipleTarget implements BalancingPrincipleTarget
+func (s *LeastLoPiStrategy) GetPrincipleTarget(candidates []string) []string {
+	var ret []string
+	for _, v := range s.pickOutbounds(candidates) {
+		ret = append(ret, v.Tag)
+	}
+	return ret
+}
+
+// PickOutbound implements BalancingStrategy
+func (s *LeastLoPiStrategy) PickOutbound(candidates []string) string {
+	selects := s.pickOutbounds(candidates)
+	count := len(selects)
+	if count == 0 {
+		// goes to fallbackTag
+		return ""
+	}
+	return selects[dice.Roll(count)].Tag
+}
+
+func (s *LeastLoPiStrategy) pickOutbounds(candidates []string) []*lopiNode {
+	return s.selectLeastLoPi(s.getNodes(candidates))
+}
+
+// selectLeastLoPi selects nodes by Expected and Baselines like selectLeastLoad
+// of LeastLoadStrategy, comparing the baselines with the scores
+func (s *LeastLoPiStrategy) selectLeastLoPi(nodes []*lopiNode) []*lopiNode {
+	if len(nodes) == 0 {
+		errors.LogInfo(s.ctx, "least load pi: no qualified outbound")
+		return nil
+	}
+	expected := int(s.settings.GetExpected())
+	availableCount := len(nodes)
+	if expected > availableCount {
+		return nodes
+	}
+	if expected <= 0 {
+		expected = 1
+	}
+	baselines := s.settings.GetBaselines()
+	if len(baselines) == 0 {
+		return nodes[:expected]
+	}
+	count := 0
+	// go through all base line until find expected selects
+	for _, b := range baselines {
+		baseline := float64(b)
+		for i := count; i < availableCount; i++ {
+			if nodes[i].Score >= baseline {
+				break
+			}
+			count = i + 1
+		}
+		// don't continue if find expected selects
+		if count >= expected {
+			errors.LogDebug(s.ctx, "least load pi: applied baseline: ", time.Duration(b))
+			break
+		}
+	}
+	if s.settings.GetExpected() > 0 && count < expected {
+		count = expected
+	}
+	return nodes[:count]
+}
+
+// getObserver looks up the registered observatory without changing the state of the
+// core; a missing observatory is not cached, so the next call looks it up again
+func (s *LeastLoPiStrategy) getObserver() extension.Observatory {
+	s.observerMu.Lock()
+	defer s.observerMu.Unlock()
+	if s.observer != nil {
+		return s.observer
+	}
+	if s.ctx == nil {
+		return nil
+	}
+	instance := core.FromContext(s.ctx)
+	if instance == nil {
+		return nil
+	}
+	feature := instance.GetFeature(extension.ObservatoryType())
+	if observer, ok := feature.(extension.Observatory); ok {
+		s.observer = observer
+	}
+	return s.observer
+}
+
+func (s *LeastLoPiStrategy) getNodes(candidates []string) []*lopiNode {
+	observer := s.getObserver()
+	if observer == nil {
+		errors.LogInfo(s.ctx, "least load pi: no observatory")
+		return nil
+	}
+	observeResult, err := observer.GetObservation(s.ctx)
+	if err != nil {
+		errors.LogInfoInner(s.ctx, err, "cannot get observation")
+		return nil
+	}
+	results, ok := observeResult.(*observatory.ObservationResult)
+	if !ok {
+		errors.LogInfo(s.ctx, "least load pi: unexpected observation result")
+		return nil
+	}
+	maxRTT := time.Duration(s.settings.GetMaxRTT())
+	outbounds := outboundList(candidates)
+	var ret []*lopiNode
+	for _, v := range results.Status {
+		if !(v.Alive && (v.Delay < maxRTT.Milliseconds() || maxRTT == 0) && outbounds.contains(v.OutboundTag)) {
+			continue
+		}
+		cost := s.getCost(v.OutboundTag)
+		average, deviation := leastLoPiMeasure(v)
+		record := &lopiNode{
+			Tag:     v.OutboundTag,
+			Average: average,
+			Score:   cost.score(average, deviation),
+		}
+		if hp := v.HealthPing; hp != nil {
+			record.CountAll = hp.All
+			record.CountFail = hp.Fail
+		}
+		ret = append(ret, record)
+	}
+	leastLoPiSort(ret)
+	return ret
+}
+
+// getCost returns the weights of the first matched rule, 1 for a weight not configured
+func (s *LeastLoPiStrategy) getCost(tag string) leastLoPiCost {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if cost, ok := s.cache[tag]; ok {
+		return cost
+	}
+	cost := leastLoPiCost{ping: 1, devi: 1}
+	for _, rule := range s.rules {
+		if !rule.matches(tag) {
+			continue
+		}
+		if rule.costPing != nil {
+			cost.ping = *rule.costPing
+		}
+		if rule.costDevi != nil {
+			cost.devi = *rule.costDevi
+		}
+		break
+	}
+	s.cache[tag] = cost
+	return cost
+}
+
+func (r *leastLoPiRule) matches(tag string) bool {
+	if r.re != nil {
+		return r.re.MatchString(tag)
+	}
+	return strings.Contains(tag, r.match)
+}
+
+func (c leastLoPiCost) score(average, deviation float64) float64 {
+	return average*math.Sqrt(c.ping) + deviation*math.Sqrt(c.devi)
+}
+
+func leastLoPiSort(nodes []*lopiNode) {
+	sort.Slice(nodes, func(i, j int) bool {
+		left := nodes[i]
+		right := nodes[j]
+		if left.Score != right.Score {
+			return left.Score < right.Score
+		}
+		if left.Average != right.Average {
+			return left.Average < right.Average
+		}
+		if left.CountFail != right.CountFail {
+			return left.CountFail < right.CountFail
+		}
+		if left.CountAll != right.CountAll {
+			return left.CountAll > right.CountAll
+		}
+		return left.Tag < right.Tag
+	})
+}
+
+// CostRules implements BalancingCostReporter
+func (s *LeastLoPiStrategy) CostRules() []routing.BalancerCostRule {
+	var ret []routing.BalancerCostRule
+	for _, rule := range s.rules {
+		ret = append(ret, routing.BalancerCostRule{
+			Match:    rule.match,
+			Regexp:   rule.re != nil,
+			CostPing: copyCost(rule.costPing),
+			CostDevi: copyCost(rule.costDevi),
+		})
+	}
+	return ret
+}
+
+// OutboundCosts implements BalancingCostReporter with the weights the ranking applies
+func (s *LeastLoPiStrategy) OutboundCosts(candidates []string) []routing.BalancerOutboundCost {
+	var ret []routing.BalancerOutboundCost
+	for _, tag := range sortedCandidates(candidates) {
+		cost := s.getCost(tag)
+		ping, devi := cost.ping, cost.devi
+		ret = append(ret, routing.BalancerOutboundCost{OutboundTag: tag, CostPing: &ping, CostDevi: &devi})
+	}
+	return ret
+}
