+func Test_lbMs(t *testing.T) {
+	type args struct {
+		ns float64
+	}
+	tests := []struct {
+		name string
+		args args
+		want string
+	}{
+		{name: "zero", args: args{ns: 0}, want: "0.000ms"},
+		{name: "under half a microsecond rounds down", args: args{ns: 1499}, want: "0.001ms"},
+		{name: "half a microsecond rounds up", args: args{ns: 1500}, want: "0.002ms"},
+		{name: "milliseconds", args: args{ns: 645e6}, want: "645.000ms"},
+		{name: "huge value without an exponent", args: args{ns: 1e22}, want: "10000000000000000.000ms"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := lbMs(tt.args.ns); got != tt.want {
+				t.Errorf("lbMs() = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
