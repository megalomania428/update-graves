+func Test_routingServer_ListBalancers(t *testing.T) {
+	tests := []struct {
+		name     string
+		initial  []string
+		reload   []string
+		add      []string
+		plain    bool
+		want     []string
+		wantCode codes.Code
+	}{
+		{
+			name: "no balancers",
+		},
+		{
+			name:    "several balancers in ascending order",
+			initial: []string{"vl-w", "b", "a-x"},
+			want:    []string{"a-x", "b", "vl-w"},
+		},
+		{
+			name:    "ReloadRules replaces the balancers",
+			initial: []string{"old"},
+			reload:  []string{"new2", "new1"},
+			want:    []string{"new1", "new2"},
+		},
+		{
+			name:    "AddRule appends balancers",
+			initial: []string{"b"},
+			add:     []string{"c", "a"},
+			want:    []string{"a", "b", "c"},
+		},
+		{
+			name:     "router without the list",
+			plain:    true,
+			wantCode: codes.Unimplemented,
+		},
+	}
+	balancers := func(tags []string) *router.Config {
+		config := &router.Config{}
+		for _, tag := range tags {
+			config.BalancingRule = append(config.BalancingRule,
+				&router.BalancingRule{Tag: tag, OutboundSelector: []string{"x"}})
+		}
+		return config
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			mockCtl := gomock.NewController(t)
+			defer mockCtl.Finish()
+			var rt routing.Router = routing.DefaultRouter{}
+			if !tt.plain {
+				r := new(router.Router)
+				if err := r.Init(context.TODO(), balancers(tt.initial), mocks.NewDNSClient(mockCtl),
+					mocks.NewOutboundManager(mockCtl), nil); err != nil {
+					t.Fatalf("Router.Init() error = %v", err)
+				}
+				if tt.reload != nil {
+					if err := r.ReloadRules(balancers(tt.reload), false); err != nil {
+						t.Fatalf("Router.ReloadRules() error = %v", err)
+					}
+				}
+				if tt.add != nil {
+					if err := r.AddRule(serial.ToTypedMessage(balancers(tt.add)), true); err != nil {
+						t.Fatalf("Router.AddRule() error = %v", err)
+					}
+				}
+				rt = r
+			}
+			resp, err := NewRoutingServer(rt, nil).ListBalancers(context.Background(),
+				&ListBalancersRequest{})
+			if code := status.Code(err); code != tt.wantCode {
+				t.Fatalf("ListBalancers() error = %v, want code %v", err, tt.wantCode)
+			}
+			if err != nil {
+				return
+			}
+			if diff := cmp.Diff(tt.want, resp.GetTags(), cmpopts.EquateEmpty()); diff != "" {
+				t.Errorf("ListBalancers() tags mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
