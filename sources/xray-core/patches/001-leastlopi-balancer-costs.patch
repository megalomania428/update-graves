diff -ruN -x .git a/main/commands/all/api/balancer_list.go b/main/commands/all/api/balancer_list.go
--- a/main/commands/all/api/balancer_list.go	1970-01-01 00:00:00.000000000 +0000
+++ b/main/commands/all/api/balancer_list.go	2026-11-24 13:23:42.920746565 +0000
@@ -0,0 +1,462 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+	observatoryService "github.com/xtls/xray-core/app/observatory/command"
+	"github.com/xtls/xray-core/app/router"
+	routerService "github.com/xtls/xray-core/app/router/command"
+	"github.com/xtls/xray-core/main/commands/base"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+var cmdBalancerList = &base.Command{
+	CustomFlags: true,
+	UsageLine:   "{{.Exec}} api lb [--server=127.0.0.1:8080] [balancer]...",
+	Short:       "list balancers with outbound scores",
+	Long: `
+List the outbounds of balancers with their observatory status and the
+score of the balancer strategy, computed by the functions the strategy
+ranks outbounds with. Without balancer tags, list all balancers and then
+the outbounds of the observatory report out of them under "(no balancer)".
+
+> Make sure you have "RoutingService" and "ObservatoryService" set in
+"config.api.services" of server config.
+
+Arguments:
+
+	-json
+		Use json output.
+
+	-s, -server <server:port>
+		The API server address. Default 127.0.0.1:8080
+
+	-t, -timeout <seconds>
+		Timeout seconds to call API. Default 3
+
+Example:
+
+    {{.Exec}} {{.LongName}} --server=127.0.0.1:8080
+    {{.Exec}} {{.LongName}} --server=127.0.0.1:8080 balancer1 balancer2
+`,
+	Run: executeBalancerList,
+}
+
+// lbNoBalancer is the header of the outbounds of the observatory report out of the
+// listed balancers
+const lbNoBalancer = "(no balancer)"
+
+// lbOutbound is an outbound of a group, the JSON fields keep the order of the text line
+type lbOutbound struct {
+	OutboundTag string   `json:"outboundTag"`
+	Alive       bool     `json:"alive"`
+	Status      bool     `json:"status"`
+	DelayMs     *int64   `json:"delayMs,omitempty"`
+	Average     *int64   `json:"average,omitempty"`
+	Deviation   *int64   `json:"deviation,omitempty"`
+	Min         *int64   `json:"min,omitempty"`
+	Max         *int64   `json:"max,omitempty"`
+	Fail        *int64   `json:"fail,omitempty"`
+	All         *int64   `json:"all,omitempty"`
+	Score       *float64 `json:"score"`
+	Cost        *float64 `json:"cost,omitempty"`
+	CostPing    *float64 `json:"costPing,omitempty"`
+	CostDevi    *float64 `json:"costDevi,omitempty"`
+	// avg is the unweighted average RTT in nanoseconds the order compares
+	avg float64
+}
+
+// lbGroup is a balancer with its outbounds
+type lbGroup struct {
+	Tag       string       `json:"tag"`
+	Strategy  string       `json:"strategy"`
+	Outbounds []lbOutbound `json:"outbounds"`
+}
+
+// lbReport is the output of the command, Unassigned is set only without balancer tags
+type lbReport struct {
+	Balancers  []lbGroup     `json:"balancers"`
+	Unassigned *[]lbOutbound `json:"unassigned,omitempty"`
+}
+
+func executeBalancerList(cmd *base.Command, args []string) {
+	setSharedFlags(cmd)
+	cmd.Flag.Parse(args)
+	conn, ctx, close := dialAPIServer()
+	defer close()
+	report, err := collectBalancerList(ctx, routerService.NewRoutingServiceClient(conn),
+		observatoryService.NewObservatoryServiceClient(conn), cmd.Flag.Args(),
+		apiServerAddrPtr, os.Stderr)
+	if err != nil {
+		base.Fatalf("%s", err)
+	}
+	if err := writeBalancerList(os.Stdout, report, apiJSON); err != nil {
+		base.Fatalf("failed to print balancers: %s", err)
+	}
+}
+
+// collectBalancerList requests the balancers and the observatory report and builds the
+// groups: of all balancers and then the outbounds out of them without tags, of the
+// balancers of tags in their order otherwise. Warnings go to warn.
+func collectBalancerList(ctx context.Context, rc routerService.RoutingServiceClient,
+	oc observatoryService.ObservatoryServiceClient, tags []string, server string,
+	warn io.Writer,
+) (*lbReport, error) {
+	all := len(tags) == 0
+	tags = uniqueTags(tags)
+	list, err := rc.ListBalancers(ctx, &routerService.ListBalancersRequest{})
+	switch {
+	case err == nil && all:
+		tags = list.GetTags()
+	case err == nil:
+		if unknown := unknownTags(tags, list.GetTags()); len(unknown) > 0 {
+			return nil, fmt.Errorf("unknown balancer: %s", strings.Join(unknown, ", "))
+		}
+	case status.Code(err) == codes.Unimplemented && all:
+		return nil, fmt.Errorf(
+			"the server does not list balancers, specify balancer tags as arguments: %w", err)
+	case status.Code(err) != codes.Unimplemented:
+		return nil, fmt.Errorf("failed to list balancers: %w", err)
+	}
+	infos := make([]*routerService.BalancerMsg, 0, len(tags))
+	for _, tag := range tags {
+		resp, err := rc.GetBalancerInfo(ctx, &routerService.GetBalancerInfoRequest{Tag: tag})
+		if err != nil {
+			return nil, fmt.Errorf("failed to get balancer %s: %w", tag, err)
+		}
+		infos = append(infos, resp.GetBalancer())
+	}
+	resp, err := oc.GetOutboundStatus(ctx, &observatoryService.GetOutboundStatusRequest{})
+	if err != nil {
+		return nil, fmt.Errorf("failed to get outbound status: %w", err)
+	}
+	statuses := make(map[string]*observatory.OutboundStatus)
+	var order []string
+	for _, st := range resp.GetStatus().GetStatus() {
+		if _, ok := statuses[st.GetOutboundTag()]; !ok {
+			statuses[st.GetOutboundTag()] = st
+			order = append(order, st.GetOutboundTag())
+		}
+	}
+	if len(order) == 0 {
+		fmt.Fprintf(warn, "warning: the observatory at %s reported no outbounds\n", server)
+	}
+	report := &lbReport{Balancers: make([]lbGroup, 0, len(tags))}
+	assigned := make(map[string]bool)
+	for i, tag := range tags {
+		group := newBalancerGroup(tag, infos[i], statuses, warn)
+		for _, o := range group.Outbounds {
+			assigned[o.OutboundTag] = true
+		}
+		report.Balancers = append(report.Balancers, group)
+	}
+	if all {
+		unassigned := make([]lbOutbound, 0)
+		for _, tag := range order {
+			if !assigned[tag] {
+				unassigned = append(unassigned, newLbOutbound(tag, statuses[tag]))
+			}
+		}
+		sortLbOutbounds(unassigned)
+		report.Unassigned = &unassigned
+	}
+	return report, nil
+}
+
+// newBalancerGroup builds the group of a balancer: its candidates or, from a server
+// without them, the tags of its weights, with the observatory status and the score
+func newBalancerGroup(tag string, info *routerService.BalancerMsg,
+	statuses map[string]*observatory.OutboundStatus, warn io.Writer,
+) lbGroup {
+	group := lbGroup{Tag: tag, Strategy: info.GetStrategy(), Outbounds: make([]lbOutbound, 0)}
+	costs := make(map[string]*routerService.BalancerOutboundCost)
+	var costTags []string
+	for _, c := range info.GetOutboundCosts() {
+		if _, ok := costs[c.GetOutboundTag()]; !ok {
+			costs[c.GetOutboundTag()] = c
+			costTags = append(costTags, c.GetOutboundTag())
+		}
+	}
+	members := sortedUniqueTags(info.GetCandidates())
+	if len(members) == 0 {
+		members = sortedUniqueTags(costTags)
+	}
+	weighted := group.Strategy == "leastload" || group.Strategy == "leastlopi"
+	switch {
+	case len(members) == 0:
+		fmt.Fprintf(warn, "warning: balancer %s reports neither candidates nor outbound costs\n",
+			tag)
+	case weighted && len(costs) == 0:
+		fmt.Fprintf(warn,
+			"warning: balancer %s reports no outbound costs: scores are not computed\n", tag)
+	}
+	switch {
+	case group.Strategy == "":
+		fmt.Fprintf(warn, "warning: balancer %s reports no strategy, its Xray API has no "+
+			"balancer weights: scores are not computed\n", tag)
+	case !weighted:
+		fmt.Fprintf(warn,
+			"warning: balancer %s: strategy %s has no weights: scores are not computed\n",
+			tag, group.Strategy)
+	}
+	var overflow, notFinite bool
+	for _, member := range members {
+		st := statuses[member]
+		o := newLbOutbound(member, st)
+		c := costs[member]
+		if c != nil {
+			o.Cost, o.CostPing, o.CostDevi = c.Cost, c.CostPing, c.CostDevi
+		}
+		if score, ok, inRange := lbScore(group.Strategy, st, c); ok {
+			overflow = overflow || !inRange
+			if math.IsNaN(score) || math.IsInf(score, 0) {
+				notFinite = true
+			} else {
+				o.Score = &score
+			}
+		}
+		group.Outbounds = append(group.Outbounds, o)
+	}
+	if overflow {
+		fmt.Fprintf(warn, "warning: balancer %s: a leastLoad score is out of the int64 range "+
+			"of time.Duration: the server overflows it, so its order may differ\n", tag)
+	}
+	if notFinite {
+		fmt.Fprintf(warn,
+			"warning: balancer %s: a score is not a finite number, it is shown as n/a\n", tag)
+	}
+	sortLbOutbounds(group.Outbounds)
+	return group
+}
+
+// newLbOutbound returns an outbound with its observatory status, st is nil for a
+// candidate missing from the observatory report
+func newLbOutbound(tag string, st *observatory.OutboundStatus) lbOutbound {
+	o := lbOutbound{OutboundTag: tag}
+	if st == nil {
+		return o
+	}
+	o.Status = true
+	o.Alive = st.GetAlive()
+	if hp := st.GetHealthPing(); hp != nil {
+		fail, all := hp.GetFail(), hp.GetAll()
+		o.Fail, o.All = &fail, &all
+		o.avg = float64(hp.GetAverage())
+		if all > fail {
+			average, deviation := hp.GetAverage(), hp.GetDeviation()
+			minimum, maximum := hp.GetMin(), hp.GetMax()
+			o.Average, o.Deviation, o.Min, o.Max = &average, &deviation, &minimum, &maximum
+		}
+		return o
+	}
+	o.avg = float64(st.GetDelay()) * float64(time.Millisecond)
+	if o.Alive {
+		delay := st.GetDelay()
+		o.DelayMs = &delay
+	}
+	return o
+}
+
+// lbScore returns the score of a measured outbound computed by the functions the
+// strategy ranks with; ok is false without a score, inRange is false for a leastLoad
+// value out of the int64 range of time.Duration
+func lbScore(strategy string, st *observatory.OutboundStatus,
+	cost *routerService.BalancerOutboundCost,
+) (score float64, ok, inRange bool) {
+	if cost == nil || !lbMeasured(st) {
+		return 0, false, true
+	}
+	switch {
+	case strategy == "leastload" && cost.Cost != nil:
+		score, inRange = router.LeastLoadScore(st, cost.GetCost())
+		return score, true, inRange
+	case strategy == "leastlopi" && cost.CostPing != nil && cost.CostDevi != nil:
+		return router.LeastLoPiScore(st, cost.GetCostPing(), cost.GetCostDevi()), true, true
+	}
+	return 0, false, true
+}
+
+// lbMeasured reports an alive outbound with a successful probe or a last delay
+func lbMeasured(st *observatory.OutboundStatus) bool {
+	if st == nil || !st.GetAlive() {
+		return false
+	}
+	hp := st.GetHealthPing()
+	return hp == nil || hp.GetAll() > hp.GetFail()
+}
+
+// sortLbOutbounds orders alive outbounds first, the scored ones by the score, then by
+// the unweighted average, fewer failed probes, more probes and the tag; candidates
+// missing from the observatory report go last by tag
+func sortLbOutbounds(list []lbOutbound) {
+	sort.SliceStable(list, func(i, j int) bool {
+		a, b := &list[i], &list[j]
+		if a.Status != b.Status {
+			return a.Status
+		}
+		if a.Alive != b.Alive {
+			return a.Alive
+		}
+		if (a.Score != nil) != (b.Score != nil) {
+			return a.Score != nil
+		}
+		if a.Score != nil && *a.Score != *b.Score {
+			return *a.Score < *b.Score
+		}
+		if a.avg != b.avg {
+			return a.avg < b.avg
+		}
+		if fa, fb := lbCount(a.Fail), lbCount(b.Fail); fa != fb {
+			return fa < fb
+		}
+		if aa, ab := lbCount(a.All), lbCount(b.All); aa != ab {
+			return aa > ab
+		}
+		return a.OutboundTag < b.OutboundTag
+	})
+}
+
+func lbCount(v *int64) int64 {
+	if v == nil {
+		return 0
+	}
+	return *v
+}
+
+// writeBalancerList prints the groups as text or, with asJSON, as JSON
+func writeBalancerList(w io.Writer, report *lbReport, asJSON bool) error {
+	if asJSON {
+		data, err := json.MarshalIndent(report, "", "  ")
+		if err != nil {
+			return err
+		}
+		_, err = fmt.Fprintln(w, string(data))
+		return err
+	}
+	var b strings.Builder
+	header := func(title string) {
+		if b.Len() > 0 {
+			b.WriteString("\n")
+		}
+		b.WriteString(title + ":\n")
+	}
+	for _, group := range report.Balancers {
+		title := group.Tag
+		if group.Strategy != "" {
+			title += " " + group.Strategy
+		}
+		header(title)
+		for _, o := range group.Outbounds {
+			b.WriteString(formatLbOutbound(o) + "\n")
+		}
+	}
+	if report.Unassigned != nil {
+		header(lbNoBalancer)
+		for _, o := range *report.Unassigned {
+			b.WriteString(formatLbOutbound(o) + "\n")
+		}
+	}
+	_, err := io.WriteString(w, b.String())
+	return err
+}
+
+// formatLbOutbound returns the text line of an outbound
+func formatLbOutbound(o lbOutbound) string {
+	var b strings.Builder
+	b.WriteString(o.OutboundTag)
+	if !o.Status {
+		b.WriteString(" status=n/a")
+	} else {
+		fmt.Fprintf(&b, " alive=%t", o.Alive)
+		switch {
+		case o.Average != nil:
+			fmt.Fprintf(&b, " avg=%s dev=%s min=%s max=%s", lbMs(float64(*o.Average)),
+				lbMs(float64(*o.Deviation)), lbMs(float64(*o.Min)), lbMs(float64(*o.Max)))
+		case o.DelayMs != nil:
+			fmt.Fprintf(&b, " last=%s", lbMs(float64(*o.DelayMs)*float64(time.Millisecond)))
+		default:
+			b.WriteString(" RTT=n/a")
+		}
+	}
+	if o.Score != nil {
+		fmt.Fprintf(&b, " score=%s", lbMs(*o.Score))
+	} else {
+		b.WriteString(" score=n/a")
+	}
+	if o.Fail != nil {
+		fmt.Fprintf(&b, " fail=%d/%d", *o.Fail, *o.All)
+	}
+	for _, weight := range []struct {
+		name  string
+		value *float64
+	}{{"cost", o.Cost}, {"costPing", o.CostPing}, {"costDevi", o.CostDevi}} {
+		if weight.value != nil {
+			fmt.Fprintf(&b, " %s=%s", weight.name, strconv.FormatFloat(*weight.value, 'f', -1, 64))
+		}
+	}
+	return b.String()
+}
+
+// lbMs formats nanoseconds as milliseconds with three decimals, rounded to a
+// microsecond and without an exponent for huge values
+func lbMs(ns float64) string {
+	us := math.Round(ns / 1e3)
+	if us == 0 {
+		us = 0
+	}
+	digits := strconv.FormatFloat(us, 'f', 0, 64)
+	sign := ""
+	if strings.HasPrefix(digits, "-") {
+		sign, digits = "-", digits[1:]
+	}
+	if len(digits) < 4 {
+		digits = strings.Repeat("0", 4-len(digits)) + digits
+	}
+	return sign + digits[:len(digits)-3] + "." + digits[len(digits)-3:] + "ms"
+}
+
+// uniqueTags returns the tags without repeats in their order
+func uniqueTags(tags []string) []string {
+	seen := make(map[string]bool, len(tags))
+	ret := make([]string, 0, len(tags))
+	for _, tag := range tags {
+		if !seen[tag] {
+			seen[tag] = true
+			ret = append(ret, tag)
+		}
+	}
+	return ret
+}
+
+// sortedUniqueTags returns the tags without repeats in ascending order
+func sortedUniqueTags(tags []string) []string {
+	ret := uniqueTags(tags)
+	sort.Strings(ret)
+	return ret
+}
+
+// unknownTags returns the tags missing from known in the order of tags
+func unknownTags(tags, known []string) []string {
+	set := make(map[string]bool, len(known))
+	for _, tag := range known {
+		set[tag] = true
+	}
+	var ret []string
+	for _, tag := range tags {
+		if !set[tag] {
+			ret = append(ret, tag)
+		}
+	}
+	return ret
+}
diff -ruN -x .git a/main/commands/all/api/balancer_list_test.go b/main/commands/all/api/balancer_list_test.go
--- a/main/commands/all/api/balancer_list_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/main/commands/all/api/balancer_list_test.go	2026-11-24 14:13:51.838303377 +0000
@@ -0,0 +1,477 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"maps"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+	observatoryService "github.com/xtls/xray-core/app/observatory/command"
+	routerService "github.com/xtls/xray-core/app/router/command"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// fakeRoutingClient answers ListBalancers and GetBalancerInfo with fixed replies
+type fakeRoutingClient struct {
+	routerService.RoutingServiceClient
+	list      []string
+	listErr   error
+	balancers map[string]*routerService.BalancerMsg
+
+	listCalls int
+	infoCalls map[string]int
+}
+
+func (c *fakeRoutingClient) ListBalancers(ctx context.Context,
+	in *routerService.ListBalancersRequest, opts ...grpc.CallOption,
+) (*routerService.ListBalancersResponse, error) {
+	c.listCalls++
+	if c.listErr != nil {
+		return nil, c.listErr
+	}
+	return &routerService.ListBalancersResponse{Tags: c.list}, nil
+}
+
+func (c *fakeRoutingClient) GetBalancerInfo(ctx context.Context,
+	in *routerService.GetBalancerInfoRequest, opts ...grpc.CallOption,
+) (*routerService.GetBalancerInfoResponse, error) {
+	if c.infoCalls == nil {
+		c.infoCalls = make(map[string]int)
+	}
+	c.infoCalls[in.GetTag()]++
+	balancer, ok := c.balancers[in.GetTag()]
+	if !ok {
+		return nil, errors.New("app/router: cannot find tag")
+	}
+	return &routerService.GetBalancerInfoResponse{Balancer: balancer}, nil
+}
+
+// fakeObservatoryClient answers GetOutboundStatus with a fixed report
+type fakeObservatoryClient struct {
+	status []*observatory.OutboundStatus
+
+	statusCalls int
+}
+
+func (c *fakeObservatoryClient) GetOutboundStatus(ctx context.Context,
+	in *observatoryService.GetOutboundStatusRequest, opts ...grpc.CallOption,
+) (*observatoryService.GetOutboundStatusResponse, error) {
+	c.statusCalls++
+	return &observatoryService.GetOutboundStatusResponse{
+		Status: &observatory.ObservationResult{Status: c.status},
+	}, nil
+}
+
+func lbF(v float64) *float64 { return &v }
+
+func lbBurst(tag string, average, deviation, minimum, maximum time.Duration,
+	all, fail int64,
+) *observatory.OutboundStatus {
+	return &observatory.OutboundStatus{
+		OutboundTag: tag,
+		Alive:       all != fail,
+		Delay:       average.Milliseconds(),
+		HealthPing: &observatory.HealthPingMeasurementResult{
+			All:       all,
+			Fail:      fail,
+			Average:   int64(average),
+			Deviation: int64(deviation),
+			Min:       int64(minimum),
+			Max:       int64(maximum),
+		},
+	}
+}
+
+func lbPlain(tag string, alive bool, delay int64) *observatory.OutboundStatus {
+	return &observatory.OutboundStatus{OutboundTag: tag, Alive: alive, Delay: delay}
+}
+
+// lbTestBalancers returns a random balancer and a leastLoPi one sharing cg-vl-w
+func lbTestBalancers() map[string]*routerService.BalancerMsg {
+	return map[string]*routerService.BalancerMsg{
+		"rnd": {Strategy: "random", Candidates: []string{"x-free", "cg-vl-w"}},
+		"vl-w": {
+			Strategy:   "leastlopi",
+			Candidates: []string{"mh-vl-w", "idle-vl-w", "cg-vl-w", "cb-vl-w", "mh-vl-w"},
+			OutboundCosts: []*routerService.BalancerOutboundCost{
+				{OutboundTag: "cb-vl-w", CostPing: lbF(4096), CostDevi: lbF(4096)},
+				{OutboundTag: "cg-vl-w", CostPing: lbF(1), CostDevi: lbF(1)},
+				{OutboundTag: "idle-vl-w", CostPing: lbF(1), CostDevi: lbF(0)},
+				{OutboundTag: "mh-vl-w", CostPing: lbF(16), CostDevi: lbF(1)},
+			},
+		},
+	}
+}
+
+// lbTestStatus returns the observatory report of lbTestBalancers with two outbounds
+// out of the balancers and without idle-vl-w
+func lbTestStatus() []*observatory.OutboundStatus {
+	ms := time.Millisecond
+	return []*observatory.OutboundStatus{
+		lbPlain("dead-x", false, 99999999),
+		lbBurst("mh-vl-w", 150*ms, 45*ms, 101*ms, 230*ms, 10, 1),
+		lbPlain("out-x", true, 7),
+		lbBurst("cb-vl-w", 0, 0, 0, 0, 10, 10),
+		lbBurst("cg-vl-w", 1500*ms, 0, 1500*ms, 1500*ms, 10, 0),
+		lbPlain("x-free", true, 20),
+	}
+}
+
+const (
+	lbTestRnd = "rnd random:\n" +
+		"x-free alive=true last=20.000ms score=n/a\n" +
+		"cg-vl-w alive=true avg=1500.000ms dev=0.000ms min=1500.000ms max=1500.000ms " +
+		"score=n/a fail=0/10\n"
+	lbTestVlw = "vl-w leastlopi:\n" +
+		"mh-vl-w alive=true avg=150.000ms dev=45.000ms min=101.000ms max=230.000ms " +
+		"score=645.000ms fail=1/10 costPing=16 costDevi=1\n" +
+		"cg-vl-w alive=true avg=1500.000ms dev=0.000ms min=1500.000ms max=1500.000ms " +
+		"score=1500.000ms fail=0/10 costPing=1 costDevi=1\n" +
+		"cb-vl-w alive=false RTT=n/a score=n/a fail=10/10 costPing=4096 costDevi=4096\n" +
+		"idle-vl-w status=n/a score=n/a costPing=1 costDevi=0\n"
+	lbTestRndWarn = "warning: balancer rnd: strategy random has no weights: " +
+		"scores are not computed\n"
+	lbTestEqLine = " alive=true avg=100.000ms dev=0.000ms min=100.000ms max=100.000ms " +
+		"score=100.000ms"
+	lbTestJSON = `{
+  "balancers": [
+    {
+      "tag": "vl-w",
+      "strategy": "leastlopi",
+      "outbounds": [
+        {
+          "outboundTag": "mh-vl-w",
+          "alive": true,
+          "status": true,
+          "average": 150000000,
+          "deviation": 45000000,
+          "min": 101000000,
+          "max": 230000000,
+          "fail": 1,
+          "all": 10,
+          "score": 645000000,
+          "costPing": 16,
+          "costDevi": 1
+        },
+        {
+          "outboundTag": "idle-vl-w",
+          "alive": false,
+          "status": false,
+          "score": null,
+          "costPing": 1,
+          "costDevi": 0
+        }
+      ]
+    }
+  ],
+  "unassigned": [
+    {
+      "outboundTag": "out-x",
+      "alive": true,
+      "status": true,
+      "delayMs": 7,
+      "score": null
