+func TestRouter_GetBalancerCosts(t *testing.T) {
+	type fields struct {
+		rule     *BalancingRule
+		ohm      outbound.Manager
+		override string
+		status   []*observatory.OutboundStatus
+	}
+	type args struct {
+		tag string
+	}
+	tests := []struct {
+		name             string
+		fields           fields
+		args             args
+		want             *routing.BalancerCosts
+		wantErr          bool
+		wantOutboundsErr bool
+	}{
+		{
+			name: "leastLoad reports the weights of its WeightManager for unmeasured candidates",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"ax", "cg-", "mh-", "pl"},
+					Strategy:         "leastLoad",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{
+						Costs: []*StrategyWeight{
+							{Match: "x5"},
+							{Regexp: true, Match: `^mh-\d+`},
+							{Match: "vl", Value: 2.5},
+							{Match: "zz", Value: 7},
+						},
+					}),
+				},
+				ohm: &fakeHandlerSelector{tags: []string{"ax5b", "cg-vl", "mh-16-vl", "other", "pl"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastload",
+				Rules: []routing.BalancerCostRule{
+					{Match: "x5", Value: costOf(0)},
+					{Match: `^mh-\d+`, Regexp: true, Value: costOf(0)},
+					{Match: "vl", Value: costOf(2.5)},
+					{Match: "zz", Value: costOf(7)},
+				},
+				Candidates: []string{"ax5b", "cg-vl", "mh-16-vl", "pl"},
+				Outbounds: []routing.BalancerOutboundCost{
+					{OutboundTag: "ax5b", Cost: costOf(5)},
+					{OutboundTag: "cg-vl", Cost: costOf(2.5)},
+					{OutboundTag: "mh-16-vl", Cost: costOf(16)},
+					{OutboundTag: "pl", Cost: costOf(1)},
+				},
+			},
+		},
+		{
+			name: "leastLoPi reports configured and effective weights",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"cg-", "mh-", "cb-", "zz"},
+					Strategy:         "LeastLoPi",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoPiConfig{
+						Costs: []*StrategyLeastLoPiWeight{
+							{Match: "cg", CostDevi: costOf(0)},
+							{Regexp: true, Match: "^mh-", CostPing: costOf(16)},
+							{Match: "-w", CostPing: costOf(4), CostDevi: costOf(4)},
+						},
+					}),
+				},
+				ohm: &fakeHandlerSelector{tags: []string{"cb-w", "cg-w", "mh-w", "other-w", "zz"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastlopi",
+				Rules: []routing.BalancerCostRule{
+					{Match: "cg", CostDevi: costOf(0)},
+					{Match: "^mh-", Regexp: true, CostPing: costOf(16)},
+					{Match: "-w", CostPing: costOf(4), CostDevi: costOf(4)},
+				},
+				Candidates: []string{"cb-w", "cg-w", "mh-w", "zz"},
+				Outbounds: []routing.BalancerOutboundCost{
+					{OutboundTag: "cb-w", CostPing: costOf(4), CostDevi: costOf(4)},
+					{OutboundTag: "cg-w", CostPing: costOf(1), CostDevi: costOf(0)},
+					{OutboundTag: "mh-w", CostPing: costOf(16), CostDevi: costOf(1)},
+					{OutboundTag: "zz", CostPing: costOf(1), CostDevi: costOf(1)},
+				},
+			},
+		},
+		{
+			name: "strategy without weights",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{Strategy: "random", Candidates: []string{"a"}},
+		},
+		{
+			name: "leastPing has no weights",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}, Strategy: "leastPing"},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{Strategy: "leastping", Candidates: []string{"a"}},
+		},
+		{
+			name: "roundRobin reports sorted unique candidates without fallbackTag and override",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"mh-", "cg-"},
+					Strategy:         "roundRobin",
+					FallbackTag:      "fb",
+				},
+				ohm:      &fakeHandlerSelector{tags: []string{"mh-2", "cg-1", "fb", "mh-2", "other", "cg-1"}},
+				override: "ovr",
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{Strategy: "roundrobin", Candidates: []string{"cg-1", "mh-2"}},
+		},
+		{
+			name: "leastLoad candidates do not depend on the observatory, maxRTT and expected",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"a"},
+					Strategy:         "leastLoad",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{
+						Expected: 1,
+						MaxRTT:   int64(time.Millisecond),
+					}),
+				},
+				ohm: &fakeHandlerSelector{tags: []string{"a3", "a2", "a1"}},
+				status: []*observatory.OutboundStatus{
+					plainStatus("a1", false, 99999999),
+					plainStatus("a2", true, 500),
+				},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy:   "leastload",
+				Candidates: []string{"a1", "a2", "a3"},
+				Outbounds: []routing.BalancerOutboundCost{
+					{OutboundTag: "a1", Cost: costOf(1)},
+					{OutboundTag: "a2", Cost: costOf(1)},
+					{OutboundTag: "a3", Cost: costOf(1)},
+				},
+			},
+		},
+		{
+			name: "unknown balancer",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}},
+				ohm:  &fakeHandlerSelector{tags: []string{"a"}},
+			},
+			args:    args{tag: "other"},
+			wantErr: true,
+		},
+		{
+			name: "selector error keeps the strategy and the rules",
+			fields: fields{
+				rule: &BalancingRule{
+					Tag:              "b",
+					OutboundSelector: []string{"a"},
+					Strategy:         "leastload",
+					StrategySettings: serial.ToTypedMessage(&StrategyLeastLoadConfig{
+						Costs: []*StrategyWeight{{Match: "a", Value: 3}},
+					}),
+				},
+			},
+			args: args{tag: "b"},
+			want: &routing.BalancerCosts{
+				Strategy: "leastload",
+				Rules:    []routing.BalancerCostRule{{Match: "a", Value: costOf(3)}},
+			},
+			wantOutboundsErr: true,
+		},
+		{
+			name: "random selector error leaves no candidates",
+			fields: fields{
+				rule: &BalancingRule{Tag: "b", OutboundSelector: []string{"a"}},
+			},
+			args:             args{tag: "b"},
+			want:             &routing.BalancerCosts{Strategy: "random"},
+			wantOutboundsErr: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			b, err := tt.fields.rule.Build(tt.fields.ohm, nil)
+			if err != nil {
+				t.Fatalf("BalancingRule.Build() error = %v", err)
+			}
+			if tt.fields.override != "" {
+				b.override.Put(tt.fields.override)
+			}
+			if s, ok := b.strategy.(*LeastLoadStrategy); ok && tt.fields.status != nil {
+				s.observer = &fakeObservatory{status: tt.fields.status}
+			}
+			r := &Router{balancers: map[string]*Balancer{tt.fields.rule.Tag: b}}
+			got, err := r.GetBalancerCosts(tt.args.tag)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("Router.GetBalancerCosts() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if err != nil {
+				return
+			}
+			if (got.OutboundsErr != nil) != tt.wantOutboundsErr {
+				t.Fatalf("Router.GetBalancerCosts() OutboundsErr = %v, want error %v", got.OutboundsErr, tt.wantOutboundsErr)
+			}
+			got.OutboundsErr = nil
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("Router.GetBalancerCosts() = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
diff -ruN -x .git a/app/router/balancer_scores.go b/app/router/balancer_scores.go
--- a/app/router/balancer_scores.go	1970-01-01 00:00:00.000000000 +0000
+++ b/app/router/balancer_scores.go	2026-11-24 13:22:58.463799635 +0000
@@ -0,0 +1,57 @@
+package router
+
+import (
+	"math"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+)
+
+// durationRange is the bound of the int64 range of time.Duration in nanoseconds
+const durationRange = 1 << 63
+
+// leastLoadScale weights a measured value with the leastLoad weight cost
+func leastLoadScale(value, cost float64) float64 {
+	return value * math.Pow(cost, 0.5)
+}
+
+// leastLoadWeighted returns the value leastLoad ranks an outbound status by before its
+// conversion to time.Duration: the HealthPing deviation or, without HealthPing, the
+// last delay, weighted with the effective weight cost
+func leastLoadWeighted(status *observatory.OutboundStatus, cost float64) float64 {
+	if status.HealthPing != nil {
+		return leastLoadScale(float64(status.HealthPing.Deviation), cost)
+	}
+	return leastLoadScale(float64(time.Duration(status.Delay)*time.Millisecond), cost)
+}
+
+// LeastLoadScore returns the leastLoad score of an outbound status in nanoseconds with
+// the effective weight cost, truncated as the strategy converts it to time.Duration.
+// inRange is false when the weighted value is out of the int64 range of
+// time.Duration: the strategy overflows it, and the score is the unconverted value.
+func LeastLoadScore(
+	status *observatory.OutboundStatus, cost float64,
+) (score float64, inRange bool) {
+	weighted := leastLoadWeighted(status, cost)
+	if weighted >= -durationRange && weighted < durationRange {
+		return float64(time.Duration(weighted)), true
+	}
+	return weighted, false
+}
+
+// leastLoPiMeasure returns the average RTT and its deviation in nanoseconds leastLoPi
+// ranks an outbound status by: those of HealthPing or, without HealthPing, the last
+// delay and no deviation
+func leastLoPiMeasure(status *observatory.OutboundStatus) (average, deviation float64) {
+	if hp := status.HealthPing; hp != nil {
+		return float64(hp.Average), float64(hp.Deviation)
+	}
+	return float64(status.Delay) * float64(time.Millisecond), 0
+}
+
+// LeastLoPiScore returns the leastLoPi score of an outbound status in nanoseconds with
+// the effective weights costPing and costDevi
+func LeastLoPiScore(status *observatory.OutboundStatus, costPing, costDevi float64) float64 {
+	average, deviation := leastLoPiMeasure(status)
+	return leastLoPiCost{ping: costPing, devi: costDevi}.score(average, deviation)
+}
diff -ruN -x .git a/app/router/balancer_scores_test.go b/app/router/balancer_scores_test.go
--- a/app/router/balancer_scores_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/app/router/balancer_scores_test.go	2026-11-24 13:24:09.377311590 +0000
@@ -0,0 +1,132 @@
+package router
+
+import (
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/app/observatory"
+)
+
+func TestLeastLoadScore(t *testing.T) {
+	ms := time.Millisecond
+	type args struct {
+		status *observatory.OutboundStatus
+		cost   float64
+	}
+	tests := []struct {
+		name        string
+		args        args
+		wantScore   float64
+		wantInRange bool
+	}{
+		{
+			name:        "HealthPing weights the deviation",
+			args:        args{status: burstStatus("a", 100*ms, 30*ms, 10, 0), cost: 4},
+			wantScore:   60e6,
+			wantInRange: true,
+		},
+		{
+			name:        "last delay without HealthPing is truncated as time.Duration",
+			args:        args{status: plainStatus("p", true, 7), cost: 2},
+			wantScore:   9899494,
+			wantInRange: true,
+		},
+		{
+			name:        "weight 1",
+			args:        args{status: plainStatus("p", true, 7), cost: 1},
+			wantScore:   7e6,
+			wantInRange: true,
+		},
+		{
+			name:      "overflow without HealthPing keeps the unconverted value",
+			args:      args{status: plainStatus("p", true, 1), cost: 1e32},
+			wantScore: 1e22,
+		},
+		{
+			name:      "overflow with HealthPing keeps the unconverted value",
+			args:      args{status: burstStatus("a", 2*ms, 1*ms, 10, 0), cost: 1e32},
+			wantScore: 1e22,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotScore, gotInRange := LeastLoadScore(tt.args.status, tt.args.cost)
+			if gotScore != tt.wantScore {
+				t.Errorf("LeastLoadScore() gotScore = %v, want %v", gotScore, tt.wantScore)
+			}
+			if gotInRange != tt.wantInRange {
+				t.Errorf("LeastLoadScore() gotInRange = %v, want %v", gotInRange, tt.wantInRange)
+			}
+			if !tt.wantInRange {
+				return
+			}
+			tag := tt.args.status.OutboundTag
+			s := NewLeastLoadStrategy(&StrategyLeastLoadConfig{
+				Costs: []*StrategyWeight{{Match: tag, Value: float32(tt.args.cost)}},
+			})
+			s.observer = &fakeObservatory{status: []*observatory.OutboundStatus{tt.args.status}}
+			nodes := s.getNodes([]string{tag}, 0)
+			if len(nodes) != 1 || float64(nodes[0].RTTDeviationCost) != gotScore {
+				t.Errorf("LeastLoadStrategy.getNodes() = %+v, want RTTDeviationCost %v", nodes, gotScore)
+			}
+		})
+	}
+}
+
+func TestLeastLoPiScore(t *testing.T) {
+	ms := time.Millisecond
+	type args struct {
+		status   *observatory.OutboundStatus
+		costPing float64
+		costDevi float64
+	}
+	tests := []struct {
+		name string
+		args args
+		want float64
+	}{
+		{
+			name: "mh weighs the average by sqrt(16)",
+			args: args{status: burstStatus("mh-vl-w", 150*ms, 45*ms, 10, 1), costPing: 16, costDevi: 1},
+			want: 645e6,
+		},
+		{
+			name: "cg with weights 1",
+			args: args{status: burstStatus("cg-vl-w", 1500*ms, 0, 10, 0), costPing: 1, costDevi: 1},
+			want: 1500e6,
+		},
+		{
+			name: "costPing 0 leaves the weighted deviation",
+			args: args{status: burstStatus("x", 100*ms, 20*ms, 5, 0), costPing: 0, costDevi: 4},
+			want: 40e6,
+		},
+		{
+			name: "plain observatory: the last delay without deviation",
+			args: args{status: plainStatus("p", true, 7), costPing: 4, costDevi: 9},
+			want: 14e6,
+		},
+		{
+			name: "plain observatory with costPing 0",
+			args: args{status: plainStatus("p", true, 7), costPing: 0, costDevi: 9},
+			want: 0,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := LeastLoPiScore(tt.args.status, tt.args.costPing, tt.args.costDevi)
+			if got != tt.want {
+				t.Errorf("LeastLoPiScore() = %v, want %v", got, tt.want)
+			}
+			tag := tt.args.status.OutboundTag
+			s := newTestLeastLoPi(t, &StrategyLeastLoPiConfig{
+				Costs: []*StrategyLeastLoPiWeight{
+					{Match: tag, CostPing: costOf(tt.args.costPing), CostDevi: costOf(tt.args.costDevi)},
+				},
+			}, []*observatory.OutboundStatus{tt.args.status})
+			nodes := s.getNodes([]string{tag})
+			if len(nodes) != 1 || nodes[0].Score != got {
+				t.Errorf("LeastLoPiStrategy.getNodes() = %+v, want Score %v", nodes, got)
+			}
+		})
+	}
+}
diff -ruN -x .git a/app/router/command/balancer_costs.go b/app/router/command/balancer_costs.go
--- a/app/router/command/balancer_costs.go	1970-01-01 00:00:00.000000000 +0000
+++ b/app/router/command/balancer_costs.go	2026-11-24 13:23:42.920746565 +0000
@@ -0,0 +1,47 @@
+package command
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/features/routing"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// fillBalancerCosts copies the strategy, the candidates and the weights of a balancer
+// into msg
+func fillBalancerCosts(ctx context.Context, msg *BalancerMsg, costs *routing.BalancerCosts) {
+	msg.Strategy = costs.Strategy
+	for _, rule := range costs.Rules {
+		msg.CostRules = append(msg.CostRules, &BalancerCostRule{
+			Match:    rule.Match,
+			Regexp:   rule.Regexp,
+			Value:    rule.Value,
+			CostPing: rule.CostPing,
+			CostDevi: rule.CostDevi,
+		})
+	}
+	if costs.OutboundsErr != nil {
+		errors.LogInfoInner(ctx, costs.OutboundsErr, "unable to obtain outbound costs")
+		return
+	}
+	msg.Candidates = append([]string(nil), costs.Candidates...)
+	for _, cost := range costs.Outbounds {
+		msg.OutboundCosts = append(msg.OutboundCosts, &BalancerOutboundCost{
+			OutboundTag: cost.OutboundTag,
+			Cost:        cost.Cost,
+			CostPing:    cost.CostPing,
+			CostDevi:    cost.CostDevi,
+		})
+	}
+}
+
+// ListBalancers implements RoutingServiceServer
+func (s *routingServer) ListBalancers(ctx context.Context, request *ListBalancersRequest) (*ListBalancersResponse, error) {
+	lister, ok := s.router.(routing.BalancerLister)
+	if !ok {
+		return nil, status.Error(codes.Unimplemented, "the router does not list balancers")
+	}
+	return &ListBalancersResponse{Tags: lister.ListBalancers()}, nil
+}
