+
+// fakeObservatory returns a fixed observation
+type fakeObservatory struct {
+	status []*observatory.OutboundStatus
+}
+
+func (o *fakeObservatory) Type() interface{} { return extension.ObservatoryType() }
+
+func (o *fakeObservatory) Start() error { return nil }
+
+func (o *fakeObservatory) Close() error { return nil }
+
+func (o *fakeObservatory) GetObservation(context.Context) (proto.Message, error) {
+	return &observatory.ObservationResult{Status: o.status}, nil
+}
+
+// fakeHandlerSelector selects the tags with any of the selector prefixes
+type fakeHandlerSelector struct {
+	outbound.Manager
+	tags []string
+}
+
+func (s *fakeHandlerSelector) Select(selectors []string) []string {
+	var ret []string
+	for _, tag := range s.tags {
+		for _, selector := range selectors {
+			if strings.HasPrefix(tag, selector) {
+				ret = append(ret, tag)
+				break
+			}
+		}
+	}
+	return ret
+}
+
+func costOf(v float64) *float64 { return &v }
+
+func burstStatus(tag string, average, deviation time.Duration, all, fail int64) *observatory.OutboundStatus {
+	return &observatory.OutboundStatus{
+		OutboundTag: tag,
+		Alive:       all != fail,
+		Delay:       average.Milliseconds(),
+		HealthPing: &observatory.HealthPingMeasurementResult{
+			All:       all,
+			Fail:      fail,
+			Average:   int64(average),
+			Deviation: int64(deviation),
+			Min:       int64(average),
+			Max:       int64(average),
+		},
+	}
+}
+
+func plainStatus(tag string, alive bool, delay int64) *observatory.OutboundStatus {
+	return &observatory.OutboundStatus{OutboundTag: tag, Alive: alive, Delay: delay}
+}
+
+func newTestLeastLoPi(t *testing.T, settings *StrategyLeastLoPiConfig, status []*observatory.OutboundStatus) *LeastLoPiStrategy {
+	t.Helper()
+	s, err := NewLeastLoPiStrategy(settings)
+	if err != nil {
+		t.Fatalf("NewLeastLoPiStrategy() error = %v", err)
+	}
+	s.InjectContext(context.Background())
+	s.observer = &fakeObservatory{status: status}
+	return s
+}
