+func Test_collectBalancerList(t *testing.T) {
+	ms := time.Millisecond
+	unimplemented := status.Error(codes.Unimplemented, "unknown method ListBalancers")
+	eqCosts := func(tags ...string) []*routerService.BalancerOutboundCost {
+		var ret []*routerService.BalancerOutboundCost
+		for _, tag := range tags {
+			ret = append(ret, &routerService.BalancerOutboundCost{
+				OutboundTag: tag, CostPing: lbF(1), CostDevi: lbF(1),
+			})
+		}
+		return ret
+	}
+	type args struct {
+		rc     *fakeRoutingClient
+		oc     *fakeObservatoryClient
+		tags   []string
+		asJSON bool
+	}
+	tests := []struct {
+		name     string
+		args     args
+		want     string
+		wantWarn string
+		wantErr  string
+	}{
+		{
+			name: "all balancers and the outbounds out of them",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"rnd", "vl-w"}, balancers: lbTestBalancers()},
+				oc: &fakeObservatoryClient{status: lbTestStatus()},
+			},
+			want: lbTestRnd + "\n" + lbTestVlw + "\n(no balancer):\n" +
+				"out-x alive=true last=7.000ms score=n/a\n" +
+				"dead-x alive=false RTT=n/a score=n/a\n",
+			wantWarn: lbTestRndWarn,
+		},
+		{
+			name: "tags in the order of the arguments once each",
+			args: args{
+				rc:   &fakeRoutingClient{list: []string{"rnd", "vl-w"}, balancers: lbTestBalancers()},
+				oc:   &fakeObservatoryClient{status: lbTestStatus()},
+				tags: []string{"vl-w", "rnd", "vl-w"},
+			},
+			want:     lbTestVlw + "\n" + lbTestRnd,
+			wantWarn: lbTestRndWarn,
+		},
+		{
+			name: "unknown tags",
+			args: args{
+				rc:   &fakeRoutingClient{list: []string{"rnd", "vl-w"}, balancers: lbTestBalancers()},
+				oc:   &fakeObservatoryClient{status: lbTestStatus()},
+				tags: []string{"vl-w", "nope", "zz"},
+			},
+			wantErr: "unknown balancer: nope, zz",
+		},
+		{
+			name: "ListBalancers unimplemented without tags",
+			args: args{
+				rc: &fakeRoutingClient{listErr: unimplemented, balancers: lbTestBalancers()},
+				oc: &fakeObservatoryClient{status: lbTestStatus()},
+			},
+			wantErr: "specify balancer tags as arguments",
+		},
+		{
+			name: "ListBalancers unimplemented with tags",
+			args: args{
+				rc:   &fakeRoutingClient{listErr: unimplemented, balancers: lbTestBalancers()},
+				oc:   &fakeObservatoryClient{status: lbTestStatus()},
+				tags: []string{"vl-w"},
+			},
+			want: lbTestVlw,
+		},
+		{
+			name: "ListBalancers unimplemented with an unknown tag",
+			args: args{
+				rc:   &fakeRoutingClient{listErr: unimplemented, balancers: lbTestBalancers()},
+				oc:   &fakeObservatoryClient{status: lbTestStatus()},
+				tags: []string{"nope"},
+			},
+			wantErr: "failed to get balancer nope",
+		},
+		{
+			name: "ListBalancers fails",
+			args: args{
+				rc: &fakeRoutingClient{
+					listErr:   status.Error(codes.Unavailable, "connection refused"),
+					balancers: lbTestBalancers(),
+				},
+				oc:   &fakeObservatoryClient{status: lbTestStatus()},
+				tags: []string{"vl-w"},
+			},
+			wantErr: "failed to list balancers",
+		},
+		{
+			name: "no strategy and no candidates, members from the weights",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"mid", "old"}, balancers: map[string]*routerService.BalancerMsg{
+					"old": {},
+					"mid": {Strategy: "leastload", OutboundCosts: []*routerService.BalancerOutboundCost{
+						{OutboundTag: "out-x", Cost: lbF(2)},
+						{OutboundTag: "x-free", Cost: lbF(0)},
+					}},
+				}},
+				oc: &fakeObservatoryClient{status: []*observatory.OutboundStatus{
+					lbPlain("out-x", true, 7),
+					lbPlain("x-free", true, 20),
+				}},
+				tags: []string{"old", "mid"},
+			},
+			want: "old:\n\nmid leastload:\n" +
+				"x-free alive=true last=20.000ms score=0.000ms cost=0\n" +
+				"out-x alive=true last=7.000ms score=9.899ms cost=2\n",
+			wantWarn: "warning: balancer old reports neither candidates nor outbound costs\n" +
+				"warning: balancer old reports no strategy, its Xray API has no balancer " +
+				"weights: scores are not computed\n",
+		},
+		{
+			name: "equal scores go to the average, failed probes, probes and the tag",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"eq"}, balancers: map[string]*routerService.BalancerMsg{
+					"eq": {
+						Strategy:      "leastlopi",
+						Candidates:    []string{"a", "b", "c", "d", "e", "g"},
+						OutboundCosts: eqCosts("a", "b", "c", "d", "e", "g"),
+					},
+				}},
+				oc: &fakeObservatoryClient{status: []*observatory.OutboundStatus{
+					lbBurst("a", 100*ms, 0, 100*ms, 100*ms, 10, 2),
+					lbBurst("b", 100*ms, 0, 100*ms, 100*ms, 10, 1),
+					lbBurst("c", 100*ms, 0, 100*ms, 100*ms, 12, 1),
+					lbBurst("d", 90*ms, 10*ms, 90*ms, 90*ms, 10, 0),
+					lbBurst("e", 100*ms, 0, 100*ms, 100*ms, 10, 2),
+					lbBurst("g", 100*ms+400, 0, 100*ms+400, 100*ms+400, 10, 0),
+				}},
+				tags: []string{"eq"},
+			},
+			want: "eq leastlopi:\n" +
+				"d alive=true avg=90.000ms dev=10.000ms min=90.000ms max=90.000ms " +
+				"score=100.000ms fail=0/10 costPing=1 costDevi=1\n" +
+				"c" + lbTestEqLine + " fail=1/12 costPing=1 costDevi=1\n" +
+				"b" + lbTestEqLine + " fail=1/10 costPing=1 costDevi=1\n" +
+				"a" + lbTestEqLine + " fail=2/10 costPing=1 costDevi=1\n" +
+				"e" + lbTestEqLine + " fail=2/10 costPing=1 costDevi=1\n" +
+				"g" + lbTestEqLine + " fail=0/10 costPing=1 costDevi=1\n",
+		},
+		{
+			name: "alive with all probes failed has no RTT and no score",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"af"}, balancers: map[string]*routerService.BalancerMsg{
+					"af": {
+						Strategy:      "leastlopi",
+						Candidates:    []string{"z", "y"},
+						OutboundCosts: eqCosts("y", "z"),
+					},
+				}},
+				oc: &fakeObservatoryClient{status: []*observatory.OutboundStatus{
+					{
+						OutboundTag: "z",
+						Alive:       true,
+						HealthPing:  &observatory.HealthPingMeasurementResult{All: 3, Fail: 3},
+					},
+					lbBurst("y", 50*ms, 0, 50*ms, 50*ms, 3, 0),
+				}},
+				tags: []string{"af"},
+			},
+			want: "af leastlopi:\n" +
+				"y alive=true avg=50.000ms dev=0.000ms min=50.000ms max=50.000ms " +
+				"score=50.000ms fail=0/3 costPing=1 costDevi=1\n" +
+				"z alive=true RTT=n/a score=n/a fail=3/3 costPing=1 costDevi=1\n",
+		},
+		{
+			name: "leastLoad score out of the time.Duration range",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"huge"}, balancers: map[string]*routerService.BalancerMsg{
+					"huge": {
+						Strategy:      "leastload",
+						Candidates:    []string{"one"},
+						OutboundCosts: []*routerService.BalancerOutboundCost{{OutboundTag: "one", Cost: lbF(1e32)}},
+					},
+				}},
+				oc:   &fakeObservatoryClient{status: []*observatory.OutboundStatus{lbPlain("one", true, 1)}},
+				tags: []string{"huge"},
+			},
+			want: "huge leastload:\n" +
+				"one alive=true last=1.000ms score=10000000000000000.000ms " +
+				"cost=100000000000000000000000000000000\n",
+			wantWarn: "warning: balancer huge: a leastLoad score is out of the int64 range " +
+				"of time.Duration: the server overflows it, so its order may differ\n",
+		},
+		{
+			name: "empty observatory report without balancers",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{}},
+				oc: &fakeObservatoryClient{},
+			},
+			want:     "(no balancer):\n",
+			wantWarn: "warning: the observatory at 127.0.0.1:8080 reported no outbounds\n",
+		},
+		{
+			name: "json",
+			args: args{
+				rc: &fakeRoutingClient{list: []string{"vl-w"}, balancers: map[string]*routerService.BalancerMsg{
+					"vl-w": {
+						Strategy:   "leastlopi",
+						Candidates: []string{"idle-vl-w", "mh-vl-w"},
+						OutboundCosts: []*routerService.BalancerOutboundCost{
+							{OutboundTag: "idle-vl-w", CostPing: lbF(1), CostDevi: lbF(0)},
+							{OutboundTag: "mh-vl-w", CostPing: lbF(16), CostDevi: lbF(1)},
+						},
+					},
+				}},
+				oc: &fakeObservatoryClient{status: []*observatory.OutboundStatus{
+					lbBurst("mh-vl-w", 150*ms, 45*ms, 101*ms, 230*ms, 10, 1),
+					lbPlain("out-x", true, 7),
+				}},
+				asJSON: true,
+			},
+			want: lbTestJSON,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			warn := &bytes.Buffer{}
+			got, err := collectBalancerList(context.Background(), tt.args.rc, tt.args.oc,
+				tt.args.tags, "127.0.0.1:8080", warn)
+			if got := tt.args.rc.listCalls; got != 1 {
+				t.Errorf("ListBalancers calls = %d, want 1", got)
+			}
+			if tt.wantErr != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.wantErr) {
+					t.Fatalf("collectBalancerList() error = %v, want %q", err, tt.wantErr)
+				}
+				if got := tt.args.oc.statusCalls; got != 0 {
+					t.Errorf("GetOutboundStatus calls = %d, want 0 after an error", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("collectBalancerList() error = %v", err)
+			}
+			if got := tt.args.oc.statusCalls; got != 1 {
+				t.Errorf("GetOutboundStatus calls = %d, want 1", got)
+			}
+			wantInfo := map[string]int{}
+			if len(tt.args.tags) == 0 {
+				for _, tag := range tt.args.rc.list {
+					wantInfo[tag] = 1
+				}
+			}
+			for _, tag := range tt.args.tags {
+				wantInfo[tag] = 1
+			}
+			if !maps.Equal(tt.args.rc.infoCalls, wantInfo) {
+				t.Errorf("GetBalancerInfo calls = %v, want %v", tt.args.rc.infoCalls, wantInfo)
+			}
+			out := &bytes.Buffer{}
+			if err := writeBalancerList(out, got, tt.args.asJSON); err != nil {
+				t.Fatalf("writeBalancerList() error = %v", err)
+			}
+			if out.String() != tt.want {
+				t.Errorf("collectBalancerList() output = %q, want %q", out.String(), tt.want)
+			}
+			if gotWarn := warn.String(); gotWarn != tt.wantWarn {
+				t.Errorf("collectBalancerList() warnings = %q, want %q", gotWarn, tt.wantWarn)
+			}
+		})
+	}
+}
