+		// Exchange the accepted envelope for a fresh capability. Quoted request ids
+		// and capabilities from persisted inputs confer no ownership on this input.
+		const capability = request ? randomUUID() : undefined;
+		if (request && capability) current.acceptedInputs.set(capability, request.id);
+		const text = String(event.text).replace(
+			/<!-- pi-subagents-request:([a-zA-Z0-9-]+) -->/g,
+			(_token, id: string) => id === request?.id
+				? `<!-- pi-subagents-request:${capability} -->` : "",
+		);
+		return text === event.text ? undefined : { action: "transform", text };
+	});
+
+	on("before_agent_start", (event) => {
+		const current = run;
+		if (!current?.policy || !checkLedger(current) || !current.ready) return undefined;
+		try {
+			const text = String(event.prompt);
+			const token = acceptedRequestId(current, text) ?? randomUUID();
+			if (current.abortRequests.has(token)) {
+				try { current.ctx.ui.notify("pi-subagents: cancelled input was discarded before its turn.", "info"); } catch { /* advisory */ }
+			}
+			const systemPrompt = `${renderWebChildSystemPrompt(current.policy, event.systemPromptOptions as unknown as BuildSystemPromptOptions, String(event.systemPrompt))}\n<!-- pi-subagents-turn:${token} -->`;
+			current.prompts.set(token, systemPrompt);
+			current.armed = true;
+			current.renderedPrompt = systemPrompt;
+			return { systemPrompt };
+		} catch (error) {
+			fail(current, error instanceof Error ? error.message : String(error));
+			try { current.ctx.ui.notify(lockedText(current.failure!), "error"); } catch { /* advisory */ }
+			return undefined;
+		}
+	});
+
+	pi.on("context", (event) => {
+		if (!run) return undefined;
+		return { messages: event.messages.filter((message) => {
+			if (message.role !== "user") return true;
+			const text = typeof message.content === "string" ? message.content
+				: message.content.filter((part) => part.type === "text").map((part) => part.text).join("");
+			const id = acceptedRequestId(run!, text);
+			if (!id || !run!.abortRequests.has(id)) return true;
+			try { run!.ctx.ui.notify("pi-subagents: cancelled input was discarded before its turn.", "info"); } catch { /* advisory */ }
+			return false;
+		}).map((message) => message.role === "user"
+			? { ...message, content: typeof message.content === "string"
+				? webChildInputText(message.content)
+				: message.content.map((part) => part.type === "text"
+					? { ...part, text: webChildInputText(part.text) } : part) }
+			: message) };
+	});
+
+	on("tool_call", (event) => {
+		const current = run;
+		if (!current) return undefined;
+		const toolName = String(event.toolName);
+		if (current.failure !== undefined) return { block: true, reason: lockedText(current.failure) };
+		if (!current.armed) return { block: true, reason: "pi-subagents: this turn did not start with the agent system prompt; tools are blocked." };
+		if (!current.allowed.has(toolName)) return { block: true, reason: `pi-subagents: tool '${toolName}' is not allowed for this agent.` };
+		return undefined;
+	});
+
+	for (const name of FORWARDED_EVENTS) {
+		on(name, (event, ctx) => {
+			const current = run;
+			if (!current) return;
+			if (name === "agent_settled" && current.runOpen && ctx.signal !== undefined) {
+				// A settle while a run is still open comes from a concurrent prompt
+				// that lost the race: Pi has just dropped the agent prompt of the
+				// open run, so that run must not reach another model request.
+				const reason = "another prompt reached the child at the same moment; the turn was aborted because it lost the agent system prompt";
+				abortRun(current, ctx, reason);
+				const affected = current.claims.filter((claim) => claim.started || !claim.queued);
+				current.claims = current.claims.filter((claim) => !affected.includes(claim));
+				settleClaims(current, affected, "failed", reason);
+				forward({ type: "pi_subagents_premature_settle" });
+				return;
+			}
+			if (name === "agent_start") {
+				current.turnId = /<!-- pi-subagents-turn:([a-zA-Z0-9-]+) -->/.exec(String(ctx.getSystemPrompt()))?.[1];
+				current.renderedPrompt = current.turnId ? current.prompts.get(current.turnId) : undefined;
+				current.runOpen = true;
+				current.abortNoted = current.turnId !== undefined && current.abortRequests.has(current.turnId);
+				current.unobserveAbort?.();
+				const signal = ctx.signal;
+				if (signal) {
+					// Pi exposes the run signal before agent_start. Unlike assistant
+					// stopReason, it also witnesses abort during terminating tools.
+					const observed = () => {
+						current.abortNoted = true;
+						for (const claim of current.claims) {
+							if (!claim.started) claim.turnAbortObserved = true;
+						}
+					};
+					signal.addEventListener("abort", observed, { once: true });
+					current.unobserveAbort = () => signal.removeEventListener("abort", observed);
+					if (signal.aborted) observed();
+				}
+				if (current.abortNoted) {
+					current.armed = false;
+					try { ctx.abort(); } catch { /* runtime already closed */ }
+				}
+				for (const claim of current.claims) if (claim.id === current.turnId) claim.started = true;
+				if (!current.abortNoted && (!checkLedger(current) || !current.armed || current.renderedPrompt === undefined)) {
+					// A run that bypassed before_agent_start (an extension's triggered
+					// custom message, a retry after a lost override) never gets the
+					// agent prompt.
+					abortRun(current, ctx, current.failure !== undefined ? lockedText(current.failure) : "this turn did not start with the agent system prompt");
+				} else if (!current.abortNoted && current.renderedPrompt !== undefined && !String(ctx.getSystemPrompt()).startsWith(current.renderedPrompt)) {
+					// Extensions after this one may still rewrite the prompt in their own
+					// before_agent_start; appending keeps the contract, anything else does not.
+					abortRun(current, ctx, "another extension replaced the agent system prompt of this turn");
+				}
+			}
+			if (name === "message_start" || name === "message_end") {
+				const message = event.message as { role?: string; content?: unknown } | undefined;
+				if (message?.role === "user") {
+					const text = typeof message.content === "string" ? message.content
+						: Array.isArray(message.content) ? message.content.filter((part) => part.type === "text").map((part) => part.text).join("") : "";
+					for (const claim of current.claims) if (claim.id === acceptedRequestId(current, text)) claim.started = true;
+				}
+			}
+			const requestIds = current.claims.filter((claim) => claim.started).map((claim) => claim.id);
+			forward({ ...event, type: name, requestIds });
+			if (name === "message_end") {
+				const message = (event as { message?: { role?: unknown; stopReason?: unknown; errorMessage?: unknown } }).message;
+				if (message?.role === "assistant") {
+					current.lastStopReason = typeof message.stopReason === "string" ? message.stopReason : undefined;
+					current.lastErrorMessage = typeof message.errorMessage === "string" ? message.errorMessage : undefined;
+				}
+			}
+			if (name === "agent_settled") {
+				// Real settlement has no active run signal. agent_end handlers still
+				// own an abortable run, including inputs queued by other hooks.
+				current.runOpen = false;
+				current.armed = false;
+				current.renderedPrompt = undefined;
+				const claims = current.claims.filter((claim) => claim.started);
+				current.claims = current.claims.filter((claim) => !claims.includes(claim));
+				const carried = claims;
+				if (current.forcedAbort !== undefined) settleClaims(current, carried, "failed", current.forcedAbort);
+				else if (current.abortNoted) settleClaims(current, carried, "aborted");
+				else if (current.lastStopReason === "error") settleClaims(current, carried, "failed", current.lastErrorMessage ?? "the model request failed");
+				else settleClaims(current, carried, "completed");
+				// A browser-owned turn may outlive the last cancelled queued claim.
+				// Once it settles, that claim's ledger must not remain running.
+				if (carried.length === 0 && current.claims.length === 0) {
+					const loaded = loadWebChildLedger(current.sessionId);
+					if ("ledger" in loaded && loaded.ledger.state === "running" && loaded.ledger.lastTurn) {
+						const outcome = loaded.ledger.lastTurn.outcome;
+						recordLedger(current, { state: outcome === "completed" ? "settled" : outcome });
+					}
+				}
+				current.unobserveAbort?.();
+				current.unobserveAbort = undefined;
+				current.abortNoted = false;
+				if (current.turnId) {
+					if (carried.some((claim) => claim.id === current.turnId)) current.abortRequests.delete(current.turnId);
+					current.prompts.delete(current.turnId);
+				}
+				for (const [token, id] of current.acceptedInputs) {
+					if (!current.abortRequests.has(id) && (id === current.turnId || carried.some((claim) => claim.id === id))) {
+						current.acceptedInputs.delete(token);
+					}
+				}
+				current.turnId = undefined;
+				current.forcedAbort = undefined;
+				current.lastStopReason = undefined;
+				current.lastErrorMessage = undefined;
+			}
+		});
+	}
+
+	on("session_before_compact", (event) => forward({ type: "compaction_start", reason: event.reason }));
+	on("session_compact", (event) => forward({ type: "compaction_end", reason: event.reason, willRetry: event.willRetry, aborted: false }));
+	on("session_compact_failed", (event) => forward({ type: "compaction_end", reason: event.reason, willRetry: event.willRetry, aborted: event.aborted, errorMessage: event.errorMessage }));
+}
