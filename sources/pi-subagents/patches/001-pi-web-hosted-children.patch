+		pi: { events: { emit() {}, on() { return () => {}; } }, getSessionName: () => "parent" } as never,
+		state: state as never, config: { maxSubagentDepth: 2, control: {}, intercomBridge: {} } as never,
+		asyncByDefault: false, tempArtifactsDir: daemon.root,
