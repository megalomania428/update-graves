+	it("fails a ledger write whose directory flush fails, but not where a directory cannot be flushed", () => {
+		const sessionId = "0193a2b4-0000-7000-8000-000000000002";
+		const ledger = { schemaVersion: 1 as const, sessionId, sessionFile: "/s.jsonl", cwd: "/work", parentSessionFile: "/p.jsonl", runId: "r", agent: "worker", digest: "d", state: "running" as const, updatedAt: new Date().toISOString() };
+		writeWebChildLedger(ledger);
+		const original = fsDefault.fsyncSync;
+		// The file is flushed first and its directory second.
+		const failDirectoryFlush = (code: string) => {
+			let calls = 0;
+			fsDefault.fsyncSync = (fd) => {
+				calls += 1;
+				if (calls === 2) throw Object.assign(new Error(`${code}: directory flush`), { code });
+				original(fd);
+			};
+			syncBuiltinESMExports();
+		};
+		try {
+			failDirectoryFlush("EIO");
+			assert.throws(() => updateWebChildLedger(sessionId, { state: "stopped", terminated: { at: "now", reason: "user" } }), /EIO/);
+			failDirectoryFlush("EACCES");
+			assert.throws(() => updateWebChildLedger(sessionId, { state: "stopped", terminated: { at: "now", reason: "user" } }), /EACCES/);
+			failDirectoryFlush("EINVAL");
+			// A failed directory flush follows rename; the tombstone is already visible.
+			const updated = updateWebChildLedger(sessionId, { state: "settled" });
+			assert.equal(updated?.state, "stopped");
+			assert.deepEqual(updated?.terminated, { at: "now", reason: "user" });
+		} finally {
+			fsDefault.fsyncSync = original;
+			syncBuiltinESMExports();
+		}
+	});
