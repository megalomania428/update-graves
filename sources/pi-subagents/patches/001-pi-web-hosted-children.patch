+						assert.ok(["aborted", "error"].includes(assistants[0]!.stopReason),
+							JSON.stringify(assistants));
+						assert.deepEqual(assistants[0]!.content, [], JSON.stringify(assistants));
+					} else {
+						assert.deepEqual(assistants, [], `no assistant message after stop: ${phase}`);
+					}
+				} finally {
+					if (target !== stoppedChild) await target.dispose();
+				}
+			} finally {
+				releaseShutdown();
+				await (closing ?? stoppedChild.dispose());
+				webChildChannel(id).live = undefined;
+			}
+		}
+
+		// A tampered policy, a missing ledger or a missing required tool locks the
+		// session: input is handled, the model never runs.
+		for (const [label, prepared, reason] of [
+			["tampered policy", prepare("append", { tamper: true }), /digest/],
+			["missing ledger", prepare("append", { ledger: false }), /no pi-subagents ledger/],
+			["missing tool", prepare("append", { tools: ["read", "no_such_tool"] }), /no_such_tool/],
+		] as const) {
+			const locked = await open(prepared.allocation.sessionFile);
+			try {
+				const state = webChildChannel(prepared.allocation.sessionId).companion?.state;
+				assert.equal(state?.kind, "failed", label);
+				assert.match(state?.kind === "failed" ? state.reason : "", reason, label);
+				const calls = auditLines().length;
+				await locked.prompt("Task: Do the fixture task");
+				assert.equal(auditLines().length, calls, label);
+				const entries = fs.readFileSync(prepared.allocation.sessionFile, "utf8").trim().split("\n").map((line) => JSON.parse(line));
+				assert.ok(entries.some((entry) => entry.customType === WEB_CHILD_POLICY_TYPE), label);
+			} finally {
+				await locked.dispose();
+			}
+		}
+	} finally {
+		await factory.dispose();
+		for (const key of ["PI_CODING_AGENT_DIR", "PI_OFFLINE", "PI_SUBAGENTS_WEB_AUDIT"]) {
+			if (savedEnv[key] === undefined) delete process.env[key]; else process.env[key] = savedEnv[key];
+		}
+		fs.rmSync(root, { recursive: true, force: true });
+	}
+});
diff -ruN -x .git a/test/integration/web-launch-refusals.test.ts b/test/integration/web-launch-refusals.test.ts
--- a/test/integration/web-launch-refusals.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/integration/web-launch-refusals.test.ts	2026-11-08 21:28:41.116873963 +0000
@@ -0,0 +1,48 @@
+import { execFileSync } from "node:child_process";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import { fileURLToPath } from "node:url";
+import { it } from "node:test";
+
+const project = fileURLToPath(new URL("../../", import.meta.url));
+for (const mode of ["external-cli", "external-job", "forced"]) {
+	const forced = mode === "forced";
+	it(`reports the actual PI WEB launch refusal (${mode})`, () => {
+		const root = fs.mkdtempSync(path.join(os.tmpdir(), "web-refusal-"));
+		try {
+			const config = path.join(root, "agent", "extensions", "subagent");
+			fs.mkdirSync(config, { recursive: true });
+			fs.writeFileSync(path.join(config, "config.json"), JSON.stringify({ forceTopLevelAsync: forced }));
+			const script = `
+				import assert from "node:assert/strict";
+				import fs from "node:fs";
+				import path from "node:path";
+				import register from "./index.ts";
+				import { registerAgent } from "./src/api/agents.ts";
+				import { readProcessStartTime } from "./src/web/daemon.ts";
+				const root = process.env.PI_WEB_DATA_DIR;
+				fs.writeFileSync(path.join(root, "sessiond-owner.json"), JSON.stringify({ pid: process.pid, processStartTime: readProcessStartTime(process.pid), endpoint: path.join(root, "unused.sock") }));
+				let tool;
+				const pi = new Proxy({ events: { on() { return () => {}; }, emit() {} }, registerTool(value) { if (value.name === "subagent") tool = value; } }, { get(target, key) { return key in target ? target[key] : () => undefined; } });
+				register(pi);
+				registerAgent({ pi, name: "refusal-fixture", definition: { description: "Fixture", systemPrompt: "Work", ${forced ? "" : mode === "external-cli" ? 'runner: { type: "external-cli", command: "never-executed" },' : 'runner: { type: "external-job", provider: "fixture" },'} } });
+				const parent = path.join(root, "parent.jsonl");
+				fs.writeFileSync(parent, "");
+				const ctx = { cwd: root, hasUI: false, ui: { setToolsExpanded() {}, setWidget() {} }, sessionManager: { getSessionFile() { return parent; }, getSessionId() { return "parent"; }, getEntries() { return []; } }, modelRegistry: { getAvailable() { return []; } } };
+				for (const asyncValue of [undefined, false, true]) {
+					await assert.rejects(tool.execute("refusal-" + asyncValue, { agent: "refusal-fixture", task: "Work", ...(asyncValue === undefined ? {} : { async: asyncValue }) }, new AbortController().signal, undefined, ctx), (error) => {
+						assert.match(error.message, ${forced ? "/forceTopLevelAsync/" : "/external-(cli|job).*cannot run inside PI WEB/"});
+						assert.doesNotMatch(error.message, /pass async:false|Omit async|pass async:true/);
+						return true;
+					});
+				}
+			`;
+			execFileSync(process.execPath, ["--experimental-strip-types", "--import", "./test/support/register-loader.mjs", "--input-type=module", "--eval", script], {
+				cwd: project,
+				env: { ...process.env, PI_WEB_SESSION: "1", PI_WEB_DATA_DIR: root, PI_WEB_SESSIOND_SOCKET: path.join(root, "unused.sock"), PI_WEB_SESSIOND_PORT: "", PI_CODING_AGENT_DIR: path.join(root, "agent"), PI_SUBAGENT_DEPTH: "0" },
+				stdio: "pipe",
+			});
+		} finally { fs.rmSync(root, { recursive: true, force: true }); }
+	});
+}
diff -ruN -x .git a/test/integration/web-pi-web-e2e.test.ts b/test/integration/web-pi-web-e2e.test.ts
--- a/test/integration/web-pi-web-e2e.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/integration/web-pi-web-e2e.test.ts	2026-11-08 20:13:22.818492463 +0000
@@ -0,0 +1,375 @@
+/**
+ * End to end against an isolated instance of the installed, unmodified pi-web,
+ * driven through its web process (`/api`) the way the browser drives it: a
+ * parent session delegates through the `subagent` tool, the child becomes a
+ * PI WEB session listed under the parent with one writer, two children of a
+ * foreground `runs.all` workflow run at the same time, `/run` launches from
+ * the chat, the browser lists the package's commands and `/subagents-web`
+ * diagnoses, steers, follows up, aborts, reconnects and reports without a
+ * model turn, an abort from the chat of the orchestrator's running child reaches
+ * the orchestrator as the result of its run and the orchestrator continues that
+ * idle child with a new turn, aborting the orchestrator's turn aborts its
+ * running child and leaves the child usable, a browser that reconnects to a running child sees the same run
+ * continue, a reopened child runs a browser prompt under the agent contract,
+ * and a terminal stop locks the child.
+ *
+ * Opt-in: PI_SUBAGENTS_PI_WEB_ROOT=<installed @raven428/pi-web package dir>.
+ * Both processes get a fully explicit environment; nothing of the hosting PI
+ * WEB instance or the user's profile is inherited.
+ */
+import assert from "node:assert/strict";
+import { spawn, type ChildProcess } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import * as fs from "node:fs";
+import * as http from "node:http";
+import * as net from "node:net";
+import * as os from "node:os";
+import * as path from "node:path";
+import { fileURLToPath } from "node:url";
+import { it } from "node:test";
+
+const PI_WEB_ROOT = process.env.PI_SUBAGENTS_PI_WEB_ROOT;
+
+interface Api {
+	request(method: string, route: string, body?: unknown): Promise<{ status: number; body: unknown }>;
+}
+
+function api(port: number): Api {
+	return {
+		request: (method, route, body) => new Promise((resolve, reject) => {
+			const payload = body === undefined ? undefined : JSON.stringify(body);
+			const req = http.request({ host: "127.0.0.1", port, method, path: route, headers: payload === undefined ? {} : { "content-type": "application/json" } }, (res) => {
+				const chunks: Buffer[] = [];
+				res.on("data", (chunk: Buffer) => chunks.push(chunk));
+				res.on("end", () => {
+					const text = Buffer.concat(chunks).toString("utf8");
+					let parsed: unknown = text;
+					try { parsed = text ? JSON.parse(text) : undefined; } catch { /* keep text */ }
+					resolve({ status: res.statusCode ?? 0, body: parsed });
+				});
+			});
+			req.setTimeout(30000, () => req.destroy(new Error(`${method} ${route} timed out`)));
+			req.on("error", reject);
+			if (payload !== undefined) req.write(payload);
+			req.end();
+		}),
+	};
+}
+
+function freePort(): Promise<number> {
+	return new Promise((resolve, reject) => {
+		const server = net.createServer();
+		server.once("error", reject);
+		server.listen(0, "127.0.0.1", () => {
+			const { port } = server.address() as net.AddressInfo;
+			server.close(() => resolve(port));
+		});
+	});
+}
+
+async function waitFor<T>(what: string, probe: () => T | undefined | false | Promise<T | undefined | false>, timeoutMs = 60000): Promise<T> {
+	const deadline = Date.now() + timeoutMs;
+	for (;;) {
+		const value = await probe();
+		if (value !== undefined && value !== false) return value;
+		if (Date.now() > deadline) throw new Error(`Timed out waiting for ${what}`);
+		await new Promise((resolve) => setTimeout(resolve, 200));
+	}
+}
+
+interface AuditLine {
+	model: string;
+	event?: string;
+	hold?: string;
+	lastUser?: string;
+	systemPrompt: string;
+	tools?: string[];
+	content?: unknown;
+}
+
+interface EventSocket {
+	frames: Array<{ type?: string; eventType?: string; seq?: number }>;
+	close(): Promise<void>;
+}
+
+/** A browser-like subscription to the session's event stream through the web process. */
+async function subscribe(port: number, sessionId: string): Promise<EventSocket> {
+	const socket = new WebSocket(`ws://127.0.0.1:${port}/api/sessions/${sessionId}/events`);
+	const frames: EventSocket["frames"] = [];
+	socket.binaryType = "arraybuffer";
+	socket.addEventListener("message", (event) => {
+		const text = event.data instanceof ArrayBuffer
+			? Buffer.from(event.data).toString("utf8") : String(event.data);
+		try { frames.push(JSON.parse(text)); } catch { /* not a JSON frame */ }
+	});
+	await new Promise<void>((resolve, reject) => {
+		socket.addEventListener("open", () => resolve(), { once: true });
+		socket.addEventListener("error", () => reject(new Error(`WebSocket to ${sessionId} failed`)), { once: true });
+	});
+	return {
+		frames,
+		close: () => new Promise((resolve) => {
+			socket.addEventListener("close", () => resolve(), { once: true });
+			socket.close();
+		}),
+	};
+}
+
+interface ListedSession {
+	id: string;
+	path: string;
+	parentSessionPath?: string;
+	name?: string;
+}
+
+it("hosts subagent children as PI WEB sessions of an unmodified pi-web", {
+	skip: !PI_WEB_ROOT && "Requires PI_SUBAGENTS_PI_WEB_ROOT (installed @raven428/pi-web package directory)",
+	timeout: 300000,
+}, async () => {
+	const repoRoot = fileURLToPath(new URL("../../", import.meta.url));
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-subagents-web-e2e-"));
+	const home = path.join(root, "home");
+	const agentDir = path.join(root, "agent");
+	const dataDir = path.join(root, "data");
+	const sessionDir = path.join(root, "sessions");
+	const work = path.join(root, "work");
+	const socketPath = path.join(dataDir, "sessiond.sock");
+	const audit = path.join(root, "audit.jsonl");
+	const ledgerDir = path.join(agentDir, "pi-subagents", "web-children");
+	for (const dir of [home, agentDir, dataDir, sessionDir, work, path.join(agentDir, "agents")]) fs.mkdirSync(dir, { recursive: true });
+	fs.writeFileSync(path.join(work, "fixture.txt"), "fixture content");
+	fs.writeFileSync(path.join(root, "web-config.json"), "{}\n");
+	fs.writeFileSync(path.join(agentDir, "settings.json"), JSON.stringify({
+		defaultProvider: "web-fixture",
+		defaultModel: "parent",
+		compaction: { enabled: false },
+		retry: { enabled: false },
+		extensions: [path.join(repoRoot, "index.ts"), path.join(repoRoot, "test", "fixtures", "web-hosting-provider.ts")],
+	}));
+	fs.writeFileSync(path.join(agentDir, "agents", "web-worker.md"), [
+		"---", "name: web-worker", "description: PI WEB hosting fixture worker", "model: web-fixture/worker", "tools: read",
+		"inheritGlobalContext: false", "inheritProjectContext: false", "inheritSkills: false", "---",
+		"You are the web worker. Answer with the fixture marker.",
+	].join("\n"));
+	// Without this the daemon auto-installs the shipped Relays package into the profile at startup.
+	fs.writeFileSync(path.join(dataDir, "pi-package-dismissals.json"), JSON.stringify({ dismissals: [{ profileDir: agentDir, packageId: "@jmfederico/pi-relay", dismissedAt: new Date().toISOString() }] }));
+	const port = await freePort();
+	const env: NodeJS.ProcessEnv = {
+		PATH: process.env.PATH,
+		HOME: home,
+		USERPROFILE: home,
+		XDG_CONFIG_HOME: path.join(root, "config"),
+		XDG_CACHE_HOME: path.join(root, "cache"),
+		TMPDIR: os.tmpdir(),
+		PI_WEB_CONFIG: path.join(root, "web-config.json"),
+		PI_WEB_DATA_DIR: dataDir,
+		PI_WEB_PROJECTS_FILE: path.join(dataDir, "projects.json"),
+		PI_WEB_SESSIOND_SOCKET: socketPath,
+		PI_WEB_HOST: "127.0.0.1",
+		PI_WEB_PORT: String(port),
+		PI_CODING_AGENT_DIR: agentDir,
+		PI_CODING_AGENT_SESSION_DIR: sessionDir,
+		PI_OFFLINE: "1",
+		PI_TELEMETRY: "0",
+		PI_SUBAGENTS_WEB_AUDIT: audit,
+	};
+	const log = fs.openSync(path.join(root, "pi-web.log"), "a");
+	const processes: ChildProcess[] = [];
+	const web = api(port);
+	const auditLines = (): AuditLine[] => fs.existsSync(audit) ? fs.readFileSync(audit, "utf8").trim().split("\n").filter(Boolean).map((line) => JSON.parse(line) as AuditLine) : [];
+	const answers = (model: string) => auditLines().filter((line) => line.model === model && line.event === undefined);
+	const holds = () => auditLines().filter((line) => line.event === "hold");
+	const release = (hold: string) => fs.writeFileSync(`${audit}.release-${hold}`, "");
+	const ledgerOf = (id: string) => JSON.parse(fs.readFileSync(path.join(ledgerDir, `${id}.json`), "utf8")) as { state: string; terminated?: unknown; lastTurn?: { outcome: string } };
+	const sessions = async (): Promise<ListedSession[]> => (await web.request("GET", `/api/sessions?cwd=${encodeURIComponent(work)}`)).body as ListedSession[];
+	const statusOf = async (id: string) => (await web.request("GET", `/api/sessions/${id}/status?cwd=${encodeURIComponent(work)}`)).body as { isStreaming?: boolean };
+	try {
+		const daemon = spawn(process.execPath, [path.join(PI_WEB_ROOT!, "dist", "server", "sessiond.js")], { cwd: work, env, stdio: ["ignore", log, log] });
+		processes.push(daemon);
+		const server = spawn(process.execPath, [path.join(PI_WEB_ROOT!, "dist", "server", "index.js")], { cwd: work, env, stdio: ["ignore", log, log] });
+		processes.push(server);
+		await waitFor("the isolated web process and session daemon", async () => {
+			for (const child of processes) {
+				if (child.exitCode !== null) throw new Error(`pi-web exited: ${fs.readFileSync(path.join(root, "pi-web.log"), "utf8").slice(-4000)}`);
+			}
+			try { return (await web.request("GET", "/api/sessiond/health")).status === 200 || undefined; } catch { return undefined; }
+		}, 30000);
+
+		const parentId = randomUUID();
+		const parentTimestamp = new Date().toISOString();
+		const parentFile = path.join(sessionDir, `${parentTimestamp.replace(/[:.]/g, "-")}_${parentId}.jsonl`);
+		fs.writeFileSync(parentFile, `${JSON.stringify({ type: "session", version: 3, id: parentId, timestamp: parentTimestamp, cwd: work })}\n`);
+		const prompt = (id: string, text: string) => web.request("POST", `/api/sessions/${id}/prompt`, { cwd: work, text });
+		const slash = async (text: string) => {
+			const response = await web.request("POST", `/api/sessions/${parentId}/commands/run`, { cwd: work, text });
+			assert.ok(response.status >= 200 && response.status < 300, JSON.stringify(response.body));
+		};
+		const parentText = () => fs.readFileSync(parentFile, "utf8");
+		const childrenOfParent = async () => (await sessions()).filter((session) => session.parentSessionPath === parentFile);
+
+		// Launch through the subagent tool: the child is a PI WEB session under the parent.
+		assert.equal((await prompt(parentId, "Delegate the fixture task")).status, 200);
+		const parentDone = await waitFor("the parent to finish", () => answers("parent").find((line) => JSON.stringify(line.content).includes("PARENT_DONE")));
+		assert.ok(JSON.stringify(parentDone.content).includes("WORKER_DONE"), JSON.stringify(parentDone.content));
+		const worker = answers("worker")[0]!;
+		assert.deepEqual(worker.tools, ["contact_supervisor", "read"]);
+		assert.ok(worker.systemPrompt.includes("You are the web worker."));
+		assert.ok(worker.systemPrompt.includes("<pi_web_session_environment>"), "PI WEB's environment facts stay after the agent prompt");
+		const [first] = await childrenOfParent();
+		assert.ok(first, `child listed under the parent: ${JSON.stringify(await sessions())}`);
+		assert.match(first.name ?? "", /web-worker/);
+		assert.equal(ledgerOf(first.id).state, "settled");
+		assert.equal(ledgerOf(first.id).lastTurn?.outcome, "completed");
+		// One writer: PI WEB wrote the child file, which holds exactly one header and one entry chain.
+		const entries = fs.readFileSync(first.path, "utf8").trim().split("\n").map((line) => JSON.parse(line) as { type: string; id: string; parentId?: string | null });
+		assert.equal(entries.filter((entry) => entry.type === "session").length, 1);
+		const ids = new Set<string>();
+		for (const entry of entries.slice(1)) {
+			assert.ok(!ids.has(entry.id), "entry ids are unique");
+			assert.ok(entry.parentId === null || ids.has(entry.parentId!), "every entry continues the chain");
+			ids.add(entry.id);
+		}
+
+		// The browser lists the package's commands, and doctor answers without a model turn.
+		const commands = (await web.request("GET", `/api/sessions/${parentId}/commands?cwd=${encodeURIComponent(work)}`)).body as Array<{ name: string; description?: string; source: string }>;
+		for (const name of ["subagents-web", "run", "subagents", "subagents-fleet", "subagents-stop"]) {
+			const command = commands.find((entry) => entry.name === name);
+			assert.ok(command && command.source === "extension" && command.description, `${name} is listed: ${JSON.stringify(commands.map((entry) => entry.name))}`);
+		}
+		const callsBeforeDoctor = auditLines().length;
+		await slash("/subagents-web doctor");
+		await waitFor("the doctor report in the parent session", () => parentText().includes("Pi 0.85.1: supported") || undefined, 30000);
+		assert.equal(auditLines().length, callsBeforeDoctor, "doctor does not wake the parent model");
+
+		// Two children of a foreground runs.all workflow run at the same time.
+		assert.equal((await prompt(parentId, "PARALLEL delegate")).status, 200);
+		await waitFor("both parallel children to hold at the same time", () => {
+			const held = new Set(holds().map((line) => line.hold));
+			return (held.has("a") && held.has("b")) || undefined;
+		}, 90000);
+		release("a");
+		release("b");
+		await waitFor("the parent to report the workflow", () => answers("parent").filter((line) => JSON.stringify(line.content).includes("PARENT_DONE")).length >= 2 || undefined, 90000);
+		const parallelChildren = (await childrenOfParent()).filter((session) => session.id !== first.id);
+		assert.equal(parallelChildren.length, 2, JSON.stringify(parallelChildren));
+		for (const child of parallelChildren) assert.equal(ledgerOf(child.id).lastTurn?.outcome, "completed");
+		for (const line of holds()) assert.ok(line.systemPrompt.includes("You are the web worker."));
+
+		// The browser aborts the orchestrator's running child from the child's own
+		// chat: the orchestrator gets the aborted run as its tool result and goes on.
+		assert.equal((await prompt(parentId, "HOLDTASK delegate")).status, 200);
+		await waitFor("the orchestrated child to hold", () => holds().some((line) => line.hold === "o") || undefined, 90000);
+		const orchestrated = await waitFor("the orchestrated child under the parent", async () => (await childrenOfParent()).find((session) => session.id !== first.id && !parallelChildren.some((child) => child.id === session.id)));
+		assert.equal((await web.request("POST", `/api/sessions/${orchestrated.id}/abort`, { cwd: work })).status, 200);
+		const afterAbort = await waitFor("the parent to finish after the abort", () => answers("parent").filter((line) => JSON.stringify(line.content).includes("PARENT_DONE"))[2], 90000);
+		assert.ok(!JSON.stringify(afterAbort.content).includes("WORKER_DONE"), JSON.stringify(afterAbort.content));
+		assert.equal(ledgerOf(orchestrated.id).lastTurn?.outcome, "aborted");
+		assert.equal(holds().filter((line) => line.hold === "o").length, 1, "the aborted child was not started again");
+		// The orchestrator continues the aborted, idle child with a new turn in its own session.
+		assert.equal((await prompt(parentId, `CONTINUE#${orchestrated.id}`)).status, 200);
+		const continuedDone = await waitFor("the parent to report the continuation", () => answers("parent").filter((line) => JSON.stringify(line.content).includes("PARENT_DONE"))[3], 90000);
+		assert.ok(JSON.stringify(continuedDone.content).includes("WORKER_DONE for CONTINUED turn"), JSON.stringify(continuedDone.content));
+		const continuedTurn = answers("worker").find((line) => line.lastUser?.includes("CONTINUED turn"));
+		assert.ok(continuedTurn?.systemPrompt.includes("You are the web worker."), "the continuation runs under the agent contract");
+		assert.deepEqual(continuedTurn?.tools, ["contact_supervisor", "read"]);
+		assert.equal(ledgerOf(orchestrated.id).lastTurn?.outcome, "completed");
+		assert.equal((await childrenOfParent()).filter((session) => session.id === orchestrated.id).length, 1, "no new child session");
+		// Aborting the orchestrator's own turn interrupts its running foreground child.
+		const parentCallsBeforeHold = answers("parent").length;
+		assert.equal((await prompt(parentId, "HOLDPARENT delegate")).status, 200);
+		await waitFor("the child of the held orchestrator turn to hold", () => holds().some((line) => line.hold === "p") || undefined, 90000);
+		const interrupted = await waitFor("the child of the held orchestrator turn", async () => (await childrenOfParent()).find((session) => ![first.id, orchestrated.id, ...parallelChildren.map((child) => child.id)].includes(session.id)));
+		assert.equal((await web.request("POST", `/api/sessions/${parentId}/abort`, { cwd: work })).status, 200);
+		await waitFor("the interrupted child outcome", () => ledgerOf(interrupted.id).lastTurn?.outcome === "aborted" || undefined, 90000);
+		await waitFor("the orchestrator to stop working", async () => (await statusOf(parentId)).isStreaming === false || undefined);
+		await waitFor("the interrupted child to be idle", async () => (await statusOf(interrupted.id)).isStreaming === false || undefined);
+		assert.equal(ledgerOf(interrupted.id).terminated, undefined, "an interrupt is not a terminal stop");
