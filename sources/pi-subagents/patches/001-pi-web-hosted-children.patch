diff -ruN -x .git a/src/web/child-session-factory.ts b/src/web/child-session-factory.ts
--- a/src/web/child-session-factory.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/web/child-session-factory.ts	2026-11-09 07:05:29.018858645 +0000
@@ -0,0 +1,501 @@
+/**
+ * Parent-side adapter: a `ChildSessionFactory` whose children are sessions of
+ * the PI WEB daemon that hosts the parent.
+ *
+ * The daemon owns execution and lifecycle. The adapter prepares the child
+ * session file, opens it through the daemon, waits for the companion to
+ * confirm the restored contract, sends prompts and steering through the
+ * daemon's HTTP API, observes the child through the process registry and
+ * aborts through the daemon. Each prompt is registered as a pending request
+ * before it is posted; the companion claims it on the matching input and
+ * reports the outcome of exactly the turn that carried it, so a turn started
+ * from the browser is never taken for the adapter's. It never closes the
+ * child runtime on its own: releasing a finished run only stops observing it.
+ * A terminal stop is a separate, explicit operation.
+ */
+import { randomUUID } from "node:crypto";
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { AgentMessage } from "@earendil-works/pi-agent-core";
+import type { ChildSession, ChildSessionEvent, ChildSessionFactory, ChildSessionLaunch } from "../runs/shared/child-session.ts";
+import { PI_WEB_CHILD_PARENT_CAPABILITY, piWebErrorText, type PiWebDaemon } from "./daemon.ts";
+import {
+	createWebChildPolicy,
+	parseWebChildSessionFile,
+	prepareWebChildSessionFile,
+	loadWebChildLedger,
+	recordWebChildTombstone,
+	serializeChildRuntimeConfig,
+	updateWebChildLedger,
+	writeWebChildLedger,
+	WEB_CHILD_POLICY_TYPE,
+	type WebChildLedgerState,
+	type WebChildPolicy,
+} from "./policy.ts";
+import {
+	addWebChildPendingRequest,
+	cancelWebChildRequest,
+	postWebChildRequest,
+	publishWebCompanionState,
+	releaseWebChildChannel,
+	webChildChannel,
+	webChildRequestText,
+	type WebChildEvent,
+	type WebChildTurnClaimedEvent,
+	type WebChildTurnSettledEvent,
+} from "./registry.ts";
+
+const OPEN_TIMEOUT_MS = 30_000;
+const ABORT_TIMEOUT_MS = 15_000;
+
+export interface WebChildRecord {
+	sessionId: string;
+	sessionFile: string;
+	cwd: string;
+	runId: string;
+	agent: string;
+	session: WebChildSession;
+}
+
+export interface WebChildSession extends ChildSession {
+	readonly cwd: string;
+	/** Terminal stop: tombstone, abort, then close the runtime. */
+	stop(reason: string): Promise<void>;
+}
+
+export interface WebChildSessionFactory extends ChildSessionFactory {
+	readonly children: ReadonlyMap<string, WebChildRecord>;
+}
+
+export interface WebChildSessionFactoryOptions {
+	daemon: PiWebDaemon;
+	parentSessionFile: string;
+	parentSessionId?: string;
+	parentCwd: string;
+	/** Called for every child the factory created, so management commands can find it. */
+	onChild?: (record: WebChildRecord) => void;
+	/** Overrides for contract tests. */
+	timeouts?: { openMs?: number; abortMs?: number };
+}
+
+function sessionRoute(sessionId: string, action: string): string {
+	return `/sessions/${encodeURIComponent(sessionId)}/${action}`;
+}
+
+/** Reasons a launch cannot be hosted by PI WEB; checked before anything is written. */
+export function webLaunchError(launch: ChildSessionLaunch, parentCwd: string): string | undefined {
+	if (launch.machine) return "pane-native (machine) placement is not available for PI WEB hosted children";
+	if (launch.storage.kind !== "file") return "a PI WEB hosted child needs a prepared session file";
+	if (path.resolve(launch.cwd) !== path.resolve(parentCwd)) return `a PI WEB hosted child runs in the parent's cwd (${parentCwd}); '${launch.cwd}' was requested`;
+	if (launch.extensionPaths.length > 0) return `agent extensions (${launch.extensionPaths.join(", ")}) cannot be loaded into a PI WEB session; the daemon profile's extensions are shared by every session`;
+	if (launch.processEnv && Object.keys(launch.processEnv).length > 0) return "per-child process environment is not available in a PI WEB session";
+	if (launch.runtime.fanoutChild || launch.runtime.nestedRoute) return "nested subagent launches are not available for PI WEB hosted children";
+	return undefined;
+}
+
+function webPolicyForLaunch(launch: ChildSessionLaunch, options: WebChildSessionFactoryOptions): WebChildPolicy {
+	const replace = launch.systemPrompt !== undefined;
+	return createWebChildPolicy({
+		runId: launch.runtime.runId ?? "",
+		agent: launch.runtime.agent ?? "subagent",
+		childIndex: launch.runtime.childIndex ?? 0,
+		cwd: path.resolve(launch.cwd),
+		parentSessionFile: options.parentSessionFile,
+		...(options.parentSessionId ? { parentSessionId: options.parentSessionId } : {}),
+		...(launch.model ? { model: launch.model } : {}),
+		...(launch.tools ? { tools: [...launch.tools] } : {}),
+		...(launch.excludeTools?.length ? { excludeTools: [...launch.excludeTools] } : {}),
+		systemPromptMode: replace ? "replace" : "append",
+		agentPrompt: (replace ? launch.systemPrompt : launch.appendSystemPrompt) ?? "",
+		noSkills: launch.noSkills,
+		noContextFiles: launch.noContextFiles,
+		runtime: serializeChildRuntimeConfig(launch.runtime),
+	});
+}
+
+function waitForCompanion(sessionId: string, digest: string, timeoutMs: number): Promise<void> {
+	const channel = webChildChannel(sessionId);
+	return new Promise((resolve, reject) => {
+		let timer: ReturnType<typeof setTimeout> | undefined;
+		const check = (): boolean => {
+			const state = channel.companion?.state;
+			if (!state) return false;
+			cleanup();
+			if (state.kind === "failed") reject(new Error(`the child refused to start: ${state.reason}`));
+			else if (state.digest !== digest) reject(new Error("the child restored a different policy"));
+			else resolve();
+			return true;
+		};
+		const cleanup = (): void => {
+			channel.stateListeners.delete(listener);
+			if (timer) clearTimeout(timer);
+		};
+		const listener = (): void => { check(); };
+		channel.stateListeners.add(listener);
+		if (check()) return;
+		timer = setTimeout(() => {
+			cleanup();
+			reject(new Error("the pi-subagents companion did not confirm the child contract; install pi-subagents globally in the PI WEB daemon's agent profile"));
+		}, timeoutMs);
+		timer.unref?.();
+	});
+}
+
+/** Deliver correlated input; PI WEB atomically queues if busy or starts if idle. */
+export async function queueWebChildInput(daemon: PiWebDaemon, sessionId: string, cwd: string, text: string, streamingBehavior: "steer" | "followUp", signal?: AbortSignal): Promise<void> {
+	if (signal?.aborted) throw new Error("The input was cancelled before it started.");
+	const channel = webChildChannel(sessionId);
+	// A locked child answers every input itself; the message would never reach
+	// the model while the POST still succeeds.
+	const companion = channel.companion?.state;
+	if (companion?.kind === "failed") throw new Error(`The child session is locked: ${companion.reason}`);
+	const id = randomUUID();
+	const pending = { id, text: webChildRequestText(id, text), cancelled: false };
+	const withdraw = addWebChildPendingRequest(sessionId, pending);
+	let listener!: (event: WebChildEvent) => void;
+	const claimed = new Promise<void>((resolve, reject) => {
+		listener = (event) => {
+			if (event.type === "session_shutdown") {
+				reject(new Error("The child session runtime closed before accepting the input."));
+				return;
+			}
+			if (!Array.isArray(event.requestIds) || !event.requestIds.includes(id)) return;
+			if (event.type === "pi_subagents_turn_claimed") resolve();
+			else if (event.type === "pi_subagents_turn_settled") reject(new Error(String(event.error ?? "the child refused the input")));
+		};
+	});
+	claimed.catch(() => undefined);
+	channel.listeners.add(listener);
+	let rejectCancelled!: (error: Error) => void;
+	const cancelled = new Promise<never>((_resolve, reject) => { rejectCancelled = reject; });
+	cancelled.catch(() => undefined);
+	let cancellation: Promise<never> | undefined;
+	const onAbort = () => {
+		cancellation ??= (async () => {
+			if (cancelWebChildRequest(sessionId, id)) {
+				throw new Error("The input was cancelled before acceptance.");
+			}
+			try {
+				const response = await daemon.request("POST", sessionRoute(sessionId, "abort"), { cwd });
+				if (response.status !== 200) throw new Error(piWebErrorText(response));
+				channel.companion?.noteAbort(id);
+			} catch (error) {
+				throw new Error(`The input cancellation failed: ${String(error)}`);
+			}
+			throw new Error("The input was cancelled.");
+		})();
+		cancellation.catch(rejectCancelled);
+	};
+	signal?.addEventListener("abort", onAbort, { once: true });
+	try {
+		if (signal?.aborted) throw new Error("The input was cancelled before it started.");
+		await Promise.race([postWebChildRequest(sessionId, id, () => daemon.request("POST", sessionRoute(sessionId, "prompt"), { cwd, text: pending.text, streamingBehavior }).then((response) => {
+			if (response.status !== 200) throw new Error(`PI WEB prompt failed: ${piWebErrorText(response)}`);
+		})), cancelled]);
+		await Promise.race([claimed, cancelled]);
+		if (cancellation) await cancellation;
+	} catch (error) {
+		if (cancellation) await cancellation;
+		cancelWebChildRequest(sessionId, id);
+		throw error;
+	} finally {
+		signal?.removeEventListener("abort", onAbort);
+		channel.listeners.delete(listener);
+		if (!pending.cancelled) withdraw();
+	}
+}
+
+export function createWebChildSessionFactory(options: WebChildSessionFactoryOptions): WebChildSessionFactory {
+	const { daemon } = options;
+	const openTimeoutMs = options.timeouts?.openMs ?? OPEN_TIMEOUT_MS;
+	const abortTimeoutMs = options.timeouts?.abortMs ?? ABORT_TIMEOUT_MS;
+	const children = new Map<string, WebChildRecord>();
+
+	const createChild = async (launch: ChildSessionLaunch): Promise<WebChildSession> => {
+		const launchError = webLaunchError(launch, options.parentCwd);
+		if (launchError) throw new Error(`PI WEB hosting: ${launchError}.`);
+		if (!fs.existsSync(options.parentSessionFile)) {
+			throw new Error(`PI WEB hosting: the parent session file ${options.parentSessionFile} does not exist yet, so the child cannot be listed under it.`);
+		}
+		const runtime = await daemon.runtime();
+		const allocation = parseWebChildSessionFile((launch.storage as { sessionFile: string }).sessionFile);
+		if (!allocation || path.dirname(allocation.sessionFile) !== path.dirname(options.parentSessionFile)) {
+			throw new Error("PI WEB hosting: the child session file must be allocated next to the parent session file.");
+		}
+		const { sessionId, sessionFile } = allocation;
+		const cwd = path.resolve(launch.cwd);
+		const policy = webPolicyForLaunch(launch, options);
+		const name = launch.runtime.sessionName ?? policy.agent;
+		const loaded = loadWebChildLedger(sessionId);
+		if ("error" in loaded && !loaded.missing) {
+			throw new Error(`PI WEB hosting: refusing to replace the child ledger: ${loaded.error}`);
+		}
+		const existing = "ledger" in loaded ? loaded.ledger : undefined;
+		if (existing?.terminated) throw new Error(`PI WEB hosting: child ${sessionId} was stopped (${existing.terminated.reason}).`);
+		// The companion refuses a child without a ledger, so the ledger exists
+		// before PI WEB can open the session.
+		writeWebChildLedger({
+			schemaVersion: 1,
+			sessionId,
+			sessionFile,
+			cwd,
+			parentSessionFile: options.parentSessionFile,
+			runId: policy.runId,
+			agent: policy.agent,
+			digest: policy.digest,
+			state: "prepared",
+			...(existing?.digest === policy.digest ? {
+				toolBudgetUsed: existing.toolBudgetUsed,
+				lastTurn: existing.lastTurn,
+				structuredOutput: existing.structuredOutput,
+			} : {}),
+			updatedAt: new Date().toISOString(),
+		});
+		if (!fs.existsSync(sessionFile)) {
+			if (runtime.capabilities.includes(PI_WEB_CHILD_PARENT_CAPABILITY)) {
+				const created = await daemon.request("POST", "/sessions", {
+					cwd,
+					sessionId,
+					sessionFile,
+					parentSession: options.parentSessionFile,
+					name,
+					entries: [{ type: "custom", customType: WEB_CHILD_POLICY_TYPE, data: policy }],
+				});
+				if (created.status !== 200 && created.status !== 201) throw new Error(`PI WEB could not create the child session: ${piWebErrorText(created)}`);
+				const body = created.body as { id?: unknown; path?: unknown } | undefined;
+				if (body?.id !== sessionId || body?.path !== sessionFile) throw new Error("PI WEB created the child session under a different id or file.");
+			} else {
+				prepareWebChildSessionFile({ allocation, parentSessionFile: options.parentSessionFile, cwd, name, policy });
+			}
+		}
+
+		const channel = webChildChannel(sessionId);
+		channel.live = { runId: policy.runId, digest: policy.digest, hooks: launch.hooks, runtime: launch.runtime };
+		const listeners = new Set<(event: ChildSessionEvent) => void>();
+		const messages: AgentMessage[] = [];
+		let currentRun: {
+			id: string;
+			claimed: boolean;
+			queued: boolean;
+			started: boolean;
+			reject: (error: Error) => void;
+			settle: () => void;
+		} | undefined;
+		let disposed = false;
+		let stopped: string | undefined;
+		let tombstoned = false;
+		const onEvent = (event: WebChildEvent): void => {
+			const run = currentRun;
+			if (event.type === "pi_subagents_turn_claimed") {
+				const claimed = event as WebChildTurnClaimedEvent;
+				if (run && claimed.requestIds.includes(run.id)) {
+					run.claimed = true;
+					run.queued = claimed.queued;
+				}
+				return;
+			}
+			if (event.type === "pi_subagents_turn_settled") {
+				const settled = event as WebChildTurnSettledEvent;
+				if (!run || !settled.requestIds.includes(run.id)) return;
+				if (settled.outcome === "failed") run.reject(new Error(`The child turn failed: ${settled.error ?? "unknown error"}`));
+				else run.settle();
+				return;
+			}
+			if (event.type === "session_shutdown") {
+				channel.pending.splice(0);
+				run?.reject(new Error(`The child session runtime closed (${String(event.reason ?? "shutdown")}).`));
+				return;
+			}
+			const compaction = event.type === "compaction_start" || event.type === "compaction_end";
+			// Only the turn that carries this adapter's request belongs to the run;
+			// turns started from the browser before it are not observed.
+			if (!compaction && (!run?.claimed || (Array.isArray(event.requestIds) && !event.requestIds.includes(run.id)))) return;
+			if (event.type === "agent_start" && run) run.started = true;
+			if (event.type === "message_end" && event.message) messages.push(event.message as AgentMessage);
+			for (const listener of [...listeners]) listener(event as ChildSessionEvent);
+		};
+		channel.listeners.add(onEvent);
+		const onState = (): void => {
+			const state = channel.companion?.state;
+			if (state?.kind === "failed" && currentRun) currentRun.reject(new Error(`The child session is locked: ${state.reason}`));
+		};
+		channel.stateListeners.add(onState);
+		const release = (): void => {
+			channel.listeners.delete(onEvent);
+			channel.stateListeners.delete(onState);
+			if (channel.live?.digest === policy.digest) channel.live = undefined;
+			releaseWebChildChannel(sessionId);
+		};
+		const setState = (state: WebChildLedgerState, error?: string): void => {
+			try {
+				updateWebChildLedger(sessionId, { state, ...(error ? { error } : {}) });
+			} catch (ledgerError) {
+				console.error("[pi-subagents] Failed to update the PI WEB child ledger:", ledgerError);
+			}
+		};
+
+		try {
+			const opened = await daemon.request("GET", `${sessionRoute(sessionId, "status")}?cwd=${encodeURIComponent(cwd)}`);
+			if (opened.status !== 200) throw new Error(`PI WEB could not open the child session: ${piWebErrorText(opened)}`);
+			await waitForCompanion(sessionId, policy.digest, openTimeoutMs);
+		} catch (error) {
+			release();
+			const message = error instanceof Error ? error.message : String(error);
+			setState("failed", message);
+			await daemon.request("POST", sessionRoute(sessionId, "stop"), { cwd }).catch(() => undefined);
+			throw new Error(`PI WEB hosting: ${message}`);
+		}
+
+		const post = async (action: string, body: Record<string, unknown>, timeoutMs?: number): Promise<void> => {
+			const response = await daemon.request("POST", sessionRoute(sessionId, action), { cwd, ...body }, timeoutMs);
+			if (response.status !== 200) throw new Error(`PI WEB ${action} failed: ${piWebErrorText(response)}`);
+		};
+		const childIsStreaming = (): boolean => {
+			const companion = channel.companion;
+			return companion ? !companion.isIdle() : false;
+		};
+		let sequence: Promise<void> = Promise.resolve();
+		const runPrompt = async (text: string): Promise<void> => {
+			if (disposed) throw new Error("The parent released observation of this child request.");
+			if (stopped) throw new Error(`The child session was stopped: ${stopped}`);
+			const id = randomUUID();
+			const settled = new Promise<void>((resolve, reject) => {
+				currentRun = { id, claimed: false, queued: false, started: false, settle: resolve, reject };
+			});
+			// A stop or shutdown can reject the run while the prompt is still being
+			// posted; the rejection is observed below, never left unhandled.
+			settled.catch(() => undefined);
+			const pending = { id, text: webChildRequestText(id, text), cancelled: false };
+			const withdraw = addWebChildPendingRequest(sessionId, pending);
+			let unobserve: (() => void) | undefined;
+			let failure: string | undefined;
+			try {
+				unobserve = await daemon.observe(sessionId);
+				await postWebChildRequest(sessionId, id, () => post("prompt", { text: pending.text }));
+				// HTTP acceptance and idle status do not identify a prompt's outcome.
+				// Even input handlers before this companion may still be awaiting.
+				await settled;
+			} catch (error) {
+				cancelWebChildRequest(sessionId, id);
+				failure = error instanceof Error ? error.message : String(error);
+				setState(stopped ? "stopped" : childIsStreaming() ? "running" : "failed", failure);
+				throw error;
+			} finally {
+				channel.companion?.releaseRequest(id, failure ? "failed" : "aborted", failure);
+				// A delayed cancelled input owns its token until consumed or runtime shutdown.
+				if (!pending.cancelled) withdraw();
+				unobserve?.();
+				currentRun = undefined;
+			}
+		};
+		const queueWhileStreaming = async (text: string, streamingBehavior: "steer" | "followUp"): Promise<void> => {
+			if (stopped) throw new Error(`The child session was stopped: ${stopped}`);
+			if (!childIsStreaming()) throw new Error("The child is not running a turn; there is nothing to steer.");
+			await queueWebChildInput(daemon, sessionId, cwd, text, streamingBehavior);
+		};
+
+		const session: WebChildSession = {
+			cwd,
+			abortRequiresConfirmation: true,
+			subscribe(listener) {
+				listeners.add(listener);
+				return () => { listeners.delete(listener); };
+			},
+			prompt(text) {
+				// The adapter serializes its own sends; a second idle prompt racing the
+				// first would drop the agent system prompt override in Pi.
+				const next = sequence.then(() => runPrompt(text));
+				sequence = next.catch(() => undefined);
+				return next;
+			},
+			steer: (text) => queueWhileStreaming(text, "steer"),
+			followUp: (text) => queueWhileStreaming(text, "followUp"),
+			async abort() {
+				const run = currentRun;
+				if (run && cancelWebChildRequest(sessionId, run.id)) {
+					run.settle();
+					return;
+				}
+				try {
+					await post("abort", {}, abortTimeoutMs);
+					channel.companion?.noteAbort(run?.id);
+					run?.settle();
+				} catch (error) {
+					const failure = new Error(`The child cancellation failed: ${error instanceof Error ? error.message : String(error)}`);
+					// Persist even after a foreground hard finish released observation.
+					try { updateWebChildLedger(sessionId, { error: failure.message }); }
+					catch (ledgerError) { console.error("[pi-subagents] Could not record cancellation failure:", failure, ledgerError); }
+					run?.reject(failure);
+					throw failure;
+				}
+			},
+			async stop(reason) {
+				stopped ??= reason;
+				// Lock the live child before anything else: the browser can prompt it
+				// while the stop is recorded and the runtime closes.
+				channel.companion?.terminate(stopped);
+				let unrecorded: string | undefined;
+				if (!tombstoned) {
+					try {
+						recordWebChildTombstone(sessionId, stopped);
+						tombstoned = true;
+					} catch (error) {
+						unrecorded = error instanceof Error ? error.message : String(error);
+					}
+				}
+				await post("abort", {}, abortTimeoutMs).catch(() => undefined);
+				try {
+					await post("stop", {});
+				} catch (error) {
+					if (unrecorded === undefined) throw error;
+					throw new Error(`${error instanceof Error ? error.message : String(error)}; besides, ${unrecorded}; stop it again once PI WEB answers and its state file is writable.`);
+				}
+				currentRun?.reject(new Error(`The child session was stopped: ${stopped}`));
+				publishWebCompanionState(sessionId, undefined);
+				if (unrecorded !== undefined) throw new Error(`The child runtime was stopped, but ${unrecorded}; stop it again once its state file is writable.`);
+			},
+			async dispose() {
+				if (disposed) return;
+				disposed = true;
+				if (currentRun) cancelWebChildRequest(sessionId, currentRun.id);
+				currentRun?.reject(new Error("The parent released observation of this child request."));
+				release();
+			},
+			hasQueuedMessages: () => channel.companion?.hasPendingMessages() === true,
+			get messages() { return messages; },
+			get sessionFile() { return sessionFile; },
+			get sessionId() { return sessionId; },
+			get modelId() { return policy.model?.replace(/:(off|minimal|low|medium|high|xhigh|max)$/, ""); },
+		};
+		const record: WebChildRecord = { sessionId, sessionFile, cwd, runId: policy.runId, agent: policy.agent, session };
+		children.set(sessionId, record);
+		options.onChild?.(record);
+		return session;
+	};
+
+	return {
+		children,
+		create: createChild,
+		async dispose() {
+			// The parent closed or reloads: abort all its children, detached ones
+			// included, because nothing observes them any more (q5); the daemon
+			// keeps their sessions, which stay addressable from the browser.
+			const live = [...children.values()];
+			for (const record of live) record.session.shutDown = true;
+			const results = await Promise.allSettled(live.map(async (record) => {
