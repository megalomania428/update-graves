+describe("PI WEB daemon detection", () => {
+	it("finds only the daemon whose owner marker names this process", () => {
+		const dataDir = tempDir();
+		const env = { PI_WEB_SESSION: "1", PI_WEB_DATA_DIR: dataDir };
+		const marker = path.join(dataDir, "sessiond-owner.json");
+		const endpoint = path.join(dataDir, "sessiond.sock");
+		assert.equal(piWebDataDir(env), dataDir);
+		assert.deepEqual(piWebEndpoint(env), { endpoint: { kind: "socket", socketPath: endpoint }, description: endpoint });
+		resetPiWebDaemonDetection();
+		fs.writeFileSync(marker, JSON.stringify({ pid: process.pid + 1, startedAt: "x", endpoint }));
+		assert.equal(detectPiWebDaemon(env), undefined);
+		const startTime = readProcessStartTime(process.pid);
+		fs.writeFileSync(marker, JSON.stringify({ pid: process.pid, startedAt: "x", ...(startTime ? { processStartTime: startTime } : {}), endpoint }));
+		resetPiWebDaemonDetection();
+		assert.equal(detectPiWebDaemon(env)?.dataDir, dataDir);
+		resetPiWebDaemonDetection();
+		assert.equal(detectPiWebDaemon({ ...env, PI_WEB_SESSION: undefined }), undefined);
+		fs.writeFileSync(marker, JSON.stringify({ pid: process.pid, startedAt: "x", processStartTime: "not-this-process", endpoint }));
+		resetPiWebDaemonDetection();
+		assert.equal(detectPiWebDaemon(env), undefined);
+		resetPiWebDaemonDetection();
+	});
+
+	it("refuses to fall back to in-process children inside a pi-web daemon whose marker is broken", () => {
+		const dir = tempDir();
+		const pkg = path.join(dir, "node_modules", "@raven428", "pi-web");
+		fs.mkdirSync(path.join(pkg, "dist", "server"), { recursive: true });
+		fs.writeFileSync(path.join(pkg, "package.json"), JSON.stringify({ name: "@raven428/pi-web" }));
+		fs.writeFileSync(path.join(pkg, "dist", "server", "sessiond.js"), "");
+		fs.mkdirSync(path.join(dir, "node_modules", ".bin"));
+		const bin = path.join(dir, "node_modules", ".bin", "pi-web-sessiond");
+		fs.symlinkSync(path.join(pkg, "dist", "server", "sessiond.js"), bin);
+		fs.writeFileSync(path.join(dir, "other.js"), "");
+		assert.equal(isPiWebSessiondEntrypoint(bin), true);
+		assert.equal(isPiWebSessiondEntrypoint(path.join(dir, "other.js")), false);
+		const env = { PI_WEB_SESSION: "1", PI_WEB_DATA_DIR: path.join(dir, "data") };
+		resetPiWebDaemonDetection();
+		assert.throws(() => detectPiWebDaemon(env, bin), /owner marker .* is missing, unreadable or names another process/);
+		fs.mkdirSync(env.PI_WEB_DATA_DIR);
+		fs.writeFileSync(path.join(env.PI_WEB_DATA_DIR, "sessiond-owner.json"), "{ broken");
+		assert.throws(() => detectPiWebDaemon(env, bin), /owner marker/);
+		assert.equal(detectPiWebDaemon(env, path.join(dir, "other.js")), undefined, "a process spawned from a PI WEB session keeps the upstream behavior");
+		resetPiWebDaemonDetection();
