diff -ruN -x .git a/test/integration/web-adapter-contract.test.ts b/test/integration/web-adapter-contract.test.ts
--- a/test/integration/web-adapter-contract.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/test/integration/web-adapter-contract.test.ts	2026-11-09 07:08:37.243271231 +0000
@@ -0,0 +1,1152 @@
+/**
+ * Contract of the PI WEB adapter against a scripted session daemon: the HTTP
+ * calls it makes, the prepared child file, the companion handshake through the
+ * process registry, correlation of the adapter's prompt with the turn that
+ * carries it, run settlement and outcomes, refusals before launch, terminal
+ * stop (also by the child's state file and when the stop cannot be recorded),
+ * the orchestrator's interrupt of its foreground run, its continuation of an
+ * idle child and the future
+ * parented-creation capability. The scripted companion
+ * claims and settles requests through the registry like the real one.
+ */
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import type { Socket } from "node:net";
+import fsDefault, * as fs from "node:fs";
+import { syncBuiltinESMExports } from "node:module";
+import * as http from "node:http";
+import * as os from "node:os";
+import * as path from "node:path";
+import { after, afterEach, describe, it } from "node:test";
+import type { ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { createSubagentExecutor } from "../../src/runs/foreground/subagent-executor.ts";
+import { runSync } from "../../src/runs/foreground/execution.ts";
+import type { ChildSessionLaunch } from "../../src/runs/shared/child-session.ts";
+import { createWebChildSessionFactory } from "../../src/web/child-session-factory.ts";
+import { PI_WEB_CHILD_PARENT_CAPABILITY, PI_WEB_SUPPORTED_RUNTIME_VERSIONS, createPiWebDaemonForTest, readProcessStartTime, resetPiWebDaemonDetection, type PiWebEndpoint } from "../../src/web/daemon.ts";
+import { disposeWebChildSessions, webChildStopAddresses, stopWebChildByLedger } from "../../src/web/host-integration.ts";
+import { allocateWebChildSessionFile, findWebChildPolicyEntry, readWebChildLedger, updateWebChildLedger, verifyWebChildPolicy, webChildLedgerDir } from "../../src/web/policy.ts";
+import { continueWebChild, runWebSlashCommand } from "../../src/web/slash.ts";
+import { makeAgentConfigs } from "../support/helpers.ts";
+import { claimWebChildPendingRequest, webChildInputText, publishWebChildEvent, publishWebCompanionState, webChildChannel, type WebChildTurnOutcome, type WebCompanionHandle } from "../../src/web/registry.ts";
+
+interface Recorded {
+	method: string;
+	url: string;
+	body: Record<string, unknown> | undefined;
+}
+
+interface ScriptedDaemon {
+	requests: Recorded[];
+	capabilities: string[];
+	/** What the scripted companion does when the child is opened. */
+	onOpen: (sessionId: string, sessionFile: string | undefined) => void;
+	onPrompt: (sessionId: string, body: Record<string, unknown>) => void;
+	/** Delay before the scripted daemon answers a prompt request. */
+	promptDelayMs: number;
+	emitError(sessionId: string, message: string): void;
+	disconnect(sessionId: string): void;
+	endpoint: PiWebEndpoint;
+	onStatus?: () => void;
+	onObserve?: () => void;
+	streaming: Map<string, boolean>;
+	terminated: Map<string, string>;
+	aborts: string[];
+	released: string[];
+	close(): Promise<void>;
+	socketPath: string;
+	root: string;
+}
+
+const roots: string[] = [];
+after(() => {
+	for (const root of roots) fs.rmSync(root, { recursive: true, force: true });
+});
+
+function companion(daemon: ScriptedDaemon, sessionId: string, state: WebCompanionHandle["state"]): WebCompanionHandle {
+	return {
+		generation: 1,
+		runId: readWebChildLedger(sessionId)?.runId,
+		state,
+		isIdle: () => daemon.streaming.get(sessionId) !== true,
+		hasPendingMessages: () => false,
+		terminate: (reason) => { daemon.terminated.set(sessionId, reason); },
+		currentRequestIds: () => [],
+		noteAbort: () => { daemon.aborts.push(sessionId); },
+		releaseRequest: (id) => { daemon.released.push(id); },
+	};
+}
+
+/** What the real companion does for a claimed request: report the claim, then the outcome. */
+function claim(sessionId: string, text: unknown, queued = false): string | undefined {
+	const request = typeof text === "string" ? claimWebChildPendingRequest(sessionId, text) : undefined;
+	publishWebChildEvent(sessionId, { type: "input", text, source: "interactive" });
+	if (request) publishWebChildEvent(sessionId, { type: "pi_subagents_turn_claimed", requestIds: [request.id], queued });
+	return request?.id;
+}
+
+function settle(sessionId: string, requestId: string | undefined, outcome: WebChildTurnOutcome, error?: string): void {
+	if (!requestId) return;
+	updateWebChildLedger(sessionId, { state: outcome === "completed" ? "settled" : outcome, lastTurn: { requestIds: [requestId], outcome, at: new Date().toISOString() } });
+	publishWebChildEvent(sessionId, { type: "pi_subagents_turn_settled", requestIds: [requestId], outcome, ...(error ? { error } : {}) });
+}
+
+function turn(daemon: ScriptedDaemon, sessionId: string, answer: string): void {
+	daemon.streaming.set(sessionId, true);
+	publishWebChildEvent(sessionId, { type: "agent_start" });
+	publishWebChildEvent(sessionId, { type: "message_end", message: { role: "assistant", content: [{ type: "text", text: answer }], stopReason: "stop" } });
+	daemon.streaming.set(sessionId, false);
+	publishWebChildEvent(sessionId, { type: "agent_settled" });
+}
+
+function readyOnOpen(daemon: ScriptedDaemon) {
+	return (sessionId: string, sessionFile: string | undefined) => {
+		const entries = fs.readFileSync(sessionFile!, "utf8").trim().split("\n").map((line) => JSON.parse(line));
+		const verified = verifyWebChildPolicy(findWebChildPolicyEntry(entries));
+		assert.ok("policy" in verified);
+		publishWebCompanionState(sessionId, companion(daemon, sessionId, { kind: "ready", digest: verified.policy.digest }));
+	};
+}
+
+function settleOnPrompt(daemon: ScriptedDaemon, answer: string) {
+	return (sessionId: string, body: Record<string, unknown>) => {
+		setImmediate(() => {
+			const requestId = claim(sessionId, body.text);
+			turn(daemon, sessionId, answer);
+			settle(sessionId, requestId, "completed");
+		});
+	};
+}
+
+async function startDaemon(host?: string): Promise<ScriptedDaemon> {
+	const root = fs.mkdtempSync(path.join(os.tmpdir(), "pi-subagents-web-contract-"));
+	roots.push(root);
+	const socketPath = path.join(root, "sessiond.sock");
+	const sessionFiles = new Map<string, string>();
+	const daemon: ScriptedDaemon = {
+		requests: [],
+		capabilities: [],
+		onOpen: () => {},
+		onPrompt: () => {},
+		promptDelayMs: 0,
+		endpoint: { kind: "socket", socketPath },
+		disconnect: (id) => { for (const socket of sockets.get(id) ?? []) socket.destroy(); },
+		emitError: (id, message) => {
+			const payload = Buffer.from(JSON.stringify({ type: "session.error", message }));
+			assert.ok(payload.length < 126);
+			for (const socket of sockets.get(id) ?? []) socket.write(Buffer.concat([Buffer.from([0x81, payload.length]), payload]));
+		},
+		streaming: new Map(),
+		terminated: new Map(),
+		aborts: [],
+		released: [],
+		socketPath,
+		root,
+		close: () => new Promise((resolve) => server.close(() => resolve())),
+	};
+	const sockets = new Map<string, Set<Socket>>();
+	const server = http.createServer((request, response) => {
+		const chunks: Buffer[] = [];
+		request.on("data", (chunk: Buffer) => chunks.push(chunk));
+		request.on("end", () => {
+			const text = Buffer.concat(chunks).toString("utf8");
+			const body = text ? JSON.parse(text) as Record<string, unknown> : undefined;
+			const url = request.url ?? "";
+			daemon.requests.push({ method: request.method ?? "", url, body });
+			const reply = (status: number, value: unknown) => {
+				response.statusCode = status;
+				response.setHeader("content-type", "application/json");
+				response.end(JSON.stringify(value));
+			};
+			if (url === "/health") return reply(200, { ok: true, version: { runtimeVersion: PI_WEB_SUPPORTED_RUNTIME_VERSIONS[0], piVersion: "0.85.1" } });
+			if (url === "/runtime") return reply(200, { capabilities: daemon.capabilities });
+			if (url === "/sessions" && request.method === "POST") {
+				sessionFiles.set(String(body?.sessionId), String(body?.sessionFile));
+				return reply(200, { id: body?.sessionId, path: body?.sessionFile });
+			}
+			const match = /^\/sessions\/([^/]+)\/([a-z]+)(\?.*)?$/.exec(url);
+			if (!match) return reply(404, { error: "Not found" });
+			const sessionId = decodeURIComponent(match[1]!);
+			const action = match[2]!;
+			if (action === "status") {
+				daemon.onStatus?.();
+				reply(200, { sessionId, isStreaming: daemon.streaming.get(sessionId) === true, isCompacting: false, pendingMessageCount: 0 });
+				const file = sessionFiles.get(sessionId) ?? fs.readdirSync(root).map((name) => path.join(root, name)).find((name) => name.endsWith(`_${sessionId}.jsonl`));
+				setImmediate(() => daemon.onOpen(sessionId, file));
+				return;
+			}
+			if (action === "prompt") {
+				setTimeout(() => {
+					reply(200, { accepted: true });
+					daemon.onPrompt(sessionId, body ?? {});
+				}, daemon.promptDelayMs);
+				return;
+			}
+			if (action === "abort") return reply(200, { aborted: true });
+			if (action === "stop") return reply(200, { stopped: true });
+			return reply(404, { error: "Not found" });
+		});
+	});
+	server.on("upgrade", (request, socket) => {
+		daemon.onObserve?.();
+		const id = decodeURIComponent(request.url!.split("/")[2]!);
+		const accept = createHash("sha1").update(`${request.headers["sec-websocket-key"]}258EAFA5-E914-47DA-95CA-C5AB0DC85B11`).digest("base64");
+		socket.write(`HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${accept}\r\n\r\n`);
+		const set = sockets.get(id) ?? new Set<Socket>();
+		sockets.set(id, set);
+		set.add(socket);
+		socket.on("data", () => socket.end());
+		socket.on("close", () => set.delete(socket));
+	});
+	await new Promise<void>((resolve) => {
+		if (host) server.listen(0, host, resolve);
+		else server.listen(socketPath, resolve);
+	});
+	if (host) daemon.endpoint = { kind: "tcp", host, port: (server.address() as { port: number }).port };
+	return daemon;
+}
+
+function parentFile(daemon: ScriptedDaemon): string {
+	const file = path.join(daemon.root, "2026-11-08T00-00-00-000Z_parent.jsonl");
+	if (!fs.existsSync(file)) fs.writeFileSync(file, `${JSON.stringify({ type: "session", version: 3, id: "parent", timestamp: "2026-11-08T00:00:00.000Z", cwd: daemon.root })}\n`);
+	return file;
+}
+
+function launch(daemon: ScriptedDaemon, overrides: Partial<ChildSessionLaunch> = {}): ChildSessionLaunch {
+	return {
+		cwd: daemon.root,
+		storage: { kind: "file", sessionFile: allocateWebChildSessionFile(daemon.root).sessionFile },
+		model: "faux/worker",
+		tools: ["read"],
+		extensionPaths: [],
+		ambientExtensions: false,
+		hooks: [],
+		noSkills: true,
+		noContextFiles: true,
+		systemPrompt: "<active_agent name=\"worker\"/>\n\nYou are the worker.",
+		runtime: { runId: "run-1", agent: "worker", childIndex: 0, sessionName: "worker: task", depth: 1, fanoutChild: false, fast: false, waitTool: { enabled: false, defaultTimeoutMs: 1000 } } as ChildSessionLaunch["runtime"],
+		...overrides,
+	};
+}
+
+function factoryFor(daemon: ScriptedDaemon) {
+	return createWebChildSessionFactory({
+		daemon: createPiWebDaemonForTest(daemon.root, daemon.endpoint),
+		parentSessionFile: parentFile(daemon),
+		parentSessionId: "parent",
+		parentCwd: daemon.root,
+		timeouts: { openMs: 1000, abortMs: 1000 },
+	});
+}
+
+/** Run `body` as if this process were the daemon serving `daemon`, as the parent's hosted commands see it. */
+async function asDaemonProcess(daemon: ScriptedDaemon, body: () => Promise<void>): Promise<void> {
+	const keys = ["PI_WEB_SESSION", "PI_WEB_DATA_DIR", "PI_WEB_SESSIOND_SOCKET", "PI_WEB_SESSIOND_PORT"] as const;
+	const savedEnv = keys.map((key) => [key, process.env[key]] as const);
+	const startTime = readProcessStartTime(process.pid);
+	fs.writeFileSync(path.join(daemon.root, "sessiond-owner.json"), JSON.stringify({ pid: process.pid, startedAt: "test", ...(startTime ? { processStartTime: startTime } : {}), endpoint: daemon.socketPath }));
+	process.env.PI_WEB_SESSION = "1";
+	process.env.PI_WEB_DATA_DIR = daemon.root;
+	delete process.env.PI_WEB_SESSIOND_SOCKET;
+	delete process.env.PI_WEB_SESSIOND_PORT;
+	resetPiWebDaemonDetection();
+	try {
+		await body();
+	} finally {
+		for (const [key, value] of savedEnv) {
+			if (value === undefined) delete process.env[key];
+			else process.env[key] = value;
+		}
+		resetPiWebDaemonDetection();
+	}
+}
+
+let openDaemons: ScriptedDaemon[] = [];
+afterEach(async () => {
+	await Promise.all(openDaemons.map((daemon) => daemon.close()));
+	openDaemons = [];
+});
+async function daemonForTest(host?: string): Promise<ScriptedDaemon> {
+	const daemon = await startDaemon(host);
+	openDaemons.push(daemon);
+	return daemon;
+}
+
