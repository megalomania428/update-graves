+	for (const operation of ["writeFileSync", "fsyncSync", "renameSync"] as const) {
+		it(`cleans temporary ledgers on ${operation} failure`, () => {
+			const sessionId = allocateWebChildSessionFile(tempDir()).sessionId;
+			const ledger = {
+				schemaVersion: 1 as const, sessionId, sessionFile: "/s.jsonl", cwd: "/work",
+				parentSessionFile: "/p.jsonl", runId: "r", agent: "worker", digest: "d",
+				state: "running" as const, updatedAt: "now",
+			};
+			writeWebChildLedger(ledger);
+			for (const code of ["ENOSPC", "EIO", "EACCES"]) {
+				const original = fsDefault[operation];
+				const failure = Object.assign(new Error(`${operation}: ${code}`), { code });
+				try {
+					Object.assign(fsDefault, { [operation]: () => { throw failure; } });
+					syncBuiltinESMExports();
+					assert.throws(() => writeWebChildLedger(ledger), (error) => error === failure);
+					assert.deepEqual(fs.readdirSync(webChildLedgerDir()).filter((name) =>
+						name.startsWith(sessionId) && name.endsWith(".tmp")), []);
