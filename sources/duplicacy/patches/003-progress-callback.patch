+			check: func(t *testing.T, run *progressRun) {
+				if run.fixture.storage.injectedCount() == 0 || run.fixture.revisionExists(1) {
+					t.Fatalf("The upload of the snapshot file has not failed")
+				}
+				expectNoEnd(t, run.recorder.take(), ProgressOperationBackup)
+				waitForWorkerErrorsGoroutines(t, run.baseline)
+			},
+		},
+		{
+			name: "NilHook", args: hash, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				setProgressFunction(t, nil)
+				return &progressRun{fixture: newWorkerErrorsFixture(t, false)}
+			},
+			check: func(t *testing.T, run *progressRun) {
+				if !run.fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has not been uploaded")
+				}
+			},
+		},
+		{
+			// A panic of the hook on the start is raised before the files are packed
+			name: "HookPanicStart", args: hash, want: false, wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := &progressRun{fixture: newWorkerErrorsFixture(t, false)}
+				panicOnProgress(t, func(event ProgressEvent) bool {
+					return event.Kind == ProgressKindStart
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				fixture := run.fixture
+				if fixture.storage.uploadCount() != 0 || fixture.revisionExists(1) {
+					t.Fatalf("The backup has uploaded %d files after the start",
+						fixture.storage.uploadCount())
+				}
+				waitForWorkerErrorsGoroutines(t, run.baseline)
+			},
+		},
+		{
+			// A panic of the hook on the step of an uploaded chunk, in a worker
+			name: "HookPanicUploadStep", args: hash, want: false,
+			wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := &progressRun{fixture: newWorkerErrorsFixture(t, false)}
+				panicOnProgress(t, func(event ProgressEvent) bool {
+					return event.Kind == ProgressKindStep && event.UploadedBytes > 0
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				if run.fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has been uploaded despite the panic")
+				}
+				waitForWorkerErrorsGoroutines(t, run.baseline)
+			},
+		},
+		{
+			// A panic of the hook on the step of a chunk found in the chunk cache, in the
+			// goroutine that runs the backup
+			name: "HookPanicCacheStep", args: hash, want: false,
+			wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := &progressRun{fixture: newProgressCacheFixture(t)}
+				run.recorder = recordProgress(t)
+				record := ProgressFunction
+				setProgressFunction(t, func(event ProgressEvent) {
+					record(event)
