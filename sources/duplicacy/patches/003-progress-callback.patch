+// chunkDirectoryFiles returns the files under all chunk directories of the storage.
+func chunkDirectoryFiles(t *testing.T, storage *FileStorage) []string {
+	t.Helper()
+	return workerErrorsStorageFiles(t, storage, storage.GetChunkDirectories()...)
+}
+
+// vanishedFiles returns the files of before that are not in after.
+func vanishedFiles(before []string, after []string) []string {
+	present := map[string]bool{}
+	for _, file := range after {
+		present[file] = true
+	}
+	var vanished []string
+	for _, file := range before {
+		if !present[file] {
+			vanished = append(vanished, file)
+		}
+	}
+	return vanished
+}
+
+// discardStdout runs the operation with the standard output replaced by the null device.
+func discardStdout(t *testing.T, operation func()) {
+	t.Helper()
+	devNull, err := os.OpenFile(os.DevNull, os.O_WRONLY, 0)
+	if err != nil {
+		t.Fatalf("Failed to open the null device: %v", err)
+	}
+	saved := os.Stdout
+	os.Stdout = devNull
+	defer func() {
+		os.Stdout = saved
+		devNull.Close()
+	}()
+	operation()
+}
