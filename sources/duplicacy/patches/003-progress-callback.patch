+// hasEnd reports whether the recorder has received an end.
+func (recorder *progressRecorder) hasEnd() bool {
+	recorder.lock.Lock()
+	defer recorder.lock.Unlock()
+	for _, event := range recorder.events {
+		if event.Kind == ProgressKindEnd {
+			return true
+		}
+	}
+	return false
+}
+
+// summarizePruneProgress checks that the events are those of one prune, the start first
+// and the end last, and that each of them has only the fields of its kind.
+func summarizePruneProgress(t *testing.T, events []ProgressEvent) progressSummary {
+	t.Helper()
+	if len(events) < 2 {
+		t.Fatalf("Expected the start and the end, got %+v", events)
+	}
+	summary := progressSummary{start: events[0], end: events[len(events)-1]}
+	start := ProgressEvent{Operation: ProgressOperationPrune, Kind: ProgressKindStart,
+		TotalBytes: -1, TotalChunks: -1}
+	if summary.start != start {
+		t.Fatalf("The first event is not a prune start: %+v", summary.start)
+	}
+	end := ProgressEvent{Operation: ProgressOperationPrune, Kind: ProgressKindEnd,
+		TotalBytes: -1, TotalChunks: -1, Failed: summary.end.Failed}
+	if summary.end != end {
+		t.Fatalf("The last event is not a prune end: %+v", summary.end)
+	}
+	for i, event := range events[1 : len(events)-1] {
+		action := event.Action == ProgressActionDelete ||
+			event.Action == ProgressActionFossilize ||
+			event.Action == ProgressActionResurrect
+		if event.Operation != ProgressOperationPrune || event.Kind != ProgressKindStep ||
+			!action || event.TotalBytes != 0 || event.TotalChunks != 0 ||
+			event.Bytes != 0 || event.UploadedBytes != 0 || event.Failed != 0 {
+			t.Fatalf("The event %d is not a prune step: %+v", i+1, event)
+		}
+		summary.steps = append(summary.steps, event)
+	}
+	return summary
+}
+
+// countSteps returns the number of the steps of the action whose Skipped is skipped.
+func (summary progressSummary) countSteps(action ProgressAction, skipped bool) int {
+	count := 0
+	for _, step := range summary.steps {
+		if step.Action == action && step.Skipped == skipped {
+			count++
+		}
+	}
+	return count
+}
+
+// findStep returns the step of the action for the chunk id.
+func (summary progressSummary) findStep(action ProgressAction,
+	chunkID string) (ProgressEvent, bool) {
+	for _, step := range summary.steps {
+		if step.Action == action && step.ChunkID == chunkID {
+			return step, true
+		}
+	}
+	return ProgressEvent{}, false
+}
+
+// expectActions checks that the steps have only the given actions.
+func (summary progressSummary) expectActions(t *testing.T, actions ...ProgressAction) {
+	t.Helper()
+	for _, step := range summary.steps {
+		found := false
+		for _, action := range actions {
+			found = found || step.Action == action
+		}
+		if !found {
+			t.Fatalf("Unexpected step %+v, expected only %v", step, actions)
+		}
+	}
+}
