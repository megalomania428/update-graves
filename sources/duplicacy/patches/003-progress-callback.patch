+// newProgressCacheFixture creates a repository with two files of the same content of one
+// chunk, so that the chunk of the second file is found in the chunk cache by the
+// goroutine that runs the backup.
+func newProgressCacheFixture(t *testing.T) *workerErrorsFixture {
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	repository := filepath.Join(dir, "repository")
+	if err := os.MkdirAll(filepath.Join(repository, ".duplicacy"), 0700); err != nil {
+		t.Fatalf("Failed to create the repository: %v", err)
+	}
+	const chunkSize = 64 * 1024
+	content := make([]byte, chunkSize)
+	rand.New(rand.NewSource(1)).Read(content)
+	for _, file := range []string{"file1", "file2"} {
+		if err := os.WriteFile(filepath.Join(repository, file), content, 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", file, err)
+		}
+	}
+	raw, err := CreateFileStorage(filepath.Join(dir, "storage"), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	// An average size of 2^30 keeps the rolling hash from cutting the chunks, so they are
+	// cut at the maximum size
+	if !ConfigStorage(raw, 16384, 100, 1<<30, chunkSize, chunkSize/4, "", nil, false, "", 0,
+		0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	fixture := &workerErrorsFixture{t: t, repository: repository, raw: raw,
+		storage: newFaultStorage(raw)}
+	SetDuplicacyPreferencePath(filepath.Join(repository, ".duplicacy"))
+	fixture.manager = CreateBackupManager("host1", fixture.storage, repository, "", "", "",
+		false)
+	if fixture.manager == nil || !fixture.manager.SetupSnapshotCache("default") {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	return fixture
+}
