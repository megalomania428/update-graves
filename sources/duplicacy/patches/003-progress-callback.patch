+	vm1 := args{selfID: "vm1@host1", snapshotID: "vm1@host1", threads: 2}
+	// The prune that fossilizes the chunks of the revision 1
+	keep := vm1
+	keep.retentions = workerErrorsKeep
+	exclusive := vm1
+	exclusive.revisionsToBeDeleted = []int{1}
+	exclusive.exclusive = true
+	dryRun := vm1
+	dryRun.revisionsToBeDeleted = []int{1}
+	dryRun.dryRun = true
+	deleteOnly := vm1
+	deleteOnly.deleteOnly = true
+	collectOnly := vm1
+	collectOnly.collectOnly = true
+	exhaustiveExclusive := vm1
+	exhaustiveExclusive.exhaustive = true
+	exhaustiveExclusive.exclusive = true
+	separate := args{selfID: "host1", snapshotID: "host1", revisionsToBeDeleted: []int{1},
+		exclusive: true, threads: 2}
+	chunkID := func(run *progressRun, index int) string {
+		return run.pruneFixture.manager.config.GetChunkIDFromHash(
+			run.pruneFixture.chunks[index])
+	}
+	prepareExclusive := func(t *testing.T) *progressRun {
+		run := prepareProgressPrune(t)
+		run.storageFiles = chunkDirectoryFiles(t, run.pruneFixture.raw)
+		return run
+	}
+	// expectKeep checks the events of a prune that fossilizes the chunk 1 and the chunk
+	// sequence of the revision 1: skipped tells that the fossil of the chunk 1 existed
+	expectKeep := func(skipped bool) func(t *testing.T, run *progressRun) {
+		return func(t *testing.T, run *progressRun) {
+			summary := summarizePruneProgress(t, run.recorder.take())
+			summary.expectActions(t, ProgressActionFossilize)
