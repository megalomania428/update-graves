@@ -0,0 +1,80 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+// ProgressOperation is the operation that reports a progress event.
+type ProgressOperation string
+
+const (
+	ProgressOperationBackup  ProgressOperation = "backup"
+	ProgressOperationCopy    ProgressOperation = "copy"
+	ProgressOperationRestore ProgressOperation = "restore"
+	ProgressOperationCheck   ProgressOperation = "check"
+	ProgressOperationPrune   ProgressOperation = "prune"
+)
+
+// ProgressKind tells whether a progress event starts an operation, reports one of its
+// steps or ends it.
+type ProgressKind string
+
+const (
+	ProgressKindStart ProgressKind = "start"
+	ProgressKindStep  ProgressKind = "step"
+	ProgressKindEnd   ProgressKind = "end"
+)
+
+// ProgressAction is what a step of a prune does to its chunk; steps of other operations
+// have no action.
+type ProgressAction string
+
+const (
+	ProgressActionDelete    ProgressAction = "delete"
+	ProgressActionFossilize ProgressAction = "fossilize"
+	ProgressActionResurrect ProgressAction = "resurrect"
+)
+
+// ProgressEvent is an event passed to ProgressFunction.  A step reports one chunk; the
+// consumer sums the steps itself.  The steps of a backup report its file chunks only,
+// while its metadata chunks are counted in the totals of the end; the steps of a copy
+// report the chunks that it copies: those it doesn't count as stored at the destination.
+type ProgressEvent struct {
+	Operation ProgressOperation
+	Kind      ProgressKind
+	Action    ProgressAction // The action of a prune step; empty otherwise
+	// The totals known at the start, or -1 if unknown.  TotalBytes of a backup start is
+	// the size of the modified files to be split into chunks, as listed; the steps don't
+	// add up to it if a file changes before its chunks are made, and a file that can't be
+	// opened has no steps.  At the end of a backup the totals are the number and the
+	// length of the new file and metadata chunks; at the end of a copy, the number of
+	// copied chunks and their length.
+	TotalBytes  int64
+	TotalChunks int64
+	// The length of the chunk of a step before compression and encryption
+	Bytes int64
+	// The bytes of a step written to the storage, 0 if skipped; at the end, those of the
+	// chunks of the totals.  A dry run reports the bytes that it would write.
+	UploadedBytes int64
+	Skipped       bool   // The chunk of a step is already in the cache or in the storage
+	Metadata      bool   // The chunk of a step is a metadata chunk
+	ChunkID       string // The id of the chunk of a step; empty for the start and the end
+	// At the end, the number of failures in the final log message of the operation: for
+	// a backup, the skipped files and directories of BACKUP_SKIPPED, other failures not
+	// included
+	Failed int64
+}
+
+// ProgressFunction, unless nil, receives the progress events of backup and copy.  It is
+// called regardless of showStatistics, RunInBackground and the logging level, and may be
+// called concurrently by the worker goroutines and the goroutine that runs the
+// operation.  Set it before an operation and don't change it while the operation runs.
+// It must return without waiting for the operation, which waits for its worker
+// goroutines to finish their calls.  An operation that ends with an error, by a panic or
+// by returning false, doesn't report its end, so a start without an end means a failure;
+// an error before the start, such as an empty repository of a backup, reports no events
+// at all, and so does a copy with no revisions to copy.  A panic of ProgressFunction is
+// raised by the operation in the goroutine that called it, like any other panic of the
+// operation; the worker goroutines may still call ProgressFunction after the panic until
+// the operation returns, but not after that.
+var ProgressFunction func(event ProgressEvent)
diff -ruN -x .git a/src/duplicacy_progress_test.go b/src/duplicacy_progress_test.go
--- a/src/duplicacy_progress_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_progress_test.go	2026-11-09 17:42:18.832666421 +0000
@@ -0,0 +1,1265 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"math/rand"
+	"os"
+	"path/filepath"
+	"runtime"
+	"sort"
+	"sync"
+	"testing"
+)
+
+// progressHookPanic is the value that the panicking hooks of the tests panic with.
+const progressHookPanic = "progress hook panic"
+
+// setProgressFunction installs the hook for the test and restores the previous one
+// after it.
+func setProgressFunction(t *testing.T, hook func(event ProgressEvent)) {
+	saved := ProgressFunction
+	t.Cleanup(func() { ProgressFunction = saved })
+	ProgressFunction = hook
+}
+
+// progressRecorder collects the events passed to the hook, which may be called
+// concurrently.
+type progressRecorder struct {
+	lock   sync.Mutex
+	events []ProgressEvent
+}
+
+func recordProgress(t *testing.T) *progressRecorder {
+	recorder := &progressRecorder{}
+	setProgressFunction(t, func(event ProgressEvent) {
+		recorder.lock.Lock()
+		defer recorder.lock.Unlock()
+		recorder.events = append(recorder.events, event)
+	})
+	return recorder
+}
+
+// take returns the events collected so far and forgets them.
+func (recorder *progressRecorder) take() []ProgressEvent {
+	recorder.lock.Lock()
+	defer recorder.lock.Unlock()
+	events := recorder.events
+	recorder.events = nil
+	return events
+}
+
+// progressSummary is the start, the steps and the end of one operation.
+type progressSummary struct {
+	start ProgressEvent
+	steps []ProgressEvent
+	end   ProgressEvent
+	bytes int64 // The sum of Bytes of the steps
+}
+
+// summarizeProgress checks that the events are those of one operation, the start first
+// and the end last, and that each of them has only the fields of its kind.
+func summarizeProgress(t *testing.T, events []ProgressEvent,
+	operation ProgressOperation) progressSummary {
+	t.Helper()
+	if len(events) < 2 {
+		t.Fatalf("Expected the start and the end, got %+v", events)
+	}
+	summary := progressSummary{start: events[0], end: events[len(events)-1]}
+	start := ProgressEvent{Operation: operation, Kind: ProgressKindStart,
+		TotalBytes: summary.start.TotalBytes, TotalChunks: summary.start.TotalChunks}
+	if summary.start != start {
+		t.Fatalf("The first event is not a %s start: %+v", operation, summary.start)
+	}
+	end := ProgressEvent{Operation: operation, Kind: ProgressKindEnd,
+		TotalBytes: summary.end.TotalBytes, TotalChunks: summary.end.TotalChunks,
+		UploadedBytes: summary.end.UploadedBytes, Failed: summary.end.Failed}
+	if summary.end != end {
+		t.Fatalf("The last event is not a %s end: %+v", operation, summary.end)
+	}
+	for i, event := range events[1 : len(events)-1] {
+		if event.Operation != operation || event.Kind != ProgressKindStep ||
+			event.Action != "" || event.TotalBytes != 0 || event.TotalChunks != 0 ||
+			event.Failed != 0 || event.ChunkID == "" {
+			t.Fatalf("The event %d is not a %s step: %+v", i+1, operation, event)
+		}
+		summary.steps = append(summary.steps, event)
+		summary.bytes += event.Bytes
+	}
+	return summary
+}
+
+// storedChunkSize returns the size of the chunk file in the storage.
+func storedChunkSize(t *testing.T, storage *FileStorage, chunkID string,
+	isMetadata bool) int64 {
+	t.Helper()
+	chunkPath, exist, _, err := storage.FindChunk(0, chunkID, false, isMetadata)
+	if err != nil || !exist {
+		t.Fatalf("Failed to find the chunk %s: %v (exist %t)", chunkID, err, exist)
+	}
+	info, err := os.Stat(filepath.Join(storage.storageDir, chunkPath))
+	if err != nil {
+		t.Fatalf("Failed to stat the chunk %s: %v", chunkID, err)
+	}
+	return info.Size()
+}
+
+// storedChunks returns the number and the total size of the chunk files in the storage.
+func storedChunks(t *testing.T, storage *FileStorage) (count int64, size int64) {
+	t.Helper()
+	walk := func(path string, info os.FileInfo, err error) error {
+		if err == nil && info.Mode().IsRegular() {
+			count++
+			size += info.Size()
+		}
+		return err
+	}
+	if err := filepath.Walk(filepath.Join(storage.storageDir, "chunks"), walk); err != nil {
+		t.Fatalf("Failed to list the chunks: %v", err)
+	}
+	return count, size
+}
+
+// repositorySize returns the total size of the files of the repository.
+func repositorySize(t *testing.T, repository string, files ...string) int64 {
+	t.Helper()
+	size := int64(0)
+	for _, file := range files {
+		info, err := os.Stat(filepath.Join(repository, file))
+		if err != nil {
+			t.Fatalf("Failed to stat %s: %v", file, err)
+		}
+		size += info.Size()
+	}
+	return size
+}
+
+// newMetadataChunks returns the number and the total length of the distinct metadata
+// chunks of the revision that no earlier revision has, downloaded through a temporary
+// operator.
+func (fixture *workerErrorsFixture) newMetadataChunks(snapshot *Snapshot,
+	earlier ...*Snapshot) (int64, int64) {
+	fixture.t.Helper()
+	manager := fixture.manager.SnapshotManager
+	defer fixture.stopSnapshotOperator()
+	seen := map[string]bool{}
+	for _, previous := range earlier {
+		for _, sequence := range [][]string{previous.FileSequence, previous.ChunkSequence,
+			previous.LengthSequence, previous.ChunkHashes} {
+			for _, chunkHash := range sequence {
+				seen[chunkHash] = true
+			}
+		}
+	}
+	count, length := int64(0), int64(0)
+	for _, sequence := range [][]string{snapshot.FileSequence, snapshot.ChunkSequence,
+		snapshot.LengthSequence} {
+		for _, chunkHash := range sequence {
+			if !seen[chunkHash] {
+				seen[chunkHash] = true
+				count++
+				length += int64(len(manager.DownloadSequence([]string{chunkHash})))
+			}
+		}
+	}
+	return count, length
+}
+
+// expectChunkSteps checks that the steps are of distinct chunks of the copied revision,
+// that a step is of a metadata chunk exactly if its chunk is one and that each chunk of
+// the revision has a step.
+func (fixture *workerErrorsCopyFixture) expectChunkSteps(t *testing.T,
+	steps []ProgressEvent) {
+	t.Helper()
+	metadataChunks := map[string]bool{}
+	for _, sequence := range [][]string{fixture.snapshot.FileSequence,
+		fixture.snapshot.ChunkSequence, fixture.snapshot.LengthSequence} {
+		for _, chunkHash := range sequence {
+			metadataChunks[fixture.destination.config.GetChunkIDFromHash(chunkHash)] = true
+		}
+	}
+	for _, chunkHash := range fixture.snapshot.ChunkHashes {
+		chunkID := fixture.destination.config.GetChunkIDFromHash(chunkHash)
+		if _, found := metadataChunks[chunkID]; !found {
+			metadataChunks[chunkID] = false
+		}
+	}
+	seen := map[string]bool{}
+	for _, step := range steps {
+		isMetadata, found := metadataChunks[step.ChunkID]
+		if !found || seen[step.ChunkID] || step.Metadata != isMetadata {
+			t.Fatalf("Unexpected step %+v", step)
+		}
+		seen[step.ChunkID] = true
+	}
+	for chunkID := range metadataChunks {
+		if !seen[chunkID] {
+			t.Fatalf("No step of the chunk %s", chunkID)
+		}
+	}
+}
+
+// newProgressBackupManager creates an empty storage named name for the repository and a
+// backup manager for it.
+func newProgressBackupManager(t *testing.T, repository string,
+	name string) (*FileStorage, *BackupManager) {
+	t.Helper()
+	storage, err := CreateFileStorage(filepath.Join(t.TempDir(), name), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	if !ConfigStorage(storage, 16384, 100, 64*1024, 256*1024, 16*1024, "", nil, false, "",
+		0, 0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	manager := CreateBackupManager("host1", storage, repository, "", "", "", false)
+	if manager == nil || !manager.SetupSnapshotCache(name) {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	return storage, manager
+}
+
+// progressRun is the state of one case of the table tests: the fixture, the manager
+// whose fields the case uses and the values that the preparation passes to the check.
+type progressRun struct {
+	fixture     *workerErrorsFixture
+	copyFixture *workerErrorsCopyFixture
+	manager     *BackupManager
+	recorder    *progressRecorder
+	baseline    int             // The number of goroutines before the preparation
+	earlier     progressSummary // The events of an operation run by the preparation
+	storedCount int64           // The number of chunks in the storage before the call
+	storedSize  int64           // The size of the chunks in the storage before the call
+	flag        bool            // Set by the hook of the case
+	revision    int             // The revision that the backup of the case uploads
+}
+
+// prepareProgressBackup creates the backup fixture, runs a backup for each of earlier,
+// which is its quick mode, and then records the events.
+func prepareProgressBackup(t *testing.T, earlier ...bool) *progressRun {
+	run := &progressRun{fixture: newWorkerErrorsFixture(t, false), revision: 1}
+	for _, quickMode := range earlier {
+		run.fixture.expectSuccess(run.fixture.backup(run.fixture.repository, quickMode),
+			run.revision)
+		run.revision++
+	}
+	run.storedCount, run.storedSize = storedChunks(t, run.fixture.raw)
+	run.recorder = recordProgress(t)
+	return run
+}
+
+// prepareProgressCopy creates the copy fixture, whose revision 1 is backed up, copies it
+// if firstCopy is set and then records the events.
+func prepareProgressCopy(t *testing.T, firstCopy bool) *progressRun {
+	fixture := newWorkerErrorsCopyFixture(t)
+	if firstCopy {
+		fixture.expectCopied(fixture.copy())
+	}
+	return &progressRun{fixture: fixture.workerErrorsFixture, copyFixture: fixture,
+		recorder: recordProgress(t)}
+}
+
+// expectNoEnd checks that the events are the start and the steps of the operation.
+func expectNoEnd(t *testing.T, events []ProgressEvent, operation ProgressOperation) {
+	t.Helper()
+	if len(events) < 2 || events[0].Kind != ProgressKindStart ||
+		events[0].Operation != operation {
+		t.Fatalf("Expected the start of a %s first, got %+v", operation, events)
+	}
+	for i, event := range events[1:] {
+		if event.Kind != ProgressKindStep || event.Operation != operation {
+			t.Fatalf("The event %d is not a %s step: %+v", i+1, operation, event)
+		}
+	}
+}
+
+// expectNoEvents checks that the hook has not been called.
+func (run *progressRun) expectNoEvents(t *testing.T) {
+	t.Helper()
+	if events := run.recorder.take(); len(events) != 0 {
+		t.Fatalf("Unexpected events %+v", events)
+	}
+}
+
+// expectNewMetadataEnd checks the end of the revision of the case, where only metadata
+// chunks may be new, against the chunks that the earlier revisions don't have and the
+// chunks added to the storage.
+func (run *progressRun) expectNewMetadataEnd(t *testing.T, summary progressSummary) {
+	t.Helper()
+	fixture := run.fixture
+	var earlier []*Snapshot
+	for revision := 1; revision < run.revision; revision++ {
+		earlier = append(earlier, fixture.revisionSnapshot(revision))
+	}
+	count, length := fixture.newMetadataChunks(fixture.revisionSnapshot(run.revision),
+		earlier...)
+	newCount, newSize := storedChunks(t, fixture.raw)
+	if summary.end.TotalChunks != count || summary.end.TotalBytes != length ||
+		summary.end.UploadedBytes != newSize-run.storedSize || summary.end.Failed != 0 ||
+		newCount-run.storedCount != count {
+		t.Fatalf("The end is %+v instead of %d chunks, %d bytes and %d bytes stored",
+			summary.end, count, length, newSize-run.storedSize)
+	}
+}
+
+// skipWithoutPermissions skips the test where chmod doesn't take the permissions away.
+func skipWithoutPermissions(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("chmod doesn't remove the read permission on Windows")
+	}
+	if os.Geteuid() == 0 {
+		t.Skip("root can read a file or list a directory without permissions")
+	}
+}
+
+// panicOnProgress installs a hook that panics on the events for which panics returns
+// true.
+func panicOnProgress(t *testing.T, panics func(event ProgressEvent) bool) {
+	setProgressFunction(t, func(event ProgressEvent) {
+		if panics(event) {
+			panic(progressHookPanic)
+		}
+	})
+}
+
+// newProgressCacheFixture creates a repository with two files of the same content of one
+// chunk, so that the chunk of the second file is found in the chunk cache by the
+// goroutine that runs the backup.
+func newProgressCacheFixture(t *testing.T) *workerErrorsFixture {
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	repository := filepath.Join(dir, "repository")
+	if err := os.MkdirAll(filepath.Join(repository, ".duplicacy"), 0700); err != nil {
+		t.Fatalf("Failed to create the repository: %v", err)
+	}
+	const chunkSize = 64 * 1024
+	content := make([]byte, chunkSize)
+	rand.New(rand.NewSource(1)).Read(content)
+	for _, file := range []string{"file1", "file2"} {
+		if err := os.WriteFile(filepath.Join(repository, file), content, 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", file, err)
+		}
+	}
+	raw, err := CreateFileStorage(filepath.Join(dir, "storage"), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	// An average size of 2^30 keeps the rolling hash from cutting the chunks, so they are
+	// cut at the maximum size
+	if !ConfigStorage(raw, 16384, 100, 1<<30, chunkSize, chunkSize/4, "", nil, false, "", 0,
+		0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	fixture := &workerErrorsFixture{t: t, repository: repository, raw: raw,
+		storage: newFaultStorage(raw)}
+	SetDuplicacyPreferencePath(filepath.Join(repository, ".duplicacy"))
+	fixture.manager = CreateBackupManager("host1", fixture.storage, repository, "", "", "",
+		false)
