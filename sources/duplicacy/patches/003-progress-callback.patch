+				if len(steps) != 2 || steps[0].Skipped == steps[1].Skipped ||
+					steps[0].ChunkID != steps[1].ChunkID || run.fixture.revisionExists(1) {
+					t.Fatalf("Unexpected steps %+v", steps)
