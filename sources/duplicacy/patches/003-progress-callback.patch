+			outcome := runWorkerErrorsOperation(t, func() bool {
+				return manager.PruneSnapshots(tt.args.selfID, tt.args.snapshotID,
+					tt.args.revisionsToBeDeleted, tt.args.tags, tt.args.retentions,
+					tt.args.exhaustive, tt.args.exclusive, tt.args.ignoredIDs,
+					tt.args.dryRun, tt.args.deleteOnly, tt.args.collectOnly,
