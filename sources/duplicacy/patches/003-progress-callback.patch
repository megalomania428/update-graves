+// prepareProgressPrune creates the prune fixture, whose revisions 1 and 2 of vm1@host1
+// share the chunk 2, and records the events.
+func prepareProgressPrune(t *testing.T) *progressRun {
+	fixture := newWorkerErrorsPruneFixture(t)
+	return &progressRun{pruneFixture: fixture, recorder: recordProgress(t),
+		chunkPath: fixture.chunkPath(fixture.chunks[0])}
+}
+
+// prepareProgressOldCollection creates the prune fixture, saves a fossil collection by a
+// prune that keeps only the revision 2 and then adds the revision 4, which references the
+// chunk 1 of the fossil collection again; with temporary the prune is exhaustive, so that
+// a temporary file of the storage goes to the collection too.  It records the events.
+func prepareProgressOldCollection(t *testing.T, temporary bool) *progressRun {
+	run := prepareProgressPrune(t)
+	run.recorder.take()
+	fixture := run.pruneFixture
+	if temporary {
+		run.temporary = filepath.ToSlash(filepath.Join(filepath.Dir(run.chunkPath),
+			"leftover.tmp"))
+		err := os.WriteFile(filepath.Join(fixture.raw.storageDir, run.temporary),
+			[]byte("temporary"), 0600)
+		if err != nil {
+			t.Fatalf("Failed to create the temporary file: %v", err)
+		}
+	}
+	fixture.expectSuccess(runWorkerErrorsOperation(t, func() bool {
+		return fixture.manager.PruneSnapshots("vm1@host1", "vm1@host1", nil, nil,
+			workerErrorsKeep, temporary, false, nil, false, false, false, 2)
+	}))
+	if !fixture.collectionSaved() {
+		t.Fatalf("No fossil collection has been saved")
+	}
+	fixture.createRevision(4, 1, uploadRandomChunk(fixture.manager, 1024),
+		fixture.chunks[0])
+	run.recorder.take()
+	return run
+}
+
+// delayDeletes makes the first delete under chunks/ of the run wait for its end.
+func (run *progressRun) delayDeletes() {
+	fixture := run.pruneFixture
+	run.delay = newProgressDelayStorage(fixture.storage, fixture.raw, chunkDir,
+		run.recorder.hasEnd)
+	fixture.manager.storage = run.delay
+}
+
+// expectEndAfterTasks checks that the end of the events is the last of them and has no
+// failures, and that the end has not been reported while the delayed delete was waiting.
+func (run *progressRun) expectEndAfterTasks(t *testing.T) progressSummary {
+	t.Helper()
+	summary := summarizePruneProgress(t, run.recorder.take())
+	if summary.end.Failed != 0 || !run.delay.timedOut.Load() {
+		t.Fatalf("The end %+v, the delayed delete has waited out the end: %t",
+			summary.end, run.delay.timedOut.Load())
+	}
+	return summary
+}
