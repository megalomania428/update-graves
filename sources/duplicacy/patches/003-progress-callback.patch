+				}
+				count, stored := storedChunks(t, run.fixture.raw)
+				if summary.end.TotalChunks != count-run.storedCount ||
+					summary.end.UploadedBytes != stored-run.storedSize ||
+					summary.end.Failed != 0 {
+					t.Fatalf("The end is %+v instead of %d chunks and %d bytes stored",
