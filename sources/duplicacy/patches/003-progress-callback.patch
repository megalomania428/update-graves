+		},
+		{
+			// A panic of the hook on the end leaves the uploaded revision and no
+			// incomplete snapshot behind
+			name: "HookPanicEnd", args: inFile, want: false, wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := &progressRun{fixture: newWorkerErrorsFixture(t, false)}
+				incompleteFiles := filepath.Join(run.fixture.manager.cachePath,
+					"incomplete_files")
+				setProgressFunction(t, func(event ProgressEvent) {
+					switch event.Kind {
+					case ProgressKindStart:
+						_, err := os.Stat(incompleteFiles)
+						run.flag = err == nil
+					case ProgressKindEnd:
+						panic(progressHookPanic)
+					}
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				fixture := run.fixture
+				if !run.flag {
+					t.Fatalf("The backup has not kept its entries in incomplete_files")
+				}
+				// The command line calls RunAtError on a panic, as CatchLogException does
+				RunAtError()
+				for _, file := range []string{"incomplete_snapshot", "incomplete_chunks",
+					"incomplete_files"} {
+					_, err := os.Stat(filepath.Join(fixture.manager.cachePath, file))
+					if !os.IsNotExist(err) {
+						t.Fatalf("The backup has left %s behind: %v", file, err)
+					}
+				}
+				if !fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has not been uploaded before the end")
+				}
+				waitForWorkerErrorsGoroutines(t, run.baseline)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			if run.manager == nil {
+				run.manager = run.fixture.manager
+			}
+			tt.fields = fields{
+				snapshotID:         run.manager.snapshotID,
+				storage:            run.manager.storage,
+				SnapshotManager:    run.manager.SnapshotManager,
+				snapshotCache:      run.manager.snapshotCache,
+				config:             run.manager.config,
+				nobackupFile:       run.manager.nobackupFile,
+				filtersFile:        run.manager.filtersFile,
+				excludeByAttribute: run.manager.excludeByAttribute,
+				cachePath:          run.manager.cachePath,
+			}
+			tt.args.top = run.fixture.repository
+			manager := &BackupManager{
+				snapshotID:         tt.fields.snapshotID,
+				storage:            tt.fields.storage,
+				SnapshotManager:    tt.fields.SnapshotManager,
+				snapshotCache:      tt.fields.snapshotCache,
+				config:             tt.fields.config,
+				nobackupFile:       tt.fields.nobackupFile,
+				filtersFile:        tt.fields.filtersFile,
+				excludeByAttribute: tt.fields.excludeByAttribute,
+				cachePath:          tt.fields.cachePath,
+			}
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				return manager.Backup(tt.args.top, tt.args.quickMode, tt.args.threads,
+					tt.args.tag, tt.args.showStatistics, tt.args.shadowCopy,
+					tt.args.shadowCopyTimeout, tt.args.enumOnly, tt.args.metadataChunkSize,
+					tt.args.maximumInMemoryEntries)
+			})
+			if outcome.recovered != tt.wantPanic {
+				t.Fatalf("BackupManager.Backup() panicked with %#v, want %#v",
+					outcome.recovered, tt.wantPanic)
+			}
+			if got := outcome.result; got != tt.want {
+				t.Errorf("BackupManager.Backup() = %v, want %v", got, tt.want)
+			}
+			tt.check(t, run)
+		})
+	}
+}
