+			if summary.end.Failed != 0 || len(summary.steps) != 2 || fossils != 2 {
+				t.Fatalf("The end %+v, %d steps and %d fossils", summary.end,
+					len(summary.steps), fossils)
+			}
+			step, found := summary.findStep(ProgressActionFossilize, chunkID(run, 0))
+			if !found || step.Skipped != skipped || step.Metadata {
+				t.Fatalf("Unexpected step %+v (found %t) of the chunk 1", step, found)
+			}
+		}
+	}
+	// expectDeletes checks the events of an exclusive prune of the revision 1 of the
+	// fixture, whose delete steps are the files that have disappeared
+	expectDeletes := func(t *testing.T, run *progressRun) {
+		summary := summarizePruneProgress(t, run.recorder.take())
+		summary.expectActions(t, ProgressActionDelete)
+		vanished := vanishedFiles(run.storageFiles, chunkDirectoryFiles(t,
+			run.pruneFixture.raw))
+		if summary.end.Failed != 0 || len(vanished) == 0 ||
+			summary.countSteps(ProgressActionDelete, false) != len(vanished) ||
+			len(summary.steps) != len(vanished) {
+			t.Fatalf("The end %+v and %d steps for the files %v", summary.end,
+				len(summary.steps), vanished)
+		}
+	}
+	panicAt := func(kind ProgressKind) func(t *testing.T) *progressRun {
+		return func(t *testing.T) *progressRun {
+			run := prepareProgressPrune(t)
+			panicOnProgress(t, func(event ProgressEvent) bool {
+				return event.Kind == kind
+			})
+			return run
+		}
+	}
+	expectReturned := func(t *testing.T, run *progressRun) {
+		waitForWorkerErrorsGoroutines(t, run.baseline)
