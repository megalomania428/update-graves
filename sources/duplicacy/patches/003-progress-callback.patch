+// expectChunkSteps checks that the steps are of distinct chunks of the copied revision,
+// that a step is of a metadata chunk exactly if its chunk is one and that each chunk of
+// the revision has a step.
+func (fixture *workerErrorsCopyFixture) expectChunkSteps(t *testing.T,
+	steps []ProgressEvent) {
+	t.Helper()
+	metadataChunks := map[string]bool{}
+	for _, sequence := range [][]string{fixture.snapshot.FileSequence,
+		fixture.snapshot.ChunkSequence, fixture.snapshot.LengthSequence} {
+		for _, chunkHash := range sequence {
+			metadataChunks[fixture.destination.config.GetChunkIDFromHash(chunkHash)] = true
+		}
+	}
+	for _, chunkHash := range fixture.snapshot.ChunkHashes {
+		chunkID := fixture.destination.config.GetChunkIDFromHash(chunkHash)
+		if _, found := metadataChunks[chunkID]; !found {
+			metadataChunks[chunkID] = false
+		}
+	}
+	seen := map[string]bool{}
+	for _, step := range steps {
+		isMetadata, found := metadataChunks[step.ChunkID]
+		if !found || seen[step.ChunkID] || step.Metadata != isMetadata {
+			t.Fatalf("Unexpected step %+v", step)
+		}
+		seen[step.ChunkID] = true
+	}
+	for chunkID := range metadataChunks {
+		if !seen[chunkID] {
+			t.Fatalf("No step of the chunk %s", chunkID)
+		}
+	}
+}
