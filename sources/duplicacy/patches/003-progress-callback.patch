+				backup := summarizeProgress(t, run.recorder.take(), ProgressOperationBackup)
+				if summary.end != backup.end || summary.end.UploadedBytes == 0 {
+					t.Fatalf("The end is %+v instead of %+v", summary.end, backup.end)
