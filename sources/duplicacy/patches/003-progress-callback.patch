+// progressDelayStorage makes the first delete of a file under a prefix wait until ready
+// returns true or 2 seconds pass, which tells whether an end has been reported while a
+// task was still running.
+type progressDelayStorage struct {
+	*faultStorage
+	prefix   string
+	ready    func() bool
+	delayed  atomic.Bool
+	timedOut atomic.Bool
+}
+
+// newProgressDelayStorage puts the storage between the file storage and its callers, as
+// newFaultStorage does.
+func newProgressDelayStorage(storage *faultStorage, raw *FileStorage, prefix string,
+	ready func() bool) *progressDelayStorage {
+	delay := &progressDelayStorage{faultStorage: storage, prefix: prefix, ready: ready}
+	raw.DerivedStorage = delay
+	return delay
+}
+
+func (storage *progressDelayStorage) DeleteFile(threadIndex int, filePath string) error {
+	if strings.HasPrefix(filePath, storage.prefix) &&
+		storage.delayed.CompareAndSwap(false, true) {
+		deadline := time.Now().Add(2 * time.Second)
+		for !storage.ready() {
+			if time.Now().After(deadline) {
+				storage.timedOut.Store(true)
+				break
+			}
+			time.Sleep(10 * time.Millisecond)
+		}
+	}
+	return storage.faultStorage.DeleteFile(threadIndex, filePath)
+}
+
+// fossilFiles returns the number of the fossils under the directory of the storage.
+func fossilFiles(t *testing.T, dir string) int {
+	t.Helper()
+	count := 0
+	walk := func(path string, info os.FileInfo, err error) error {
+		if err == nil && info.Mode().IsRegular() && strings.HasSuffix(path, ".fsl") {
+			count++
+		}
+		return err
+	}
+	if err := filepath.Walk(dir, walk); err != nil {
+		t.Fatalf("Failed to list the fossils: %v", err)
+	}
+	return count
+}
