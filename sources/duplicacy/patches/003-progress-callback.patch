+						panic(progressHookPanic)
+					}
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				// Only the chunk of the first file is uploaded, by a worker in any order with
+				// the panic; the same chunk of the second file is found in the cache
+				var steps []ProgressEvent
+				for _, event := range run.recorder.take() {
+					if event.Kind == ProgressKindStep {
+						steps = append(steps, event)
