+	// moveToFossil makes the fossil of the chunk 1 exist before the prune
+	moveToFossil := func(t *testing.T, copyOnly bool) *progressRun {
+		run := prepareProgressPrune(t)
+		path := filepath.Join(run.pruneFixture.raw.storageDir, run.chunkPath)
+		if copyOnly {
+			content, err := os.ReadFile(path)
+			if err == nil {
