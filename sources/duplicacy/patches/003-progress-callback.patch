+// TestBackupManager_CopySnapshots checks the progress events of CopySnapshots, which
+// copies the revision 1 of the source to the destination of the copy fixture.  The
+// cases are added to the skeleton generated by gotests: the fields come from the source
+// manager, the other manager is the destination.
+func TestBackupManager_CopySnapshots(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		otherManager        *BackupManager
+		snapshotID          string
+		revisionsToBeCopied []int
+		uploadingThreads    int
+		downloadingThreads  int
+	}
+	// The arguments of fixture.copy: 2 uploading and 2 downloading threads
+	revision1 := args{snapshotID: "host1", revisionsToBeCopied: []int{1},
+		uploadingThreads: 2, downloadingThreads: 2}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantPanic interface{}
+		prepare   func(t *testing.T) *progressRun
+		check     func(t *testing.T, run *progressRun)
+	}{
+		{
+			// A copy to the empty destination
+			name: "EmptyDestination", args: revision1, want: true,
+			prepare: func(t *testing.T) *progressRun { return prepareProgressCopy(t, false) },
+			check: func(t *testing.T, run *progressRun) {
+				fixture := run.copyFixture
+				events := run.recorder.take()
+				fixture.expectCopied(workerErrorsOutcome{result: true})
+				summary := summarizeProgress(t, events, ProgressOperationCopy)
+				chunkCount := int64(fixture.chunkCount())
+				if summary.start.TotalChunks != chunkCount || summary.start.TotalBytes != -1 ||
+					int64(len(summary.steps)) != chunkCount {
+					t.Fatalf("The start is %+v and there are %d steps instead of %d chunks",
+						summary.start, len(summary.steps), chunkCount)
+				}
+				fixture.expectChunkSteps(t, summary.steps)
+				uploaded := int64(0)
+				for _, step := range summary.steps {
+					if step.Skipped {
+						t.Fatalf("Unexpected step %+v", step)
+					}
+					stored := storedChunkSize(t, fixture.destinationRaw, step.ChunkID,
+						step.Metadata)
+					if step.UploadedBytes != stored {
+						t.Fatalf("The step %+v has uploaded %d bytes instead of %d", step,
+							step.UploadedBytes, stored)
+					}
+					uploaded += step.UploadedBytes
+				}
+				if summary.end.TotalChunks != chunkCount ||
+					summary.end.TotalBytes != summary.bytes ||
+					summary.end.UploadedBytes != uploaded || summary.end.Failed != 0 {
+					t.Fatalf("The end is %+v instead of %d chunks, %d bytes and %d bytes "+
+						"uploaded", summary.end, chunkCount, summary.bytes, uploaded)
+				}
+			},
+		},
+		{
+			// Without the snapshot file the revision is copied again, but all of its
+			// chunks are at the destination
+			name: "ChunksAtDestination", args: revision1, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, true)
+				err := run.copyFixture.destinationRaw.DeleteFile(0, "snapshots/host1/1")
+				if err != nil {
+					t.Fatalf("Failed to delete the copied revision: %v", err)
+				}
+				run.recorder.take()
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				events := run.recorder.take()
+				run.copyFixture.expectCopied(workerErrorsOutcome{result: true})
+				summary := summarizeProgress(t, events, ProgressOperationCopy)
+				if summary.start.TotalChunks != 0 || summary.start.TotalBytes != -1 ||
+					len(summary.steps) != 0 ||
+					summary.end != (ProgressEvent{Operation: ProgressOperationCopy,
+						Kind: ProgressKindEnd}) {
+					t.Fatalf("The start is %+v with %d steps and the end %+v", summary.start,
+						len(summary.steps), summary.end)
+				}
+			},
+		},
+		{
+			// The chunks of the destination are missing from its listing, so the copy
+			// uploads every chunk of the revision again and finds each of them at the
+			// destination
+			name: "DestinationDuplicates", args: revision1, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, true)
+				fixture := run.copyFixture
+				if err := fixture.destinationRaw.DeleteFile(0, "snapshots/host1/1"); err != nil {
+					t.Fatalf("Failed to delete the copied revision: %v", err)
+				}
+				run.storedCount, run.storedSize = storedChunks(t, fixture.destinationRaw)
+				fixture.destinationStorage.hideListing("chunks/")
+				run.recorder.take()
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				fixture := run.copyFixture
+				events := run.recorder.take()
+				if fixture.destinationStorage.hiddenCount() == 0 {
+					t.Fatalf("The listing of the destination chunks has not been hidden")
+				}
+				fixture.expectCopied(workerErrorsOutcome{result: true})
+				summary := summarizeProgress(t, events, ProgressOperationCopy)
+				chunkCount := int64(fixture.chunkCount())
+				if summary.start.TotalChunks != chunkCount || summary.start.TotalBytes != -1 ||
+					int64(len(summary.steps)) != chunkCount {
+					t.Fatalf("The start is %+v and there are %d steps instead of %d chunks",
+						summary.start, len(summary.steps), chunkCount)
+				}
+				fixture.expectChunkSteps(t, summary.steps)
+				for _, step := range summary.steps {
+					if !step.Skipped || step.UploadedBytes != 0 || step.Bytes == 0 {
+						t.Fatalf("The step %+v is not skipped", step)
+					}
+				}
+				if summary.end != (ProgressEvent{Operation: ProgressOperationCopy,
+					Kind: ProgressKindEnd, TotalChunks: chunkCount,
+					TotalBytes: summary.bytes}) {
+					t.Fatalf("The end is %+v instead of %d chunks and %d bytes", summary.end,
+						chunkCount, summary.bytes)
+				}
+				count, stored := storedChunks(t, fixture.destinationRaw)
+				if count != run.storedCount || stored != run.storedSize {
+					t.Fatalf("%d chunks of %d bytes at the destination instead of %d and %d",
+						count, stored, run.storedCount, run.storedSize)
+				}
+			},
+		},
+		{
+			// A copy with nothing to copy reports no events
+			name: "NothingToCopy", args: revision1, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, true)
+				run.recorder.take()
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) { run.expectNoEvents(t) },
+		},
+		{
+			// The upload of the snapshot file fails, which is raised also through a log
+			// function: there is a start and there are steps, but no end
+			name: "FailedSnapshotFile", args: revision1, want: false,
+			wantPanic: Exception{Level: ERROR, LogID: "UPLOAD_File",
+				Message: "Failed to upload the file snapshots/host1/1: " +
+					"injected UploadFile failure for snapshots/host1/1"},
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, false)
+				run.copyFixture.destinationStorage.fail("UploadFile", "snapshots/host1/1")
+				setWorkerErrorsLogFunction()
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				if run.copyFixture.destinationStorage.injectedCount() == 0 {
+					t.Fatalf("The upload of the snapshot file has not failed")
+				}
+				expectNoEnd(t, run.recorder.take(), ProgressOperationCopy)
+				run.copyFixture.expectNotCopied(run.baseline)
+			},
+		},
+		{
+			name: "NilHook", args: revision1, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				setProgressFunction(t, nil)
+				fixture := newWorkerErrorsCopyFixture(t)
+				return &progressRun{fixture: fixture.workerErrorsFixture, copyFixture: fixture}
+			},
+			check: func(t *testing.T, run *progressRun) {
+				run.copyFixture.expectCopied(workerErrorsOutcome{result: true})
+			},
+		},
+		{
+			// A panic of the hook on the start is raised before the chunks are copied
+			name: "HookPanicStart", args: revision1, want: false, wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, false)
+				panicOnProgress(t, func(event ProgressEvent) bool {
+					return event.Kind == ProgressKindStart
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				if count, _ := storedChunks(t, run.copyFixture.destinationRaw); count != 0 {
+					t.Fatalf("The copy has copied %d chunks after the start", count)
+				}
+				run.copyFixture.expectNotCopied(run.baseline)
+			},
+		},
+		{
+			name: "HookPanicStep", args: revision1, want: false, wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, false)
+				panicOnProgress(t, func(event ProgressEvent) bool {
+					return event.Kind == ProgressKindStep
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				run.copyFixture.expectNotCopied(run.baseline)
+			},
+		},
+		{
+			name: "HookPanicEnd", args: revision1, want: false, wantPanic: progressHookPanic,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressCopy(t, false)
+				panicOnProgress(t, func(event ProgressEvent) bool {
+					return event.Kind == ProgressKindEnd
+				})
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				if !run.copyFixture.copiedRevisionExists() {
+					t.Fatalf("The revision 1 has not been copied before the end")
+				}
+				waitForWorkerErrorsGoroutines(t, run.baseline)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			source := run.copyFixture.manager
+			tt.fields = fields{
+				snapshotID:         source.snapshotID,
+				storage:            source.storage,
+				SnapshotManager:    source.SnapshotManager,
+				snapshotCache:      source.snapshotCache,
+				config:             source.config,
+				nobackupFile:       source.nobackupFile,
+				filtersFile:        source.filtersFile,
+				excludeByAttribute: source.excludeByAttribute,
+				cachePath:          source.cachePath,
+			}
+			tt.args.otherManager = run.copyFixture.destination
