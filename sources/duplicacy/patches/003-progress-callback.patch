+// TestBackupManager_Backup checks the progress events of Backup.  The cases are added to
+// the skeleton generated by gotests: the fields come from the manager of the case, the
+// top directory from its repository.
+func TestBackupManager_Backup(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		top                    string
+		quickMode              bool
+		threads                int
+		tag                    string
+		showStatistics         bool
+		shadowCopy             bool
+		shadowCopyTimeout      int
+		enumOnly               bool
+		metadataChunkSize      int
+		maximumInMemoryEntries int
+	}
+	// The arguments of fixture.backup: a hash backup with 2 threads
+	hash := args{threads: 2, tag: "test", metadataChunkSize: 65536,
+		maximumInMemoryEntries: 1024}
+	quick := hash
+	quick.quickMode = true
+	enumOnly := hash
+	enumOnly.enumOnly = true
+	// With more entries than maximumInMemoryEntries a hash backup keeps them in
+	// incomplete_files, which RunAtError would turn into an incomplete snapshot
+	inFile := hash
+	inFile.maximumInMemoryEntries = 1
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantPanic interface{}
+		prepare   func(t *testing.T) *progressRun
+		check     func(t *testing.T, run *progressRun)
+	}{
+		{
+			// The first backup of files without repeated content
+			name: "First", args: hash, want: true,
+			prepare: func(t *testing.T) *progressRun { return prepareProgressBackup(t) },
+			check: func(t *testing.T, run *progressRun) {
+				fixture := run.fixture
+				summary := summarizeProgress(t, run.recorder.take(), ProgressOperationBackup)
+				size := repositorySize(t, fixture.repository, "file1", "file2", "dir1/file3")
+				if summary.start.TotalBytes != size || summary.start.TotalChunks != -1 {
+					t.Fatalf("The start is %+v instead of %d bytes and -1 chunks", summary.start,
+						size)
+				}
+				if summary.bytes != size {
+					t.Fatalf("The steps have %d bytes instead of %d", summary.bytes, size)
+				}
+				snapshot := fixture.revisionSnapshot(1)
+				if len(summary.steps) != len(snapshot.ChunkHashes) {
+					t.Fatalf("%d steps instead of %d file chunks", len(summary.steps),
+						len(snapshot.ChunkHashes))
+				}
+				for _, step := range summary.steps {
+					if step.Skipped || step.Metadata {
+						t.Fatalf("Unexpected step %+v", step)
+					}
+					stored := storedChunkSize(t, fixture.raw, step.ChunkID, false)
+					if step.UploadedBytes != stored {
+						t.Fatalf("The step %+v has uploaded %d bytes instead of %d", step,
+							step.UploadedBytes, stored)
+					}
+				}
+				// All chunks in the storage are new: the file chunks of the steps and the
+				// metadata chunks
+				metadataCount, metadataLength := fixture.newMetadataChunks(snapshot)
+				count, stored := storedChunks(t, fixture.raw)
+				if count != int64(len(summary.steps))+metadataCount {
+					t.Fatalf("%d chunks in the storage instead of %d file and %d metadata chunks",
+						count, len(summary.steps), metadataCount)
+				}
+				if summary.end.TotalChunks != count || summary.end.UploadedBytes != stored ||
+					summary.end.TotalBytes != summary.bytes+metadataLength ||
+					summary.end.Failed != 0 {
+					t.Fatalf("The end is %+v instead of %d chunks, %d bytes and %d bytes stored",
+						summary.end, count, summary.bytes+metadataLength, stored)
+				}
+			},
+		},
+		{
+			// The size of a symbolic link is not counted at the start, as the link is not
+			// split into chunks
+			name: "Symlink", args: hash, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressBackup(t)
+				link := filepath.Join(run.fixture.repository, "link1")
+				if err := os.Symlink("file1", link); err != nil {
+					t.Skipf("Failed to create a symbolic link: %v", err)
+				}
+				return run
+			},
+			check: func(t *testing.T, run *progressRun) {
+				summary := summarizeProgress(t, run.recorder.take(), ProgressOperationBackup)
+				size := repositorySize(t, run.fixture.repository, "file1", "file2",
+					"dir1/file3")
+				if summary.start.TotalBytes != size || summary.bytes != size {
+					t.Fatalf("The start is %+v with %d bytes of steps instead of %d",
+						summary.start, summary.bytes, size)
+				}
+			},
+		},
+		{
+			// A quick backup of an unchanged repository has no steps
+			name: "QuickNoChanges", args: quick, want: true,
+			prepare: func(t *testing.T) *progressRun { return prepareProgressBackup(t, false) },
+			check: func(t *testing.T, run *progressRun) {
+				summary := summarizeProgress(t, run.recorder.take(), ProgressOperationBackup)
+				if summary.start.TotalBytes != 0 || len(summary.steps) != 0 {
+					t.Fatalf("The start is %+v with %d steps", summary.start,
+						len(summary.steps))
+				}
+				run.expectNewMetadataEnd(t, summary)
+			},
+		},
+		{
+			// A hash backup of an unchanged repository after a hash and a quick backup
+			// skips every file chunk
+			name: "HashNoChanges", args: hash, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				return prepareProgressBackup(t, false, true)
+			},
+			check: func(t *testing.T, run *progressRun) {
+				summary := summarizeProgress(t, run.recorder.take(), ProgressOperationBackup)
+				fileChunks := len(run.fixture.revisionSnapshot(1).ChunkHashes)
+				if len(summary.steps) != fileChunks {
+					t.Fatalf("%d steps instead of %d", len(summary.steps), fileChunks)
+				}
+				for _, step := range summary.steps {
+					if !step.Skipped || step.UploadedBytes != 0 {
+						t.Fatalf("The step %+v is not skipped", step)
+					}
+				}
+				run.expectNewMetadataEnd(t, summary)
+			},
+		},
+		{
+			// After a hash, a quick and a hash backup, a quick backup keeps the chunks of a
