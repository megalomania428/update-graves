+			if outcome.recovered != tt.wantPanic {
+				t.Fatalf("SnapshotManager.PruneSnapshots() panicked with %#v, want %#v",
+					outcome.recovered, tt.wantPanic)
+			}
+			if got := outcome.result; got != tt.want {
+				t.Errorf("SnapshotManager.PruneSnapshots() = %v, want %v", got, tt.want)
+			}
+			tt.check(t, run)
+		})
+	}
+}
