+				}
+			},
+		},
+		{
+			// A backup in the background without statistics has the events of a backup of
+			// the same files that shows statistics in the foreground
+			name: "Background", args: hash, want: true,
+			prepare: func(t *testing.T) *progressRun {
+				run := prepareProgressBackup(t)
+				savedRunInBackground := RunInBackground
