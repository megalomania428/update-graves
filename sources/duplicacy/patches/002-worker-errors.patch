+// createPrintableRevision creates the revision 1 of print@host1 that PrintFile can print, unlike the revisions of
+// createTestSnapshot, which have no file and length sequences; it references the chunk 1 and lists no files.  It
+// returns the hash of the chunk of its chunk sequence.
+func (fixture *workerErrorsPruneFixture) createPrintableRevision() string {
+	fixture.t.Helper()
+	manager := fixture.manager
+	chunkHashes, err := json.Marshal([]string{hex.EncodeToString([]byte(fixture.chunks[0]))})
+	if err != nil {
+		fixture.t.Fatalf("Failed to encode the chunk hashes: %v", err)
+	}
+	lengths, err := json.Marshal([]int{1024})
+	if err != nil {
+		fixture.t.Fatalf("Failed to encode the chunk lengths: %v", err)
+	}
+	snapshot := &Snapshot{
+		ID:             "print@host1",
+		Revision:       1,
+		StartTime:      fixture.now - 3600,
+		EndTime:        fixture.now - 60,
+		FileSequence:   []string{uploadTestChunk(manager, []byte("[]"))},
+		ChunkSequence:  []string{uploadTestChunk(manager, chunkHashes)},
+		LengthSequence: []string{uploadTestChunk(manager, lengths)},
+	}
+	description, err := snapshot.MarshalJSON()
+	if err != nil {
+		fixture.t.Fatalf("Failed to encode the snapshot: %v", err)
+	}
+	if err = manager.storage.CreateDirectory(0, "snapshots/print@host1"); err != nil {
+		fixture.t.Fatalf("Failed to create the directory of print@host1: %v", err)
+	}
+	if !manager.UploadFile("snapshots/print@host1/1", "snapshots/print@host1/1", description) {
+		fixture.t.Fatalf("Failed to upload the revision 1 of print@host1")
+	}
+	return snapshot.ChunkSequence[0]
+}
