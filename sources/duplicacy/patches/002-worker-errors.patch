+// newWorkerErrorsFixture creates the fixture; with separateMetadata metadata chunks are stored under metadata/.
+func newWorkerErrorsFixture(t *testing.T, separateMetadata bool) *workerErrorsFixture {
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	fixture := &workerErrorsFixture{t: t, repository: filepath.Join(dir, "repository")}
+	for _, subdir := range []string{"dir1", ".duplicacy"} {
+		if err := os.MkdirAll(filepath.Join(fixture.repository, subdir), 0700); err != nil {
+			t.Fatalf("Failed to create the repository: %v", err)
+		}
+	}
+	for _, file := range []string{"file1", "file2", "dir1/file3"} {
+		createRandomFile(filepath.Join(fixture.repository, file), 1000000)
+	}
+	raw, err := CreateFileStorage(filepath.Join(dir, "storage"), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	if !ConfigStorage(raw, 16384, 100, 64*1024, 256*1024, 16*1024, "", nil, false, "", 0, 0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	if separateMetadata {
+		// The nesting file must exist before the storage is loaded by CreateBackupManager, as in TestBackupManager
+		nesting := []byte(`{"read-levels":[1],"write-level":1,"separate-metadata":true}`)
+		if err = raw.UploadFile(0, "nesting", nesting); err != nil {
+			t.Fatalf("Failed to upload the nesting file: %v", err)
+		}
+	}
+	fixture.raw = raw
+	fixture.storage = newFaultStorage(raw)
+	SetDuplicacyPreferencePath(filepath.Join(fixture.repository, ".duplicacy"))
+	fixture.manager = CreateBackupManager("host1", fixture.storage, fixture.repository, "", "", "", false)
+	if fixture.manager == nil || !fixture.manager.SetupSnapshotCache("default") {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	return fixture
+}
