+// expectSuccess checks that the operation returned true without a panic.
+func (fixture *workerErrorsPruneFixture) expectSuccess(outcome workerErrorsOutcome) {
+	fixture.t.Helper()
+	if outcome.recovered != nil || !outcome.result {
+		fixture.t.Fatalf("The operation failed: %#v (result %t)", outcome.recovered, outcome.result)
+	}
+}
+
+// expectOperator checks the operator of the snapshot manager after an operation: an operator existing before it is
+// kept running without the failures and the fossils, otherwise the operator has been removed.
+func (fixture *workerErrorsPruneFixture) expectOperator(existing *ChunkOperator) {
+	fixture.t.Helper()
+	operator := fixture.manager.chunkOperator
+	if existing == nil {
+		if operator != nil {
+			fixture.t.Fatalf("The operator of the snapshot manager has not been removed")
+		}
+		return
+	}
+	if operator != existing || operator.isStopped() || operator.failures.hasFailed() || len(operator.fossils) != 0 ||
+		atomic.LoadInt64(&operator.NumberOfFailedChunks) != 0 {
+		fixture.t.Fatalf("The existing operator of the snapshot manager has not been kept without its failures")
+	}
+}
+
+// expectPruned checks the storage after a successful prune of revision 1 that isn't exclusive: revision 2 is kept
+// with all its chunks, and the fossils of the chunk 1 and of the chunk sequence of revision 1 are collected.
+func (fixture *workerErrorsPruneFixture) expectPruned() {
+	fixture.t.Helper()
