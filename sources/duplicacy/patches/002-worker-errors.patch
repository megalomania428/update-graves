+func TestWorkerErrorsBackupChunkUpload(t *testing.T) {
+	for _, name := range []string{"Log", "LogFunction"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			// Without encryption the same files give the same chunk ids in any storage,
+			// so the chunk in the middle of the probe backup is the one to fail in the
+			// backup under test
+			probe := newWorkerErrorsFixture(t, false)
+			probe.expectSuccess(probe.backup(probe.repository, false), 1)
+			snapshot := probe.manager.SnapshotManager.DownloadSnapshot("host1", 1)
+			if snapshot == nil {
+				t.Fatalf("Failed to download the revision 1")
+			}
+			probe.manager.SnapshotManager.GetSnapshotChunks(snapshot, true)
+			if len(snapshot.ChunkHashes) < 6 {
+				t.Fatalf("Expected at least 6 file chunks, got %d", len(snapshot.ChunkHashes))
+			}
+			chunkHash := snapshot.ChunkHashes[len(snapshot.ChunkHashes)/2]
+			chunkID := probe.manager.config.GetChunkIDFromHash(chunkHash)
+			probe.stopSnapshotOperator()
+			waitForWorkerErrorsGoroutines(t, baseline)
+
+			fixture := newWorkerErrorsFixture(t, false)
+			for _, file := range []string{"file1", "file2", "dir1/file3"} {
+				content, err := os.ReadFile(filepath.Join(probe.repository, file))
+				if err != nil {
+					t.Fatalf("Failed to read %s: %v", file, err)
+				}
+				err = os.WriteFile(filepath.Join(fixture.repository, file), content, 0600)
+				if err != nil {
+					t.Fatalf("Failed to write %s: %v", file, err)
+				}
+			}
+			chunkPath, _, _, err := fixture.raw.FindChunk(0, chunkID, false, false)
+			if err != nil {
+				t.Fatalf("Failed to find the path of the chunk %s: %v", chunkID, err)
+			}
+			fixture.storage.fail("UploadFile", chunkPath)
+			if name == "LogFunction" {
+				setWorkerErrorsLogFunction()
+			}
+
+			expectWorkerErrorsException(t, fixture.backup(fixture.repository, false),
+				"UPLOAD_CHUNK")
+			if fixture.revisionExists(1) {
+				t.Fatalf("The revision 1 has been created despite the failed upload")
+			}
+			if fixture.storage.injectedCount() == 0 || fixture.storage.uploadCount() == 0 {
+				t.Fatalf("Expected uploads before the failure, got %d uploads and %d failures",
+					fixture.storage.uploadCount(), fixture.storage.injectedCount())
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+
+			fixture.storage.clearFaults()
+			fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectSuccess(fixture.backup(fixture.repository, true), 2)
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+
+	// The file of the entry list is closed on a panic unless RunAtError saves the incomplete snapshot with it
+	expectIncompleteFilesClosed := func(t *testing.T, fixture *workerErrorsFixture) {
+		t.Helper()
+		dir, err := filepath.EvalSymlinks(fixture.manager.cachePath)
+		if err != nil {
+			t.Fatalf("Failed to resolve the cache path: %v", err)
+		}
+		open, haveProc := openFilesOf(t)
+		if !haveProc {
+			t.Skip("/proc/self/fd is not available to check the open files")
+		}
+		for _, path := range open {
+			// Linux appends this to the path of a file removed while it is open
+			if strings.TrimSuffix(path, " (deleted)") == filepath.Join(dir, "incomplete_files") {
+				t.Fatalf("The file %s is still open after the backup", path)
+			}
+		}
+	}
+	t.Run("QuickIncompleteFiles", func(t *testing.T) {
+		baseline := runtime.NumGoroutine()
+		fixture := newWorkerErrorsFixture(t, false)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		createRandomFile(filepath.Join(fixture.repository, "file1"), 1000000)
+		fixture.storage.fail("UploadFile", "chunks/")
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		// A quick backup with a previous revision doesn't set RunAtError, so nothing else closes the file
+		expectWorkerErrorsException(t, fixture.backupInMemory(fixture.repository, true, false, 0), "UPLOAD_CHUNK")
+		if fixture.storage.injectedCount() == 0 {
+			t.Fatalf("The upload of a chunk has not been attempted")
+		}
+		waitForWorkerErrorsGoroutines(t, baseline)
+		expectIncompleteFilesClosed(t, fixture)
+
+		fixture.storage.clearFaults()
+		fixture.expectSuccess(fixture.backup(fixture.repository, true), 2)
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		// The file of the entry list is closed after a successful backup as well, where a failure of a function
+		// deferred before the closing one cannot be reproduced on Linux: the DeleteShadowCopy there is empty
+		fixture.expectSuccess(fixture.backupInMemory(fixture.repository, true, false, 0), 3)
+		waitForWorkerErrorsGoroutines(t, baseline)
+		expectIncompleteFilesClosed(t, fixture)
+	})
+	t.Run("StatsIncompleteFiles", func(t *testing.T) {
+		baseline := runtime.NumGoroutine()
+		fixture := newWorkerErrorsFixture(t, false)
+		// The statistics are logged after the incomplete snapshot has been deleted, when RunAtError saves nothing
+		LogFunction = func(level int, logID string, message string) {
+			if logID == "BACKUP_STATS" {
+				panic("backup-stats-panic")
+			}
+		}
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		if outcome := fixture.backupInMemory(fixture.repository, false, true, 0); outcome.recovered != "backup-stats-panic" {
+			t.Fatalf("Expected the panic of the log function, got %#v", outcome.recovered)
+		}
+		waitForWorkerErrorsGoroutines(t, baseline)
+		expectIncompleteFilesClosed(t, fixture)
+
+		LogFunction = nil
+		fixture.expectSuccess(fixture.backup(fixture.repository, true), 2)
+		waitForWorkerErrorsGoroutines(t, baseline)
+	})
+}
