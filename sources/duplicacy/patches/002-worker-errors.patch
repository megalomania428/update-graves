+// collectionSaved reports whether a fossil collection has been saved in the snapshot cache.
+func (fixture *workerErrorsPruneFixture) collectionSaved() bool {
+	fixture.t.Helper()
+	files, err := os.ReadDir(filepath.Join(fixture.testDir, "cache", "fossils"))
+	if err != nil && !os.IsNotExist(err) {
+		fixture.t.Fatalf("Failed to list the fossil collections: %v", err)
+	}
+	return len(files) > 0
+}
