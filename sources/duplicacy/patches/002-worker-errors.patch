+// TestWorkerErrorsRestoreListing fails the listing of Restore: the file sequence in the remote listing goroutine,
+// the chunk and length sequences in the goroutine calling Restore, and the filters in the local listing goroutine.
+func TestWorkerErrorsRestoreListing(t *testing.T) {
