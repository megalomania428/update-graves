+func TestListEntries(t *testing.T) {
+	type args struct {
+		top                string
+		path               string
+		patterns           []string
+		nobackupFile       string
+		excludeByAttribute bool
+		listingChannel     chan *Entry
+		stop               <-chan struct{}
+	}
+	tests := []struct {
+		name              string
+		args              args
+		prepare           func(t *testing.T, args *args)
+		wantDirectoryList []*Entry
+		wantSkippedFiles  []string
+		wantErr           bool
+	}{
+		{
+			// The closing of 'stop' during a read of the directory that ends with an error is not covered: the window
+			// can't be created without a test point in the code
+			name: "StoppedBefore",
+			prepare: func(t *testing.T, args *args) {
+				args.top = t.TempDir()
+				for i := 0; i < 3; i++ {
+					if err := os.WriteFile(filepath.Join(args.top, fmt.Sprintf("f%d", i)), nil, 0600); err != nil {
+						t.Fatalf("Failed to write the file %d: %v", i, err)
+					}
+				}
+				args.listingChannel = make(chan *Entry, 16)
+				stop := make(chan struct{})
+				close(stop)
+				args.stop = stop
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			SetLoggingLevel(DEBUG)
+			var logged int64
+			LogFunction = func(level int, logID string, message string) {
+				atomic.AddInt64(&logged, 1)
+			}
+			tt.prepare(t, &tt.args)
+			gotDirectoryList, gotSkippedFiles, err := ListEntries(tt.args.top, tt.args.path, tt.args.patterns, tt.args.nobackupFile, tt.args.excludeByAttribute, tt.args.listingChannel, tt.args.stop)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("ListEntries() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			if !reflect.DeepEqual(gotDirectoryList, tt.wantDirectoryList) {
+				t.Errorf("ListEntries() gotDirectoryList = %v, want %v", gotDirectoryList, tt.wantDirectoryList)
+			}
+			if !reflect.DeepEqual(gotSkippedFiles, tt.wantSkippedFiles) {
+				t.Errorf("ListEntries() gotSkippedFiles = %v, want %v", gotSkippedFiles, tt.wantSkippedFiles)
+			}
+			if count := atomic.LoadInt64(&logged); count != 0 {
+				t.Errorf("ListEntries() has logged %d records after 'stop' was closed", count)
+			}
+			if sent := len(tt.args.listingChannel); sent != 0 {
+				t.Errorf("ListEntries() has sent %d entries after 'stop' was closed", sent)
+			}
+		})
+	}
+}
