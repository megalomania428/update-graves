+func TestWorkerErrorsRecordFirst(t *testing.T) {
+	t.Run("Sequential", func(t *testing.T) {
+		failures := newWorkerErrors()
+		failures.record(Exception{Level: ERROR, LogID: "FIRST", Message: "first"})
+		failures.record(Exception{Level: ERROR, LogID: "SECOND", Message: "second"})
+		if !failures.hasFailed() {
+			t.Fatalf("The panic has not been recorded")
+		}
+		outcome := runWorkerErrorsOperation(t, func() bool {
+			failures.raise()
+			return true
+		})
+		expectWorkerErrorsException(t, outcome, "FIRST")
+	})
+	t.Run("Concurrent", func(t *testing.T) {
+		failures := newWorkerErrors()
+		expected := map[string]bool{}
+		start := make(chan struct{})
+		var ready, finished sync.WaitGroup
+		for i := 0; i < 8; i++ {
+			logID := fmt.Sprintf("WORKER%d", i)
+			expected[logID] = true
+			ready.Add(1)
+			finished.Add(1)
+			go func() {
+				defer finished.Done()
+				ready.Done()
+				<-start
+				failures.record(Exception{Level: ERROR, LogID: logID, Message: "concurrent"})
+			}()
+		}
+		ready.Wait()
+		close(start)
+		finished.Wait()
+		raise := func() workerErrorsOutcome {
+			return runWorkerErrorsOperation(t, func() bool {
+				failures.raise()
+				return true
+			})
+		}
+		first, second := raise(), raise()
+		exception, ok := first.recovered.(Exception)
+		if !ok || !expected[exception.LogID] {
+			t.Fatalf("Expected an Exception of a worker, got %#v", first.recovered)
+		}
+		if second.recovered != first.recovered {
+			t.Fatalf("The panics differ: %#v and %#v", first.recovered, second.recovered)
+		}
+	})
+}
