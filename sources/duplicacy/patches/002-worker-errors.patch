+func TestWorkerErrorsPruneFossilizeLookup(t *testing.T) {
+	fixture := newWorkerErrorsPruneFixture(t)
+	chunkPath := fixture.chunkPath(fixture.chunks[0])
+	// FindChunk looks for the chunk at the nesting levels 2 and 3, chunks/ab/cd/efgh... and chunks/ab/cd/ef/gh...,
+	// and for its fossil at the same paths with .fsl; the prefix up to ef covers them all.  FindChunk treats the
+	// failed GetFileInfo as a missing chunk, so the fossilize task finds neither the chunk nor its fossil.
+	fixture.storage.fail("GetFileInfo", chunkPath[:strings.LastIndex(chunkPath, "/")+3])
+	baseline := runtime.NumGoroutine()
+	expectWorkerErrorsException(t, fixture.prune(nil, workerErrorsKeep, false), "CHUNK_FIND")
+	fixture.expectInjected()
+	waitForWorkerErrorsGoroutines(t, baseline)
+	fixture.expectRevisions([]int{1, 2}, nil)
+	if fixture.collectionSaved() {
+		t.Fatalf("A fossil collection has been saved after the failure")
+	}
+	fixture.expectOperator(nil)
+}
+
+func TestWorkerErrorsPruneResurrect(t *testing.T) {
+	fixture := newWorkerErrorsPruneFixture(t)
+	fossilPath := fixture.chunkPath(fixture.chunks[0]) + ".fsl"
+	fixture.expectSuccess(fixture.prune(nil, workerErrorsKeep, false))
+	// Revision 4 references the chunk 1 again, so the next prune resurrects its fossil from the collection
+	fixture.createRevision(4, 1, uploadRandomChunk(fixture.manager, 1024), fixture.chunks[0])
+	fixture.storage.fail("MoveFile", fossilPath)
+	baseline := runtime.NumGoroutine()
+	// No revision is to be deleted; the failure of the resurrection is raised by the wait for the tasks before the
+	// prune returns
+	expectWorkerErrorsException(t, fixture.prune(nil, nil, false), "FOSSIL_RESURRECT")
+	fixture.expectInjected()
+	waitForWorkerErrorsGoroutines(t, baseline)
+	fixture.expectRevisions([]int{2, 4}, []int{1})
+	fixture.expectOperator(nil)
+}
+
+func TestWorkerErrorsPruneExclusiveDelete(t *testing.T) {
+	fixture := newWorkerErrorsPruneFixture(t)
+	chunkPath := fixture.chunkPath(fixture.chunks[0])
+	fixture.storage.fail("DeleteFile", chunkPath)
+	baseline := runtime.NumGoroutine()
+	// A chunk that can't be deleted is only a warning
+	fixture.expectSuccess(fixture.prune([]int{1}, nil, true))
+	fixture.expectInjected()
+	waitForWorkerErrorsGoroutines(t, baseline)
+	fixture.expectRevisions([]int{2}, []int{1})
+	if exist, _, _, err := fixture.raw.GetFileInfo(0, chunkPath); err != nil || !exist {
+		t.Fatalf("The chunk 1 that failed to be deleted is missing: %v", err)
+	}
+	fixture.expectOperator(nil)
+}
