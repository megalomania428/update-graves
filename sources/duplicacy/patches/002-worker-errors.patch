+func TestWorkerErrorsChunkOperator(t *testing.T) {
+	for _, name := range []string{"UploadFailure", "UploadSkipsQueue", "FindChunkFailure", "CompletionPanic"} {
+		t.Run(name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			raw, err := CreateFileStorage(t.TempDir(), false, 2)
+			if err != nil {
+				t.Fatalf("Failed to create the storage: %v", err)
+			}
+			for _, dir := range []string{"chunks", "snapshots"} {
+				if err = raw.CreateDirectory(0, dir); err != nil {
+					t.Fatalf("Failed to create the directory %s: %v", dir, err)
+				}
+			}
+			storage := newFaultStorage(raw)
+			config := CreateConfig()
+			config.MinimumChunkSize = 100
+			config.chunkPool = make(chan *Chunk, 20)
+			var chunks []*Chunk
+			for i := 0; i < 10; i++ {
+				content := make([]byte, 1000)
+				if _, err = crypto_rand.Read(content); err != nil {
+					t.Fatalf("Failed to generate the content: %v", err)
+				}
+				chunk := CreateChunk(config, true)
+				chunk.Reset(true)
+				chunk.Write(content)
+				chunks = append(chunks, chunk)
+			}
+			var expected interface{} = "injected completion failure"
+			completionFunc := func(chunk *Chunk, chunkIndex int, inCache bool, chunkSize int, uploadSize int) {}
+			// With one thread the queue holds one task, so the loop below is blocked in the upload of the chunk 7 while
+			// the upload of the chunk 5 is held, with the chunk 6 waiting in the queue
+			threads := 2
+			var started, returned int32
+			if name == "UploadSkipsQueue" {
+				threads = 1
+			}
+			if name == "UploadFailure" || name == "UploadSkipsQueue" {
+				chunkPath, _, _, err := raw.FindChunk(0, chunks[5].GetID(), false, false)
+				if err != nil {
+					t.Fatalf("Failed to find the chunk path: %v", err)
+				}
+				storage.fail("UploadFile", chunkPath)
+				if name == "UploadSkipsQueue" {
+					storage.delayUpload(chunkPath, func() bool { return atomic.LoadInt32(&started) >= 8 })
+				}
+			} else if name == "FindChunkFailure" {
+				storage.failFindChunk(chunks[5].GetID())
+			} else {
+				completionFunc = func(chunk *Chunk, chunkIndex int, inCache bool, chunkSize int, uploadSize int) {
+					if chunkIndex == 5 {
+						panic(expected)
+					}
+				}
+			}
+			baseline := runtime.NumGoroutine()
+			operator := CreateChunkOperator(config, storage, nil, false, false, threads, false)
+			operator.UploadCompletionFunc = completionFunc
+			outcomes := []workerErrorsOutcome{runWorkerErrorsOperation(t, func() bool {
+				for i, chunk := range chunks {
+					atomic.AddInt32(&started, 1)
+					operator.Upload(chunk, i, false)
+					atomic.AddInt32(&returned, 1)
+				}
+				operator.WaitForCompletion()
+				return true
+			})}
+			outcomes = append(outcomes, runWorkerErrorsOperation(t, func() bool {
+				operator.Stop()
+				return true
+			}))
+			for _, outcome := range outcomes {
+				if name != "CompletionPanic" {
+					expectWorkerErrorsException(t, outcome, "UPLOAD_CHUNK")
+				} else if outcome.recovered != expected {
+					t.Fatalf("Expected the panic %v, got %#v", expected, outcome.recovered)
+				}
+			}
+			if name == "UploadSkipsQueue" {
+				// The chunk 6 in the queue is skipped after the failure of the chunk 5, and the loop stops before the
+				// last chunk since Upload raises the failure
+				if uploads := storage.uploadCount(); uploads != 5 {
+					t.Fatalf("%d chunks have been uploaded instead of 5", uploads)
+				}
+				if calls := atomic.LoadInt32(&returned); calls >= 10 {
+					t.Fatalf("The loop has gone on to the end: %d uploads returned", calls)
+				}
+				if storage.lateCount() != 0 {
+					t.Fatalf("The upload of the chunk 5 did not wait for the loop in 10 seconds")
+				}
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+}
