+// complete is the completion function of the download tasks.  The worker doesn't block on the channel once nobody
+// can be waiting for the chunk: after Stop or after a failure recorded by the operator.
+// A chunk dropped that way is returned to the chunk pool, as the receiver would do.
+func (downloader *ChunkDownloader) complete(chunk *Chunk, chunkIndex int) {
+	select {
+	case downloader.completionChannel <- ChunkDownloadCompletion{chunk: chunk, chunkIndex: chunkIndex}:
+	case <-downloader.stopped:
+		downloader.operator.config.PutChunk(chunk)
+	case <-downloader.operator.failures.failed:
+		downloader.operator.config.PutChunk(chunk)
+	}
+}
+
+// receive waits for the next downloaded chunk; a failure recorded by the operator is raised instead.
+func (downloader *ChunkDownloader) receive() ChunkDownloadCompletion {
+	select {
+	case completion := <-downloader.completionChannel:
+		return completion
+	case <-downloader.operator.failures.failed:
+	}
+	downloader.operator.failures.raise()
+	return ChunkDownloadCompletion{}
+}
+
+// Stop makes the download tasks still running drop their chunks instead of waiting for a receiver, so that the
+// operator can be stopped; it can be called more than once.
+func (downloader *ChunkDownloader) Stop() {
+	downloader.stopOnce.Do(func() {
+		close(downloader.stopped)
+	})
+}
