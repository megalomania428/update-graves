+// TestWorkerErrorsCheckChunks fails the download of a chunk verified by the goroutines of CheckSnapshots.
+func TestWorkerErrorsCheckChunks(t *testing.T) {
+	for _, name := range []string{"Log", "LogFunction", "AllowFailures"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			fixture := newWorkerErrorsFixture(t, false)
+			fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+			snapshot := fixture.revisionSnapshot(1)
+			fixture.failDownload(snapshot.ChunkHashes[len(snapshot.ChunkHashes)/2], false)
+			if name == "LogFunction" {
+				setWorkerErrorsLogFunction()
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+
+			logID := "DOWNLOAD_CHUNK"
+			if name == "AllowFailures" {
+				// The failed chunk is only counted, and the check reports the corrupted chunks at the end
+				logID = "SNAPSHOT_VERIFY"
+			}
+			expectWorkerErrorsException(t, fixture.check(false, name == "AllowFailures"), logID)
+			if fixture.storage.injectedCount() == 0 {
+				t.Fatalf("The download of the chunk has not been attempted")
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+}
