+// The tests of this file check that an error logged through a log function that returns
+// still stops the operation with an Exception, at the points where the operation would
+// otherwise go on with a wrong state.  A failed read in the middle of a file packed by
+// Backup (CHUNK_MAKER) is not tested: Backup opens the files itself, so the failure can't
+// be caused deterministically without a test point in the production code.  The cases
+// are added to the skeletons generated by gotests, renamed with the suffix _LogErrors.  The
+// cases with a suppressed log id print to the standard output and check that SuppressLog
+// hides only the entries up to WARN.
+
+// Test_logf_LogErrors calls logf with a log function on every level, and without one with
+// a suppressed log id.
+func Test_logf_LogErrors(t *testing.T) {
+	type args struct {
+		level  int
+		logID  string
+		format string
+		v      []interface{}
+	}
+	message := func(level int) args {
+		return args{level: level, logID: "LOG_TEST", format: "message %d",
+			v: []interface{}{level}}
+	}
+	raised := func(level int) Exception {
+		return Exception{Level: level, LogID: "LOG_TEST",
+			Message: fmt.Sprintf("message %d", level)}
+	}
+	logPanic := "log function panic"
+	tests := []struct {
+		name      string
+		args      args
+		wantPanic interface{}
+		logPanic  interface{} // The panic of the log function, nil if it returns
+		suppress  string      // The log id given to SuppressLog; logf then prints at INFO
+		printed   bool        // Whether the entry is printed, with suppress
+	}{
+		{name: "DEBUG", args: message(DEBUG)},
+		{name: "TRACE", args: message(TRACE)},
+		{name: "INFO", args: message(INFO)},
+		{name: "WARN", args: message(WARN)},
+		{name: "ERROR", args: message(ERROR), wantPanic: raised(ERROR)},
+		{name: "FATAL", args: message(FATAL), wantPanic: raised(FATAL)},
+		{name: "ASSERT", args: message(ASSERT), wantPanic: raised(ASSERT)},
+		{
+			// The panic of the log function is raised as is, without a second call
+			name: "PanickingLogFunction", args: message(ERROR), wantPanic: logPanic,
+			logPanic: logPanic,
+		},
+		{name: "SuppressedINFO", args: message(INFO), suppress: "LOG_TEST"},
+		{name: "SuppressedWARN", args: message(WARN), suppress: "LOG_TEST"},
+		{
+			name: "SuppressedERROR", args: message(ERROR), suppress: "LOG_TEST", printed: true,
+			wantPanic: raised(ERROR),
+		},
+		{
+			name: "SuppressedFATAL", args: message(FATAL), suppress: "LOG_TEST", printed: true,
+			wantPanic: raised(FATAL),
+		},
+		{name: "OtherSuppressedINFO", args: message(INFO), suppress: "LOG_OTHER", printed: true},
+		{name: "OtherSuppressedWARN", args: message(WARN), suppress: "LOG_OTHER", printed: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			expected := Exception{Level: tt.args.level, LogID: tt.args.logID,
+				Message: fmt.Sprintf(tt.args.format, tt.args.v...)}
+			operation := func() bool {
+				logf(tt.args.level, tt.args.logID, tt.args.format, tt.args.v...)
+				return true
+			}
+			var outcome workerErrorsOutcome
+			if tt.suppress != "" {
+				SetLoggingLevel(INFO)
+				SuppressLog(tt.suppress)
+				var output string
+				outcome, output = captureLogErrorsOutput(t, operation)
+				printed := strings.Contains(output, expected.Message+"\n")
+				if printed != tt.printed {
+					t.Fatalf("The entry has been printed: %t, want %t:\n%s", printed,
+						tt.printed, output)
+				}
+			} else {
+				var calls []Exception
+				LogFunction = func(level int, logID string, message string) {
+					calls = append(calls,
+						Exception{Level: level, LogID: logID, Message: message})
+					if tt.logPanic != nil {
+						panic(tt.logPanic)
+					}
+				}
+				outcome = runWorkerErrorsOperation(t, operation)
+				if len(calls) != 1 || calls[0] != expected {
+					t.Fatalf("The log function has been called with %+v instead of %+v",
+						calls, expected)
+				}
+			}
+			if outcome.recovered != tt.wantPanic {
+				t.Fatalf("logf() panicked with %#v, want %#v", outcome.recovered, tt.wantPanic)
+			}
+			if tt.wantPanic == nil && !outcome.result {
+				t.Fatalf("logf() has not returned")
+			}
+		})
+	}
+}
+
+// logErrorsRun is a case of the operation tests of this file: its fixture, the entries of
+// the log function and the state that the check compares after the operation.
+type logErrorsRun struct {
+	baseline     int
+	fixture      *workerErrorsFixture
+	copyFixture  *workerErrorsCopyFixture
+	pruneFixture *workerErrorsPruneFixture
+	logs         *workerErrorsLogs
+	outcome      workerErrorsOutcome
+	uploads      int               // The number of the uploads before the operation
+	revision     []byte            // The revision file before the operation
+	files        map[string]string // The files of the repository before the operation
+	storageFiles []string          // The files of the storage before the operation
+	stdout       bool              // The case prints to the standard output, without a log function
+	ownLog       bool              // The case has installed its own log function, which panics
+	output       string            // What the operation has printed, with stdout
+	wantPanic    interface{}       // The expected panic if it depends on the fixture, or nil
+}
+
+// startLogErrorsRun installs the log function of a case after its fixture is prepared,
+// unless the case prints to the standard output, and waits for the goroutines of the
+// preparation.
+func startLogErrorsRun(t *testing.T, run *logErrorsRun, baseline int) {
+	t.Helper()
+	run.baseline = baseline
+	if !run.stdout && !run.ownLog {
+		run.logs = collectWorkerErrorsLogs()
+	}
+	waitForWorkerErrorsGoroutines(t, baseline)
+}
+
+// runLogErrorsOperation runs the operation of a case and keeps its outcome and, if the case
+// prints to the standard output, what the operation has printed.
+func runLogErrorsOperation(t *testing.T, run *logErrorsRun, operation func() bool) {
+	t.Helper()
+	if run.stdout {
+		run.outcome, run.output = captureLogErrorsOutput(t, operation)
+	} else {
+		run.outcome = runWorkerErrorsOperation(t, operation)
+	}
+}
+
+// captureLogErrorsOutput runs the operation as runWorkerErrorsOperation does, with the
+// standard output replaced by a pipe, and returns its outcome and what it has printed.
+func captureLogErrorsOutput(t *testing.T, operation func() bool) (workerErrorsOutcome, string) {
+	t.Helper()
+	reader, writer, err := os.Pipe()
+	if err != nil {
+		t.Fatalf("Failed to create a pipe: %v", err)
+	}
+	stdout := os.Stdout
+	os.Stdout = writer
+	restored := false
+	restore := func() {
+		if !restored {
+			restored = true
+			os.Stdout = stdout
+			_ = writer.Close()
+		}
+	}
+	t.Cleanup(restore)
+	// The pipe is read concurrently, so that a long output doesn't block the operation
+	printed := make(chan string, 1)
+	go func() {
+		defer func() { _ = reader.Close() }()
+		data, _ := io.ReadAll(reader)
+		printed <- string(data)
+	}()
+	outcome := runWorkerErrorsOperation(t, operation)
+	restore()
+	return outcome, <-printed
+}
+
+// expectLogErrorsException checks that the operation has raised the expected Exception
+// after the log function, or the standard output if the case prints there, has received
+// it, and that no goroutine of it is left.
+func expectLogErrorsException(t *testing.T, method string, run *logErrorsRun,
+	wantPanic interface{}) {
+	t.Helper()
+	if run.outcome.recovered != wantPanic {
+		t.Fatalf("%s panicked with %#v, want %#v", method, run.outcome.recovered, wantPanic)
+	}
+	// A case with its own log function checks what the log function has received itself
+	if !run.ownLog {
+		exception := wantPanic.(Exception)
+		if run.stdout {
+			// The message ends a line of the output, after the header if it is enabled
+			if !strings.Contains(run.output, exception.Message+"\n") {
+				t.Fatalf("The standard output has not received %q:\n%s", exception.Message,
+					run.output)
+			}
+		} else {
+			entry := getLevelName(exception.Level) + " " + exception.LogID + " " +
+				exception.Message
+			if !strings.Contains("\n"+run.logs.String()+"\n", "\n"+entry+"\n") {
+				t.Fatalf("The log function has not received %q:\n%s", entry, run.logs.String())
+			}
+		}
+	}
+	waitForWorkerErrorsGoroutines(t, run.baseline)
+}
+
+// fileSequenceError is the Exception of the remote listing of the file sequence made by
+// corruptFileSequence, which the msgpack decoder fails to read.
+var fileSequenceError = Exception{Level: ERROR, LogID: "SNAPSHOT_PARSE",
+	Message: "Failed to load the snapshot host1 at revision 1: " +
+		"msgpack: invalid code=6e decoding bytes length"}
+
+// snapshotInfoError is the Exception of a failed lookup of the revision file.
+func snapshotInfoError(snapshotID string, revision int) Exception {
+	return Exception{Level: ERROR, LogID: "SNAPSHOT_INFO", Message: fmt.Sprintf(
+		"Failed to get the information on the snapshot %s at revision %d: "+
+			"injected GetFileInfo failure for snapshots/%s/%d", snapshotID, revision,
+		snapshotID, revision)}
+}
+
+// workerErrorsStorageFiles returns the paths of the files under the directories of the
+// storage, relative to the storage.
+func workerErrorsStorageFiles(t *testing.T, storage *FileStorage,
+	dirs ...string) []string {
+	t.Helper()
+	var files []string
+	for _, dir := range dirs {
+		root := filepath.Join(storage.storageDir, dir)
+		err := filepath.WalkDir(root, func(path string, entry fs.DirEntry, err error) error {
+			if err != nil || entry.IsDir() {
+				return err
+			}
+			relative, err := filepath.Rel(storage.storageDir, path)
+			files = append(files, filepath.ToSlash(relative))
+			return err
+		})
+		if err != nil {
+			t.Fatalf("Failed to list the files under %s: %v", dir, err)
+		}
+	}
+	sort.Strings(files)
+	return files
+}
+
+// workerErrorsRepositoryFiles returns the contents of the files of the repository by
+// their paths, without the .duplicacy directory.
+func workerErrorsRepositoryFiles(t *testing.T, top string) map[string]string {
+	t.Helper()
+	files := map[string]string{}
+	err := filepath.WalkDir(top, func(path string, entry fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if entry.IsDir() && entry.Name() == ".duplicacy" {
+			return filepath.SkipDir
+		}
+		if entry.IsDir() {
+			return nil
+		}
+		content, err := os.ReadFile(path)
+		files[path] = string(content)
+		return err
+	})
+	if err != nil {
+		t.Fatalf("Failed to read the repository: %v", err)
+	}
+	return files
+}
