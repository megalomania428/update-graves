+	if !fixture.collectionSaved() {
+		fixture.t.Fatalf("No fossil collection has been saved")
+	}
+	fixture.expectSuccess(runWorkerErrorsOperation(fixture.t, func() bool {
+		checkTestSnapshots(fixture.manager, 1, 2)
