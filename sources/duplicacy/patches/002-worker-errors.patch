+func TestWorkerErrorsPruneNoFaults(t *testing.T) {
+	fixture := newWorkerErrorsPruneFixture(t)
+	baseline := runtime.NumGoroutine()
+	fixture.expectSuccess(fixture.prune(nil, workerErrorsKeep, false))
+	waitForWorkerErrorsGoroutines(t, baseline)
+	fixture.expectOperator(nil)
+	fixture.expectPruned()
+}
+
+// testWorkerErrorsPruneAfter fails the download of the chunk sequence of revision 2 by the operation, which downloads
+// it by a task of the operator of the snapshot manager, and then checks that a prune doesn't hang on the operator.
+func testWorkerErrorsPruneAfter(t *testing.T, operation func(fixture *workerErrorsPruneFixture) bool) {
+	for _, name := range []string{"Log", "LogFunction"} {
+		t.Run(name, func(t *testing.T) {
+			fixture := newWorkerErrorsPruneFixture(t)
+			snapshot := fixture.manager.DownloadSnapshot("vm1@host1", 2)
+			fixture.storage.fail("DownloadFile", fixture.chunkPath(snapshot.ChunkSequence[0]))
+			baseline := runtime.NumGoroutine()
+			if name == "LogFunction" {
+				setWorkerErrorsLogFunction()
+			}
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				return operation(fixture)
+			})
+			LogFunction = nil
+			expectWorkerErrorsException(t, outcome, "DOWNLOAD_CHUNK")
+			fixture.expectInjected()
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectOperator(nil)
+
+			// A stopped operator left in the snapshot manager would make the prune wait for tasks that no goroutine
+			// runs
+			fixture.storage.clearFaults()
+			fixture.expectSuccess(fixture.prune(nil, workerErrorsKeep, false))
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectOperator(nil)
+			fixture.expectPruned()
+		})
+	}
+}
