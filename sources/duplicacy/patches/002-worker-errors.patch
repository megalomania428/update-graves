--- a/src/duplicacy_workererrors.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_workererrors.go	2026-11-02 22:42:19.758451177 +0000
@@ -0,0 +1,76 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"fmt"
+	"os"
+	"runtime/debug"
+	"sync"
+)
+
+// workerErrors keeps the first panic of the background goroutines of an operation, so that the goroutine that
+// called the operation can raise it again instead of the whole process exiting through CatchLogException.
+type workerErrors struct {
+	once   sync.Once
+	failed chan struct{} // Closed once the first panic has been recorded
+	value  interface{}   // The value of the first panic
+}
+
+func newWorkerErrors() *workerErrors {
+	return &workerErrors{failed: make(chan struct{})}
+}
+
+// catch records the panic of the current goroutine.  It must be deferred directly: 'defer failures.catch()'.
+func (failures *workerErrors) catch() {
+	if r := recover(); r != nil {
+		failures.record(r)
+	}
+}
+
+// record keeps the first panic and wakes up the goroutines waiting on 'failed'; later panics are dropped.
+func (failures *workerErrors) record(value interface{}) {
+	failures.once.Do(func() {
+		if _, ok := value.(Exception); ok {
+			if printStackTrace {
+				debug.PrintStack()
+			}
+		} else {
+			// Print the stack of the goroutine that panicked, as CatchLogException does
+			fmt.Fprintf(os.Stderr, "%v\n", value)
+			debug.PrintStack()
+		}
+		failures.value = value
+		close(failures.failed)
+	})
+}
+
+// hasFailed reports whether a panic has been recorded.
+func (failures *workerErrors) hasFailed() bool {
+	select {
+	case <-failures.failed:
+		return true
+	default:
+		return false
+	}
+}
+
+// raise panics in the calling goroutine with the recorded value, if there is one.
+func (failures *workerErrors) raise() {
+	if failures.hasFailed() {
+		panic(failures.value)
+	}
+}
+
+// logErrorAndPanic logs an error and raises it as an Exception even if LogFunction returns instead of panicking,
+// so that the error reaches the caller of the operation.
+func logErrorAndPanic(logID string, format string, v ...interface{}) {
+	LOG_ERROR(logID, format, v...)
+	panic(Exception{
+		Level:   ERROR,
+		LogID:   logID,
+		Message: fmt.Sprintf(format, v...),
+	})
+}
