+// TestWorkerErrorsDiff fails the download of a file chunk of the file compared by Diff, also with an operator of the
+// snapshot manager existing before Diff, and the local listing of a missing directory compared with a revision,
+// which makes Diff return false when LogFunction doesn't panic.
+func TestWorkerErrorsDiff(t *testing.T) {
+	for _, name := range []string{"File", "ExistingOperator", "LocalListing", "LocalListingLogFunction"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			fixture := newWorkerErrorsFixture(t, false)
+			fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+			listing := strings.HasPrefix(name, "LocalListing")
+			mode := "Log"
+			if name == "LocalListingLogFunction" {
+				mode = "LogFunction"
+				setWorkerErrorsLogFunction()
+			}
+			top, filePath, logID := fixture.repository, "", "LIST_FAILURE"
+			if !listing {
+				snapshot := fixture.revisionSnapshot(1)
+				entry := fixture.findFile(snapshot, "file1")
+				fixture.failDownload(snapshot.ChunkHashes[entry.StartChunk], false)
+				filePath, logID = "file1", "DOWNLOAD_CHUNK"
+			} else {
+				top = filepath.Join(fixture.repository, "missing")
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			var operator *ChunkOperator
+			if name == "ExistingOperator" {
+				operator = fixture.existingSnapshotOperator()
+				baseline = runtime.NumGoroutine()
+			}
+			diff := func() workerErrorsOutcome {
+				return runWorkerErrorsOperation(t, func() bool {
+					return fixture.manager.SnapshotManager.Diff(top, "host1", []int{1}, filePath, false, "", "", false)
+				})
+			}
+
+			expectWorkerErrorsFailure(t, mode, diff(), logID)
+			if !listing && fixture.storage.injectedCount() == 0 {
+				t.Fatalf("The download of the file chunk has not been attempted")
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectSnapshotOperator(operator)
+			if operator == nil {
+				return
+			}
+			fixture.storage.clearFaults()
+			if outcome := diff(); outcome.recovered != nil || !outcome.result {
+				t.Fatalf("The diff failed: %#v (result %t)", outcome.recovered, outcome.result)
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.stopSnapshotOperator()
+		})
+	}
+}
