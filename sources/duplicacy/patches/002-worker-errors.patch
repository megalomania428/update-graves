+// TestWorkerErrorsRestoreDroppedChunk checks that a chunk whose download ends after a
+// failure recorded by the operator, when Restore has stopped waiting for it, is returned
+// to the chunk pool.  file1 has the chunks 0 to 2.  The chunks 0 and 1 are prefetched and
+// the download of the chunk 0 goes on once both have started.  The chunk 2 is prefetched
+// while file1 waits for the chunk 1, and its download fails.  The download of the chunk 1
+// goes on only after that failure, so Restore raises the failure instead of receiving
+// the chunk 1.
+func TestWorkerErrorsRestoreDroppedChunk(t *testing.T) {
+	saveWorkerErrorsGlobals(t)
+	baseline := runtime.NumGoroutine()
+	fixture := newWorkerErrorsPrefetchFixture(t)
+	top, snapshot, storage := fixture.repository, fixture.snapshot, fixture.storage
+	if err := os.Remove(filepath.Join(top, "file1")); err != nil {
+		t.Fatalf("Failed to remove file1: %v", err)
+	}
+	// The download of the chunk 0 waits until the chunk 1 has started, and the chunk 2 is
+	// prefetched only after the chunk 0 has been received, so the chunk 1 has started
+	// before the failure of the chunk 2 is recorded
+	storage.delayDownload(fixture.chunkPath(snapshot.ChunkHashes[0], false), func() bool {
+		return storage.delayedCount() >= 2
+	})
+	fixture.failDownload(snapshot.ChunkHashes[2], false)
+	storage.delayDownload(fixture.chunkPath(snapshot.ChunkHashes[1], false), func() bool {
+		return storage.injectedCount() > 0
+	})
+	waitForWorkerErrorsGoroutines(t, baseline)
+	outstanding := fixture.outstandingChunks()
+	expectWorkerErrorsException(t, fixture.restore(top, false, false), "DOWNLOAD_CHUNK")
+	if storage.injectedCount() == 0 {
+		t.Fatalf("The download of the chunk 2 has not been attempted")
+	}
+	if storage.delayedCount() < 2 {
+		t.Fatalf("The chunks 0 and 1 have not both been prefetched")
+	}
+	if storage.lateCount() != 0 {
+		t.Fatalf("The condition of a delayed download did not hold in 10 seconds")
+	}
+	waitForWorkerErrorsGoroutines(t, baseline)
+	// No chunk is left in the downloader: the chunk 0 was reclaimed before the failure
+	if got := fixture.outstandingChunks() - outstanding; got != 0 {
+		t.Fatalf("The restore left %d chunks out of the pool", got)
+	}
+}
