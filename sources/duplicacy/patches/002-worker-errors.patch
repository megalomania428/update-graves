+// TestWorkerErrorsRestoreDropBranches checks that the downloader returns the chunk it
+// drops to the chunk pool when only Stop has been called and when only a failure has been
+// recorded by the operator.  The tests of Restore can't tell these apart after a failure,
+// since Restore stops the downloader before the dropped chunk is completed.
+func TestWorkerErrorsRestoreDropBranches(t *testing.T) {
+	for _, name := range []string{"Stopped", "Failed"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			config := CreateConfig()
+			operator := CreateChunkOperator(config, nil, nil, false, false, 1, false)
+			downloader := CreateChunkDownloader(operator)
+			chunk := config.GetChunk()
+			if name == "Stopped" {
+				downloader.Stop()
+			} else {
+				operator.failures.record(Exception{Level: ERROR, LogID: "DOWNLOAD_CHUNK"})
+			}
+			downloader.complete(chunk, 0)
+			select {
+			case returned := <-config.chunkPool:
+				if returned != chunk {
+					t.Fatalf("The pool has got another chunk than the dropped one")
+				}
+			default:
+				t.Fatalf("The dropped chunk has not been returned to the pool")
+			}
+			operator.stopWorkers()
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+}
