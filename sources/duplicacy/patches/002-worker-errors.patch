+// expectWorkerErrorsFailure checks the outcome of a failed operation: an Exception with
+// the log id when the log function panics, or false without a panic when LogFunction
+// only returns.
+func expectWorkerErrorsFailure(t *testing.T, mode string, outcome workerErrorsOutcome,
+	logID string) {
+	t.Helper()
+	if mode == "Log" {
+		expectWorkerErrorsException(t, outcome, logID)
+	} else if outcome.recovered != nil || outcome.result {
+		t.Fatalf("Expected false without a panic, got %#v (result %t)", outcome.recovered,
+			outcome.result)
+	}
+}
