+func newWorkerErrorsPruneFixture(t *testing.T) *workerErrorsPruneFixture {
+	saveWorkerErrorsGlobals(t)
+	fixture := &workerErrorsPruneFixture{t: t, testDir: filepath.Join(t.TempDir(), "snapshot_test")}
+	fixture.manager = createTestSnapshotManager(fixture.testDir)
+	fixture.raw = fixture.manager.storage.(*FileStorage)
+	fixture.storage = newFaultStorage(fixture.raw)
+	fixture.manager.storage = fixture.storage
+	for i := 0; i < 3; i++ {
+		fixture.chunks = append(fixture.chunks, uploadRandomChunk(fixture.manager, 1024))
+	}
+	fixture.now = time.Now().Unix()
+	fixture.createRevision(1, -3, fixture.chunks[0], fixture.chunks[1])
+	fixture.createRevision(2, -2, fixture.chunks[1], fixture.chunks[2])
+	return fixture
+}
+
+// createRevision creates a revision of vm1@host1 that ends the given number of days from now.
+func (fixture *workerErrorsPruneFixture) createRevision(revision int, days int64, chunkHashes ...string) {
+	end := fixture.now + days*24*3600
+	createTestSnapshot(fixture.manager, "vm1@host1", revision, end-3600, end-60, chunkHashes, "tag")
+}
+
+// prune prunes vm1@host1 with 2 threads.
+func (fixture *workerErrorsPruneFixture) prune(revisions []int, retentions []string,
+	exclusive bool) workerErrorsOutcome {
+	return runWorkerErrorsOperation(fixture.t, func() bool {
+		return fixture.manager.PruneSnapshots("vm1@host1", "vm1@host1", revisions, nil, retentions, false,
+			exclusive, nil, false, false, false, 2)
+	})
+}
+
+// chunkPath returns the path of the chunk in the storage; it must be called before a GetFileInfo fault is set.
+func (fixture *workerErrorsPruneFixture) chunkPath(chunkHash string) string {
+	fixture.t.Helper()
+	chunkID := fixture.manager.config.GetChunkIDFromHash(chunkHash)
+	chunkPath, exist, _, err := fixture.raw.FindChunk(0, chunkID, false, false)
+	if err != nil || !exist {
+		fixture.t.Fatalf("Failed to find the chunk %s: %v (exist %t)", chunkID, err, exist)
+	}
+	return chunkPath
+}
+
+// revisionExists checks the revision file in the storage itself, bypassing the faults.
+func (fixture *workerErrorsPruneFixture) revisionExists(revision int) bool {
+	fixture.t.Helper()
+	exist, _, _, err := fixture.raw.GetFileInfo(0, fmt.Sprintf("snapshots/vm1@host1/%d", revision))
+	if err != nil {
+		fixture.t.Fatalf("Failed to check the revision %d: %v", revision, err)
+	}
+	return exist
+}
+
+// expectRevisions checks that the present revisions exist and the absent ones have been deleted.
+func (fixture *workerErrorsPruneFixture) expectRevisions(present []int, absent []int) {
+	fixture.t.Helper()
+	for _, revision := range present {
+		if !fixture.revisionExists(revision) {
+			fixture.t.Fatalf("The revision %d is missing", revision)
+		}
+	}
+	for _, revision := range absent {
+		if fixture.revisionExists(revision) {
+			fixture.t.Fatalf("The revision %d has not been deleted", revision)
+		}
+	}
+}
