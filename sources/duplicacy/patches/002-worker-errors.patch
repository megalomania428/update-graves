+func TestWorkerErrorsPruneFossilize(t *testing.T) {
+	for _, name := range []string{"Log", "LogFunction", "ExistingOperator", "SkipsQueue"} {
+		t.Run(name, func(t *testing.T) {
+			fixture := newWorkerErrorsPruneFixture(t)
+			if name == "SkipsQueue" {
+				// Revision 1 gets ten more chunks to fossilize.  The prune queues the Fossilize tasks without raising
+				// the error of a failed one, so with one thread only the check of the failure before running a task
+				// stops the tasks queued after the fifth call of MoveFile
+				chunks := append([]string{}, fixture.chunks[0], fixture.chunks[1])
+				for i := 0; i < 10; i++ {
+					chunks = append(chunks, uploadRandomChunk(fixture.manager, 1024))
+				}
+				fixture.createRevision(1, -3, chunks...)
+				fixture.storage.failNthCall("MoveFile", 5)
+				baseline := runtime.NumGoroutine()
+				outcome := runWorkerErrorsOperation(t, func() bool {
+					return fixture.manager.PruneSnapshots("vm1@host1", "vm1@host1", nil, nil, workerErrorsKeep, false,
+						false, nil, false, false, false, 1)
+				})
+				expectWorkerErrorsException(t, outcome, "CHUNK_DELETE")
+				fixture.expectInjected()
+				if calls := fixture.storage.callCount("MoveFile"); calls != 5 {
+					t.Fatalf("MoveFile has been called %d times instead of 5", calls)
+				}
+				waitForWorkerErrorsGoroutines(t, baseline)
+				fixture.expectRevisions([]int{1, 2}, nil)
+				if fixture.collectionSaved() {
+					t.Fatalf("A fossil collection has been saved after the failure")
+				}
+				fixture.expectOperator(nil)
+				return
+			}
+			fixture.storage.fail("MoveFile", fixture.chunkPath(fixture.chunks[0]))
+			var operator *ChunkOperator
+			if name == "ExistingOperator" {
+				fixture.manager.CreateChunkOperator(false, false, 2, false)
+				operator = fixture.manager.chunkOperator
+				t.Cleanup(operator.stopWorkers)
+				// A fossil collected before the prune, so that clearing the fossils is checked even if the failed
+				// prune has skipped every task that would add one
+				operator.fossils = []string{"chunks/workererrors.fsl"}
+			}
+			baseline := runtime.NumGoroutine()
+			if name == "LogFunction" {
+				setWorkerErrorsLogFunction()
+			}
+			// The chunk 1 can't be turned into a fossil and no fossil of it exists
+			expectWorkerErrorsException(t, fixture.prune(nil, workerErrorsKeep, false), "CHUNK_DELETE")
+			LogFunction = nil
+			fixture.expectInjected()
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectRevisions([]int{1, 2}, nil)
+			if fixture.collectionSaved() {
+				t.Fatalf("A fossil collection has been saved after the failure")
+			}
+			fixture.expectOperator(operator)
+
+			fixture.storage.clearFaults()
+			fixture.expectSuccess(fixture.prune(nil, workerErrorsKeep, false))
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectOperator(operator)
+			fixture.expectPruned()
+		})
+	}
+}
