+		baseline := runtime.NumGoroutine()
+		fixture := newWorkerErrorsPrefetchFixture(t)
+		top, snapshot, contents := fixture.repository, fixture.snapshot, fixture.contents
+		fixture.storage.delayDownload(fixture.chunkPath(snapshot.ChunkHashes[3], false), func() bool {
+			restored, err := os.ReadFile(filepath.Join(top, "file1"))
+			return err == nil && string(restored) == string(contents["file1"])
+		})
+		if err := os.Remove(filepath.Join(top, "file1")); err != nil {
+			t.Fatalf("Failed to remove file1: %v", err)
+		}
+		filters := filepath.Join(top, ".duplicacy", "filters")
+		if err := os.WriteFile(filters, []byte("-file2\n-file3\n"), 0600); err != nil {
+			t.Fatalf("Failed to write the filters: %v", err)
+		}
+		modified := make([]byte, len(contents["file3"])-100)
+		rand.New(rand.NewSource(100)).Read(modified)
+		if err := os.WriteFile(filepath.Join(top, "file3"), modified, 0600); err != nil {
+			t.Fatalf("Failed to write file3: %v", err)
+		}
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		outcome := runWorkerErrorsOperation(t, func() bool {
+			return fixture.manager.Restore(top, 1, true, true, 2, false, false, false, false, nil, false) == 0
+		})
+		expectWorkerErrorsException(t, outcome, "DOWNLOAD_OVERWRITE")
