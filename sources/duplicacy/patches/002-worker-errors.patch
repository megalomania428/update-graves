+// workerErrorsPrefetchFixture is the repository of the tests of the chunks that Restore
+// prefetches, backed up as the revision 1.  Its file chunks are cut at 64 KiB: file1 has
+// the chunks 0 to 2, file2 the chunks 2 and 3, file3 the chunks 3 and 4.
+type workerErrorsPrefetchFixture struct {
+	*workerErrorsFixture
+	contents map[string][]byte // The contents of file1, file2 and file3
+	snapshot *Snapshot         // The revision 1
+}
+
+// newWorkerErrorsPrefetchFixture creates the repository and backs up the revision 1.
+// The caller has called saveWorkerErrorsGlobals.
+func newWorkerErrorsPrefetchFixture(t *testing.T) *workerErrorsPrefetchFixture {
+	dir := t.TempDir()
+	repository := filepath.Join(dir, "repository")
+	if err := os.MkdirAll(filepath.Join(repository, ".duplicacy"), 0700); err != nil {
+		t.Fatalf("Failed to create the repository: %v", err)
+	}
+	const chunkSize = 64 * 1024
+	contents := map[string][]byte{}
+	for i, file := range []string{"file1", "file2", "file3"} {
+		size := chunkSize
+		if file == "file1" {
+			size = 2*chunkSize + chunkSize/2
+		}
+		contents[file] = make([]byte, size)
+		rand.New(rand.NewSource(int64(i + 1))).Read(contents[file])
+		if err := os.WriteFile(filepath.Join(repository, file), contents[file], 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", file, err)
+		}
+	}
+	raw, err := CreateFileStorage(filepath.Join(dir, "storage"), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	// An average size of 2^30 keeps the rolling hash from cutting the chunks, so they are cut at the maximum size
+	if !ConfigStorage(raw, 16384, 100, 1<<30, chunkSize, chunkSize/4, "", nil, false, "", 0, 0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	fixture := &workerErrorsFixture{t: t, repository: repository, raw: raw, storage: newFaultStorage(raw)}
+	SetDuplicacyPreferencePath(filepath.Join(repository, ".duplicacy"))
+	fixture.manager = CreateBackupManager("host1", fixture.storage, repository, "", "", "", false)
+	if fixture.manager == nil || !fixture.manager.SetupSnapshotCache("default") {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	fixture.expectSuccess(fixture.backup(repository, false), 1)
+
+	snapshot := fixture.revisionSnapshot(1)
+	layout := map[string][2]int{"file1": {0, 2}, "file2": {2, 3}, "file3": {3, 4}}
+	for file, chunks := range layout {
+		entry := fixture.findFile(snapshot, file)
+		if entry.StartChunk != chunks[0] || entry.EndChunk != chunks[1] {
+			t.Fatalf("The file %s has the chunks %d to %d instead of %d to %d", file, entry.StartChunk,
+				entry.EndChunk, chunks[0], chunks[1])
+		}
+	}
+	return &workerErrorsPrefetchFixture{workerErrorsFixture: fixture, contents: contents, snapshot: snapshot}
+}
+
+// failDownloadAfterRestore makes the download of the chunk wait until the file under top
+// has been restored, and then fail: the chunk is removed from the storage once the wait
+// is over.  The failure is recorded by the operator after the restore has gone on, when
+// nothing waits for the chunk any more.
+func (fixture *workerErrorsPrefetchFixture) failDownloadAfterRestore(chunkIndex int,
+	top string, file string) {
+	fixture.t.Helper()
+	chunkPath := fixture.chunkPath(fixture.snapshot.ChunkHashes[chunkIndex], false)
+	fixture.storage.delayDownload(chunkPath, func() bool {
+		restored, err := os.ReadFile(filepath.Join(top, file))
+		if err != nil || string(restored) != string(fixture.contents[file]) {
+			return false
+		}
+		err = os.Remove(filepath.Join(fixture.raw.storageDir, chunkPath))
+		if err != nil && !os.IsNotExist(err) {
+			fixture.t.Errorf("Failed to remove the chunk %s: %v", chunkPath, err)
+		}
+		return true
+	})
+}
+
+// expectDownloadDelayed checks that the download set up by failDownloadAfterRestore has
+// started, and that its wait for the restored file did not time out.
+func (fixture *workerErrorsPrefetchFixture) expectDownloadDelayed() {
+	fixture.t.Helper()
+	if fixture.storage.delayedCount() == 0 {
+		fixture.t.Fatalf("The chunk has not been prefetched")
+	}
+	if fixture.storage.lateCount() != 0 {
+		fixture.t.Fatalf("The wait of the download for the restored file timed out")
+	}
+}
+
+// TestWorkerErrorsRestorePrefetch checks that Restore returns when a chunk prefetched for a file that is skipped
+// later is never waited for.  The chunks are cut at 64 KiB: file1 has the chunks 0 to 2, file2 the chunks 2 and 3,
+// file3 the chunks 3 and 4.  The chunk 3 is prefetched while file1 waits for the chunk 2, and file2 and file3 are
+// skipped in quick mode since the filters hide them from the local listing.  The download of the chunk 3 returns
+// only once file1 has been restored, when nothing waits for the chunk 3 any more.
+// The dropped chunk 3 is returned to the chunk pool, as a received chunk is.
+func TestWorkerErrorsRestorePrefetch(t *testing.T) {
+	saveWorkerErrorsGlobals(t)
+	baseline := runtime.NumGoroutine()
+	fixture := newWorkerErrorsPrefetchFixture(t)
+	repository, snapshot, contents := fixture.repository, fixture.snapshot, fixture.contents
+	file1 := filepath.Join(repository, "file1")
+	fixture.storage.delayDownload(fixture.chunkPath(snapshot.ChunkHashes[3], false), func() bool {
+		restored, err := os.ReadFile(file1)
+		return err == nil && string(restored) == string(contents["file1"])
+	})
+	if err := os.Remove(filepath.Join(repository, "file1")); err != nil {
+		t.Fatalf("Failed to remove file1: %v", err)
+	}
+	filters := filepath.Join(repository, ".duplicacy", "filters")
+	if err := os.WriteFile(filters, []byte("-file2\n-file3\n"), 0600); err != nil {
+		t.Fatalf("Failed to write the filters: %v", err)
+	}
+	waitForWorkerErrorsGoroutines(t, baseline)
+	outstanding := fixture.outstandingChunks()
+
+	fixture.expectRestored(fixture.restore(repository, true, false))
+	if fixture.storage.delayedCount() == 0 {
+		t.Fatalf("The chunk 3 has not been prefetched")
+	}
+	if fixture.storage.lateCount() != 0 {
+		t.Fatalf("file1 has not been restored in 10 seconds while the download of the chunk 3 waited for it")
+	}
+	restored, err := os.ReadFile(filepath.Join(repository, "file1"))
+	if err != nil || string(restored) != string(contents["file1"]) {
+		t.Fatalf("file1 has not been restored: %v", err)
+	}
+	waitForWorkerErrorsGoroutines(t, baseline)
+	// The chunk 2, which file1 received last, stays in the downloader since nothing
+	// reclaims it after the last restored file; the chunk 3 must be back in the pool
+	if got := fixture.outstandingChunks() - outstanding; got != 1 {
+		t.Fatalf("The restore left %d chunks out of the pool instead of 1: the chunk 2 "+
+			"stays in the downloader, the chunk 3 must be returned", got)
+	}
+
+	// The chunk 3 is prefetched successfully, and Restore stops at the error of file3, which differs from the
+	// snapshot and is not overwritten: it returns only if it stops the downloader that is still holding the chunk 3
+	t.Run("OverwriteAfterPrefetch", func(t *testing.T) {
