+// TestWorkerErrorsPrintAfterFailure fails the download of the chunk sequence by a task of the operator of the snapshot
+// manager: an operator created by PrintFile is removed with the failure, one existing before PrintFile is kept without
+// the failure, so that the next PrintFile doesn't raise it again.
+func TestWorkerErrorsPrintAfterFailure(t *testing.T) {
+	for _, name := range []string{"NewOperator", "ExistingOperator"} {
+		t.Run(name, func(t *testing.T) {
+			fixture := newWorkerErrorsPruneFixture(t)
+			fixture.storage.fail("DownloadFile", fixture.chunkPath(fixture.createPrintableRevision()))
+			var operator *ChunkOperator
+			if name == "ExistingOperator" {
+				fixture.manager.CreateChunkOperator(false, false, 2, false)
+				operator = fixture.manager.chunkOperator
+				t.Cleanup(operator.stopWorkers)
+			}
+			baseline := runtime.NumGoroutine()
+			printOperation := func() bool {
+				return fixture.manager.PrintFile("print@host1", 1, "")
+			}
+			expectWorkerErrorsException(t, runWorkerErrorsOperation(t, printOperation), "DOWNLOAD_CHUNK")
+			fixture.expectInjected()
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectOperator(operator)
+
+			fixture.storage.clearFaults()
+			// The earlier failure must not be raised again
+			if outcome, _ := captureLogErrorsOutput(t, printOperation); outcome.recovered != nil || !outcome.result {
+				t.Fatalf("Unexpected outcome of the print: %#v (result %t)", outcome.recovered, outcome.result)
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectOperator(operator)
+		})
+	}
+}
