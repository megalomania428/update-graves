+func TestSnapshot_ListLocalFiles(t *testing.T) {
+	type fields struct {
+		Version        int
+		ID             string
+		Revision       int
+		Options        string
+		Tag            string
+		StartTime      int64
+		EndTime        int64
+		FileSize       int64
+		NumberOfFiles  int64
+		FileSequence   []string
+		ChunkSequence  []string
+		LengthSequence []string
+		ChunkHashes    []string
+		ChunkLengths   []int
+		Flag           bool
+	}
+	type args struct {
+		top                string
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		listingChannel     chan *Entry
+		stop               <-chan struct{}
+		skippedDirectories *[]string
+		skippedFiles       *[]string
+	}
+	var logged int64
+	// The stop channel is closed by the case after the first entry is received, so prepare returns the closing function
+	tests := []struct {
+		name    string
+		fields  fields
+		args    args
+		prepare func(t *testing.T, args *args) (closeStop func())
+		check   func(t *testing.T, args args, closeStop func(), done <-chan struct{})
+	}{
+		{
+			// The failure of the listing of the directory, which is raised after 'stop' is closed, is not covered: the
+			// window between the end of the read of a directory and the check of 'stop' can't be created without a test
+			// point in the code
+			name: "StopInDirectory",
+			prepare: func(t *testing.T, args *args) func() {
+				const files = 2000
+				args.top = t.TempDir()
+				args.filtersFile = filepath.Join(args.top, "no-such-filters")
+				for i := 0; i < files; i++ {
+					if err := os.WriteFile(filepath.Join(args.top, fmt.Sprintf("f%04d", i)), nil, 0600); err != nil {
+						t.Fatalf("Failed to write the file %d: %v", i, err)
+					}
+				}
+				args.listingChannel = make(chan *Entry)
+				stop := make(chan struct{})
+				args.stop = stop
+				return func() { close(stop) }
+			},
+			check: func(t *testing.T, args args, closeStop func(), done <-chan struct{}) {
+				select {
+				case <-args.listingChannel:
+				case <-time.After(10 * time.Second):
+					t.Fatalf("The listing has not sent an entry")
+				}
+				closeStop()
+				received := 0
+				for range args.listingChannel {
+					received++
+				}
+				<-done
+				// One entry may be sent by the select that has already been waiting when 'stop' was closed
+				if received > 1 {
+					t.Fatalf("The listing has sent %d entries of the directory after 'stop' was closed", received)
+				}
+			},
+		},
+		{
+			// A filters file that is not valid would be logged and raised by its processing, which must not start
+			name: "StoppedBefore",
+			prepare: func(t *testing.T, args *args) func() {
+				args.top = t.TempDir()
+				args.filtersFile = filepath.Join(t.TempDir(), "filters")
+				if err := os.WriteFile(args.filtersFile, []byte("e:[\n"), 0600); err != nil {
+					t.Fatalf("Failed to write the filters file: %v", err)
+				}
+				if err := os.WriteFile(filepath.Join(args.top, "f"), nil, 0600); err != nil {
+					t.Fatalf("Failed to write the file: %v", err)
+				}
+				args.listingChannel = make(chan *Entry)
+				stop := make(chan struct{})
+				close(stop)
+				args.stop = stop
+				LogFunction = func(level int, logID string, message string) {
+					atomic.AddInt64(&logged, 1)
+				}
+				return func() {}
+			},
+			check: func(t *testing.T, args args, closeStop func(), done <-chan struct{}) {
+				select {
+				case entry, ok := <-args.listingChannel:
+					if ok {
+						t.Fatalf("The listing has sent %v after 'stop' was closed", entry)
+					}
+				case <-time.After(10 * time.Second):
+					t.Fatalf("The listing has not closed the channel")
+				}
+				<-done
+				if count := atomic.LoadInt64(&logged); count != 0 {
+					t.Fatalf("The listing has written %d log records after 'stop' was closed", count)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			baseline := runtime.NumGoroutine()
+			closeStop := tt.prepare(t, &tt.args)
+			snapshot := &Snapshot{
+				Version:        tt.fields.Version,
+				ID:             tt.fields.ID,
+				Revision:       tt.fields.Revision,
+				Options:        tt.fields.Options,
+				Tag:            tt.fields.Tag,
+				StartTime:      tt.fields.StartTime,
+				EndTime:        tt.fields.EndTime,
+				FileSize:       tt.fields.FileSize,
+				NumberOfFiles:  tt.fields.NumberOfFiles,
+				FileSequence:   tt.fields.FileSequence,
+				ChunkSequence:  tt.fields.ChunkSequence,
+				LengthSequence: tt.fields.LengthSequence,
+				ChunkHashes:    tt.fields.ChunkHashes,
+				ChunkLengths:   tt.fields.ChunkLengths,
+				Flag:           tt.fields.Flag,
+			}
+			done := make(chan struct{})
+			var listingPanic interface{}
+			go func() {
+				defer close(done)
+				defer func() { listingPanic = recover() }()
+				snapshot.ListLocalFiles(tt.args.top, tt.args.nobackupFile, tt.args.filtersFile, tt.args.excludeByAttribute, tt.args.listingChannel, tt.args.stop, tt.args.skippedDirectories, tt.args.skippedFiles)
+			}()
+			tt.check(t, tt.args, closeStop, done)
+			if listingPanic != nil {
+				t.Fatalf("The listing has panicked: %#v", listingPanic)
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+}
