+// TestWorkerErrorsBackupRemoteDownload checks that Backup returns after a failed
+// download of the remote listing.  With the default log the failure exits the process
+// in the worker, so only a log function that returns is tested.
+func TestWorkerErrorsBackupRemoteDownload(t *testing.T) {
+	// A failed download that is not allowed to fail never completes, so the remote
+	// listing stays blocked in the download for good; the operator does not report
+	// such a failure yet.  Backup must not wait for this goroutine.  The blocked
+	// goroutine is exactly one new goroutine in the remote listing, and no more than
+	// baseline+1 goroutines are running in total, so nothing else is left behind.
+	expectBlockedListing := func(t *testing.T, baseline int, listings int) {
+		t.Helper()
+		waitForWorkerErrorsGoroutines(t, baseline+1)
+		if got := workerErrorsListingGoroutines(); got != listings+1 {
+			t.Fatalf("%d goroutines are blocked in the remote listing instead of %d:\n%s",
+				got, listings+1, workerErrorsStacks())
+		}
+	}
+
+	t.Run("EmptyListing", func(t *testing.T) {
+		baseline := runtime.NumGoroutine()
+		listings := workerErrorsListingGoroutines()
+		fixture := newWorkerErrorsFixture(t, false)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		snapshot := fixture.manager.SnapshotManager.DownloadSnapshot("host1", 1)
+		if snapshot == nil || len(snapshot.FileSequence) == 0 {
+			t.Fatalf("The revision 1 has no file sequence")
+		}
+		chunkID := fixture.manager.config.GetChunkIDFromHash(snapshot.FileSequence[0])
+		chunkPath, exist, _, err := fixture.raw.FindChunk(0, chunkID, false, true)
+		if err != nil || !exist {
+			t.Fatalf("Failed to find the chunk %s: %v (exist %t)", chunkID, err, exist)
+		}
+		fixture.storage.fail("DownloadFile", chunkPath)
+
+		// A copy of the chunk in the snapshot cache would be read instead of the storage
+		cache := fixture.manager.snapshotCache
+		cachedPath, exist, _, err := cache.FindChunk(0, chunkID, false, true)
+		if err != nil {
+			t.Fatalf("Failed to find the cached chunk %s: %v", chunkID, err)
+		}
+		if exist {
+			if err = cache.DeleteFile(0, cachedPath); err != nil {
+				t.Fatalf("Failed to delete the cached chunk %s: %v", chunkID, err)
+			}
+		}
+		if _, exist, _, err = cache.FindChunk(0, chunkID, false, true); err != nil || exist {
+			t.Fatalf("The chunk %s is still cached: %v (exist %t)", chunkID, err, exist)
+		}
+
+		// The local listing is empty, so the comparison ends without asking for a remote entry
+		for _, name := range []string{"file1", "file2", "dir1"} {
+			if err = os.RemoveAll(filepath.Join(fixture.repository, name)); err != nil {
+				t.Fatalf("Failed to remove %s: %v", name, err)
+			}
+		}
+		setWorkerErrorsLogFunction()
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		outcome := fixture.backup(fixture.repository, true)
+		if outcome.recovered != nil || outcome.result {
+			t.Fatalf("Expected false without a panic, got %#v (result %t)", outcome.recovered,
+				outcome.result)
+		}
+		if fixture.revisionExists(2) {
+			t.Fatalf("The revision 2 has been created despite the empty listing")
+		}
+		if fixture.storage.injectedCount() == 0 {
+			t.Fatalf("The download of the file sequence has not been attempted")
+		}
+		expectBlockedListing(t, baseline, listings)
+	})
+
+	t.Run("SecondChunk", func(t *testing.T) {
+		baseline := runtime.NumGoroutine()
+		listings := workerErrorsListingGoroutines()
+		fixture := newWorkerErrorsFixture(t, false)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		chunks := fixture.manager.SnapshotManager.DownloadSnapshot("host1", 1)
+		if chunks == nil {
+			t.Fatalf("Failed to download the revision 1")
+		}
+		fixture.manager.SnapshotManager.GetSnapshotChunks(chunks, true)
+		if len(chunks.ChunkHashes) == 0 {
+			t.Fatalf("The revision 1 has no file chunks")
+		}
+		// A file chunk is not in the snapshot cache; it is appended to the file
+		// sequence as its second chunk, which the listing asks for only after sending
+		// the last entry
+		dataHash := chunks.ChunkHashes[0]
+		dataID := fixture.manager.config.GetChunkIDFromHash(dataHash)
+		_, exist, _, err := fixture.manager.snapshotCache.FindChunk(0, dataID, false, true)
+		if err != nil || exist {
+			t.Fatalf("The chunk %s is cached: %v (exist %t)", dataID, err, exist)
+		}
+		chunkPath, exist, _, err := fixture.raw.FindChunk(0, dataID, false, false)
+		if err != nil || !exist {
+			t.Fatalf("Failed to find the chunk %s: %v (exist %t)", dataID, err, exist)
+		}
+		snapshot := fixture.manager.SnapshotManager.DownloadSnapshot("host1", 1)
+		if snapshot == nil || len(snapshot.FileSequence) != 1 {
+			t.Fatalf("The revision 1 must have exactly one file sequence chunk")
+		}
+		snapshot.FileSequence = append(snapshot.FileSequence, dataHash)
+		description, err := snapshot.MarshalJSON()
+		if err != nil {
+			t.Fatalf("Failed to encode the revision 1: %v", err)
+		}
+		if !fixture.manager.SnapshotManager.UploadFile("snapshots/host1/1",
+			"snapshots/host1/1", description) {
+			t.Fatalf("Failed to upload the revision 1")
+		}
+		fixture.storage.fail("DownloadFile", chunkPath)
+		fixture.stopSnapshotOperator()
+		setWorkerErrorsLogFunction()
+		waitForWorkerErrorsGoroutines(t, baseline)
+
+		// Every local entry matches a remote one, so the comparison ends before the
+		// failed download
+		fixture.expectSuccess(fixture.backup(fixture.repository, true), 2)
+		if fixture.storage.injectedCount() == 0 {
+			t.Fatalf("The download of the second chunk has not been attempted")
+		}
+		expectBlockedListing(t, baseline, listings)
+	})
+}
