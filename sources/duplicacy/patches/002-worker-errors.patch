+// workerErrorsCopyOrder is shared by the wrappers of the source and the destination storages of a copy: the first
+// chunk upload waits until the chunk download with the number 'failing' has started and then 200 ms more, so that
+// the copy is waiting for that download, and fails; that download waits until the upload has failed and then
+// 200 ms more, so that the upload failure has been recorded, and fails too.  The upload flag is set before the error
+// is returned from UploadFile, and that the copy has recorded the upload failure within the 200 ms is an assumption
+// about the scheduler: the window between the flag and the record can't be observed without a test point in the
+// production code, so the test doesn't check it.
+type workerErrorsCopyOrder struct {
+	failing        int32 // The number of the failing chunk download, counted from 1
+	downloads      int32 // The number of chunk downloads started
+	uploads        int32 // The number of chunk uploads started
+	started        int32 // Set once the failing download has started
+	uploadFailed   int32 // Set once the first chunk upload has failed
+	downloadFailed int32 // Set once the failing download has failed
+	late           int32 // The number of waits whose condition didn't hold in 10 seconds
+}
+
+// wait waits until the flag is set, for 10 seconds at most, and then for 200 ms more.
+func (order *workerErrorsCopyOrder) wait(flag *int32) {
+	for deadline := time.Now().Add(10 * time.Second); atomic.LoadInt32(flag) == 0; time.Sleep(10 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			atomic.AddInt32(&order.late, 1)
+			return
+		}
+	}
+	time.Sleep(200 * time.Millisecond)
+}
+
+// workerErrorsOrderedStorage wraps the storage of the source or the destination with the shared order.
+type workerErrorsOrderedStorage struct {
+	Storage
+	order *workerErrorsCopyOrder
+}
+
+func (storage *workerErrorsOrderedStorage) DownloadFile(threadIndex int, filePath string, chunk *Chunk) error {
+	order := storage.order
+	if strings.HasPrefix(filePath, "chunks/") && atomic.AddInt32(&order.downloads, 1) == order.failing {
+		atomic.StoreInt32(&order.started, 1)
+		order.wait(&order.uploadFailed)
+		atomic.StoreInt32(&order.downloadFailed, 1)
+		return fmt.Errorf("injected DownloadFile failure for %s", filePath)
+	}
+	return storage.Storage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+func (storage *workerErrorsOrderedStorage) UploadFile(threadIndex int, filePath string, content []byte) error {
+	order := storage.order
+	if strings.HasPrefix(filePath, "chunks/") && atomic.AddInt32(&order.uploads, 1) == 1 {
+		order.wait(&order.started)
+		atomic.StoreInt32(&order.uploadFailed, 1)
+		return fmt.Errorf("injected UploadFile failure for %s", filePath)
+	}
+	return storage.Storage.UploadFile(threadIndex, filePath, content)
+}
+
+// TestWorkerErrorsCopyFailureOrder fails a chunk upload and then a chunk download that was running when the upload
+// failed: the copy raises the upload failure, which came first, both when the loop adding the chunks raises it and
+// when the downloading operator is stopped after the last chunk has been added.  The pause of 200 ms after the flag
+// of the upload failure is a scheduler assumption, as described at workerErrorsCopyOrder.
+func TestWorkerErrorsCopyFailureOrder(t *testing.T) {
+	for _, name := range []string{"LoopLog", "LoopLogFunction", "StopLog", "StopLogFunction"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			fixture := newWorkerErrorsCopyFixture(t)
+			// With one thread of each operator the second download starts once the first chunk has been passed to
+			// the uploading operator, and the copy waits to add the fourth chunk while that download is held
+			order := &workerErrorsCopyOrder{failing: 2}
+			uploadingThreads := 1
+			if strings.HasPrefix(name, "Stop") {
+				// The last download starts after every chunk has been added, and the other uploads don't wait for
+				// the held one
+				order.failing = int32(fixture.chunkCount())
+				uploadingThreads = int(order.failing)
+			}
+			fixture.manager.storage = &workerErrorsOrderedStorage{Storage: fixture.storage, order: order}
+			fixture.destination.storage = &workerErrorsOrderedStorage{Storage: fixture.destinationStorage,
+				order: order}
+			if strings.HasSuffix(name, "LogFunction") {
+				setWorkerErrorsLogFunction()
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+
+			expectWorkerErrorsException(t, runWorkerErrorsOperation(t, func() bool {
+				return fixture.manager.CopySnapshots(fixture.destination, "host1", []int{1}, uploadingThreads, 1)
+			}), "UPLOAD_CHUNK")
+			late := atomic.LoadInt32(&order.late)
+			if atomic.LoadInt32(&order.downloadFailed) == 0 || late != 0 {
+				t.Fatalf("The download %d has not failed after the upload: %d late waits", order.failing, late)
+			}
+			fixture.expectNotCopied(baseline)
+		})
+	}
+}
+
+// workerErrorsHeldStorage holds the calls of one operation on the benchmark chunks: the failing chunk waits until
+// another call is held, and the other calls wait until the failure has been injected and then 200 ms more.  So the
+// chunk fails while another goroutine is running a job, and that goroutine has to return without blocking before
+// Benchmark raises the failure.
+type workerErrorsHeldStorage struct {
+	*faultStorage
+	operation string // The held operation, or empty
+	failed    string // The path of the failing chunk
+	held      int32  // The number of held calls of the other chunks
+	running   int32  // The number of held calls of the other chunks that haven't returned yet
+	late      int32  // The number of held calls whose condition didn't hold in 10 seconds
+}
+
+// hold holds the call and returns whether it is a held call of another chunk, which runs until the call returns.
+func (storage *workerErrorsHeldStorage) hold(operation string, filePath string) bool {
+	if operation != storage.operation || !strings.HasPrefix(filePath, "benchmark/chunk") {
+		return false
+	}
+	other := filePath != storage.failed
+	ready := func() bool { return storage.injectedCount() > 0 }
+	if !other {
+		ready = func() bool { return atomic.LoadInt32(&storage.held) > 0 }
+	} else {
+		atomic.AddInt32(&storage.held, 1)
+		atomic.AddInt32(&storage.running, 1)
+	}
+	for deadline := time.Now().Add(10 * time.Second); !ready(); time.Sleep(10 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			atomic.AddInt32(&storage.late, 1)
+			return other
+		}
+	}
+	if other {
+		time.Sleep(200 * time.Millisecond)
+	}
+	return other
+}
+
+func (storage *workerErrorsHeldStorage) UploadFile(threadIndex int, filePath string, content []byte) error {
+	if storage.hold("UploadFile", filePath) {
+		defer atomic.AddInt32(&storage.running, -1)
+	}
+	return storage.faultStorage.UploadFile(threadIndex, filePath, content)
+}
+
+func (storage *workerErrorsHeldStorage) DownloadFile(threadIndex int, filePath string, chunk *Chunk) error {
+	if storage.hold("DownloadFile", filePath) {
+		defer atomic.AddInt32(&storage.running, -1)
+	}
+	return storage.faultStorage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+// workerErrorsBenchmarkFixture is a local directory and a file storage wrapped by faultStorage for Benchmark.
+type workerErrorsBenchmarkFixture struct {
+	t       *testing.T
+	local   string // The directory of the local benchmark file
+	storage *workerErrorsHeldStorage
+}
+
+func newWorkerErrorsBenchmarkFixture(t *testing.T) *workerErrorsBenchmarkFixture {
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	fixture := &workerErrorsBenchmarkFixture{t: t, local: filepath.Join(dir, "local")}
+	if err := os.MkdirAll(fixture.local, 0700); err != nil {
+		t.Fatalf("Failed to create the local directory: %v", err)
+	}
+	raw, err := CreateFileStorage(filepath.Join(dir, "storage"), false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	fixture.storage = &workerErrorsHeldStorage{faultStorage: newFaultStorage(raw)}
+	return fixture
+}
+
+// run runs a benchmark of 16 chunks of 4 KB with 2 uploading and 2 downloading threads, so that more chunks than
+// threads are left when an early chunk fails.
+func (fixture *workerErrorsBenchmarkFixture) run() workerErrorsOutcome {
+	return runWorkerErrorsOperation(fixture.t, func() bool {
+		return Benchmark(fixture.local, fixture.storage, 64*1024, 4096, 16, 2, 2)
+	})
+}
+
+func (fixture *workerErrorsBenchmarkFixture) expectFileRemoved() {
+	fixture.t.Helper()
+	if _, err := os.Stat(filepath.Join(fixture.local, "benchmark.dat")); !os.IsNotExist(err) {
+		fixture.t.Fatalf("The local benchmark file has not been removed: %v", err)
+	}
+}
+
+// TestWorkerErrorsBenchmark fails the upload and the download of the first chunk of Benchmark while another
+// goroutine is running a job, which must return without blocking before Benchmark raises the failure.
+func TestWorkerErrorsBenchmark(t *testing.T) {
+	for _, name := range []string{"UploadLog", "UploadLogFunction", "DownloadLog", "DownloadLogFunction"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			fixture := newWorkerErrorsBenchmarkFixture(t)
+			operation, logID := "UploadFile", "BENCHMARK_UPLOAD"
+			if strings.HasPrefix(name, "Download") {
+				operation, logID = "DownloadFile", "BENCHMARK_DOWNLOAD"
+			}
+			fixture.storage.operation, fixture.storage.failed = operation, "benchmark/chunk0"
+			fixture.storage.fail(operation, "benchmark/chunk0")
+			if strings.HasSuffix(name, "LogFunction") {
+				setWorkerErrorsLogFunction()
+			}
+
+			outcome := fixture.run()
+			running := atomic.LoadInt32(&fixture.storage.running)
+			expectWorkerErrorsException(t, outcome, logID)
+			if fixture.storage.injectedCount() == 0 {
+				t.Fatalf("The chunk has not been attempted")
+			}
+			held, late := atomic.LoadInt32(&fixture.storage.held), atomic.LoadInt32(&fixture.storage.late)
+			if held != 1 || late != 0 {
+				t.Fatalf("Not exactly one job was running at the failure: %d held and %d late calls", held, late)
+			}
+			if running != 0 {
+				t.Fatalf("Benchmark has raised the failure with %d held calls still running", running)
+			}
+			fixture.expectFileRemoved()
+			waitForWorkerErrorsGoroutines(t, baseline)
+		})
+	}
+}
+
+func TestWorkerErrorsBenchmarkNoFaults(t *testing.T) {
+	baseline := runtime.NumGoroutine()
+	fixture := newWorkerErrorsBenchmarkFixture(t)
+	outcome := fixture.run()
+	if outcome.recovered != nil || !outcome.result {
+		t.Fatalf("The benchmark failed: %#v (result %t)", outcome.recovered, outcome.result)
+	}
+	fixture.expectFileRemoved()
+	waitForWorkerErrorsGoroutines(t, baseline)
+}
