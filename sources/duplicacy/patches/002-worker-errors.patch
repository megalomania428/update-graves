+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"fmt"
+	"os"
+	"reflect"
+	"runtime"
+	"runtime/debug"
+	"strings"
+	"sync"
+)
+
+// workerErrors keeps the first panic of the background goroutines of an operation, so that the goroutine that
+// called the operation can raise it again instead of the whole process exiting through CatchLogException.
+type workerErrors struct {
+	once   sync.Once
+	failed chan struct{} // Closed once the first panic has been recorded
+	value  interface{}   // The value of the first panic
+}
+
+func newWorkerErrors() *workerErrors {
+	return &workerErrors{failed: make(chan struct{})}
+}
+
+// catch records the panic of the current goroutine.  It must be deferred directly: 'defer failures.catch()'.
+func (failures *workerErrors) catch() {
+	if r := recover(); r != nil {
+		failures.record(r)
+	}
+}
+
+// record keeps the first panic and wakes up the goroutines waiting on 'failed'; later panics are dropped.  What it
+// prints is remembered, so that CatchLogException doesn't print it again once raise has brought the panic to the
+// goroutine that called the operation.
+func (failures *workerErrors) record(value interface{}) {
+	failures.once.Do(func() {
+		if _, ok := value.(Exception); ok {
+			if printStackTrace {
+				debug.PrintStack()
+				rememberPrinted(value)
+			}
+		} else {
+			// Print the stack of the goroutine that panicked, as CatchLogException does
+			fmt.Fprintf(os.Stderr, "%v\n", value)
+			debug.PrintStack()
+			rememberPrinted(value)
+		}
+		failures.value = value
+		close(failures.failed)
+	})
+}
+
+// hasFailed reports whether a panic has been recorded.
+func (failures *workerErrors) hasFailed() bool {
+	select {
+	case <-failures.failed:
+		return true
+	default:
+		return false
+	}
+}
+
+// raise panics in the calling goroutine with the recorded value, if there is one.
+func (failures *workerErrors) raise() {
+	if failures.hasFailed() {
+		panic(failures.value)
+	}
+}
+
+// printedPanics are the panics that record has printed, the last maxPrintedPanics of them, so that CatchLogException
+// doesn't print them again; the panics of up to maxPrintedPanics operators failing at the same time are kept.
+const maxPrintedPanics = 64
+
+var printedPanics struct {
+	sync.Mutex
+	values []interface{}
+}
+
+// rememberPrinted keeps the value of a panic that record has printed.
+func rememberPrinted(value interface{}) {
+	printedPanics.Lock()
+	defer printedPanics.Unlock()
+	if len(printedPanics.values) == maxPrintedPanics {
+		printedPanics.values = printedPanics.values[1:]
+	}
+	printedPanics.values = append(printedPanics.values, value)
+}
+
+// wasPrinted reports whether value is a panic that record has printed and that raise has brought to the current
+// goroutine: the frame of raise is then still on the stack of the deferred function calling wasPrinted, so the same
+// value panicked anew elsewhere is printed again.  Values that can't be compared with == are compared with
+// reflect.DeepEqual, so that the comparison never panics.  A value that is not equal to itself, such as NaN, a
+// function or a struct holding either, can't be recognized by any comparison: it is taken as printed when a
+// printed value of the same dynamic type is not equal to itself either.
+func wasPrinted(value interface{}) bool {
+	if value == nil || !raisedByWorkerErrors() {
+		return false
+	}
+	printedPanics.Lock()
+	defer printedPanics.Unlock()
+	if !reflect.DeepEqual(value, value) {
+		for _, printed := range printedPanics.values {
+			if reflect.TypeOf(printed) == reflect.TypeOf(value) && !reflect.DeepEqual(printed, printed) {
+				return true
+			}
+		}
+		return false
+	}
+	canCompare := reflect.ValueOf(value).Comparable()
+	for _, printed := range printedPanics.values {
+		if canCompare && reflect.ValueOf(printed).Comparable() {
+			if value == printed {
+				return true
+			}
+		} else if reflect.DeepEqual(value, printed) {
+			return true
+		}
+	}
+	return false
+}
+
+// raisedByWorkerErrors reports whether the stack of the current goroutine has the frame of workerErrors.raise.
+func raisedByWorkerErrors() bool {
+	pcs := make([]uintptr, 256)
+	frames := runtime.CallersFrames(pcs[:runtime.Callers(1, pcs)])
+	for {
+		frame, more := frames.Next()
+		if strings.HasSuffix(frame.Function, ".(*workerErrors).raise") {
+			return true
+		}
+		if !more {
+			return false
+		}
+	}
+}
+
+// keepPanic runs cleanup, a deferred function of an operation, and must be deferred directly:
+// 'defer keepPanic(cleanup)'.  While a panic is propagated, a panic of cleanup itself, such as one of a LogFunction
+// that it calls, is dropped and the original value is raised again, so that the cleanup doesn't replace the error
+// of the operation.  Without a panic cleanup runs as before.
+func keepPanic(cleanup func()) {
+	if value := recover(); value != nil {
+		func() {
+			defer func() {
+				recover()
+			}()
+			cleanup()
+		}()
+		panic(value)
+	}
+	cleanup()
+}
