+// gcdListRun is a case of TestGCDStorage_ListFiles: the storage whose service talks to a local server, the server
+// and the goroutines before they were started.
+type gcdListRun struct {
+	storage  *GCDStorage
+	server   *httptest.Server
+	baseline int
+}
+
+// newGCDListRun creates a GCDStorage for a local server that answers the listing of a directory with respond(parent
+// id, writer); the directories in idCache are known to the storage.
+func newGCDListRun(t *testing.T, idCache map[string]string, respond func(parentID string, w http.ResponseWriter)) *gcdListRun {
+	t.Helper()
+	saveWorkerErrorsGlobals(t)
+	run := &gcdListRun{baseline: runtime.NumGoroutine()}
+	parentPattern := regexp.MustCompile(`'([^']+)' in parents`)
+	run.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		match := parentPattern.FindStringSubmatch(r.URL.Query().Get("q"))
+		if match == nil {
+			http.Error(w, "unexpected query", http.StatusBadRequest)
+			return
+		}
+		respond(match[1], w)
+	}))
+	t.Cleanup(run.server.Close)
+	service, err := drive.New(run.server.Client())
+	if err != nil {
+		t.Fatalf("Failed to create the drive service: %v", err)
+	}
+	service.BasePath = run.server.URL + "/"
+	run.storage = &GCDStorage{service: service, idCache: idCache, backoffs: []int{1, 1}, attempts: []int{0, 0},
+		driveID: GCDUserDrive, spaces: "drive", numberOfThreads: 2}
+	run.storage.DerivedStorage = run.storage
+	return run
+}
+
+// writeGCDFiles answers a listing with the files.
+func writeGCDFiles(w http.ResponseWriter, files ...*drive.File) {
+	w.Header().Set("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(&drive.FileList{Files: files}); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	}
+}
+
+// writeGCDNotFound answers a listing with the error 404, which the storage doesn't retry, and returns once the
+// response has been written to the connection.
+func writeGCDNotFound(w http.ResponseWriter) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusNotFound)
+	_, _ = w.Write([]byte(`{"error":{"code":404,"message":"not found"}}`))
+	w.(http.Flusher).Flush()
+}
+
+// gcdListBarrier orders the listings of the directories fossils and chunks/x, which run in parallel: fossils is
+// answered with 404 only after chunks/x has been asked for, and chunks/x only after that answer has been written, so
+// that neither can be answered before the other goroutine is running.
+type gcdListBarrier struct {
+	t         *testing.T
+	asked     chan struct{}
+	askedOnce sync.Once
+	answered  chan struct{}
+}
+
+func newGCDListBarrier(t *testing.T) *gcdListBarrier {
+	return &gcdListBarrier{t: t, asked: make(chan struct{}), answered: make(chan struct{})}
+}
+
+// notFound answers the listing of fossils.
+func (barrier *gcdListBarrier) notFound(w http.ResponseWriter) {
+	barrier.wait(barrier.asked)
+	writeGCDNotFound(w)
+	close(barrier.answered)
+}
+
+// ask is called by the listing of chunks/x, which goes on once fossils has been answered.
+func (barrier *gcdListBarrier) ask() {
+	barrier.askedOnce.Do(func() { close(barrier.asked) })
+	barrier.wait(barrier.answered)
+}
+
+func (barrier *gcdListBarrier) wait(channel chan struct{}) {
+	select {
+	case <-channel:
+	case <-time.After(10 * time.Second):
+		barrier.t.Errorf("The listing did not reach its barrier in 10 seconds")
+	}
+}
