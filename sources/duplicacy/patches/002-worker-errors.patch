+// expectWorkerErrorsLogged checks that the log function of collectWorkerErrorsLogs has
+// received the error, if the mode of setWorkerErrorsMode has installed it.
+func expectWorkerErrorsLogged(t *testing.T, logs *workerErrorsLogs, logID string) {
+	t.Helper()
+	if logs != nil && !strings.Contains("\n"+logs.String(), "\nERROR "+logID+" ") {
+		t.Fatalf("The log function has not received the error %s:\n%s", logID, logs.String())
+	}
+}
