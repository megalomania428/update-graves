+// TestGCDStorage_ListFiles lists the chunk directories of a Google Drive storage served by a local server.  The cases
+// are added to the skeleton generated by gotests: the fields come from the storage of the case, without the locks,
+// which vet doesn't let a test copy.  A panic of the goroutines that list chunks/, fossils/ and chunks/x is raised
+// in the goroutine calling ListFiles, an error of one of them stops the others, and a directory without an ID is
+// listed as empty.  The send of a directory after an error is not covered: its wait at the moment ListFiles returns is
+// not created without a test point in the production code.
+func TestGCDStorage_ListFiles(t *testing.T) {
+	type fields struct {
+		StorageBase     StorageBase
+		service         *drive.Service
+		idCache         map[string]string
+		backoffs        []int
+		attempts        []int
+		driveID         string
+		spaces          string
+		isConnected     bool
+		numberOfThreads int
+		TestMode        bool
+	}
+	type args struct {
+		threadIndex int
+		dir         string
+	}
+	chunksListing := args{threadIndex: 0, dir: "chunks/"}
+	knownIDs := func() map[string]string { return map[string]string{"chunks": "chunks-id", "fossils": "fossils-id"} }
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      []string
+		want1     []int64
+		wantErr   bool
+		wantPanic interface{}
+		prepare   func(t *testing.T) *gcdListRun
+		check     func(t *testing.T, err error)
+	}{
+		{
+			name: "LogFunctionPanic", args: chunksListing, wantPanic: "gcd-log-panic",
+			prepare: func(t *testing.T) *gcdListRun {
+				run := newGCDListRun(t, knownIDs(), func(parentID string, w http.ResponseWriter) {
+					writeGCDFiles(w, gcdDirectory)
+				})
+				LogFunction = func(level int, logID string, message string) {
+					if logID == "GCD_STORAGE" {
+						panic("gcd-log-panic")
+					}
+				}
+				return run
+			},
+		},
+		{
+			name: "ListingError", args: chunksListing, wantErr: true,
+			prepare: func(t *testing.T) *gcdListRun {
+				barrier := newGCDListBarrier(t)
+				return newGCDListRun(t, knownIDs(), func(parentID string, w http.ResponseWriter) {
+					switch parentID {
+					case "chunks-id":
+						writeGCDFiles(w, gcdDirectory)
+					case "fossils-id":
+						barrier.notFound(w)
+					default:
+						barrier.ask()
+						writeGCDNotFound(w)
+					}
+				})
+			},
+			check: func(t *testing.T, err error) {
+				var apiError *googleapi.Error
+				if !errors.As(err, &apiError) || apiError.Code != http.StatusNotFound {
+					t.Fatalf("Expected the error 404 of a listing, got %v", err)
+				}
+			},
+		},
+		{
+			name: "ErrorAndPanic", args: chunksListing, wantPanic: "gcd-listing-panic",
+			prepare: func(t *testing.T) *gcdListRun {
+				barrier := newGCDListBarrier(t)
+				run := newGCDListRun(t, knownIDs(), func(parentID string, w http.ResponseWriter) {
+					switch parentID {
+					case "chunks-id":
+						writeGCDFiles(w, gcdDirectory)
+					case "fossils-id":
+						barrier.notFound(w)
+					default:
+						barrier.ask()
+						writeGCDFiles(w)
+					}
+				})
+				LogFunction = func(level int, logID string, message string) {
+					if logID == "GCD_STORAGE" && strings.Contains(message, "chunks/x") {
+						panic("gcd-listing-panic")
+					}
+				}
+				return run
+			},
+		},
+		{
+			name: "MissingID", args: chunksListing, want: []string{"ab"}, want1: []int64{7},
+			prepare: func(t *testing.T) *gcdListRun {
+				return newGCDListRun(t, map[string]string{"chunks": "chunks-id"},
+					func(parentID string, w http.ResponseWriter) {
+						writeGCDFiles(w, &drive.File{Name: "ab", Id: "ab-id", MimeType: GCDFileMimeType, Size: 7})
+					})
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			run := tt.prepare(t)
+			source := run.storage
+			tt.fields = fields{
+				StorageBase:     source.StorageBase,
+				service:         source.service,
+				idCache:         source.idCache,
+				backoffs:        source.backoffs,
+				attempts:        source.attempts,
+				driveID:         source.driveID,
+				spaces:          source.spaces,
+				isConnected:     source.isConnected,
+				numberOfThreads: source.numberOfThreads,
+				TestMode:        source.TestMode,
+			}
+			storage := &GCDStorage{
+				StorageBase:     tt.fields.StorageBase,
+				service:         tt.fields.service,
+				idCache:         tt.fields.idCache,
+				backoffs:        tt.fields.backoffs,
+				attempts:        tt.fields.attempts,
+				driveID:         tt.fields.driveID,
+				spaces:          tt.fields.spaces,
+				isConnected:     tt.fields.isConnected,
+				numberOfThreads: tt.fields.numberOfThreads,
+				TestMode:        tt.fields.TestMode,
+			}
+			storage.DerivedStorage = storage
+			var got []string
+			var got1 []int64
+			var err error
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				got, got1, err = storage.ListFiles(tt.args.threadIndex, tt.args.dir)
+				return err == nil
+			})
+			if outcome.recovered != tt.wantPanic {
+				t.Fatalf("GCDStorage.ListFiles() panicked with %#v, want %#v", outcome.recovered, tt.wantPanic)
+			}
+			// The connections of the client are idle goroutines, which are not the ones of the listing
+			run.server.Client().CloseIdleConnections()
+			run.server.Close()
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			if tt.wantPanic != nil {
+				return
+			}
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("GCDStorage.ListFiles() error = %v, wantErr %v", err, tt.wantErr)
+			}
+			if tt.check != nil {
+				tt.check(t, err)
+			}
+			if tt.wantErr {
+				return
+			}
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("GCDStorage.ListFiles() got = %v, want %v", got, tt.want)
+			}
+			if !reflect.DeepEqual(got1, tt.want1) {
+				t.Errorf("GCDStorage.ListFiles() got1 = %v, want %v", got1, tt.want1)
+			}
+		})
+	}
+}
