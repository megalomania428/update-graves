+// catchLogExceptionMode is the variable that makes the test binary run as the child process of
+// TestCatchLogException; its value is "<where>/<value>[/stack]".
+const catchLogExceptionMode = "DUPLICACY_CATCH_LOG_EXCEPTION_MODE"
+
+// runCatchLogExceptionChild panics under 'defer CatchLogException()' as the mode tells: where is 'main' for the
+// goroutine itself, 'worker' for a goroutine whose panic is recorded and raised again, 'repeat' for a worker panic
+// whose raising is recovered before the goroutine panics anew with the same value, and 'two' for a worker panic
+// raised after another one has been recorded and printed; value is 'exception', 'other', 'uncomparable', 'nan',
+// 'func' or 'struct', the last three not being equal to themselves.
+func runCatchLogExceptionChild(mode string) {
+	parts := strings.Split(mode, "/")
+	RunAtError = func() { fmt.Println("RUN_AT_ERROR") }
+	if len(parts) > 2 && parts[2] == "stack" {
+		EnableStackTrace()
+	}
+	var value interface{}
+	switch parts[1] {
+	case "exception":
+		value = Exception{Level: ERROR, LogID: "CATCH_PROBE", Message: "catch probe"}
+	case "other":
+		value = "catch-log-exception-probe"
+	case "uncomparable":
+		value = []string{"catch-log-exception-probe"}
+	case "nan":
+		value = math.NaN()
+	case "func":
+		value = func() {}
+	case "struct":
+		type nanStruct struct {
+			Value  float64
+			Marker string
+		}
+		value = nanStruct{Value: math.NaN(), Marker: "catch-log-exception-probe"}
+	}
+	defer CatchLogException()
+	if parts[0] == "main" {
+		panic(value)
+	}
+	failures := newWorkerErrors()
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		defer failures.catch()
+		panic(value)
+	}()
+	<-done
+	switch parts[0] {
+	case "repeat":
+		func() {
+			defer func() { _ = recover() }()
+			failures.raise()
+		}()
+		panic(value)
+	case "two":
+		newWorkerErrors().record("catch-log-exception-other")
+	}
+	failures.raise()
+}
+
+// TestCatchLogException runs a child process that panics under CatchLogException and checks its exit code, the
+// RunAtError calls and what it prints to stderr: the value and the goroutine header of the stack, which the panic of a
+// worker raised in the goroutine that called the operation must print once, as the panic of the goroutine itself
+// does.  The child is the test binary itself, which runs runCatchLogExceptionChild.
+func TestCatchLogException(t *testing.T) {
+	if mode := os.Getenv(catchLogExceptionMode); mode != "" {
+		runCatchLogExceptionChild(mode)
+		return
+	}
+	tests := []struct {
+		name string
+		mode string
+		// The exit code, the number of the stderr lines with the value and the number of the lines starting with
+		// the header of a goroutine
+		wantCode       int
+		wantValueLines int
+		wantGoroutines int
+	}{
+		{name: "MainException", mode: "main/exception", wantCode: 100},
+		{name: "WorkerException", mode: "worker/exception", wantCode: 100},
+		{name: "MainExceptionStack", mode: "main/exception/stack", wantCode: 100, wantGoroutines: 1},
+		{name: "WorkerExceptionStack", mode: "worker/exception/stack", wantCode: 100, wantGoroutines: 1},
+		{name: "MainOther", mode: "main/other", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "WorkerOther", mode: "worker/other", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "MainUncomparable", mode: "main/uncomparable", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "WorkerUncomparable", mode: "worker/uncomparable", wantCode: 101, wantValueLines: 1,
+			wantGoroutines: 1},
+		{name: "MainNaN", mode: "main/nan", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "WorkerNaN", mode: "worker/nan", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "MainFunc", mode: "main/func", wantCode: 101, wantGoroutines: 1},
+		{name: "WorkerFunc", mode: "worker/func", wantCode: 101, wantGoroutines: 1},
+		{name: "MainStruct", mode: "main/struct", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "WorkerStruct", mode: "worker/struct", wantCode: 101, wantValueLines: 1, wantGoroutines: 1},
+		{name: "RepeatOther", mode: "repeat/other", wantCode: 101, wantValueLines: 2, wantGoroutines: 2},
+		{name: "TwoRecords", mode: "two/other", wantCode: 101, wantValueLines: 1, wantGoroutines: 2},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			command := exec.Command(os.Args[0], "-test.run=^TestCatchLogException$")
+			command.Env = append(os.Environ(), catchLogExceptionMode+"="+tt.mode)
+			var stdout, stderr bytes.Buffer
+			command.Stdout, command.Stderr = &stdout, &stderr
+			code := 0
+			if err := command.Run(); err != nil {
+				exitError, ok := err.(*exec.ExitError)
+				if !ok {
+					t.Fatalf("Failed to run the child process: %v", err)
+				}
+				code = exitError.ExitCode()
+			}
+			valueLines, goroutines := 0, 0
+			for _, line := range strings.Split(stderr.String(), "\n") {
+				if strings.Contains(line, "catch-log-exception-probe") || strings.TrimSpace(line) == "NaN" {
+					valueLines++
+				}
+				if strings.HasPrefix(line, "goroutine ") {
+					goroutines++
+				}
+			}
+			if code != tt.wantCode || valueLines != tt.wantValueLines || goroutines != tt.wantGoroutines {
+				t.Fatalf("The child exited with %d and printed %d lines of the value and %d goroutines instead "+
+					"of %d, %d and %d:\n%s", code, valueLines, goroutines, tt.wantCode, tt.wantValueLines,
+					tt.wantGoroutines, stderr.String())
+			}
+			if runs := strings.Count(stdout.String(), "RUN_AT_ERROR\n"); runs != 1 {
+				t.Fatalf("RunAtError has been called %d times instead of once:\n%s", runs, stdout.String())
+			}
+		})
+	}
+}
