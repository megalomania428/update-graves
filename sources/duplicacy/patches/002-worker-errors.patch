+// TestWorkerErrorsCopyNoFaults copies the revision without faults; copying it again finds nothing to copy.
+func TestWorkerErrorsCopyNoFaults(t *testing.T) {
+	baseline := runtime.NumGoroutine()
+	fixture := newWorkerErrorsCopyFixture(t)
+	waitForWorkerErrorsGoroutines(t, baseline)
+
+	fixture.expectCopied(fixture.copy())
+	waitForWorkerErrorsGoroutines(t, baseline)
+	// The messages of the second copy are collected; errors are not expected, so the log function doesn't panic
+	var lock sync.Mutex
+	var messages []string
+	LogFunction = func(level int, logID string, message string) {
+		lock.Lock()
+		defer lock.Unlock()
+		messages = append(messages, logID+" "+message)
+	}
+	outcome := fixture.copy()
+	if outcome.recovered != nil || !outcome.result {
+		t.Fatalf("The second copy failed: %#v (result %t)", outcome.recovered, outcome.result)
+	}
+	lock.Lock()
+	logged := strings.Join(messages, "\n")
+	lock.Unlock()
+	if !strings.Contains(logged, "SNAPSHOT_COPY Nothing to copy") {
+		t.Fatalf("The second copy has not found the revision at the destination:\n%s", logged)
+	}
+	if strings.Contains(logged, "SNAPSHOT_COPY Chunks to copy") {
+		t.Fatalf("The second copy has gone on after finding nothing to copy:\n%s", logged)
+	}
+	if fixture.manager.SnapshotManager.chunkOperator != nil {
+		t.Fatalf("The operator of the snapshot manager has not been removed")
+	}
+	waitForWorkerErrorsGoroutines(t, baseline)
