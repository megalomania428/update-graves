+// TestSnapshotManager_CheckSnapshots_LogErrors checks the revision 1 without its revision
+// file, which would leave the check with no snapshot to dereference, its files with a
+// remote listing that fails, which would leave the check with a truncated listing to
+// verify, and its chunks with one that can't be downloaded and SNAPSHOT_VERIFY suppressed,
+// which would hide the corrupted chunks and report success.
+func TestSnapshotManager_CheckSnapshots_LogErrors(t *testing.T) {
+	type fields struct {
+		config        *Config
+		storage       Storage
+		fileChunk     *Chunk
+		snapshotCache *FileStorage
+		chunkOperator *ChunkOperator
+	}
+	type args struct {
+		snapshotID       string
+		revisionsToCheck []int
+		tag              string
+		showStatistics   bool
+		showTabular      bool
+		checkFiles       bool
+		checkChunks      bool
+		searchFossils    bool
+		resurrect        bool
+		rewriteChunks    bool
+		threads          int
+		allowFailures    bool
+	}
+	// The arguments of fixture.check: the revision 1 with 2 threads
+	checkChunks := args{snapshotID: "host1", revisionsToCheck: []int{1}, checkChunks: true,
+		threads: 2}
+	checkFiles := args{snapshotID: "host1", revisionsToCheck: []int{1}, checkFiles: true,
+		threads: 2}
+	// The chunks with allowed failures, which only count a chunk that can't be downloaded
+	checkFailedChunks := checkChunks
+	checkFailedChunks.allowFailures = true
+	// The panics that the log function of a case raised in a deferred function of the check, which must not replace
+	// the panic of the check
+	var swallowed int32
+	// fillPool fills the chunk pool, so that the next PutChunk logs CHUNK_BUFFER
+	fillPool := func(config *Config) {
+		for len(config.chunkPool) < cap(config.chunkPool) {
+			config.chunkPool <- CreateChunk(config, true)
+		}
+	}
+	// panicsIn tells whether the function called its caller, such as ListRemoteFiles, directly or not; the other
+	// goroutines of the check that return chunks to the full pool must not panic
+	panicsIn := func(function string) bool {
+		pcs := make([]uintptr, 64)
+		frames := runtime.CallersFrames(pcs[:runtime.Callers(1, pcs)])
+		for {
+			frame, more := frames.Next()
+			if strings.HasSuffix(frame.Function, function) {
+				return true
+			}
+			if !more {
+				return false
+			}
+		}
+	}
+	// prepareFailedChunk backs up the revision 1 and makes the download of one of its file chunks fail, and returns
+	// the number of the chunks the check counts and the hash of the failed one
+	prepareFailedChunk := func(t *testing.T) (*workerErrorsFixture, int, string) {
+		fixture := newWorkerErrorsFixture(t, false)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		snapshot := fixture.revisionSnapshot(1)
+		failedChunk := snapshot.ChunkHashes[len(snapshot.ChunkHashes)/2]
+		manager := fixture.manager.SnapshotManager
+		chunkHashes := map[string]bool{}
+		manager.CreateChunkOperator(false, false, 1, false)
+		manager.GetSnapshotChunkHashes(snapshot, &chunkHashes, map[string]bool{})
+		fixture.stopSnapshotOperator()
+		fixture.failDownload(failedChunk, false)
+		return fixture, len(chunkHashes), failedChunk
+	}
+	// The deferred closing of the log file of PruneSnapshots (a failed Close) and DeleteShadowCopy (empty on Linux)
+	// are protected by keepPanic as well, without a case of their own: the state in which they log is not created
+	// without a test point in the production code.
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantPanic interface{}
+		prepare   func(t *testing.T) *logErrorsRun
+		check     func(t *testing.T, run *logErrorsRun)
+	}{
+		{
+			name: "MissingRevision", args: checkChunks, want: false,
+			wantPanic: snapshotInfoError("host1", 1),
+			prepare: func(t *testing.T) *logErrorsRun {
+				fixture := newWorkerErrorsFixture(t, false)
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				fixture.storage.fail("GetFileInfo", "snapshots/host1/1")
+				return &logErrorsRun{fixture: fixture}
+			},
+			check: func(t *testing.T, run *logErrorsRun) {
+				if _, ok := run.outcome.recovered.(runtime.Error); ok {
+					t.Fatalf("The check has gone on without the revision: %v",
+						run.outcome.recovered)
+				}
+			},
+		},
+		{
+			name: "TruncatedListing", args: checkFiles, want: false,
+			wantPanic: fileSequenceError,
+			prepare: func(t *testing.T) *logErrorsRun {
+				fixture := newWorkerErrorsFixture(t, false)
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				fixture.corruptFileSequence()
+				return &logErrorsRun{fixture: fixture}
+			},
+			check: func(t *testing.T, run *logErrorsRun) {
+				if run.outcome.recovered == nil && run.outcome.result {
+					t.Fatalf("The check has verified the truncated listing as complete")
+				}
+			},
+		},
+		{
+			// As duplicacy -suppress VERIFY_PROGRESS -suppress SNAPSHOT_VERIFY check -chunks
+			// -persist: the error of the corrupted chunks has the log id of the entries hidden
+			name: "SuppressedVerify", args: checkFailedChunks, want: false,
+			prepare: func(t *testing.T) *logErrorsRun {
+				fixture := newWorkerErrorsFixture(t, false)
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				snapshot := fixture.revisionSnapshot(1)
+				// Taken before GetSnapshotChunkHashes, which clears the chunks of the snapshot
+				failedChunk := snapshot.ChunkHashes[len(snapshot.ChunkHashes)/2]
+				// The check counts the chunks of the revision as GetSnapshotChunkHashes does
+				manager := fixture.manager.SnapshotManager
+				chunkHashes := map[string]bool{}
+				manager.CreateChunkOperator(false, false, 1, false)
+				manager.GetSnapshotChunkHashes(snapshot, &chunkHashes, map[string]bool{})
+				fixture.stopSnapshotOperator()
+				fixture.failDownload(failedChunk, false)
+				SetLoggingLevel(INFO)
+				SuppressLog("SNAPSHOT_VERIFY")
+				return &logErrorsRun{fixture: fixture, stdout: true,
+					wantPanic: Exception{Level: ERROR, LogID: "SNAPSHOT_VERIFY",
+						Message: fmt.Sprintf("1 out of %d chunks are corrupted",
+							len(chunkHashes))}}
+			},
+			check: func(t *testing.T, run *logErrorsRun) {
+				if strings.Contains(run.output, "Verifying ") {
+					t.Fatalf("The suppressed entry has been printed:\n%s", run.output)
+				}
+			},
+		},
+		{
+			// The log function panics in a verifying goroutine, and again on the entry of the deferred save of the
