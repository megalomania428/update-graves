+// faultStorage wraps a file storage and fails the calls of its operations on the paths under the given prefixes
+// and the lookups of the given chunks.
+type faultStorage struct {
+	Storage
+	lock     sync.Mutex
+	faults   map[string][]string // Path prefixes by operation name
+	chunkIDs []string
+	uploads  int                    // The number of successful uploads
+	injected int                    // The number of injected failures
+	delays   map[string]func() bool // Conditions that DownloadFile waits for, by path prefix
+	delayed  int                    // The number of delayed downloads
+	late     int                    // The number of delayed downloads whose condition didn't hold in 10 seconds
+	hidden   []string               // Path prefixes of the directories listed as empty
+	hides    int                    // The number of the listings hidden by hideListing
+	calls    map[string]int         // The number of the calls checked, by operation name
+	failAt   map[string]int         // The number of the call to fail, by operation name
+	upDelays map[string]func() bool // Conditions that UploadFile waits for, by path prefix
+}
+
+func newFaultStorage(storage *FileStorage) *faultStorage {
+	wrapper := &faultStorage{Storage: storage, faults: map[string][]string{}, delays: map[string]func() bool{},
+		calls: map[string]int{}, failAt: map[string]int{}, upDelays: map[string]func() bool{}}
+	// FindChunk (GetFileInfo) and SetNestingLevels (GetFileInfo, DownloadFile and CreateDirectory) call the storage
+	// through DerivedStorage and would bypass the wrapper otherwise; CreateDirectory is not intercepted
+	storage.DerivedStorage = wrapper
+	return wrapper
+}
+
+// fail makes every call of the operation (UploadFile, DownloadFile, DeleteFile, MoveFile, GetFileInfo or ListFiles)
+// on a path starting with prefix return an error.  Some callers drop the error: FindChunk treats a failed
+// GetFileInfo as a missing chunk and SetNestingLevels falls back to the default levels, so chunk lookups are failed
+// with failFindChunk instead.
+func (storage *faultStorage) fail(operation string, prefix string) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.faults[operation] = append(storage.faults[operation], prefix)
+}
+
+// failFindChunk makes every lookup of the chunk fail.
+func (storage *faultStorage) failFindChunk(chunkID string) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.chunkIDs = append(storage.chunkIDs, chunkID)
+}
+
+// delayDownload makes every DownloadFile call on a path starting with prefix wait until ready returns true, for 10
+// seconds at most, and then for 200 ms more, so that the operation goes on past the point that ready marks.
+func (storage *faultStorage) delayDownload(prefix string, ready func() bool) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.delays[prefix] = ready
+}
+
+// failNthCall makes the n-th call of the operation, counted from 1 over all its paths, return an error.  Unlike a
+// path, the number doesn't depend on the order in which the objects of the operation are processed.
+func (storage *faultStorage) failNthCall(operation string, n int) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.failAt[operation] = n
+}
+
+// callCount returns the number of the calls of the operation checked so far.
+func (storage *faultStorage) callCount(operation string) int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.calls[operation]
+}
+
+// delayUpload makes every UploadFile call on a path starting with prefix wait until ready returns true, as
+// delayDownload does for downloads.
+func (storage *faultStorage) delayUpload(prefix string, ready func() bool) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.upDelays[prefix] = ready
+}
+
+// hideListing makes ListFiles list every directory starting with prefix as empty, without
+// an error.
+func (storage *faultStorage) hideListing(prefix string) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.hidden = append(storage.hidden, prefix)
+}
+
+func (storage *faultStorage) hiddenCount() int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.hides
+}
+
+func (storage *faultStorage) delayedCount() int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.delayed
+}
+
+func (storage *faultStorage) lateCount() int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.late
+}
+
+// wait delays a download of the path as set by delayDownload, or an upload as set by delayUpload.
+func (storage *faultStorage) wait(filePath string, upload bool) {
+	storage.lock.Lock()
+	var ready func() bool
+	delays := storage.delays
+	if upload {
+		delays = storage.upDelays
+	}
+	for prefix, condition := range delays {
+		if strings.HasPrefix(filePath, prefix) {
+			ready = condition
+			storage.delayed++
+		}
+	}
+	storage.lock.Unlock()
+	if ready == nil {
+		return
+	}
+	for deadline := time.Now().Add(10 * time.Second); !ready(); time.Sleep(10 * time.Millisecond) {
+		if time.Now().After(deadline) {
+			storage.lock.Lock()
+			storage.late++
+			storage.lock.Unlock()
+			return
+		}
+	}
+	time.Sleep(200 * time.Millisecond)
+}
+
+func (storage *faultStorage) clearFaults() {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.faults, storage.chunkIDs, storage.delays = map[string][]string{}, nil, map[string]func() bool{}
+	storage.hidden = nil
+	storage.failAt, storage.upDelays = map[string]int{}, map[string]func() bool{}
+}
+
+func (storage *faultStorage) uploadCount() int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.uploads
+}
+
+func (storage *faultStorage) injectedCount() int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	return storage.injected
+}
+
+func (storage *faultStorage) check(operation string, filePath string) error {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.calls[operation]++
+	if n, ok := storage.failAt[operation]; ok && storage.calls[operation] == n {
+		storage.injected++
+		return fmt.Errorf("injected %s failure for %s", operation, filePath)
+	}
+	for _, prefix := range storage.faults[operation] {
+		if strings.HasPrefix(filePath, prefix) {
+			storage.injected++
+			return fmt.Errorf("injected %s failure for %s", operation, filePath)
+		}
+	}
+	return nil
+}
+
+func (storage *faultStorage) FindChunk(threadIndex int, chunkID string, isFossil bool,
+	isMetadata bool) (filePath string, exist bool, size int64, err error) {
+	storage.lock.Lock()
+	failed := false
+	for _, id := range storage.chunkIDs {
+		failed = failed || id == chunkID
+	}
+	storage.lock.Unlock()
+	if failed {
+		return "", false, 0, fmt.Errorf("injected lookup failure for %s", chunkID)
+	}
+	return storage.Storage.FindChunk(threadIndex, chunkID, isFossil, isMetadata)
+}
+
+func (storage *faultStorage) ListFiles(threadIndex int, dir string) (files []string, sizes []int64, err error) {
+	if err = storage.check("ListFiles", dir); err != nil {
+		return nil, nil, err
+	}
+	storage.lock.Lock()
+	for _, prefix := range storage.hidden {
+		if strings.HasPrefix(dir, prefix) {
+			storage.hides++
+			storage.lock.Unlock()
+			return nil, nil, nil
+		}
+	}
+	storage.lock.Unlock()
+	return storage.Storage.ListFiles(threadIndex, dir)
+}
+
+func (storage *faultStorage) DeleteFile(threadIndex int, filePath string) (err error) {
+	if err = storage.check("DeleteFile", filePath); err != nil {
+		return err
+	}
+	return storage.Storage.DeleteFile(threadIndex, filePath)
+}
+
+func (storage *faultStorage) MoveFile(threadIndex int, from string, to string) (err error) {
+	if err = storage.check("MoveFile", from); err != nil {
+		return err
+	}
+	return storage.Storage.MoveFile(threadIndex, from, to)
+}
+
+func (storage *faultStorage) GetFileInfo(threadIndex int, filePath string) (exist bool, isDir bool, size int64, err error) {
+	if err = storage.check("GetFileInfo", filePath); err != nil {
+		return false, false, 0, err
+	}
+	return storage.Storage.GetFileInfo(threadIndex, filePath)
+}
+
+func (storage *faultStorage) DownloadFile(threadIndex int, filePath string, chunk *Chunk) (err error) {
+	if err = storage.check("DownloadFile", filePath); err != nil {
+		return err
+	}
+	storage.wait(filePath, false)
+	return storage.Storage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+func (storage *faultStorage) UploadFile(threadIndex int, filePath string, content []byte) (err error) {
+	storage.wait(filePath, true)
+	if err = storage.check("UploadFile", filePath); err != nil {
+		return err
+	}
+	if err = storage.Storage.UploadFile(threadIndex, filePath, content); err == nil {
+		storage.lock.Lock()
+		storage.uploads++
+		storage.lock.Unlock()
+	}
+	return err
+}
+
+// saveWorkerErrorsGlobals resets the global state touched by expected errors and restores it after the test.
+func saveWorkerErrorsGlobals(t *testing.T) {
+	savedTestingT, savedLogFunction, savedLoggingLevel := testingT, LogFunction, loggingLevel
+	savedRunAtError, savedPreferencePath := RunAtError, preferencePath
+	savedSuppressedLogs := map[string]bool{}
+	for logID, suppressed := range suppressedLogs {
+		savedSuppressedLogs[logID] = suppressed
+	}
+	t.Cleanup(func() {
+		testingT, LogFunction, loggingLevel = savedTestingT, savedLogFunction, savedLoggingLevel
+		RunAtError, preferencePath = savedRunAtError, savedPreferencePath
+		suppressedLogs = savedSuppressedLogs
+	})
+	// Expected errors would fail the test through testingT, as in verifyChunk
+	testingT = nil
+	LogFunction = nil
+	SetLoggingLevel(ERROR)
+	suppressedLogs = map[string]bool{}
+	for _, name := range []string{"DUPLICACY_FAIL_CHUNK", "DUPLICACY_FAIL_SNAPSHOT"} {
+		// t.Setenv restores the variable after the test; the variable must be absent, not empty
+		t.Setenv(name, "")
+		os.Unsetenv(name)
+	}
+}
+
+// setWorkerErrorsLogFunction installs a log function that returns; logf still raises the
+// errors as an Exception after it.
+func setWorkerErrorsLogFunction() {
+	LogFunction = func(level int, logID string, message string) {}
+}
+
+// workerErrorsLogs holds the entries received by the log function of
+// collectWorkerErrorsLogs.
+type workerErrorsLogs struct {
+	lock    sync.Mutex
+	entries []string
+}
+
+// collectWorkerErrorsLogs installs a log function that collects the entries and returns.
+func collectWorkerErrorsLogs() *workerErrorsLogs {
+	logs := &workerErrorsLogs{}
+	LogFunction = func(level int, logID string, message string) {
+		logs.lock.Lock()
+		defer logs.lock.Unlock()
+		logs.entries = append(logs.entries, getLevelName(level)+" "+logID+" "+message)
+	}
+	return logs
+}
+
+// String returns the collected entries, one per line, as "<level> <log id> <message>".
+func (logs *workerErrorsLogs) String() string {
+	logs.lock.Lock()
+	defer logs.lock.Unlock()
+	return strings.Join(logs.entries, "\n")
+}
+
+// setWorkerErrorsMode prepares the expected error of a subtest: in the mode Log it is
+// logged without a log function, in LogFunction through the log function of
+// collectWorkerErrorsLogs, whose entries are returned, and in Suppressed its log id is
+// passed to SuppressLog, which doesn't hide an error.
+func setWorkerErrorsMode(mode string, logID string) *workerErrorsLogs {
+	switch mode {
+	case "LogFunction":
+		return collectWorkerErrorsLogs()
+	case "Suppressed":
+		SuppressLog(logID)
+	}
+	return nil
+}
+
+// workerErrorsOutcome is what an operation run by runWorkerErrorsOperation returned or panicked with.
+type workerErrorsOutcome struct {
+	result    bool
+	recovered interface{}
+}
+
+// runWorkerErrorsOperation runs the operation in a new goroutine and fails the test if it hangs.
+func runWorkerErrorsOperation(t *testing.T, operation func() bool) workerErrorsOutcome {
+	t.Helper()
+	done := make(chan workerErrorsOutcome, 1)
+	go func() {
+		var outcome workerErrorsOutcome
+		defer func() {
+			outcome.recovered = recover()
+			done <- outcome
+		}()
+		outcome.result = operation()
+	}()
+	select {
+	case outcome := <-done:
+		return outcome
+	case <-time.After(60 * time.Second):
+		t.Fatalf("The operation did not return in 60 seconds:\n%s", workerErrorsStacks())
+	}
+	return workerErrorsOutcome{}
+}
+
+func expectWorkerErrorsException(t *testing.T, outcome workerErrorsOutcome, logID string) {
+	t.Helper()
+	exception, ok := outcome.recovered.(Exception)
+	if !ok || exception.LogID != logID || exception.Level != ERROR {
+		t.Fatalf("Expected an Exception with the log id %s, got %#v (result %t)", logID, outcome.recovered,
+			outcome.result)
+	}
+}
+
+// waitForWorkerErrorsGoroutines waits up to 2 seconds for the number of goroutines to drop to the baseline.
+func waitForWorkerErrorsGoroutines(t *testing.T, baseline int) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for runtime.NumGoroutine() > baseline {
+		if time.Now().After(deadline) {
+			t.Fatalf("%d goroutines are running instead of %d:\n%s", runtime.NumGoroutine(), baseline,
+				workerErrorsStacks())
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+func workerErrorsStacks() string {
+	buffer := make([]byte, 1<<20)
+	return string(buffer[:runtime.Stack(buffer, true)])
+}
+
+// openFilesOf returns the paths of the files that the descriptors of the process point
+// to; ok is false when /proc/self/fd is not available.
+func openFilesOf(t *testing.T) (paths []string, ok bool) {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return nil, false
+	}
+	for _, entry := range entries {
+		// A descriptor that is closed in the meantime, like the one of the directory
+		// itself, fails to resolve
+		if target, err := os.Readlink(filepath.Join("/proc/self/fd", entry.Name())); err == nil {
+			paths = append(paths, target)
+		}
+	}
+	return paths, true
+}
+
+// createWorkerErrorsDirectories creates the directories d0000, d0001, ... under top, each with a file f.
+func createWorkerErrorsDirectories(t *testing.T, top string, count int) {
+	t.Helper()
+	for i := 0; i < count; i++ {
+		dir := filepath.Join(top, fmt.Sprintf("d%04d", i))
+		if err := os.MkdirAll(dir, 0700); err != nil {
+			t.Fatalf("Failed to create %s: %v", dir, err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "f"), []byte("x"), 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", filepath.Join(dir, "f"), err)
+		}
+	}
+}
+
+// countListedEntries installs a log function that counts the entries of the listing of a directory, LIST_ENTRIES.
+func countListedEntries() *int64 {
+	listed := new(int64)
+	LogFunction = func(level int, logID string, message string) {
+		if logID == "LIST_ENTRIES" {
+			atomic.AddInt64(listed, 1)
+		}
+	}
+	return listed
+}
