+// TestWorkerErrorsCheckFiles fails the download of a file chunk, done by CheckSnapshots in the goroutine calling it;
+// an operator of the snapshot manager existing before the check is kept without the failure, so a check of the
+// chunks with it afterwards doesn't report a corrupted chunk.
+func TestWorkerErrorsCheckFiles(t *testing.T) {
+	for _, name := range []string{"NewOperator", "ExistingOperator"} {
+		t.Run(name, func(t *testing.T) {
+			baseline := runtime.NumGoroutine()
+			fixture := newWorkerErrorsFixture(t, false)
+			fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+			snapshot := fixture.revisionSnapshot(1)
+			fixture.failDownload(snapshot.ChunkHashes[len(snapshot.ChunkHashes)/2], false)
+			waitForWorkerErrorsGoroutines(t, baseline)
+			var operator *ChunkOperator
+			if name == "ExistingOperator" {
+				operator = fixture.existingSnapshotOperator()
+				baseline = runtime.NumGoroutine()
+			}
+
+			expectWorkerErrorsException(t, fixture.check(true, false), "DOWNLOAD_CHUNK")
+			if fixture.storage.injectedCount() == 0 {
+				t.Fatalf("The download of the file chunk has not been attempted")
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.expectSnapshotOperator(operator)
+			if operator == nil {
+				return
+			}
+			fixture.storage.clearFaults()
+			outcome := fixture.check(false, false)
+			if outcome.recovered != nil || !outcome.result {
+				t.Fatalf("The check of the chunks failed: %#v (result %t)", outcome.recovered, outcome.result)
+			}
+			waitForWorkerErrorsGoroutines(t, baseline)
+			fixture.stopSnapshotOperator()
+		})
+	}
+}
