+// pruneCall is a call of the storage of a prune; number counts the calls with the same
+// operation and path, from 1.
+type pruneCall struct {
+	operation string
+	path      string
+	number    int
+}
+
+// pruneCancelStorage wraps faultStorage for the cancellation tests of PruneSnapshots.  It
+// records the calls of ListFiles, DownloadFile, DeleteFile and MoveFile and requests a
+// cancellation at the first recorded call selected by cancelOn, before the call is made.
+type pruneCancelStorage struct {
+	*faultStorage
+	lock     sync.Mutex
+	calls    []pruneCall
+	cancelOn func(call pruneCall) bool
+	fired    bool
+}
+
+func (storage *pruneCancelStorage) record(operation string, filePath string) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	call := pruneCall{operation: operation, path: filePath, number: 1}
+	for _, earlier := range storage.calls {
+		if earlier.operation == operation && earlier.path == filePath {
+			call.number++
+		}
+	}
+	storage.calls = append(storage.calls, call)
+	if !storage.fired && storage.cancelOn != nil && storage.cancelOn(call) {
+		storage.fired = true
+		RequestCancel()
+	}
+}
+
+func (storage *pruneCancelStorage) ListFiles(threadIndex int, dir string) ([]string,
+	[]int64, error) {
+	storage.record("ListFiles", dir)
+	return storage.faultStorage.ListFiles(threadIndex, dir)
+}
+
+func (storage *pruneCancelStorage) DownloadFile(threadIndex int, filePath string,
+	chunk *Chunk) error {
+	storage.record("DownloadFile", filePath)
+	return storage.faultStorage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+func (storage *pruneCancelStorage) DeleteFile(threadIndex int, filePath string) error {
+	storage.record("DeleteFile", filePath)
+	return storage.faultStorage.DeleteFile(threadIndex, filePath)
+}
+
+func (storage *pruneCancelStorage) MoveFile(threadIndex int, from string,
+	to string) error {
+	storage.record("MoveFile", from)
+	return storage.faultStorage.MoveFile(threadIndex, from, to)
+}
+
+func (storage *pruneCancelStorage) reset() {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.calls, storage.fired = nil, false
+}
+
+func (storage *pruneCancelStorage) called(operation string, filePath string) bool {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	for _, call := range storage.calls {
+		if call.operation == operation && call.path == filePath {
+			return true
+		}
+	}
+	return false
+}
+
+// count returns the number of the calls of the operation on the paths with the prefix.
+func (storage *pruneCancelStorage) count(operation string, prefix string) int {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	count := 0
+	for _, call := range storage.calls {
+		if call.operation == operation && strings.HasPrefix(call.path, prefix) {
+			count++
+		}
+	}
+	return count
+}
+
+func (storage *pruneCancelStorage) setCancelOn(cancelOn func(call pruneCall) bool) {
+	storage.lock.Lock()
+	defer storage.lock.Unlock()
+	storage.cancelOn = cancelOn
+}
+
+// cancelOnFirst selects the first call of the operation on a path with the prefix.
+func cancelOnFirst(operation string, prefix string) func(call pruneCall) bool {
+	return func(call pruneCall) bool {
+		return call.operation == operation && strings.HasPrefix(call.path, prefix)
+	}
+}
+
+// cancelOnPath selects the first call of the operation on exactly the path.
+func cancelOnPath(operation string, filePath string) func(call pruneCall) bool {
+	return func(call pruneCall) bool {
+		return call.operation == operation && call.path == filePath && call.number == 1
+	}
+}
+
+func newPruneCancelFixture(t *testing.T) (*workerErrorsPruneFixture,
+	*pruneCancelStorage) {
+	fixture := newWorkerErrorsPruneFixture(t)
+	storage := &pruneCancelStorage{faultStorage: fixture.storage}
+	fixture.raw.DerivedStorage = storage
+	fixture.manager.storage = storage
+	return fixture, storage
+}
+
+// clearPruneCache empties the cached revision files and chunks, so that the prune
+// downloads them from the storage; the fossil collections stay.
+func clearPruneCache(t *testing.T, fixture *workerErrorsPruneFixture) {
+	t.Helper()
+	for _, dir := range []string{"snapshots", "chunks"} {
+		root := filepath.Join(fixture.testDir, "cache", dir)
+		entries, err := os.ReadDir(root)
+		if err != nil {
+			t.Fatalf("Failed to list the cache %s: %v", root, err)
+		}
+		for _, entry := range entries {
+			if err = os.RemoveAll(filepath.Join(root, entry.Name())); err != nil {
+				t.Fatalf("Failed to clear the cache %s: %v", root, err)
+			}
+		}
+	}
+}
