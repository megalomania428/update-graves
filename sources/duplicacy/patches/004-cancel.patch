+// pruneCancelRun is a case of TestSnapshotManager_PruneSnapshots_Cancel.
+type pruneCancelRun struct {
+	fixture   *workerErrorsPruneFixture
+	storage   *pruneCancelStorage
+	recorder  *progressRecorder
+	logs      *workerErrorsLogs
+	operator  *ChunkOperator
+	manager   *SnapshotManager
+	files     []string // The chunks and the revision files before the prune
+	logFiles  []string // The files of the log directory before the prune
+	baseline  int
+	flagAfter bool
+	first     []string // The fossils of the old collection 1
+	second    []string // The fossils of the old collection 2
+	paths     []string // The paths of the chunks that the case looks at
+}
+
+func pruneLogFiles(t *testing.T, fixture *workerErrorsPruneFixture) []string {
+	t.Helper()
+	entries, err := os.ReadDir(filepath.Join(fixture.testDir, ".duplicacy", "logs"))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("Failed to list the log directory: %v", err)
+	}
+	var names []string
+	for _, entry := range entries {
+		names = append(names, entry.Name())
+	}
+	return names
+}
+
+// arm finishes the preparation of a case: after the preliminary prunes and revisions it
+// clears the cache, records the progress, remembers the files, requests the cancellation
+// at once or sets the trigger, and forgets the calls made so far.
+func (run *pruneCancelRun) arm(t *testing.T, cancelOn func(call pruneCall) bool,
+	immediately bool) {
+	t.Helper()
+	clearPruneCache(t, run.fixture)
+	run.recorder = recordProgress(t)
+	run.files = workerErrorsStorageFiles(t, run.fixture.raw, "chunks", "snapshots")
+	run.logFiles = pruneLogFiles(t, run.fixture)
+	if immediately {
+		RequestCancel()
+	}
+	run.storage.setCancelOn(cancelOn)
+	run.storage.reset()
+}
+
+// sequencePath returns the path of the chunk with the chunk sequence of the revision.
+func (run *pruneCancelRun) sequencePath(revision int) string {
+	snapshot := run.fixture.manager.DownloadSnapshot("vm1@host1", revision)
+	return run.fixture.chunkPath(snapshot.ChunkSequence[0])
+}
+
+func (run *pruneCancelRun) expectUnchanged(t *testing.T) {
+	t.Helper()
+	got := workerErrorsStorageFiles(t, run.fixture.raw, "chunks", "snapshots")
+	if !reflect.DeepEqual(got, run.files) {
+		t.Fatalf("The storage has changed: %v instead of %v", got, run.files)
+	}
+}
+
+func (run *pruneCancelRun) expectNoWrites(t *testing.T) {
+	t.Helper()
+	if moves, deletes := run.storage.count("MoveFile", ""),
+		run.storage.count("DeleteFile", ""); moves != 0 || deletes != 0 {
+		t.Fatalf("The prune has moved %d files and deleted %d", moves, deletes)
+	}
+}
+
+func (run *pruneCancelRun) expectNotCalled(t *testing.T, operation string,
+	prefix string) {
+	t.Helper()
+	if run.storage.count(operation, prefix) != 0 {
+		t.Fatalf("%s has been called for %s", operation, prefix)
+	}
+}
+
+// expectEvents checks the events of the prune: none, the start and the steps without an
+// end, or one end; nothing follows after the return.
+func (run *pruneCancelRun) expectEvents(t *testing.T, mode string) {
+	t.Helper()
+	events := run.recorder.take()
+	switch mode {
+	case "none":
+		if len(events) != 0 {
+			t.Fatalf("Unexpected events %+v", events)
+		}
+	case "canceled":
+		// A prune canceled before its first task has only the start
+		if len(events) == 1 && events[0].Kind == ProgressKindStart &&
+			events[0].Operation == ProgressOperationPrune {
+			break
+		}
+		expectNoEnd(t, events, ProgressOperationPrune)
+	case "completed":
+		summarizePruneProgress(t, events)
+		ends := 0
+		for _, event := range events {
+			if event.Kind == ProgressKindEnd {
+				ends++
+			}
+		}
+		if ends != 1 {
+			t.Fatalf("Expected one end, got %+v", events)
+		}
+	}
+	if late := run.recorder.take(); len(late) != 0 {
+		t.Fatalf("Events after the return: %+v", late)
+	}
+}
+
+// fossilExists checks the path in the storage itself, bypassing the wrapper.
+func (run *pruneCancelRun) fossilExists(t *testing.T, filePath string) bool {
+	t.Helper()
+	exist, _, _, err := run.fixture.raw.GetFileInfo(0, filePath)
+	if err != nil {
+		t.Fatalf("Failed to check %s: %v", filePath, err)
+	}
+	return exist
+}
+
+func (run *pruneCancelRun) collectionExists(t *testing.T, name string) bool {
+	t.Helper()
+	_, err := os.Stat(filepath.Join(run.fixture.testDir, "cache", "fossils", name))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("Failed to check the collection %s: %v", name, err)
+	}
+	return err == nil
+}
+
+func (run *pruneCancelRun) readCollection(t *testing.T, name string) FossilCollection {
+	t.Helper()
+	content, err := os.ReadFile(filepath.Join(run.fixture.testDir, "cache", "fossils",
+		name))
+	if err != nil {
+		t.Fatalf("Failed to read the collection %s: %v", name, err)
+	}
+	var collection FossilCollection
+	if err = json.Unmarshal(content, &collection); err != nil {
+		t.Fatalf("Failed to parse the collection %s: %v", name, err)
+	}
+	return collection
+}
