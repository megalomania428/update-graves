diff -ruN -x .git a/src/duplicacy_cancel.go b/src/duplicacy_cancel.go
--- a/src/duplicacy_cancel.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_cancel.go	2026-11-13 16:41:21.678255044 +0000
@@ -0,0 +1,132 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"fmt"
+	"io"
+	"sync/atomic"
+)
+
+// CancelLogID is the LogID of the Exception that an operation stopped by RequestCancel
+// panics with; a consumer tells a cancellation from other errors by comparing
+// Exception.LogID with it.
+const CancelLogID = "OPERATION_CANCELED"
+
+// cancelRequested is set by RequestCancel and cleared by ResetCancel.  Like the other
+// global state of the package, it serves one operation at a time per process.
+var cancelRequested atomic.Bool
+
+// RequestCancel asks the running operation to stop.  It doesn't block and may be called
+// from any goroutine, ProgressFunction included.  The operation stops adding new tasks
+// at its next check, lets the tasks already queued finish and panics in the goroutine
+// that called it with an Exception whose LogID is CancelLogID, logged through LOG_ERROR;
+// a failure that a worker has already recorded is raised instead.  A canceled operation
+// returns no value and reports no end through ProgressFunction.
+//
+// An operation doesn't clear the request, or a request made before it starts would be
+// lost; such an operation panics before it changes anything.  The consumer calls
+// ResetCancel before the next operation.  A request made after the last check of an
+// operation doesn't stop it: the operation completes as usual and the request stays
+// set.
+//
+// Restore checks the request while it compares the local and the remote files, before
+// each file and before it deletes the extra files and restores the metadata of the
+// directories; the files restored before stay, and so do the directories and the symbolic
+// links that the comparison has already created.  A restore through a temporary file also
+// checks it before it writes each chunk downloaded from the storage, while the chunks
+// already prefetched are still downloaded: the target is replaced only at the end and the
+// temporary file is removed, so the target stays as it was; the chunks copied from the
+// existing file don't check it.  An in-place restore, whether explicit or forced by
+// Restore even with inPlace false when GetDuplicacyPreferencePath() doesn't start with
+// top, writes into the target and stops only between files, so a large file is completed
+// first.  CheckSnapshots checks it before it downloads each revision file, before it
+// checks each revision and, with checkChunks, before it queues each chunk; the chunks
+// already queued are verified, and only the intact ones are saved to the list of verified
+// chunks.  With checkFiles a revision is verified as a whole, so the check stops only
+// between revisions.
+//
+// PruneSnapshots checks it before it lists the revisions of each snapshot ID and before
+// it downloads each revision file, between the old fossil collections, where it first
+// waits for the tasks of the previous ones, before it chooses the revisions to delete and
+// for each snapshot ID while choosing them, before it reads the chunks of each revision
+// and, in the non-exhaustive mode, once more before it fossilizes or deletes the first
+// chunk; the exhaustive mode checks it before it lists each chunk directory and after the
+// listing until it adds the first fossilize, delete or resurrect task, which a dry run
+// never adds.  A prune canceled after it has created its log writes "Prune canceled"
+// there, unless a failure of its tasks is raised instead.  A canceled prune changes the
+// storage at most through the old fossil collections it has already processed, none with
+// collectOnly, and not at all in a dry run: the fossils and temporary files of such a
+// collection that is eligible for deletion, which is a collection that has passed the
+// deletion criteria or, in the exclusive mode, any collection, may be deleted or the
+// fossils turned back into chunks, while a collection that isn't eligible is left as it
+// is.  In the local directory of the collections in the snapshot
+// cache, not in the storage, a canceled prune has removed at most the file of a processed
+// collection that is eligible, except in a dry run, and the file of a collection that
+// lists a revision that still exists, in a dry run too and without touching the fossils
+// of that collection; with collectOnly it touches no file of the collections.  The tasks
+// of an old collection are a step that ends before the check ahead of the next
+// collection, so a request made while they run cancels the prune if another collection
+// or a later check follows.  The chunks, the new fossil collection and the deletion of
+// the revision files are one step that isn't stopped, since stopping it would leave
+// fossils without a collection or, in the exclusive mode, revisions whose chunks are
+// deleted.  It starts after the last check before the first fossilize or delete task of
+// the revisions to delete in the non-exhaustive mode and with the first fossilize, delete
+// or resurrect task of the chunk scan in the exhaustive mode: a request made then doesn't
+// stop the prune, which completes and returns true with the request still set, and so
+// does one made with deleteOnly after the check of the last old collection.  So a prune
+// returns at the latest when the step it is in ends: the tasks of the current old
+// collection or the rest of the prune.  ListSnapshots, ShowHistory, PrintFile, Diff,
+// DownloadSequence and Benchmark ignore the request.
+func RequestCancel() {
+	cancelRequested.Store(true)
+}
+
+// ResetCancel clears the request of RequestCancel; the consumer calls it before the next
+// operation.
+func ResetCancel() {
+	cancelRequested.Store(false)
+}
+
+// IsCancelRequested reports whether RequestCancel has been called since the last
+// ResetCancel.
+func IsCancelRequested() bool {
+	return cancelRequested.Load()
+}
+
+// raiseCancel panics with the Exception of a cancellation through LOG_ERROR, which
+// panics also after a LogFunction that returns.
+func raiseCancel() {
+	LOG_ERROR(CancelLogID, "The operation has been canceled")
+}
+
+// raiseFailures raises the first failure recorded by one of the operators, which takes
+// precedence over a cancellation.  It doesn't wait for the tasks of the operators; a nil
+// operator is skipped.
+func raiseFailures(operators ...*ChunkOperator) {
+	for _, operator := range operators {
+		if operator != nil {
+			operator.failures.raise()
+		}
+	}
+}
+
+// raiseCancelAfterFailures raises the first failure recorded by one of the operators or
+// else the cancellation.
+func raiseCancelAfterFailures(operators ...*ChunkOperator) {
+	raiseFailures(operators...)
+	raiseCancel()
+}
+
+// raisePruneCancel raises the cancellation of PruneSnapshots.  A failure already recorded
+// by the operator is raised instead; otherwise the cancellation is written to the log of
+// the prune directly, since that log isn't written through LOG_*, and then raised.
+func (manager *SnapshotManager) raisePruneCancel(logFile io.Writer) {
+	raiseFailures(manager.chunkOperator)
+	if logFile != nil {
+		fmt.Fprintf(logFile, "Prune canceled\n")
+	}
+	raiseCancel()
+}
diff -ruN -x .git a/src/duplicacy_cancel_test.go b/src/duplicacy_cancel_test.go
--- a/src/duplicacy_cancel_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_cancel_test.go	2026-11-13 16:41:21.678255044 +0000
@@ -0,0 +1,2453 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"reflect"
+	"runtime"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// cancelChunkSize is the size at which the storages of newCancelFixture cut the chunks.
+const cancelChunkSize = 64 * 1024
+
+// resetCancelAfter clears the cancellation request now and after the test.
+func resetCancelAfter(t *testing.T) {
+	ResetCancel()
+	t.Cleanup(ResetCancel)
+}
+
+// cancelStorage wraps faultStorage for the cancellation tests.  It counts the calls of
+// UploadFile on chunk files, under chunks/ or metadata/, and their successful uploads,
+// and requests a cancellation at the call with the number cancelAt.  With hold every
+// upload of a chunk after the request waits 100 ms, so that the operation is blocked
+// adding a task when it checks the request.
+type cancelStorage struct {
+	*faultStorage
+	cancelAt int64        // The number of the chunk upload that requests the cancellation
+	hold     bool         // Delay the chunk uploads made after the request
+	calls    atomic.Int64 // The calls of UploadFile on chunk files
+	uploads  atomic.Int64 // The successful uploads of chunk files
+	// downloadMatch selects the downloads that count for downloadCancelAt; nil disables it
+	downloadMatch    func(filePath string) bool
+	downloadCancelAt int64        // The number of the matching download that requests it
+	downloadHold     bool         // Delay the matching downloads made after the request
+	downloadCalls    atomic.Int64 // The calls of DownloadFile that match downloadMatch
+	downloadsLock    sync.Mutex
+	downloads        []string // The paths of all the calls of DownloadFile
+}
+
+// newCancelStorage wraps the storage and, like newFaultStorage, points its
+// DerivedStorage to the wrapper.
+func newCancelStorage(raw *FileStorage) *cancelStorage {
+	storage := &cancelStorage{faultStorage: newFaultStorage(raw)}
+	raw.DerivedStorage = storage
+	return storage
+}
+
+func (storage *cancelStorage) UploadFile(threadIndex int, filePath string,
+	content []byte) error {
+	if !strings.HasPrefix(filePath, "chunks/") && !strings.HasPrefix(filePath, "metadata/") {
+		return storage.faultStorage.UploadFile(threadIndex, filePath, content)
+	}
+	if storage.hold && IsCancelRequested() {
+		time.Sleep(100 * time.Millisecond)
+	}
+	if storage.calls.Add(1) == storage.cancelAt {
+		RequestCancel()
+	}
+	err := storage.faultStorage.UploadFile(threadIndex, filePath, content)
+	if err == nil {
+		storage.uploads.Add(1)
+	}
+	return err
+}
+
+// DownloadFile records the path and, for a download selected by downloadMatch, requests a
+// cancellation at the call with the number downloadCancelAt, before the download.  With
+// downloadHold every selected download after the request waits 100 ms.
+func (storage *cancelStorage) DownloadFile(threadIndex int, filePath string,
+	chunk *Chunk) error {
+	storage.downloadsLock.Lock()
+	storage.downloads = append(storage.downloads, filePath)
+	storage.downloadsLock.Unlock()
+	if storage.downloadMatch != nil && storage.downloadMatch(filePath) {
+		if storage.downloadHold && IsCancelRequested() {
+			time.Sleep(100 * time.Millisecond)
+		}
+		if storage.downloadCalls.Add(1) == storage.downloadCancelAt {
+			RequestCancel()
+		}
+	}
+	return storage.faultStorage.DownloadFile(threadIndex, filePath, chunk)
+}
+
+// downloaded reports whether DownloadFile has been called with the path.
+func (storage *cancelStorage) downloaded(filePath string) bool {
+	storage.downloadsLock.Lock()
+	defer storage.downloadsLock.Unlock()
+	for _, path := range storage.downloads {
+		if path == filePath {
+			return true
+		}
+	}
+	return false
+}
+
+// cancelAtStep records the progress events like recordProgress and requests a
+// cancellation at the step with the given number.
+func cancelAtStep(t *testing.T, step int64) *progressRecorder {
+	recorder := &progressRecorder{}
+	var steps atomic.Int64
+	setProgressFunction(t, func(event ProgressEvent) {
+		recorder.lock.Lock()
+		recorder.events = append(recorder.events, event)
+		recorder.lock.Unlock()
+		if event.Kind == ProgressKindStep && steps.Add(1) == step {
+			RequestCancel()
+		}
+	})
+	return recorder
+}
+
+// cancelFixture is a repository whose files are cut into chunks of exactly
+// cancelChunkSize, with a storage wrapped by cancelStorage.
+type cancelFixture struct {
+	*workerErrorsFixture
+	cancel     *cancelStorage
+	fileChunks int // The number of the file chunks of a backup of the repository
+}
+
+// newCancelStorageFixture creates a storage in storageDir that cuts the chunks at
+// cancelChunkSize, configured from copyFrom unless it is nil, and a manager of the
+// repository for it with its own snapshot cache.
+func newCancelStorageFixture(t *testing.T, repository string, storageDir string,
+	cache string, copyFrom *Config) *cancelFixture {
+	t.Helper()
+	raw, err := CreateFileStorage(storageDir, false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	// An average size of 2^30 keeps the rolling hash from cutting the chunks, so they are
+	// cut at the maximum size
+	if !ConfigStorage(raw, 16384, 100, 1<<30, cancelChunkSize, cancelChunkSize/4, "",
+		copyFrom, false, "", 0, 0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	storage := newCancelStorage(raw)
+	fixture := &workerErrorsFixture{t: t, repository: repository, raw: raw,
+		storage: storage.faultStorage}
+	fixture.manager = CreateBackupManager("host1", storage, repository, "", "", "", false)
+	if fixture.manager == nil || !fixture.manager.SetupSnapshotCache(cache) {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	return &cancelFixture{workerErrorsFixture: fixture, cancel: storage}
+}
+
+// newCancelFixture creates a repository with a file of the given number of chunks for
+// each number, file1 first, and a storage without a backup.  The number of the file
+// chunks is checked by a backup of the same files to a separate storage with the same
+// configuration.
+func newCancelFixture(t *testing.T, chunks ...int) *cancelFixture {
+	t.Helper()
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	repository := filepath.Join(dir, "repository")
+	if err := os.MkdirAll(filepath.Join(repository, ".duplicacy"), 0700); err != nil {
+		t.Fatalf("Failed to create the repository: %v", err)
+	}
+	fileChunks := 0
+	for i, count := range chunks {
+		content := make([]byte, count*cancelChunkSize)
+		rand.New(rand.NewSource(int64(i + 1))).Read(content)
+		file := filepath.Join(repository, fmt.Sprintf("file%d", i+1))
+		if err := os.WriteFile(file, content, 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", file, err)
+		}
+		fileChunks += count
+	}
+	SetDuplicacyPreferencePath(filepath.Join(repository, ".duplicacy"))
+	control := newCancelStorageFixture(t, repository, filepath.Join(dir, "control"),
+		"control", nil)
+	control.expectSuccess(control.backup(repository, false), 1)
+	if got := len(control.revisionSnapshot(1).ChunkHashes); got != fileChunks {
+		t.Fatalf("The backup has %d file chunks instead of %d", got, fileChunks)
+	}
+	fixture := newCancelStorageFixture(t, repository, filepath.Join(dir, "storage"),
+		"default", nil)
+	fixture.fileChunks = fileChunks
+	return fixture
+}
+
+// newCancelCopyFixture creates the copy fixture of the cancellation tests: the revision 1
+// of a source with a file of 24 chunks and an empty destination wrapped by
+// cancelStorage, which it returns as well.
+func newCancelCopyFixture(t *testing.T) (*workerErrorsCopyFixture, *cancelStorage) {
+	t.Helper()
+	source := newCancelFixture(t, 24)
+	source.expectSuccess(source.backup(source.repository, false), 1)
+	destination := newCancelStorageFixture(t, source.repository,
+		filepath.Join(t.TempDir(), "destination"), "destination", source.manager.config)
+	fixture := &workerErrorsCopyFixture{workerErrorsFixture: source.workerErrorsFixture,
+		snapshot: source.revisionSnapshot(1), destinationRaw: destination.raw,
+		destinationStorage: destination.storage, destination: destination.manager}
+	return fixture, destination.cancel
+}
+
+// cancelRun is the state of one case of the cancellation tables.
+type cancelRun struct {
+	fixture     *workerErrorsFixture
+	copyFixture *workerErrorsCopyFixture
+	cancel      *cancelStorage    // The storage that requests the cancellation
+	fileChunks  int               // The number of the file chunks of the repository
+	recorder    *progressRecorder // The events of the operation
+	logs        *workerErrorsLogs // The entries of the log function of the case
+	baseline    int               // The number of goroutines before the preparation
+	storedCount int64             // The number of chunks in the storage before the call
+	storedSize  int64             // The size of the chunks in the storage before the call
+	top         string            // The directory that Restore restores to
+	path        string            // The storage path that the check expects not to be downloaded
+	hashes      map[string]string // The hashes of the files of the repository by path
+	storage     map[string]int64  // The sizes of the files of the storage before the call
+	// rerun calls the operation of the case again with the same arguments
+	rerun func() workerErrorsOutcome
+}
+
+// expectNoEvents checks that the hook has not been called.
+func (run *cancelRun) expectNoEvents(t *testing.T) {
+	t.Helper()
+	if events := run.recorder.take(); len(events) != 0 {
+		t.Fatalf("Unexpected events %+v", events)
+	}
+}
+
+// cacheFileExists reports whether the file is in the snapshot cache of the manager.
+func cacheFileExists(t *testing.T, manager *BackupManager, name string) bool {
+	t.Helper()
+	_, err := os.Stat(filepath.Join(manager.cachePath, name))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("Failed to check %s: %v", name, err)
+	}
+	return err == nil
+}
+
+// cancelOnLog installs a log function that collects the entries like
+// collectWorkerErrorsLogs and requests a cancellation when it receives the INFO entry
+// with the log id, then returns.
+func cancelOnLog(logID string) *workerErrorsLogs {
+	logs := collectWorkerErrorsLogs()
+	collect := LogFunction
+	LogFunction = func(level int, id string, message string) {
+		collect(level, id, message)
+		if level == INFO && id == logID {
+			RequestCancel()
+		}
+	}
+	return logs
+}
+
+// TestBackupManager_Backup_Cancel checks the cancellation of Backup.  The cases are added
+// to the skeleton generated by gotests: the fields come from the manager of the case, the
+// top directory from its repository.
+func TestBackupManager_Backup_Cancel(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		top                    string
+		quickMode              bool
+		threads                int
+		tag                    string
+		showStatistics         bool
+		shadowCopy             bool
+		shadowCopyTimeout      int
+		enumOnly               bool
+		metadataChunkSize      int
+		maximumInMemoryEntries int
+	}
+	// The arguments of fixture.backup: a hash backup with 2 threads
+	hash := args{threads: 2, tag: "test", metadataChunkSize: 65536,
+		maximumInMemoryEntries: 1024}
+	quick := hash
+	quick.quickMode = true
+	// prepareBeforeStart requests the cancellation before the first backup of the fixture
+	prepareBeforeStart := func(t *testing.T) *cancelRun {
+		run := &cancelRun{fixture: newWorkerErrorsFixture(t, false)}
+		run.storedCount, run.storedSize = storedChunks(t, run.fixture.raw)
+		run.recorder = recordProgress(t)
+		RequestCancel()
+		return run
+	}
+	// checkBeforeStart checks that the backup has changed nothing
+	checkBeforeStart := func(t *testing.T, run *cancelRun) {
+		run.expectNoEvents(t)
+		count, size := storedChunks(t, run.fixture.raw)
+		if count != run.storedCount || size != run.storedSize || run.fixture.revisionExists(1) {
+			t.Fatalf("The storage has %d chunks of %d bytes instead of %d of %d", count, size,
+				run.storedCount, run.storedSize)
+		}
+		if cacheFileExists(t, run.fixture.manager, "incomplete_snapshot") {
+			t.Fatalf("An incomplete snapshot has been saved")
+		}
+	}
+	// prepareCancelFixture creates the repository with files of the given numbers of
+	// chunks; the upload with the number cancelAt, or of the last file chunk for 0,
+	// requests the cancellation
+	prepareCancelFixture := func(t *testing.T, cancelAt int64, hold bool,
+		chunks ...int) *cancelRun {
+		fixture := newCancelFixture(t, chunks...)
+		fixture.cancel.cancelAt, fixture.cancel.hold = cancelAt, hold
+		if cancelAt == 0 {
+			fixture.cancel.cancelAt = int64(fixture.fileChunks)
+		}
+		return &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+			fileChunks: fixture.fileChunks, recorder: recordProgress(t)}
+	}
+	prepareBeforeUploadSnapshot := func(t *testing.T) *cancelRun {
+		return prepareCancelFixture(t, 0, false, 3, 5)
+	}
+	checkBeforeUploadSnapshot := func(t *testing.T, run *cancelRun) {
+		expectNoEnd(t, run.recorder.take(), ProgressOperationBackup)
+		if uploads := run.cancel.uploads.Load(); uploads != int64(run.fileChunks) {
+			t.Fatalf("%d chunks have been uploaded instead of the %d file chunks",
+				uploads, run.fileChunks)
+		}
+		if run.fixture.revisionExists(1) {
+			t.Fatalf("The revision 1 has been created despite the cancellation")
+		}
+		if !cacheFileExists(t, run.fixture.manager, "incomplete_snapshot") {
+			t.Fatalf("The incomplete snapshot has not been saved")
+		}
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantLogID string // The log id of the Exception that the backup panics with
+		prepare   func(t *testing.T) *cancelRun
+		check     func(t *testing.T, run *cancelRun)
+	}{
+		{
+			name: "BeforeStartLog", args: hash, wantLogID: CancelLogID,
+			prepare: prepareBeforeStart, check: checkBeforeStart,
+		},
+		{
+			// The log function returns, and the cancellation is raised after it
+			name: "BeforeStartLogFunction", args: hash, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				run.logs = collectWorkerErrorsLogs()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				checkBeforeStart(t, run)
+				entry := "ERROR " + CancelLogID + " The operation has been canceled"
+				if !strings.Contains(run.logs.String(), entry) {
+					t.Fatalf("The log function has not received %q:\n%s", entry, run.logs)
+				}
+				// The backup logs BACKUP_START and other entries before its comparison, which
+				// checks the request as well; the check of the first line stops it before them
+				if strings.Contains(run.logs.String(), " BACKUP_") {
+					t.Fatalf("The backup has started before the cancellation:\n%s", run.logs)
+				}
+			},
+		},
+		{
+			// The first backup is a hash backup: the cancellation at the step 3 saves its
+			// incomplete snapshot, which the next backup resumes
+			name: "Incomplete", args: hash, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := &cancelRun{fixture: newWorkerErrorsFixture(t, false)}
+				run.recorder = cancelAtStep(t, 3)
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				fixture := run.fixture
+				expectNoEnd(t, run.recorder.take(), ProgressOperationBackup)
+				if fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has been created despite the cancellation")
+				}
+				if !cacheFileExists(t, fixture.manager, "incomplete_snapshot") {
+					t.Fatalf("The incomplete snapshot has not been saved")
+				}
+				logs := collectWorkerErrorsLogs()
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				if !strings.Contains(logs.String(), "INFO INCOMPLETE_LOAD ") {
+					t.Fatalf("The next backup has not loaded the incomplete snapshot:\n%s", logs)
+				}
+				if cacheFileExists(t, fixture.manager, "incomplete_snapshot") {
+					t.Fatalf("The incomplete snapshot has not been deleted after the backup")
+				}
+			},
+		},
+		{
+			// The cancellation requested by the log function on INCOMPLETE_LOAD stops the
+			// comparison with the loaded incomplete snapshot; its file has to be closed
+			name: "IncompleteLoaded", args: hash, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := &cancelRun{fixture: newWorkerErrorsFixture(t, false)}
+				cancelAtStep(t, 3)
+				first := run.fixture.backup(run.fixture.repository, false)
+				expectWorkerErrorsException(t, first, CancelLogID)
+				ResetCancel()
+				if !cacheFileExists(t, run.fixture.manager, "incomplete_snapshot") {
+					t.Fatalf("The incomplete snapshot has not been saved")
+				}
+				run.recorder = recordProgress(t)
+				run.logs = cancelOnLog("INCOMPLETE_LOAD")
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				fixture := run.fixture
+				if !strings.Contains(run.logs.String(), "INFO INCOMPLETE_LOAD ") {
+					t.Fatalf("The backup has not loaded the incomplete snapshot:\n%s", run.logs)
+				}
+				run.expectNoEvents(t)
+				if fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has been created despite the cancellation")
+				}
+				if !cacheFileExists(t, fixture.manager, "incomplete_snapshot") {
+					t.Fatalf("The incomplete snapshot has been deleted")
+				}
+				cached, err := filepath.EvalSymlinks(filepath.Join(fixture.manager.cachePath,
+					"incomplete_snapshot"))
+				if err != nil {
+					t.Fatalf("Failed to resolve the incomplete snapshot: %v", err)
+				}
+				open, haveProc := openFilesOf(t)
+				for _, path := range open {
+					if path == cached {
+						t.Errorf("The file %s is still open after the cancellation", cached)
+					}
+				}
+				logs := collectWorkerErrorsLogs()
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				if !strings.Contains(logs.String(), "INFO INCOMPLETE_LOAD ") {
+					t.Fatalf("The next backup has not loaded the incomplete snapshot:\n%s", logs)
+				}
+				if !haveProc {
+					t.Skip("/proc/self/fd is not available to check the open files")
+				}
+			},
+		},
+		{
+			// The upload of the last file chunk requests the cancellation, which only the
+			// check after the uploads sees; the metadata chunks would be uploaded later, by
+			// UploadSnapshot
+			name: "BeforeUploadSnapshot", args: hash, wantLogID: CancelLogID,
+			prepare: prepareBeforeUploadSnapshot, check: checkBeforeUploadSnapshot,
+		},
+		{
+			// The same cancellation with a log function that returns
+			name: "BeforeUploadSnapshotLogFunction", args: hash, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeUploadSnapshot(t)
+				run.logs = collectWorkerErrorsLogs()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				checkBeforeUploadSnapshot(t, run)
+				entry := "ERROR " + CancelLogID + " The operation has been canceled"
+				if !strings.Contains(run.logs.String(), entry) {
+					t.Fatalf("The log function has not received %q:\n%s", entry, run.logs)
+				}
+			},
+		},
+		{
+			// One file of 16 chunks: the upload 2 requests the cancellation, which the
+			// backup sees at the next chunk of the file; with 2 threads at most 2 + 2*2 + 1
+			// chunks have been queued by then
+			name: "StopWithinFile", args: hash, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				return prepareCancelFixture(t, 2, true, 16)
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationBackup)
+				uploads := run.cancel.uploads.Load()
+				if uploads > 2+2*2+1 || uploads >= int64(run.fileChunks) {
+					t.Fatalf("%d of %d file chunks have been uploaded", uploads, run.fileChunks)
+				}
+				if run.fixture.revisionExists(1) {
+					t.Fatalf("The revision 1 has been created despite the cancellation")
+				}
+			},
+		},
+		{
+			// A quick backup after the revision 1 is not a hash backup and saves no
+			// incomplete snapshot; the files change their sizes, so they are packed again
+			name: "Quick", args: quick, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				fixture := newWorkerErrorsFixture(t, false)
+				fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+				for _, file := range []string{"file1", "file2", "dir1/file3"} {
+					// The new sizes are at least 1000000 bytes, the old ones are smaller
+					createRandomFile(filepath.Join(fixture.repository, file), 2000000)
+				}
+				return &cancelRun{fixture: fixture, recorder: cancelAtStep(t, 3)}
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				fixture := run.fixture
+				expectNoEnd(t, run.recorder.take(), ProgressOperationBackup)
+				if fixture.revisionExists(2) {
+					t.Fatalf("The revision 2 has been created despite the cancellation")
+				}
+				for _, name := range []string{"incomplete_snapshot", "incomplete_chunks"} {
+					if cacheFileExists(t, fixture.manager, name) {
+						t.Fatalf("The quick backup has saved %s", name)
+					}
+				}
+				fixture.expectSuccess(fixture.backup(fixture.repository, true), 2)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			resetCancelAfter(t)
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			tt.fields = fields{
+				snapshotID:         run.fixture.manager.snapshotID,
+				storage:            run.fixture.manager.storage,
+				SnapshotManager:    run.fixture.manager.SnapshotManager,
+				snapshotCache:      run.fixture.manager.snapshotCache,
+				config:             run.fixture.manager.config,
+				nobackupFile:       run.fixture.manager.nobackupFile,
+				filtersFile:        run.fixture.manager.filtersFile,
+				excludeByAttribute: run.fixture.manager.excludeByAttribute,
+				cachePath:          run.fixture.manager.cachePath,
+			}
+			tt.args.top = run.fixture.repository
+			manager := &BackupManager{
+				snapshotID:         tt.fields.snapshotID,
+				storage:            tt.fields.storage,
+				SnapshotManager:    tt.fields.SnapshotManager,
+				snapshotCache:      tt.fields.snapshotCache,
+				config:             tt.fields.config,
+				nobackupFile:       tt.fields.nobackupFile,
+				filtersFile:        tt.fields.filtersFile,
+				excludeByAttribute: tt.fields.excludeByAttribute,
+				cachePath:          tt.fields.cachePath,
+			}
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				return manager.Backup(tt.args.top, tt.args.quickMode, tt.args.threads,
+					tt.args.tag, tt.args.showStatistics, tt.args.shadowCopy,
+					tt.args.shadowCopyTimeout, tt.args.enumOnly, tt.args.metadataChunkSize,
+					tt.args.maximumInMemoryEntries)
+			})
+			// The request stays set after the cancellation; it is cleared before the next
+			// operation of the check
+			ResetCancel()
+			expectWorkerErrorsException(t, outcome, tt.wantLogID)
+			if got := outcome.result; got != tt.want {
+				t.Errorf("BackupManager.Backup() = %v, want %v", got, tt.want)
+			}
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			tt.check(t, run)
+		})
+	}
+}
