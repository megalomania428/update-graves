+// verifiedChunkCount returns the number of the records in the list of verified chunks
+// of the snapshot cache of the manager.
+func verifiedChunkCount(t *testing.T, manager *BackupManager) int {
+	t.Helper()
+	content, err := os.ReadFile(filepath.Join(manager.cachePath, "verified_chunks"))
+	if os.IsNotExist(err) {
+		return 0
+	}
+	records := map[string]int64{}
+	if err == nil {
+		err = json.Unmarshal(content, &records)
+	}
+	if err != nil {
+		t.Fatalf("Failed to read the verified chunks: %v", err)
+	}
+	return len(records)
+}
+
+// logVerifyStart installs a log function that collects the entries like
+// collectWorkerErrorsLogs and clears the count of the matching downloads of the storage
+// on the entry that starts the verification of the chunks.
+func logVerifyStart(storage *cancelStorage) *workerErrorsLogs {
+	logs := collectWorkerErrorsLogs()
+	collect := LogFunction
+	LogFunction = func(level int, id string, message string) {
+		collect(level, id, message)
+		if level == INFO && id == "SNAPSHOT_VERIFY" && strings.HasPrefix(message, "Verifying ") {
+			storage.downloadCalls.Store(0)
+		}
+	}
+	return logs
+}
