+// TestBackupManager_CopySnapshots_Cancel checks the cancellation of CopySnapshots.  The
+// cases are added to the skeleton generated by gotests: the fields come from the source
+// manager of the case, the other manager is its destination.
+func TestBackupManager_CopySnapshots_Cancel(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		otherManager        *BackupManager
+		snapshotID          string
+		revisionsToBeCopied []int
+		uploadingThreads    int
+		downloadingThreads  int
+	}
+	// One uploading and one downloading thread, so that the copy is blocked adding a
+	// chunk while the chunks before it are copied
+	single := args{snapshotID: "host1", revisionsToBeCopied: []int{1}, uploadingThreads: 1,
+		downloadingThreads: 1}
+	// prepareCopy creates the copy fixture; the upload to the destination with the number
+	// returned by cancelAt requests the cancellation
+	prepareCopy := func(t *testing.T,
+		cancelAt func(fixture *workerErrorsCopyFixture) int64) *cancelRun {
+		fixture, destination := newCancelCopyFixture(t)
+		destination.cancelAt = cancelAt(fixture)
+		return &cancelRun{fixture: fixture.workerErrorsFixture, copyFixture: fixture,
+			cancel: destination, recorder: recordProgress(t)}
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantLogID string // The log id of the Exception that the copy panics with
+		prepare   func(t *testing.T) *cancelRun
+		check     func(t *testing.T, run *cancelRun)
+	}{
+		{
+			name: "BeforeStart", args: single, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareCopy(t, func(*workerErrorsCopyFixture) int64 { return 0 })
+				RequestCancel()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectNoEvents(t)
+				count, _ := storedChunks(t, run.copyFixture.destinationRaw)
+				if count != 0 || run.copyFixture.copiedRevisionExists() {
+					t.Fatalf("The destination has changed: %d chunks", count)
+				}
+			},
+		},
+		{
+			// The upload 2 requests the cancellation, which the copy sees before adding the
+			// next chunk: with one thread each at most 7 chunks have been added by then
+			name: "FeedLoop", args: single, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				return prepareCopy(t, func(*workerErrorsCopyFixture) int64 { return 2 })
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				fixture := run.copyFixture
+				events := run.recorder.take()
+				expectNoEnd(t, events, ProgressOperationCopy)
+				total := events[0].TotalChunks
+				if total < 20 {
+					t.Fatalf("Only %d chunks to copy", total)
+				}
+				if uploads := run.cancel.uploads.Load(); uploads > 7 || uploads >= total {
+					t.Fatalf("%d of %d chunks have been copied", uploads, total)
+				}
+				fixture.expectNotCopied(run.baseline)
+				fixture.expectCopied(fixture.copy())
+			},
+		},
+		{
+			// The upload of the last chunk requests the cancellation, which the copy sees
+			// only before it writes the revisions
+			name: "BeforeRevisions", args: single, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				return prepareCopy(t, func(fixture *workerErrorsCopyFixture) int64 {
+					return int64(fixture.chunkCount())
+				})
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				events := run.recorder.take()
+				expectNoEnd(t, events, ProgressOperationCopy)
+				total := int64(run.copyFixture.chunkCount())
+				if uploads := run.cancel.uploads.Load(); events[0].TotalChunks != total ||
+					uploads != total {
+					t.Fatalf("%d of %d chunks have been copied instead of all %d", uploads,
+						events[0].TotalChunks, total)
+				}
+				run.copyFixture.expectNotCopied(run.baseline)
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			resetCancelAfter(t)
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			source := run.copyFixture.manager
+			tt.fields = fields{
+				snapshotID:         source.snapshotID,
+				storage:            source.storage,
+				SnapshotManager:    source.SnapshotManager,
+				snapshotCache:      source.snapshotCache,
+				config:             source.config,
+				nobackupFile:       source.nobackupFile,
+				filtersFile:        source.filtersFile,
+				excludeByAttribute: source.excludeByAttribute,
+				cachePath:          source.cachePath,
+			}
+			tt.args.otherManager = run.copyFixture.destination
+			manager := &BackupManager{
+				snapshotID:         tt.fields.snapshotID,
+				storage:            tt.fields.storage,
+				SnapshotManager:    tt.fields.SnapshotManager,
+				snapshotCache:      tt.fields.snapshotCache,
+				config:             tt.fields.config,
+				nobackupFile:       tt.fields.nobackupFile,
+				filtersFile:        tt.fields.filtersFile,
+				excludeByAttribute: tt.fields.excludeByAttribute,
+				cachePath:          tt.fields.cachePath,
+			}
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				return manager.CopySnapshots(tt.args.otherManager, tt.args.snapshotID,
+					tt.args.revisionsToBeCopied, tt.args.uploadingThreads,
+					tt.args.downloadingThreads)
+			})
+			// The request stays set after the cancellation; it is cleared before the next
+			// operation of the check
+			ResetCancel()
+			expectWorkerErrorsException(t, outcome, tt.wantLogID)
+			if got := outcome.result; got != tt.want {
+				t.Errorf("BackupManager.CopySnapshots() = %v, want %v", got, tt.want)
+			}
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			tt.check(t, run)
+		})
+	}
+}
