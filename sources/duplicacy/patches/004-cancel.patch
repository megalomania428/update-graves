+		allowFailures    bool
+	}
+	// The check of the chunks of the revision 1 of host1 and of the revisions of all the
+	// snapshot ids, both with 2 threads
+	chunks := args{snapshotID: "host1", revisionsToCheck: []int{1}, checkChunks: true,
+		threads: 2}
+	all := args{threads: 2}
+	// prepareBeforeStart requests the cancellation before the check
+	prepareBeforeStart := func(t *testing.T) *cancelRun {
+		fixture := newCancelFixture(t, 2)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel}
+		run.storage = storageFiles(t, run.fixture.raw)
+		run.armDownloads(nil, 0, false)
+		run.recorder = recordProgress(t)
+		return run
+	}
+	checkBeforeStart := func(t *testing.T, run *cancelRun) {
+		run.expectNoEvents(t)
+		run.expectNoDownloads(t)
+		run.expectStorageUnchanged(t)
+		if cacheFileExists(t, run.fixture.manager, "verified_chunks") {
+			t.Fatalf("The list of verified chunks has been saved")
+		}
+	}
+	// prepareVerify backs up a file of 16 chunks and requests the cancellation at the
+	// second verified chunk
+	prepareVerify := func(t *testing.T) *cancelRun {
+		fixture := newCancelFixture(t, 16)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel}
+		run.armDownloads(nil, 0, false)
+		run.recorder = cancelAtStep(t, 2)
+		return run
+	}
+	// verifyRecords returns the number of the records in the list of verified chunks
+	// after the canceled check
+	verifyRecords := func(t *testing.T, run *cancelRun) int {
+		expectNoEnd(t, run.recorder.take(), ProgressOperationCheck)
+		records := verifiedChunkCount(t, run.fixture.manager)
+		if records < 2 {
+			t.Fatalf("The list of verified chunks has %d records", records)
+		}
+		return records
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      bool
+		wantLogID string // The log id of the Exception that the check panics with
+		prepare   func(t *testing.T) *cancelRun
+		check     func(t *testing.T, run *cancelRun)
+	}{
+		{
+			name: "BeforeStartLog", args: chunks, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				RequestCancel()
+				return run
+			},
+			check: checkBeforeStart,
+		},
+		{
+			// The log function returns, and the cancellation is raised after it; the check
+			// logs its parameters at DEBUG after a check of the request that comes later
+			name: "BeforeStartLogFunction", args: chunks, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				SetLoggingLevel(DEBUG)
+				run.logs = collectWorkerErrorsLogs()
+				RequestCancel()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				checkBeforeStart(t, run)
+				run.expectOnlyCancelLog(t)
+			},
+		},
+		{
+			name: "VerifyLog", args: chunks, wantLogID: CancelLogID,
+			prepare: prepareVerify,
+			check:   func(t *testing.T, run *cancelRun) { verifyRecords(t, run) },
+		},
+		{
+			// The check that follows verifies only the chunks missing from the list
+			name: "VerifyLogFunction", args: chunks, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareVerify(t)
+				SetLoggingLevel(INFO)
+				run.logs = logVerifyStart(run.cancel)
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				records := verifyRecords(t, run)
+				var total int
+				for _, line := range strings.Split(run.logs.String(), "\n") {
+					if _, err := fmt.Sscanf(line, "INFO SNAPSHOT_VERIFY Verifying %d chunks",
+						&total); err == nil {
+						break
+					}
+				}
+				if total <= 2+2*2+1 || records >= total {
+					t.Fatalf("The check verified %d of %d chunks", records, total)
+				}
+				entry := "ERROR " + CancelLogID + " The operation has been canceled"
+				if got := strings.Count(run.logs.String(), entry); got != 1 {
+					t.Fatalf("The log function has received %q %d times instead of once:\n%s",
+						entry, got, run.logs)
+				}
+				run.armDownloads(func(filePath string) bool {
+					return strings.HasPrefix(filePath, "chunks/")
+				}, 0, false)
+				outcome := run.rerun()
+				if outcome.recovered != nil || !outcome.result {
+					t.Fatalf("The second check failed: %#v (result %t)", outcome.recovered,
+						outcome.result)
+				}
+				if got := run.cancel.downloadCalls.Load(); got != int64(total-records) {
+					t.Fatalf("The second check has downloaded %d chunks instead of %d - %d",
+						got, total, records)
+				}
+				verifying := fmt.Sprintf("SNAPSHOT_VERIFY Verifying %d chunks", total)
+				skipped := fmt.Sprintf("SNAPSHOT_VERIFY Skipped %d chunks that have already "+
+					"been verified before", records)
+				logs := run.logs.String()
+				if got := strings.Count(logs, entry); got != 1 {
+					t.Fatalf("The log function has received %q %d times instead of once:\n%s",
+						entry, got, logs)
+				}
+				if strings.Count(logs, verifying) != 2 || strings.Count(logs, skipped) != 1 {
+					t.Fatalf("The log has no %q twice and %q once:\n%s", verifying, skipped, logs)
+				}
+			},
+		},
+		{
+			// The download of the chunk sequence of the revision 2 requests the
+			// cancellation, which the check sees before the revision 3 of the same id
+			name: "Revisions", args: all, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareCancelRevisions(t, 3, true)
+				second := run.fixture.revisionSnapshot(2)
+				third := run.fixture.revisionSnapshot(3)
+				run.path = run.fixture.chunkPath(third.ChunkSequence[0], true)
+				run.armDownloads(matchPaths(run.fixture.chunkPath(second.ChunkSequence[0], true)),
+					1, false)
+				run.recorder = recordProgress(t)
+				clearSnapshotCache(t, run.fixture.manager)
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectNoEvents(t)
+				if run.cancel.downloaded(run.path) {
+					t.Fatalf("The chunk sequence of the revision 3 has been downloaded")
+				}
+			},
+		},
+		{
+			// The download of the file of the revision 2 requests the cancellation, which the
+			// check sees before it downloads the file of the revision 3
+			name: "RevisionFiles", args: all, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareCancelRevisions(t, 3, false)
+				if run.cancel.IsCacheNeeded() {
+					t.Fatalf("The storage needs a cache, which would serve the revision files")
+				}
+				run.armDownloads(matchPaths("snapshots/host1/2"), 1, false)
+				run.recorder = recordProgress(t)
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectNoEvents(t)
+				if run.cancel.downloaded("snapshots/host1/3") {
+					t.Fatalf("The file of the revision 3 has been downloaded")
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			resetCancelAfter(t)
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			source := run.fixture.manager.SnapshotManager
+			tt.fields = fields{
+				config:                 source.config,
+				storage:                source.storage,
+				fileChunk:              source.fileChunk,
+				snapshotCache:          source.snapshotCache,
+				chunkOperator:          nil,
+				numberOfCorruptedFiles: 0,
+			}
+			manager := &SnapshotManager{
+				config:                 tt.fields.config,
+				storage:                tt.fields.storage,
+				fileChunk:              tt.fields.fileChunk,
+				snapshotCache:          tt.fields.snapshotCache,
+				chunkOperator:          tt.fields.chunkOperator,
+				numberOfCorruptedFiles: tt.fields.numberOfCorruptedFiles,
+			}
+			run.rerun = func() workerErrorsOutcome {
+				return runWorkerErrorsOperation(t, func() bool {
+					return manager.CheckSnapshots(tt.args.snapshotID, tt.args.revisionsToCheck,
+						tt.args.tag, tt.args.showStatistics, tt.args.showTabular,
+						tt.args.checkFiles, tt.args.checkChunks, tt.args.searchFossils,
+						tt.args.resurrect, tt.args.rewriteChunks, tt.args.threads,
+						tt.args.allowFailures)
+				})
+			}
+			outcome := run.rerun()
+			// The request stays set after the cancellation; it is cleared before the next
+			// operation of the check
+			ResetCancel()
+			if tt.wantLogID != "" {
+				expectWorkerErrorsException(t, outcome, tt.wantLogID)
+			} else if outcome.recovered != nil {
+				t.Fatalf("SnapshotManager.CheckSnapshots() panicked with %#v", outcome.recovered)
+			}
+			if tt.wantLogID == "" && outcome.result != tt.want {
+				t.Errorf("SnapshotManager.CheckSnapshots() = %v, want %v", outcome.result, tt.want)
+			}
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			tt.check(t, run)
+		})
+	}
+}
