+			check: func(t *testing.T, run *cancelRun) {
+				run.expectNoEvents(t)
+				run.expectMissing(t, "zdir", "zlink")
+			},
+		},
+		{
+			// The download of the last chunk of the last file, queued only when the restore
+			// waits for it, requests the cancellation after the check before the file
+			name: "AfterFiles", args: single, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareAfterFiles(t, true) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				for _, file := range []string{"file1", "file2", "dir1/file3"} {
+					run.expectFileRestored(t, file)
+				}
+				run.expectExists(t, "extra")
+				info, err := os.Stat(filepath.Join(run.top, "dir1"))
+				if err != nil || info.ModTime().Unix() == past.Unix() {
+					t.Fatalf("The directory dir1 has the metadata restored: %v", err)
+				}
+			},
+		},
+		{
+			name: "AfterFilesNoCancel", args: single, want: 0,
+			prepare: func(t *testing.T) *cancelRun { return prepareAfterFiles(t, false) },
+			check: func(t *testing.T, run *cancelRun) {
