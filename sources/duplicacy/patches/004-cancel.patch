+				storage:            source.storage,
+				SnapshotManager:    source.SnapshotManager,
+				snapshotCache:      source.snapshotCache,
+				config:             source.config,
+				nobackupFile:       source.nobackupFile,
+				filtersFile:        source.filtersFile,
+				excludeByAttribute: source.excludeByAttribute,
+				cachePath:          source.cachePath,
