diff -ruN -x .git a/src/duplicacy_cancel.go b/src/duplicacy_cancel.go
--- a/src/duplicacy_cancel.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_cancel.go	2026-11-10 08:06:22.154774584 +0000
@@ -0,0 +1,71 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"sync/atomic"
+)
+
+// CancelLogID is the LogID of the Exception that an operation stopped by RequestCancel
+// panics with; a consumer tells a cancellation from other errors by comparing
+// Exception.LogID with it.
+const CancelLogID = "OPERATION_CANCELED"
+
+// cancelRequested is set by RequestCancel and cleared by ResetCancel.  Like the other
+// global state of the package, it serves one operation at a time per process.
+var cancelRequested atomic.Bool
+
+// RequestCancel asks the running operation to stop.  It doesn't block and may be called
+// from any goroutine, ProgressFunction included.  The operation stops adding new tasks
+// at its next check, lets the tasks already queued finish and panics in the goroutine
+// that called it with an Exception whose LogID is CancelLogID, logged through LOG_ERROR;
+// a failure that a worker has already recorded is raised instead.  A canceled operation
+// returns no value and reports no end through ProgressFunction.
+//
+// An operation doesn't clear the request, or a request made before it starts would be
+// lost; such an operation panics before it changes anything.  The consumer calls
+// ResetCancel before the next operation.  A request made after the last check of an
+// operation doesn't stop it: the operation completes as usual and the request stays
+// set.  An in-place restore stops only between files.  ListSnapshots, ShowHistory,
+// PrintFile, Diff, DownloadSequence and Benchmark ignore the request.
+func RequestCancel() {
+	cancelRequested.Store(true)
+}
+
+// ResetCancel clears the request of RequestCancel; the consumer calls it before the next
+// operation.
+func ResetCancel() {
+	cancelRequested.Store(false)
+}
+
+// IsCancelRequested reports whether RequestCancel has been called since the last
+// ResetCancel.
+func IsCancelRequested() bool {
+	return cancelRequested.Load()
+}
+
+// raiseCancel panics with the Exception of a cancellation through LOG_ERROR, which
+// panics also after a LogFunction that returns.
+func raiseCancel() {
+	LOG_ERROR(CancelLogID, "The operation has been canceled")
+}
+
+// raiseFailures raises the first failure recorded by one of the operators, which takes
+// precedence over a cancellation.  It doesn't wait for the tasks of the operators; a nil
+// operator is skipped.
+func raiseFailures(operators ...*ChunkOperator) {
+	for _, operator := range operators {
+		if operator != nil {
+			operator.failures.raise()
+		}
+	}
+}
+
+// raiseCancelAfterFailures raises the first failure recorded by one of the operators or
+// else the cancellation.
+func raiseCancelAfterFailures(operators ...*ChunkOperator) {
+	raiseFailures(operators...)
+	raiseCancel()
+}
diff -ruN -x .git a/src/duplicacy_cancel_test.go b/src/duplicacy_cancel_test.go
--- a/src/duplicacy_cancel_test.go	1970-01-01 00:00:00.000000000 +0000
+++ b/src/duplicacy_cancel_test.go	2026-11-10 08:55:45.618324937 +0000
@@ -0,0 +1,691 @@
+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package duplicacy
+
+import (
+	"fmt"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// cancelChunkSize is the size at which the storages of newCancelFixture cut the chunks.
+const cancelChunkSize = 64 * 1024
+
+// resetCancelAfter clears the cancellation request now and after the test.
+func resetCancelAfter(t *testing.T) {
+	ResetCancel()
+	t.Cleanup(ResetCancel)
+}
+
+// cancelStorage wraps faultStorage for the cancellation tests.  It counts the calls of
+// UploadFile on chunk files, under chunks/ or metadata/, and their successful uploads,
+// and requests a cancellation at the call with the number cancelAt.  With hold every
+// upload of a chunk after the request waits 100 ms, so that the operation is blocked
+// adding a task when it checks the request.
+type cancelStorage struct {
+	*faultStorage
+	cancelAt int64        // The number of the chunk upload that requests the cancellation
+	hold     bool         // Delay the chunk uploads made after the request
+	calls    atomic.Int64 // The calls of UploadFile on chunk files
+	uploads  atomic.Int64 // The successful uploads of chunk files
+}
+
+// newCancelStorage wraps the storage and, like newFaultStorage, points its
+// DerivedStorage to the wrapper.
+func newCancelStorage(raw *FileStorage) *cancelStorage {
+	storage := &cancelStorage{faultStorage: newFaultStorage(raw)}
+	raw.DerivedStorage = storage
+	return storage
+}
+
+func (storage *cancelStorage) UploadFile(threadIndex int, filePath string,
+	content []byte) error {
+	if !strings.HasPrefix(filePath, "chunks/") && !strings.HasPrefix(filePath, "metadata/") {
+		return storage.faultStorage.UploadFile(threadIndex, filePath, content)
+	}
+	if storage.hold && IsCancelRequested() {
+		time.Sleep(100 * time.Millisecond)
+	}
+	if storage.calls.Add(1) == storage.cancelAt {
+		RequestCancel()
+	}
+	err := storage.faultStorage.UploadFile(threadIndex, filePath, content)
+	if err == nil {
+		storage.uploads.Add(1)
+	}
+	return err
+}
+
+// cancelAtStep records the progress events like recordProgress and requests a
+// cancellation at the step with the given number.
+func cancelAtStep(t *testing.T, step int64) *progressRecorder {
+	recorder := &progressRecorder{}
+	var steps atomic.Int64
+	setProgressFunction(t, func(event ProgressEvent) {
+		recorder.lock.Lock()
+		recorder.events = append(recorder.events, event)
+		recorder.lock.Unlock()
+		if event.Kind == ProgressKindStep && steps.Add(1) == step {
+			RequestCancel()
+		}
+	})
+	return recorder
+}
+
+// cancelFixture is a repository whose files are cut into chunks of exactly
+// cancelChunkSize, with a storage wrapped by cancelStorage.
+type cancelFixture struct {
+	*workerErrorsFixture
+	cancel     *cancelStorage
+	fileChunks int // The number of the file chunks of a backup of the repository
+}
+
+// newCancelStorageFixture creates a storage in storageDir that cuts the chunks at
+// cancelChunkSize, configured from copyFrom unless it is nil, and a manager of the
+// repository for it with its own snapshot cache.
+func newCancelStorageFixture(t *testing.T, repository string, storageDir string,
+	cache string, copyFrom *Config) *cancelFixture {
+	t.Helper()
+	raw, err := CreateFileStorage(storageDir, false, 2)
+	if err != nil {
+		t.Fatalf("Failed to create the storage: %v", err)
+	}
+	// An average size of 2^30 keeps the rolling hash from cutting the chunks, so they are
+	// cut at the maximum size
+	if !ConfigStorage(raw, 16384, 100, 1<<30, cancelChunkSize, cancelChunkSize/4, "",
+		copyFrom, false, "", 0, 0) {
+		t.Fatalf("Failed to initialize the storage")
+	}
+	storage := newCancelStorage(raw)
+	fixture := &workerErrorsFixture{t: t, repository: repository, raw: raw,
+		storage: storage.faultStorage}
+	fixture.manager = CreateBackupManager("host1", storage, repository, "", "", "", false)
+	if fixture.manager == nil || !fixture.manager.SetupSnapshotCache(cache) {
+		t.Fatalf("Failed to create the backup manager")
+	}
+	return &cancelFixture{workerErrorsFixture: fixture, cancel: storage}
+}
+
+// newCancelFixture creates a repository with a file of the given number of chunks for
+// each number, file1 first, and a storage without a backup.  The number of the file
+// chunks is checked by a backup of the same files to a separate storage with the same
+// configuration.
+func newCancelFixture(t *testing.T, chunks ...int) *cancelFixture {
+	t.Helper()
+	saveWorkerErrorsGlobals(t)
+	dir := t.TempDir()
+	repository := filepath.Join(dir, "repository")
+	if err := os.MkdirAll(filepath.Join(repository, ".duplicacy"), 0700); err != nil {
+		t.Fatalf("Failed to create the repository: %v", err)
+	}
+	fileChunks := 0
+	for i, count := range chunks {
+		content := make([]byte, count*cancelChunkSize)
+		rand.New(rand.NewSource(int64(i + 1))).Read(content)
+		file := filepath.Join(repository, fmt.Sprintf("file%d", i+1))
+		if err := os.WriteFile(file, content, 0600); err != nil {
+			t.Fatalf("Failed to write %s: %v", file, err)
+		}
+		fileChunks += count
+	}
+	SetDuplicacyPreferencePath(filepath.Join(repository, ".duplicacy"))
+	control := newCancelStorageFixture(t, repository, filepath.Join(dir, "control"),
+		"control", nil)
+	control.expectSuccess(control.backup(repository, false), 1)
+	if got := len(control.revisionSnapshot(1).ChunkHashes); got != fileChunks {
+		t.Fatalf("The backup has %d file chunks instead of %d", got, fileChunks)
+	}
+	fixture := newCancelStorageFixture(t, repository, filepath.Join(dir, "storage"),
+		"default", nil)
+	fixture.fileChunks = fileChunks
+	return fixture
+}
+
+// newCancelCopyFixture creates the copy fixture of the cancellation tests: the revision 1
+// of a source with a file of 24 chunks and an empty destination wrapped by
+// cancelStorage, which it returns as well.
+func newCancelCopyFixture(t *testing.T) (*workerErrorsCopyFixture, *cancelStorage) {
+	t.Helper()
+	source := newCancelFixture(t, 24)
+	source.expectSuccess(source.backup(source.repository, false), 1)
+	destination := newCancelStorageFixture(t, source.repository,
+		filepath.Join(t.TempDir(), "destination"), "destination", source.manager.config)
+	fixture := &workerErrorsCopyFixture{workerErrorsFixture: source.workerErrorsFixture,
+		snapshot: source.revisionSnapshot(1), destinationRaw: destination.raw,
+		destinationStorage: destination.storage, destination: destination.manager}
+	return fixture, destination.cancel
+}
+
+// cancelRun is the state of one case of the cancellation tables.
+type cancelRun struct {
+	fixture     *workerErrorsFixture
+	copyFixture *workerErrorsCopyFixture
+	cancel      *cancelStorage    // The storage that requests the cancellation
+	fileChunks  int               // The number of the file chunks of the repository
+	recorder    *progressRecorder // The events of the operation
+	logs        *workerErrorsLogs // The entries of the log function of the case
+	baseline    int               // The number of goroutines before the preparation
+	storedCount int64             // The number of chunks in the storage before the call
+	storedSize  int64             // The size of the chunks in the storage before the call
+}
+
+// expectNoEvents checks that the hook has not been called.
+func (run *cancelRun) expectNoEvents(t *testing.T) {
+	t.Helper()
+	if events := run.recorder.take(); len(events) != 0 {
+		t.Fatalf("Unexpected events %+v", events)
+	}
+}
+
+// cacheFileExists reports whether the file is in the snapshot cache of the manager.
+func cacheFileExists(t *testing.T, manager *BackupManager, name string) bool {
+	t.Helper()
+	_, err := os.Stat(filepath.Join(manager.cachePath, name))
+	if err != nil && !os.IsNotExist(err) {
+		t.Fatalf("Failed to check %s: %v", name, err)
+	}
+	return err == nil
+}
+
+// cancelOnLog installs a log function that collects the entries like
+// collectWorkerErrorsLogs and requests a cancellation when it receives the INFO entry
+// with the log id, then returns.
+func cancelOnLog(logID string) *workerErrorsLogs {
+	logs := collectWorkerErrorsLogs()
+	collect := LogFunction
+	LogFunction = func(level int, id string, message string) {
+		collect(level, id, message)
+		if level == INFO && id == logID {
+			RequestCancel()
+		}
+	}
+	return logs
+}
+
+// openFilesOf returns the paths of the files that the descriptors of the process point
+// to; ok is false when /proc/self/fd is not available.
+func openFilesOf(t *testing.T) (paths []string, ok bool) {
+	t.Helper()
+	entries, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return nil, false
+	}
+	for _, entry := range entries {
+		// A descriptor that is closed in the meantime, like the one of the directory
+		// itself, fails to resolve
+		if target, err := os.Readlink(filepath.Join("/proc/self/fd", entry.Name())); err == nil {
+			paths = append(paths, target)
+		}
+	}
+	return paths, true
+}
+
+// TestBackupManager_Backup_Cancel checks the cancellation of Backup.  The cases are added
+// to the skeleton generated by gotests: the fields come from the manager of the case, the
+// top directory from its repository.
+func TestBackupManager_Backup_Cancel(t *testing.T) {
