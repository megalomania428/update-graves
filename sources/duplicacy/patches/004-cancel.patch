+// prepareCancelRestore backs up the files of the given numbers of chunks as the
+// revision 1 and records their hashes; the restore goes to the repository.
+func prepareCancelRestore(t *testing.T, chunks ...int) *cancelRun {
+	fixture := newCancelFixture(t, chunks...)
+	fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+	run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+		fileChunks: fixture.fileChunks, top: fixture.repository}
+	run.recordHashes(t)
+	return run
+}
+
+// TestBackupManager_Restore_Cancel checks the cancellation of Restore.  The cases are
+// added to the skeleton generated by gotests: the fields come from the manager of the
+// case, the top directory from its run.
+func TestBackupManager_Restore_Cancel(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		top            string
+		revision       int
+		inPlace        bool
+		quickMode      bool
+		threads        int
+		overwrite      bool
+		deleteMode     bool
+		setOwner       bool
+		showStatistics bool
+		patterns       []string
+		allowFailures  bool
+	}
+	// The arguments of the restores of the revision 1 to the repository: with 2 threads
+	// through a temporary file, in place, and in place with 1 thread and deleteMode
+	temporary := args{revision: 1, threads: 2, overwrite: true}
+	inPlace := temporary
+	inPlace.inPlace = true
+	deleting := inPlace
+	deleting.deleteMode = true
+	single := deleting
+	single.threads = 1
+	past := time.Unix(1000000000, 0)
+	// prepareBeforeStart requests the cancellation before the restore to a new directory
+	prepareBeforeStart := func(t *testing.T) *cancelRun {
+		run := prepareCancelRestore(t, 2, 2)
+		run.top = filepath.Join(t.TempDir(), "restored")
+		run.storage = storageFiles(t, run.fixture.raw)
+		run.armDownloads(nil, 0, false)
+		run.recorder = recordProgress(t)
+		return run
+	}
+	checkBeforeStart := func(t *testing.T, run *cancelRun) {
+		run.expectNoEvents(t)
+		run.expectNoDownloads(t)
+		run.expectStorageUnchanged(t)
+		run.expectMissing(t, "")
+	}
+	// prepareLoss restores 2 files of 4 and 1 chunks that the repository has lost, with
+	// the cancellation requested by the download number at of the chunks of the file1
+	// that match
+	prepareLoss := func(t *testing.T, at int64, hold bool, chunk int) *cancelRun {
+		run := prepareCancelRestore(t, 4, 1)
+		removeFiles(t, run.top, "file1", "file2")
+		match := matchPaths(run.fileChunkPaths(t, "file1")...)
+		if chunk > 0 {
+			match = matchPaths(run.fixture.chunkPath(run.fixture.fileChunkHash("file1", chunk),
+				false))
+		}
+		run.armDownloads(match, at, hold)
+		run.recorder = recordProgress(t)
+		return run
+	}
+	// prepareExtra is prepareLoss with a file that the snapshot doesn't have
+	prepareExtra := func(t *testing.T, cancel bool) *cancelRun {
+		run := prepareLoss(t, 1, false, 1)
+		if !cancel {
+			run.armDownloads(nil, 0, false)
+		}
+		if err := os.WriteFile(filepath.Join(run.top, "extra"), []byte("extra"), 0600); err != nil {
+			t.Fatalf("Failed to write the extra file: %v", err)
+		}
+		return run
+	}
+	// prepareAfterFiles creates the directory dir1 with a file of 2 chunks, a mode and a
+	// time that the restore sets last, and 2 files of 2 chunks, then loses all of them
+	prepareAfterFiles := func(t *testing.T, cancel bool) *cancelRun {
+		fixture := newCancelFixture(t, 2, 2)
+		dir1 := filepath.Join(fixture.repository, "dir1")
+		if err := os.MkdirAll(dir1, 0700); err != nil {
+			t.Fatalf("Failed to create dir1: %v", err)
+		}
+		content := make([]byte, 2*cancelChunkSize)
+		rand.New(rand.NewSource(99)).Read(content)
+		if err := os.WriteFile(filepath.Join(dir1, "file3"), content, 0600); err != nil {
+			t.Fatalf("Failed to write dir1/file3: %v", err)
+		}
+		if err := os.Chmod(dir1, 0750); err != nil {
+			t.Fatalf("Failed to change the mode of dir1: %v", err)
+		}
+		if err := os.Chtimes(dir1, past, past); err != nil {
+			t.Fatalf("Failed to change the time of dir1: %v", err)
+		}
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+			top: fixture.repository}
+		run.recordHashes(t)
+		snapshot := run.fixture.revisionSnapshot(1)
+		var last *Entry
+		for _, file := range []string{"file1", "file2", "dir1/file3"} {
+			if entry := run.fixture.findFile(snapshot, file); last == nil ||
+				entry.StartChunk > last.StartChunk {
+				last = entry
+			}
+		}
+		if last.EndChunk <= last.StartChunk {
+			t.Fatalf("The last file has the chunks %d to %d", last.StartChunk, last.EndChunk)
+		}
+		removeFiles(t, run.top, "file1", "file2", "dir1")
+		if err := os.WriteFile(filepath.Join(run.top, "extra"), []byte("extra"), 0600); err != nil {
+			t.Fatalf("Failed to write the extra file: %v", err)
+		}
+		if cancel {
+			run.armDownloads(matchPaths(run.fixture.chunkPath(snapshot.ChunkHashes[last.EndChunk],
+				false)), 1, false)
+		} else {
+			run.armDownloads(nil, 0, false)
+		}
+		run.recorder = recordProgress(t)
+		return run
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      int
+		wantLogID string // The log id of the Exception that the restore panics with
+		prepare   func(t *testing.T) *cancelRun
+		check     func(t *testing.T, run *cancelRun)
+	}{
+		{
+			name: "BeforeStartLog", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				RequestCancel()
+				return run
+			},
+			check: checkBeforeStart,
+		},
+		{
+			// The log function returns, and the cancellation is raised after it
+			name: "BeforeStartLogFunction", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				SetLoggingLevel(DEBUG)
+				run.logs = collectWorkerErrorsLogs()
+				RequestCancel()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				checkBeforeStart(t, run)
+				run.expectOnlyCancelLog(t)
+			},
+		},
+		{
+			// The download 2 of the chunks of the file1 requests the cancellation, which the
+			// restore sees before it writes a chunk of the file1 that follows
+			name: "TempFileLog", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareLoss(t, 2, true, 0) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectMissing(t, "file1", "file2", filepath.Join(".duplicacy", "temporary"))
+			},
+		},
+		{
+			name: "TempFileLogFunction", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareLoss(t, 2, true, 0)
+				run.logs = collectWorkerErrorsLogs()
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectMissing(t, "file1", "file2", filepath.Join(".duplicacy", "temporary"))
+				entry := "ERROR " + CancelLogID + " The operation has been canceled"
+				if !strings.Contains(run.logs.String(), entry) {
+					t.Fatalf("The log function has not received %q:\n%s", entry, run.logs)
+				}
+			},
+		},
+		{
+			// An in-place restore completes the file1 whose second chunk requests the
+			// cancellation and stops before the file2
+			name: "InPlace", args: inPlace, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareLoss(t, 1, false, 1) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectFileRestored(t, "file1")
+				run.expectMissing(t, "file2", filepath.Join(".duplicacy", "temporary"))
+			},
+		},
+		{
+			name: "DeleteMode", args: deleting, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareExtra(t, true) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectFileRestored(t, "file1")
+				run.expectMissing(t, "file2", filepath.Join(".duplicacy", "temporary"))
+				run.expectExists(t, "extra")
+			},
+		},
+		{
+			name: "DeleteModeNoCancel", args: deleting, want: 0,
+			prepare: func(t *testing.T) *cancelRun { return prepareExtra(t, false) },
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectFileRestored(t, "file1")
+				run.expectFileRestored(t, "file2")
+				run.expectMissing(t, "extra")
+			},
+		},
+		{
+			// The cancellation is requested by the download of the chunk of the file listing,
+			// before the comparison has seen the last directory and link
+			name: "Listing", args: inPlace, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				if runtime.GOOS == "windows" {
+					t.Skip("creating symbolic links needs a privilege on Windows")
+				}
+				fixture := newCancelFixture(t, 1)
+				repository := fixture.repository
+				if err := os.MkdirAll(filepath.Join(repository, "dir1"), 0700); err != nil {
+					t.Fatalf("Failed to create dir1: %v", err)
+				}
+				if err := os.MkdirAll(filepath.Join(repository, "zdir"), 0700); err != nil {
+					t.Fatalf("Failed to create zdir: %v", err)
+				}
+				createRandomFile(filepath.Join(repository, "dir1", "file3"), cancelChunkSize)
+				if err := os.Symlink("file1", filepath.Join(repository, "zlink")); err != nil {
+					t.Skipf("Failed to create a symbolic link: %v", err)
+				}
+				fixture.expectSuccess(fixture.backup(repository, false), 1)
+				run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+					top: repository}
+				snapshot := run.fixture.revisionSnapshot(1)
+				path := run.fixture.chunkPath(snapshot.FileSequence[0], true)
+				removeFiles(t, repository, "dir1", "zdir", "zlink", "file1")
+				clearSnapshotCache(t, run.fixture.manager)
+				run.armDownloads(matchPaths(path), 1, false)
+				run.recorder = recordProgress(t)
+				return run
+			},
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectNoEvents(t)
+				run.expectMissing(t, "zdir", "zlink")
+			},
+		},
+		{
+			// The download of the last chunk of the last file, queued only when the restore
+			// waits for it, requests the cancellation after the check before the file
+			name: "AfterFiles", args: single, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareAfterFiles(t, true) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				for _, file := range []string{"file1", "file2", "dir1/file3"} {
+					run.expectFileRestored(t, file)
+				}
+				run.expectExists(t, "extra")
+				info, err := os.Stat(filepath.Join(run.top, "dir1"))
+				if err != nil || info.ModTime().Unix() == past.Unix() {
+					t.Fatalf("The directory dir1 has the metadata restored: %v", err)
+				}
+			},
+		},
+		{
+			name: "AfterFilesNoCancel", args: single, want: 0,
+			prepare: func(t *testing.T) *cancelRun { return prepareAfterFiles(t, false) },
+			check: func(t *testing.T, run *cancelRun) {
+				for _, file := range []string{"file1", "file2", "dir1/file3"} {
+					run.expectFileRestored(t, file)
+				}
+				run.expectMissing(t, "extra")
+				info, err := os.Stat(filepath.Join(run.top, "dir1"))
+				if err != nil || info.ModTime().Unix() != past.Unix() {
+					t.Fatalf("The directory dir1 has not the time %v: %v", past, err)
+				}
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			resetCancelAfter(t)
+			baseline := runtime.NumGoroutine()
+			run := tt.prepare(t)
+			run.baseline = baseline
+			source := run.fixture.manager
+			tt.fields = fields{
+				snapshotID:         source.snapshotID,
+				storage:            source.storage,
+				SnapshotManager:    source.SnapshotManager,
+				snapshotCache:      source.snapshotCache,
+				config:             source.config,
+				nobackupFile:       source.nobackupFile,
+				filtersFile:        source.filtersFile,
+				excludeByAttribute: source.excludeByAttribute,
+				cachePath:          source.cachePath,
+			}
+			tt.args.top = run.top
+			manager := &BackupManager{
+				snapshotID:         tt.fields.snapshotID,
+				storage:            tt.fields.storage,
+				SnapshotManager:    tt.fields.SnapshotManager,
+				snapshotCache:      tt.fields.snapshotCache,
+				config:             tt.fields.config,
+				nobackupFile:       tt.fields.nobackupFile,
+				filtersFile:        tt.fields.filtersFile,
+				excludeByAttribute: tt.fields.excludeByAttribute,
+				cachePath:          tt.fields.cachePath,
+			}
+			// As in TestBackupManager_Restore, got stays -1 when Restore panics
+			got := -1
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				got = manager.Restore(tt.args.top, tt.args.revision, tt.args.inPlace,
+					tt.args.quickMode, tt.args.threads, tt.args.overwrite,
+					tt.args.deleteMode, tt.args.setOwner, tt.args.showStatistics,
+					tt.args.patterns, tt.args.allowFailures)
+				return got == 0
+			})
+			// The request stays set after the cancellation; it is cleared before the next
+			// operation of the check
+			ResetCancel()
+			if tt.wantLogID != "" {
+				expectWorkerErrorsException(t, outcome, tt.wantLogID)
+			} else if outcome.recovered != nil {
+				t.Fatalf("BackupManager.Restore() panicked with %#v", outcome.recovered)
+			}
+			if tt.wantLogID == "" && got != tt.want {
+				t.Errorf("BackupManager.Restore() = %v, want %v", got, tt.want)
+			}
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			tt.check(t, run)
+		})
+	}
+}
