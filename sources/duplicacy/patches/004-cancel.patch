+		run.expectNoDownloads(t)
+		run.expectStorageUnchanged(t)
+		if cacheFileExists(t, run.fixture.manager, "verified_chunks") {
+			t.Fatalf("The list of verified chunks has been saved")
+		}
+	}
+	// prepareVerify backs up a file of 16 chunks and requests the cancellation at the
+	// second verified chunk
+	prepareVerify := func(t *testing.T) *cancelRun {
+		fixture := newCancelFixture(t, 16)
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel}
+		run.armDownloads(nil, 0, false)
+		run.recorder = cancelAtStep(t, 2)
