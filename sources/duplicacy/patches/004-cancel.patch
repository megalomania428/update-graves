+func TestSnapshotManager_PruneSnapshots_Cancel(t *testing.T) {
+	type fields struct {
+		config                 *Config
+		storage                Storage
+		fileChunk              *Chunk
+		snapshotCache          *FileStorage
+		chunkOperator          *ChunkOperator
+		numberOfCorruptedFiles int64
+	}
+	type args struct {
+		selfID               string
+		snapshotID           string
+		revisionsToBeDeleted []int
+		tags                 []string
+		retentions           []string
+		exhaustive           bool
+		exclusive            bool
+		ignoredIDs           []string
+		dryRun               bool
+		deleteOnly           bool
+		collectOnly          bool
+		threads              int
+	}
+	vm1 := args{selfID: "vm1@host1", snapshotID: "vm1@host1", threads: 2}
+	with := func(change func(a *args)) args {
+		a := vm1
+		change(&a)
+		return a
+	}
+	keep := with(func(a *args) { a.retentions = workerErrorsKeep })
+	delete1 := with(func(a *args) { a.revisionsToBeDeleted = []int{1} })
+	delete1Single := with(func(a *args) { a.revisionsToBeDeleted, a.threads = []int{1}, 1 })
+	delete1Exclusive := with(func(a *args) {
+		a.revisionsToBeDeleted, a.exclusive = []int{1}, true
+	})
+	delete12 := with(func(a *args) { a.revisionsToBeDeleted = []int{1, 2} })
+	delete3Single := with(func(a *args) { a.revisionsToBeDeleted, a.threads = []int{3}, 1 })
+	exhaustive := with(func(a *args) { a.exhaustive = true })
+	exhaustiveDryRun := with(func(a *args) { a.exhaustive, a.dryRun = true, true })
+	exhaustiveActed := with(func(a *args) {
+		a.exhaustive, a.threads, a.revisionsToBeDeleted = true, 1, []int{1}
+	})
+	deleteOnly := with(func(a *args) {
+		a.revisionsToBeDeleted, a.deleteOnly, a.threads = []int{1}, true, 1
+	})
+	deleteOnlySingle := with(func(a *args) { a.deleteOnly, a.threads = true, 1 })
+	collectOnly := with(func(a *args) {
+		a.revisionsToBeDeleted, a.collectOnly = []int{1}, true
+	})
+	newRun := func(t *testing.T) *pruneCancelRun {
+		fixture, storage := newPruneCancelFixture(t)
+		return &pruneCancelRun{fixture: fixture, storage: storage}
+	}
+	newChunks := func(run *pruneCancelRun, count int) []string {
+		var hashes []string
+		for i := 0; i < count; i++ {
+			hashes = append(hashes, uploadRandomChunk(run.fixture.manager, 1024))
+		}
+		return hashes
+	}
+	// prepareCollections creates the old collection 1 of the chunks of the revision 3 and,
+	// with both, the collection 2 of the chunks of the revision 5; the revision 7, which
+	// makes them eligible, references either the chunks of the collection 1 or the chunks
+	// 2 and 3 of the fixture
+	prepareCollections := func(t *testing.T, both bool,
+		referencesFossils bool) *pruneCancelRun {
+		run := newRun(t)
+		fixture := run.fixture
+		a := newChunks(run, 3)
+		fixture.createRevision(3, -1, a...)
+		fixture.createRevision(4, 0, fixture.chunks[1], fixture.chunks[2])
+		fixture.expectSuccess(fixture.prune([]int{3}, nil, false))
+		if both {
+			b := newChunks(run, 3)
+			fixture.createRevision(5, 0, b...)
+			fixture.createRevision(6, 0, fixture.chunks[1], fixture.chunks[2])
+			fixture.expectSuccess(fixture.prune([]int{5}, nil, false))
+		}
+		if referencesFossils {
