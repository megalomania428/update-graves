+// prepareCancelRestore backs up the files of the given numbers of chunks as the
+// revision 1 and records their hashes; the restore goes to the repository.
+func prepareCancelRestore(t *testing.T, chunks ...int) *cancelRun {
+	fixture := newCancelFixture(t, chunks...)
