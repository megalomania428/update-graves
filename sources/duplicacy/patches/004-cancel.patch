+			},
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectMissing(t, "file1", "file2", filepath.Join(".duplicacy", "temporary"))
+				entry := "ERROR " + CancelLogID + " The operation has been canceled"
+				if !strings.Contains(run.logs.String(), entry) {
+					t.Fatalf("The log function has not received %q:\n%s", entry, run.logs)
+				}
+			},
+		},
+		{
+			// An in-place restore completes the file1 whose second chunk requests the
+			// cancellation and stops before the file2
+			name: "InPlace", args: inPlace, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareLoss(t, 1, false, 1) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectFileRestored(t, "file1")
+				run.expectMissing(t, "file2", filepath.Join(".duplicacy", "temporary"))
+			},
+		},
+		{
+			name: "DeleteMode", args: deleting, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareExtra(t, true) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectFileRestored(t, "file1")
+				run.expectMissing(t, "file2", filepath.Join(".duplicacy", "temporary"))
+				run.expectExists(t, "extra")
+			},
+		},
+		{
+			name: "DeleteModeNoCancel", args: deleting, want: 0,
+			prepare: func(t *testing.T) *cancelRun { return prepareExtra(t, false) },
+			check: func(t *testing.T, run *cancelRun) {
+				run.expectFileRestored(t, "file1")
+				run.expectFileRestored(t, "file2")
+				run.expectMissing(t, "extra")
+			},
+		},
+		{
+			// The cancellation is requested by the download of the chunk of the file listing,
+			// before the comparison has seen the last directory and link
+			name: "Listing", args: inPlace, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				if runtime.GOOS == "windows" {
+					t.Skip("creating symbolic links needs a privilege on Windows")
+				}
+				fixture := newCancelFixture(t, 1)
+				repository := fixture.repository
+				if err := os.MkdirAll(filepath.Join(repository, "dir1"), 0700); err != nil {
+					t.Fatalf("Failed to create dir1: %v", err)
+				}
+				if err := os.MkdirAll(filepath.Join(repository, "zdir"), 0700); err != nil {
+					t.Fatalf("Failed to create zdir: %v", err)
+				}
+				createRandomFile(filepath.Join(repository, "dir1", "file3"), cancelChunkSize)
+				if err := os.Symlink("file1", filepath.Join(repository, "zlink")); err != nil {
+					t.Skipf("Failed to create a symbolic link: %v", err)
+				}
+				fixture.expectSuccess(fixture.backup(repository, false), 1)
+				run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+					top: repository}
+				snapshot := run.fixture.revisionSnapshot(1)
+				path := run.fixture.chunkPath(snapshot.FileSequence[0], true)
+				removeFiles(t, repository, "dir1", "zdir", "zlink", "file1")
+				clearSnapshotCache(t, run.fixture.manager)
+				run.armDownloads(matchPaths(path), 1, false)
+				run.recorder = recordProgress(t)
+				return run
