+			tt.args.top = run.top
+			manager := &BackupManager{
+				snapshotID:         tt.fields.snapshotID,
+				storage:            tt.fields.storage,
+				SnapshotManager:    tt.fields.SnapshotManager,
+				snapshotCache:      tt.fields.snapshotCache,
+				config:             tt.fields.config,
+				nobackupFile:       tt.fields.nobackupFile,
+				filtersFile:        tt.fields.filtersFile,
+				excludeByAttribute: tt.fields.excludeByAttribute,
+				cachePath:          tt.fields.cachePath,
+			}
+			// As in TestBackupManager_Restore, got stays -1 when Restore panics
+			got := -1
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				got = manager.Restore(tt.args.top, tt.args.revision, tt.args.inPlace,
+					tt.args.quickMode, tt.args.threads, tt.args.overwrite,
+					tt.args.deleteMode, tt.args.setOwner, tt.args.showStatistics,
+					tt.args.patterns, tt.args.allowFailures)
+				return got == 0
+			})
+			// The request stays set after the cancellation; it is cleared before the next
+			// operation of the check
+			ResetCancel()
+			if tt.wantLogID != "" {
+				expectWorkerErrorsException(t, outcome, tt.wantLogID)
+			} else if outcome.recovered != nil {
+				t.Fatalf("BackupManager.Restore() panicked with %#v", outcome.recovered)
+			}
+			if tt.wantLogID == "" && got != tt.want {
+				t.Errorf("BackupManager.Restore() = %v, want %v", got, tt.want)
+			}
+			waitForWorkerErrorsGoroutines(t, run.baseline)
+			tt.check(t, run)
+		})
+	}
+}
