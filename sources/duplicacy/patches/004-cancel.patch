+// prepareCancelRevisions backs up the revisions of host1 whose file1 differs, and with
+// otherID the revision 1 of host2 after them, then clears the snapshot cache.
+func prepareCancelRevisions(t *testing.T, revisions int, otherID bool) *cancelRun {
+	fixture := newCancelFixture(t, 2)
+	repository := fixture.repository
+	change := func(seed int64) {
+		content := make([]byte, 2*cancelChunkSize)
+		rand.New(rand.NewSource(seed)).Read(content)
+		if err := os.WriteFile(filepath.Join(repository, "file1"), content, 0600); err != nil {
+			t.Fatalf("Failed to change the file1: %v", err)
+		}
+	}
+	for revision := 1; revision <= revisions; revision++ {
+		if revision > 1 {
+			change(int64(100 + revision))
+		}
+		fixture.expectSuccess(fixture.backup(repository, false), revision)
+	}
+	if otherID {
+		change(200)
+		other := CreateBackupManager("host2", fixture.cancel, repository, "", "", "", false)
+		if other == nil || !other.SetupSnapshotCache("default") {
+			t.Fatalf("Failed to create the backup manager of host2")
+		}
+		outcome := runWorkerErrorsOperation(t, func() bool {
+			return other.Backup(repository, false, 2, "test", false, false, 0, false, 65536, 1024)
+		})
+		if outcome.recovered != nil || !outcome.result {
+			t.Fatalf("The backup of host2 failed: %#v", outcome.recovered)
+		}
+	}
+	clearSnapshotCache(t, fixture.manager)
+	return &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel}
+}
