+// storageFiles returns the sizes of the regular files under the directory of the file
+// storage by their paths relative to it.
+func storageFiles(t *testing.T, storage *FileStorage) map[string]int64 {
+	t.Helper()
+	files := map[string]int64{}
+	err := filepath.Walk(storage.storageDir, func(path string, info os.FileInfo, err error) error {
+		if err == nil && info.Mode().IsRegular() {
+			relative, _ := filepath.Rel(storage.storageDir, path)
+			files[relative] = info.Size()
+		}
+		return err
+	})
+	if err != nil {
+		t.Fatalf("Failed to list the storage: %v", err)
+	}
+	return files
+}
+
+// expectStorageUnchanged checks that the files of the storage are those of the run.
+func (run *cancelRun) expectStorageUnchanged(t *testing.T) {
+	t.Helper()
+	if got := storageFiles(t, run.fixture.raw); !reflect.DeepEqual(got, run.storage) {
+		t.Fatalf("The storage has changed: %v instead of %v", got, run.storage)
+	}
+}
+
+// expectNoDownloads checks that DownloadFile of the storage has not been called.
+func (run *cancelRun) expectNoDownloads(t *testing.T) {
+	t.Helper()
+	run.cancel.downloadsLock.Lock()
+	defer run.cancel.downloadsLock.Unlock()
+	if len(run.cancel.downloads) != 0 {
+		t.Fatalf("The storage has been asked for %v", run.cancel.downloads)
+	}
+}
+
+// expectOnlyCancelLog checks that the log function received the entry of the
+// cancellation and nothing else.
+func (run *cancelRun) expectOnlyCancelLog(t *testing.T) {
+	t.Helper()
+	entry := "ERROR " + CancelLogID + " The operation has been canceled"
+	if got := run.logs.String(); got != entry {
+		t.Fatalf("The log function has received %q instead of %q", got, entry)
+	}
+}
+
+// armDownloads clears the record of the downloads and sets the download that requests
+// the cancellation: the call number at of the downloads selected by match.
+func (run *cancelRun) armDownloads(match func(filePath string) bool, at int64, hold bool) {
+	storage := run.cancel
+	storage.downloadsLock.Lock()
+	storage.downloads = nil
+	storage.downloadsLock.Unlock()
+	storage.downloadCalls.Store(0)
+	storage.downloadMatch, storage.downloadCancelAt, storage.downloadHold = match, at, hold
+}
+
+// matchPaths selects the downloads of the given paths.
+func matchPaths(paths ...string) func(filePath string) bool {
+	return func(filePath string) bool {
+		for _, path := range paths {
+			if path == filePath {
+				return true
+			}
+		}
+		return false
+	}
+}
+
+// fileChunkPaths returns the storage paths of the chunks of the file in the revision 1.
+func (run *cancelRun) fileChunkPaths(t *testing.T, file string) []string {
+	t.Helper()
+	snapshot := run.fixture.revisionSnapshot(1)
+	entry := run.fixture.findFile(snapshot, file)
+	var paths []string
+	for index := entry.StartChunk; index <= entry.EndChunk; index++ {
+		paths = append(paths, run.fixture.chunkPath(snapshot.ChunkHashes[index], false))
+	}
+	return paths
+}
+
+// recordHashes records the hashes of the files of the repository.
+func (run *cancelRun) recordHashes(t *testing.T) {
+	t.Helper()
+	run.hashes = map[string]string{}
+	repository := run.fixture.repository
+	err := filepath.Walk(repository, func(path string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		relative, _ := filepath.Rel(repository, path)
+		if relative == ".duplicacy" {
+			return filepath.SkipDir
+		}
+		if info.Mode().IsRegular() {
+			run.hashes[filepath.ToSlash(relative)] = getFileHash(path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatalf("Failed to hash the repository: %v", err)
+	}
+}
+
+// expectFileRestored checks that the file under top has the hash recorded before the
+// backup.
+func (run *cancelRun) expectFileRestored(t *testing.T, file string) {
+	t.Helper()
+	if got := getFileHash(filepath.Join(run.top, file)); got == "" || got != run.hashes[file] {
+		t.Fatalf("The file %s has the hash %q instead of %q", file, got, run.hashes[file])
+	}
+}
+
+// expectMissing checks that none of the paths under top exists, symbolic links included.
+func (run *cancelRun) expectMissing(t *testing.T, names ...string) {
+	t.Helper()
+	for _, name := range names {
+		if _, err := os.Lstat(filepath.Join(run.top, name)); !os.IsNotExist(err) {
+			t.Fatalf("The path %s exists (%v)", name, err)
+		}
+	}
+}
+
+// expectExists checks that every path under top exists.
+func (run *cancelRun) expectExists(t *testing.T, names ...string) {
+	t.Helper()
+	for _, name := range names {
+		if _, err := os.Lstat(filepath.Join(run.top, name)); err != nil {
+			t.Fatalf("The path %s is missing: %v", name, err)
+		}
+	}
+}
+
+// removeFiles removes the paths under the directory.
+func removeFiles(t *testing.T, directory string, names ...string) {
+	t.Helper()
+	for _, name := range names {
+		if err := os.RemoveAll(filepath.Join(directory, name)); err != nil {
+			t.Fatalf("Failed to remove %s: %v", name, err)
+		}
+	}
+}
+
+// clearSnapshotCache removes the cached chunks of the manager, so that the metadata
+// chunks are downloaded from the storage; the directory, snapshots/ and verified_chunks
+// stay.
+func clearSnapshotCache(t *testing.T, manager *BackupManager) {
+	t.Helper()
+	chunks := filepath.Join(manager.cachePath, "chunks")
+	entries, err := os.ReadDir(chunks)
+	if err != nil {
+		t.Fatalf("Failed to list the cached chunks: %v", err)
+	}
+	for _, entry := range entries {
+		if err := os.RemoveAll(filepath.Join(chunks, entry.Name())); err != nil {
+			t.Fatalf("Failed to clear the cache: %v", err)
+		}
+	}
+}
