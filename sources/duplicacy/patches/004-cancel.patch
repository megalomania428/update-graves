+// TestBackupManager_Restore_Cancel checks the cancellation of Restore.  The cases are
+// added to the skeleton generated by gotests: the fields come from the manager of the
+// case, the top directory from its run.
+func TestBackupManager_Restore_Cancel(t *testing.T) {
+	type fields struct {
+		snapshotID         string
+		storage            Storage
+		SnapshotManager    *SnapshotManager
+		snapshotCache      *FileStorage
+		config             *Config
+		nobackupFile       string
+		filtersFile        string
+		excludeByAttribute bool
+		cachePath          string
+	}
+	type args struct {
+		top            string
+		revision       int
+		inPlace        bool
+		quickMode      bool
+		threads        int
+		overwrite      bool
+		deleteMode     bool
+		setOwner       bool
+		showStatistics bool
+		patterns       []string
+		allowFailures  bool
+	}
+	// The arguments of the restores of the revision 1 to the repository: with 2 threads
+	// through a temporary file, in place, and in place with 1 thread and deleteMode
+	temporary := args{revision: 1, threads: 2, overwrite: true}
+	inPlace := temporary
+	inPlace.inPlace = true
+	deleting := inPlace
+	deleting.deleteMode = true
+	single := deleting
+	single.threads = 1
+	past := time.Unix(1000000000, 0)
+	// prepareBeforeStart requests the cancellation before the restore to a new directory
+	prepareBeforeStart := func(t *testing.T) *cancelRun {
+		run := prepareCancelRestore(t, 2, 2)
+		run.top = filepath.Join(t.TempDir(), "restored")
+		run.storage = storageFiles(t, run.fixture.raw)
+		run.armDownloads(nil, 0, false)
+		run.recorder = recordProgress(t)
+		return run
+	}
+	checkBeforeStart := func(t *testing.T, run *cancelRun) {
+		run.expectNoEvents(t)
+		run.expectNoDownloads(t)
+		run.expectStorageUnchanged(t)
+		run.expectMissing(t, "")
+	}
+	// prepareLoss restores 2 files of 4 and 1 chunks that the repository has lost, with
+	// the cancellation requested by the download number at of the chunks of the file1
+	// that match
+	prepareLoss := func(t *testing.T, at int64, hold bool, chunk int) *cancelRun {
+		run := prepareCancelRestore(t, 4, 1)
+		removeFiles(t, run.top, "file1", "file2")
+		match := matchPaths(run.fileChunkPaths(t, "file1")...)
+		if chunk > 0 {
+			match = matchPaths(run.fixture.chunkPath(run.fixture.fileChunkHash("file1", chunk),
+				false))
+		}
+		run.armDownloads(match, at, hold)
+		run.recorder = recordProgress(t)
+		return run
+	}
+	// prepareExtra is prepareLoss with a file that the snapshot doesn't have
+	prepareExtra := func(t *testing.T, cancel bool) *cancelRun {
+		run := prepareLoss(t, 1, false, 1)
+		if !cancel {
+			run.armDownloads(nil, 0, false)
+		}
+		if err := os.WriteFile(filepath.Join(run.top, "extra"), []byte("extra"), 0600); err != nil {
+			t.Fatalf("Failed to write the extra file: %v", err)
+		}
+		return run
+	}
+	// prepareAfterFiles creates the directory dir1 with a file of 2 chunks, a mode and a
+	// time that the restore sets last, and 2 files of 2 chunks, then loses all of them
+	prepareAfterFiles := func(t *testing.T, cancel bool) *cancelRun {
+		fixture := newCancelFixture(t, 2, 2)
+		dir1 := filepath.Join(fixture.repository, "dir1")
+		if err := os.MkdirAll(dir1, 0700); err != nil {
+			t.Fatalf("Failed to create dir1: %v", err)
+		}
+		content := make([]byte, 2*cancelChunkSize)
+		rand.New(rand.NewSource(99)).Read(content)
+		if err := os.WriteFile(filepath.Join(dir1, "file3"), content, 0600); err != nil {
+			t.Fatalf("Failed to write dir1/file3: %v", err)
+		}
+		if err := os.Chmod(dir1, 0750); err != nil {
+			t.Fatalf("Failed to change the mode of dir1: %v", err)
+		}
+		if err := os.Chtimes(dir1, past, past); err != nil {
+			t.Fatalf("Failed to change the time of dir1: %v", err)
+		}
+		fixture.expectSuccess(fixture.backup(fixture.repository, false), 1)
+		run := &cancelRun{fixture: fixture.workerErrorsFixture, cancel: fixture.cancel,
+			top: fixture.repository}
+		run.recordHashes(t)
+		snapshot := run.fixture.revisionSnapshot(1)
+		var last *Entry
+		for _, file := range []string{"file1", "file2", "dir1/file3"} {
+			if entry := run.fixture.findFile(snapshot, file); last == nil ||
+				entry.StartChunk > last.StartChunk {
+				last = entry
+			}
+		}
+		if last.EndChunk <= last.StartChunk {
+			t.Fatalf("The last file has the chunks %d to %d", last.StartChunk, last.EndChunk)
+		}
+		removeFiles(t, run.top, "file1", "file2", "dir1")
+		if err := os.WriteFile(filepath.Join(run.top, "extra"), []byte("extra"), 0600); err != nil {
+			t.Fatalf("Failed to write the extra file: %v", err)
+		}
+		if cancel {
+			run.armDownloads(matchPaths(run.fixture.chunkPath(snapshot.ChunkHashes[last.EndChunk],
+				false)), 1, false)
+		} else {
+			run.armDownloads(nil, 0, false)
+		}
+		run.recorder = recordProgress(t)
+		return run
+	}
+	tests := []struct {
+		name      string
+		fields    fields
+		args      args
+		want      int
+		wantLogID string // The log id of the Exception that the restore panics with
+		prepare   func(t *testing.T) *cancelRun
+		check     func(t *testing.T, run *cancelRun)
+	}{
+		{
+			name: "BeforeStartLog", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
+				RequestCancel()
+				return run
+			},
+			check: checkBeforeStart,
+		},
+		{
+			// The log function returns, and the cancellation is raised after it
+			name: "BeforeStartLogFunction", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareBeforeStart(t)
