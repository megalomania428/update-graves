+func TestSnapshotManager_CheckSnapshots_Cancel(t *testing.T) {
+	type fields struct {
+		config                 *Config
+		storage                Storage
+		fileChunk              *Chunk
+		snapshotCache          *FileStorage
+		chunkOperator          *ChunkOperator
