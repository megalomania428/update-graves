+		},
+		{
+			// The download 2 of the chunks of the file1 requests the cancellation, which the
+			// restore sees before it writes a chunk of the file1 that follows
+			name: "TempFileLog", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun { return prepareLoss(t, 2, true, 0) },
+			check: func(t *testing.T, run *cancelRun) {
+				expectNoEnd(t, run.recorder.take(), ProgressOperationRestore)
+				run.expectMissing(t, "file1", "file2", filepath.Join(".duplicacy", "temporary"))
+			},
+		},
+		{
+			name: "TempFileLogFunction", args: temporary, wantLogID: CancelLogID,
+			prepare: func(t *testing.T) *cancelRun {
+				run := prepareLoss(t, 2, true, 0)
+				run.logs = collectWorkerErrorsLogs()
