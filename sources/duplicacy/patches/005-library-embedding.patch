+
+// TestStandardLog_Embedding checks that importing the package leaves the standard log as
+// the standard library sets it up: the package doesn't redirect it in an init().
+func TestStandardLog_Embedding(t *testing.T) {
+	tests := []struct {
+		name string
+		got  interface{}
+		want interface{}
+	}{
+		{name: "writer", got: log.Writer(), want: os.Stderr},
+		{name: "flags", got: log.Flags(), want: log.LstdFlags},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.got != tt.want {
+				t.Errorf("%s = %v, want %v", tt.name, tt.got, tt.want)
+			}
+		})
+	}
+}
+
+func TestRedirectStandardLog(t *testing.T) {
+	tests := []struct {
+		name string
+		// line is printed through the standard log
+		line string
+		// want is the entry that LogFunction must receive, as "<level> <log id> <text>"
+		want string
+	}{
+		{name: "line with a log id", line: "[TEST_ID] text", want: "INFO TEST_ID text"},
+		{
+			name: "line without a log id", line: "plain text",
+			want: "INFO LOG_DEFAULT plain text",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			savedWriter, savedFlags := log.Writer(), log.Flags()
+			t.Cleanup(func() {
+				log.SetOutput(savedWriter)
+				log.SetFlags(savedFlags)
+			})
+			logs := collectWorkerErrorsLogs()
+			RedirectStandardLog()
+			log.Printf("%s", tt.line)
+			if got := logs.String(); got != tt.want {
+				t.Errorf("log = %q, want %q", got, tt.want)
+			}
+			if got := log.Flags(); got != 0 {
+				t.Errorf("log.Flags() = %v, want 0", got)
+			}
+		})
+	}
+}
+
+// TestDependencies_Embedding checks that neither the package nor its tests depend on the
+// keyring package that the CLI uses and the D-Bus package that it imports, whose init()
+// connects to the D-Bus session bus.
+func TestDependencies_Embedding(t *testing.T) {
+	cmd := exec.Command("go", "list", "-deps", "-test", ".")
+	var stderr strings.Builder
+	cmd.Stderr = &stderr
+	output, err := cmd.Output()
+	if err != nil {
+		t.Fatalf("go list: %v: %s", err, stderr.String())
+	}
+	deps := strings.Fields(string(output))
+	tests := []struct {
+		name string
+		// pkg is a package that must not be among the dependencies
+		pkg string
+	}{
+		{name: "keyring", pkg: "github.com/gilbertchen/keyring"},
+		{name: "D-Bus", pkg: "github.com/godbus/dbus"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for _, dep := range deps {
+				if dep == tt.pkg {
+					t.Errorf("go list -deps -test . lists %s", tt.pkg)
+				}
+			}
+		})
+	}
+}
