+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+//go:build !windows
+
+package main
+
+import (
+	"github.com/gilbertchen/keyring"
+
+	"github.com/gilbertchen/duplicacy/src"
+)
+
+// init lets the library read and store the passwords of the CLI in the keyring of the
+// system with the service "duplicacy", as before the library stopped importing the
+// keyring package.
+func init() {
+	duplicacy.KeyringGet = func(key string) (string, error) {
+		return keyring.Get("duplicacy", key)
+	}
+	duplicacy.KeyringSet = func(key string, value string) error {
+		return keyring.Set("duplicacy", key, value)
+	}
+}
