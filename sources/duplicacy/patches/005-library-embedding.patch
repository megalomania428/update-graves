+func TestSavePassword(t *testing.T) {
+	type args struct {
+		preference   Preference
+		passwordType string
+		password     string
+	}
+	saved := args{preference: Preference{Name: "default"}, passwordType: "password",
+		password: "secret"}
+	tests := []struct {
+		name string
+		args args
+		// background is RunInBackground of the case
+		background bool
+		// hook installs a KeyringSet that records its calls and returns err; without it
+		// KeyringSet is nil
+		hook bool
+		err  error
+		// calls are the calls that KeyringSet must receive, as "<key>=<value>"
+		calls []string
+		// log is an entry that the log must contain; empty means no KEYRING_GET entry
+		log string
+	}{
+		{
+			name: "password saved",
+			args: saved, hook: true, calls: []string{"password=secret"},
+		},
+		{
+			name: "password of a named storage saved",
+			args: args{preference: Preference{Name: "offsite"}, passwordType: "password",
+				password: "secret"},
+			hook: true, calls: []string{"offsite_password=secret"},
+		},
+		{
+			name: "background",
+			args: saved, background: true, hook: true,
+		},
+		{
+			name: "empty password",
+			args: args{preference: Preference{Name: "default"}, passwordType: "password"},
+			hook: true,
+		},
+		{
+			name: "password not to be saved",
+			args: args{preference: Preference{Name: "default", DoNotSavePassword: true},
+				passwordType: "password", password: "secret"},
+			hook: true,
+		},
+		{
+			name: "password from the preference",
+			args: args{preference: Preference{Name: "default",
+				Keys: map[string]string{"password": "secret"}},
+				passwordType: "password", password: "secret"},
+			hook: true,
+		},
+		{
+			name: "nil hook",
+			args: saved,
+		},
+		{
+			name: "error of the hook",
+			args: saved, hook: true, err: errKeyringTest,
+			calls: []string{"password=secret"},
+			log:   keyringSetFailed + "no secret service",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			logs := setKeyringTestGlobals(t)
+			RunInBackground = tt.background
+			var calls []string
+			KeyringSet = nil
+			if tt.hook {
+				KeyringSet = func(key string, value string) error {
+					calls = append(calls, key+"="+value)
+					return tt.err
+				}
+			}
+			SavePassword(tt.args.preference, tt.args.passwordType, tt.args.password)
+			if strings.Join(calls, ",") != strings.Join(tt.calls, ",") {
+				t.Errorf("KeyringSet calls = %v, want %v", calls, tt.calls)
+			}
+			checkKeyringTestLog(t, logs, tt.log)
+		})
+	}
+}
