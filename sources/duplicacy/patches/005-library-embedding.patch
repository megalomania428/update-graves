+// Copyright (c) Acrosync LLC. All rights reserved.
+// Free for personal use and commercial trial
+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+//go:build !windows
+
+package duplicacy
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+// errKeyringTest is the error that the keyring hooks of the tests return.
+var errKeyringTest = errors.New("no secret service")
+
+// Log entries of failed keyring calls, as "<level> <log id> <message>" without the cause.
+const (
+	keyringGetFailed = "DEBUG KEYRING_GET Failed to get the value from the keyring: "
+	keyringSetFailed = "DEBUG KEYRING_GET Failed to store the value to the keyring: "
+)
+
+// setKeyringTestGlobals saves the globals that a keyring test changes and restores them
+// after the test, removes the environment variables of the passwords of the tests and
+// returns the collector of the entries that LogFunction receives.
+func setKeyringTestGlobals(t *testing.T) *workerErrorsLogs {
+	saveWorkerErrorsGlobals(t)
+	savedGet, savedSet, savedRunInBackground := KeyringGet, KeyringSet, RunInBackground
+	t.Cleanup(func() {
+		KeyringGet, KeyringSet, RunInBackground = savedGet, savedSet, savedRunInBackground
+	})
+	for _, name := range []string{"DUPLICACY_PASSWORD", "DUPLICACY_OFFSITE_PASSWORD"} {
+		// t.Setenv restores the variable after the test; the variable must be absent
+		t.Setenv(name, "")
+		os.Unsetenv(name)
+	}
+	return collectWorkerErrorsLogs()
+}
+
+// setKeyringTestInput replaces the standard input with a file that contains input and
+// restores it after the test.
+func setKeyringTestInput(t *testing.T, input string) {
+	path := filepath.Join(t.TempDir(), "stdin")
+	if err := os.WriteFile(path, []byte(input), 0600); err != nil {
+		t.Fatal(err)
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	saved := os.Stdin
+	os.Stdin = file
+	t.Cleanup(func() {
+		os.Stdin = saved
+		file.Close()
+	})
+}
+
+// checkKeyringTestLog checks that the log contains the entry want or, if want is empty,
+// no KEYRING_GET entry.
+func checkKeyringTestLog(t *testing.T, logs *workerErrorsLogs, want string) {
+	t.Helper()
+	got := logs.String()
+	if want == "" && strings.Contains(got, "KEYRING_GET") {
+		t.Errorf("log = %q, want no KEYRING_GET entry", got)
+	}
+	if want != "" && !strings.Contains(got, want) {
+		t.Errorf("log = %q, want an entry %q", got, want)
+	}
+}
+
+func TestGetPassword(t *testing.T) {
+	type args struct {
+		preference    Preference
+		passwordType  string
+		prompt        string
+		showPassword  bool
+		resetPassword bool
+	}
+	stored := args{preference: Preference{Name: "default"}, passwordType: "password"}
+	tests := []struct {
+		name string
+		args args
+		want string
+		// background is RunInBackground of the case
+		background bool
+		// hook installs a KeyringGet that returns value and err; without it KeyringGet
+		// is nil
+		hook  bool
+		value string
+		err   error
+		// input is the standard input that the password prompt reads
+		input string
+		// keys are the keys that KeyringGet must receive
+		keys []string
+		// calls are the calls that KeyringSet must receive, as "<key>=<value>"
+		calls []string
+		// log is an entry that the log must contain; empty means no KEYRING_GET entry
+		log string
+	}{
+		{
+			name: "value of the hook",
+			args: stored, want: "secret", background: true,
+			hook: true, value: "secret", keys: []string{"password"},
+		},
+		{
+			name: "value of the hook for a named storage",
+			args: args{preference: Preference{Name: "offsite"}, passwordType: "password"},
+			want: "secret", background: true,
+			hook: true, value: "secret", keys: []string{"offsite_password"},
+		},
+		{
+			name: "nil hook",
+			args: stored, want: "", background: true,
+			log: keyringGetFailed + "KeyringGet is not set",
+		},
+		{
+			name: "error of the hook",
+			args: stored, want: "", background: true,
+			hook: true, err: errKeyringTest, keys: []string{"password"},
+			log: keyringGetFailed + "no secret service",
+		},
+		{
+			name: "value of the hook with an error",
+			args: stored, want: "stale", background: true,
+			hook: true, value: "stale", err: errKeyringTest, keys: []string{"password"},
+			log: keyringGetFailed + "no secret service",
+		},
+		{
+			name: "password reset",
+			args: args{preference: Preference{Name: "default"}, passwordType: "password",
+				showPassword: true, resetPassword: true},
+			want: "typed", hook: true, value: "secret", input: "typed\n",
+			calls: []string{"password="},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			logs := setKeyringTestGlobals(t)
+			RunInBackground = tt.background
+			setKeyringTestInput(t, tt.input)
+			var keys, calls []string
+			KeyringGet = nil
+			if tt.hook {
+				KeyringGet = func(key string) (string, error) {
+					keys = append(keys, key)
+					return tt.value, tt.err
+				}
+			}
+			KeyringSet = func(key string, value string) error {
+				calls = append(calls, key+"="+value)
+				return nil
+			}
+			if got := GetPassword(tt.args.preference, tt.args.passwordType,
+				tt.args.prompt, tt.args.showPassword,
+				tt.args.resetPassword); got != tt.want {
+				t.Errorf("GetPassword() = %v, want %v", got, tt.want)
+			}
+			if strings.Join(keys, ",") != strings.Join(tt.keys, ",") {
+				t.Errorf("KeyringGet keys = %v, want %v", keys, tt.keys)
+			}
+			if strings.Join(calls, ",") != strings.Join(tt.calls, ",") {
+				t.Errorf("KeyringSet calls = %v, want %v", calls, tt.calls)
+			}
+			checkKeyringTestLog(t, logs, tt.log)
+		})
+	}
+}
+
+func TestSavePassword(t *testing.T) {
+	type args struct {
+		preference   Preference
+		passwordType string
+		password     string
+	}
+	saved := args{preference: Preference{Name: "default"}, passwordType: "password",
+		password: "secret"}
+	tests := []struct {
+		name string
+		args args
+		// background is RunInBackground of the case
+		background bool
+		// hook installs a KeyringSet that records its calls and returns err; without it
+		// KeyringSet is nil
+		hook bool
+		err  error
+		// calls are the calls that KeyringSet must receive, as "<key>=<value>"
+		calls []string
+		// log is an entry that the log must contain; empty means no KEYRING_GET entry
+		log string
+	}{
+		{
+			name: "password saved",
+			args: saved, hook: true, calls: []string{"password=secret"},
+		},
+		{
+			name: "password of a named storage saved",
+			args: args{preference: Preference{Name: "offsite"}, passwordType: "password",
+				password: "secret"},
+			hook: true, calls: []string{"offsite_password=secret"},
+		},
+		{
+			name: "background",
+			args: saved, background: true, hook: true,
+		},
+		{
+			name: "empty password",
+			args: args{preference: Preference{Name: "default"}, passwordType: "password"},
+			hook: true,
+		},
+		{
+			name: "password not to be saved",
+			args: args{preference: Preference{Name: "default", DoNotSavePassword: true},
+				passwordType: "password", password: "secret"},
+			hook: true,
+		},
+		{
+			name: "password from the preference",
+			args: args{preference: Preference{Name: "default",
+				Keys: map[string]string{"password": "secret"}},
+				passwordType: "password", password: "secret"},
+			hook: true,
+		},
+		{
+			name: "nil hook",
+			args: saved,
+		},
+		{
+			name: "error of the hook",
+			args: saved, hook: true, err: errKeyringTest,
+			calls: []string{"password=secret"},
+			log:   keyringSetFailed + "no secret service",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			logs := setKeyringTestGlobals(t)
+			RunInBackground = tt.background
+			var calls []string
+			KeyringSet = nil
+			if tt.hook {
+				KeyringSet = func(key string, value string) error {
+					calls = append(calls, key+"="+value)
+					return tt.err
+				}
+			}
+			SavePassword(tt.args.preference, tt.args.passwordType, tt.args.password)
+			if strings.Join(calls, ",") != strings.Join(tt.calls, ",") {
+				t.Errorf("KeyringSet calls = %v, want %v", calls, tt.calls)
+			}
+			checkKeyringTestLog(t, logs, tt.log)
+		})
+	}
+}
