+// uncomparableError is an error whose dynamic type has a slice, so that == panics on two
+// interfaces holding it.
+type uncomparableError struct {
+	lines []string
+}
+
+func (err uncomparableError) Error() string {
+	return strings.Join(err.lines, "; ")
+}
