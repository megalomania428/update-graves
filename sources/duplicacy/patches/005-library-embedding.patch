+// Test_logf_Embedding checks that the Exception that logf raises, after a log function and
+// without one, holds the last argument of the entry that implements error, or nil if no
+// argument does, and the message formatted as before.
+func Test_logf_Embedding(t *testing.T) {
+	type args struct {
+		level  int
+		logID  string
+		format string
+		v      []interface{}
+	}
+	first, last := errors.New("first failure"), errors.New("last failure")
+	tests := []struct {
+		name string
+		args args
+		// logFunction makes logf raise the Exception after a log function
+		logFunction bool
+		// want is the error that the Exception holds
+		want error
+	}{
+		{
+			name: "no error", logFunction: true,
+			args: args{level: ERROR, logID: "LOG_TEST", format: "%d failures", v: []interface{}{2}},
+		},
+		{
+			name: "no arguments", logFunction: true,
+			args: args{level: FATAL, logID: "LOG_TEST", format: "no failure"},
+		},
+		{
+			name: "nil error", logFunction: true,
+			args: args{level: ERROR, logID: "LOG_TEST", format: "failure: %v",
+				v: []interface{}{error(nil)}},
+		},
+		{
+			name: "one error", logFunction: true,
+			args: args{level: ERROR, logID: "LOG_TEST", format: "failure: %v",
+				v: []interface{}{first}},
+			want: first,
+		},
+		{
+			name: "two errors", logFunction: true,
+			args: args{level: ERROR, logID: "LOG_TEST", format: "%v, then %v",
+				v: []interface{}{first, last}},
+			want: last,
+		},
+		{
+			name: "error before a string", logFunction: true,
+			args: args{level: ASSERT, logID: "LOG_TEST", format: "%v at %s",
+				v: []interface{}{first, "the end"}},
+			want: first,
+		},
+		{
+			name: "no error without a log function",
+			args: args{level: ERROR, logID: "LOG_TEST", format: "%d failures", v: []interface{}{2}},
+		},
+		{
+			name: "two errors without a log function",
+			args: args{level: ERROR, logID: "LOG_TEST", format: "%v, then %v",
+				v: []interface{}{first, last}},
+			want: last,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			if tt.logFunction {
+				collectWorkerErrorsLogs()
+			} else {
+				// Without a log function logf prints the entries from the logging level on
+				SetLoggingLevel(ASSERT + 1)
+			}
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				logf(tt.args.level, tt.args.logID, tt.args.format, tt.args.v...)
+				return true
+			})
+			exception, ok := outcome.recovered.(Exception)
+			if !ok {
+				t.Fatalf("logf() panicked with %#v, want an Exception", outcome.recovered)
+			}
+			if got := exception.Unwrap(); got != tt.want {
+				t.Errorf("Exception.Unwrap() = %v, want %v", got, tt.want)
+			}
+			if want := fmt.Sprintf(tt.args.format, tt.args.v...); exception.Message != want {
+				t.Errorf("Exception.Message = %q, want %q", exception.Message, want)
+			}
+		})
+	}
+}
