+// Test_sftpAuthMethods checks that with RunInBackground the SSH authentication methods
+// include the password methods if ssh_password is set in the environment, the preference or
+// the keyring and the public key methods if ssh_key_file is set in one of them or
+// SSH_AUTH_SOCK is, in the order of the methods without RunInBackground, which doesn't read
+// the keyring.
+func Test_sftpAuthMethods(t *testing.T) {
+	password := ssh.PasswordCallback(nil)
+	interactive := ssh.KeyboardInteractive(nil)
+	publicKeys := ssh.PublicKeysCallback(nil)
+	type args struct {
+		preference          Preference
+		keyFile             string
+		passwordAuthMethods []ssh.AuthMethod
+		keyFileAuthMethods  []ssh.AuthMethod
+	}
+	tests := []struct {
+		name string
+		args args
+		want []ssh.AuthMethod
+		// background is the value of RunInBackground
+		background bool
+		// env and keyring are the environment variables and the values of the keyring by key
+		env     map[string]string
+		keyring map[string]string
+		// keys are the keys that the keyring is read with, in order
+		keys []string
+	}{
+		{
+			name:       "password from the environment",
+			args:       args{preference: Preference{Name: "offsite"}},
+			want:       []ssh.AuthMethod{password, interactive},
+			background: true,
+			env:        map[string]string{"DUPLICACY_OFFSITE_SSH_PASSWORD": "secret"},
+			keys:       []string{"offsite_ssh_key_file"},
+		},
+		{
+			name: "password from the preference with the storage name",
+			args: args{preference: Preference{Name: "offsite",
+				Keys: map[string]string{"offsite_ssh_password": "secret"}}},
+			want:       []ssh.AuthMethod{password, interactive},
+			background: true,
+			keys:       []string{"offsite_ssh_key_file"},
+		},
+		{
+			name: "password from the preference without the storage name",
+			args: args{preference: Preference{Name: "offsite",
+				Keys: map[string]string{"ssh_password": "secret"}}},
+			want:       []ssh.AuthMethod{password, interactive},
+			background: true,
+			keys:       []string{"offsite_ssh_key_file"},
+		},
+		{
+			name:       "password from the keyring",
+			args:       args{preference: Preference{Name: "offsite"}},
+			want:       []ssh.AuthMethod{password, interactive},
+			background: true,
+			keyring:    map[string]string{"offsite_ssh_password": "secret"},
+			keys:       []string{"offsite_ssh_password", "offsite_ssh_key_file"},
+		},
+		{
+			name:       "key file from the environment",
+			args:       args{preference: Preference{Name: "offsite"}},
+			want:       []ssh.AuthMethod{publicKeys},
+			background: true,
+			env:        map[string]string{"DUPLICACY_OFFSITE_SSH_KEY_FILE": "/id"},
+			keys:       []string{"offsite_ssh_password"},
+		},
+		{
+			name: "key file from the preference with the storage name",
+			args: args{preference: Preference{Name: "offsite",
+				Keys: map[string]string{"offsite_ssh_key_file": "/id"}}},
+			want:       []ssh.AuthMethod{publicKeys},
+			background: true,
+			keys:       []string{"offsite_ssh_password"},
+		},
+		{
+			name: "key file from the preference without the storage name",
+			args: args{preference: Preference{Name: "offsite",
+				Keys: map[string]string{"ssh_key_file": "/id"}}},
+			want:       []ssh.AuthMethod{publicKeys},
+			background: true,
+			keys:       []string{"offsite_ssh_password"},
+		},
+		{
+			name:       "key file from the keyring",
+			args:       args{preference: Preference{Name: "offsite"}},
+			want:       []ssh.AuthMethod{publicKeys},
+			background: true,
+			keyring:    map[string]string{"offsite_ssh_key_file": "/id"},
+			keys:       []string{"offsite_ssh_password", "offsite_ssh_key_file"},
+		},
+		{
+			name:       "SSH agent only",
+			args:       args{preference: Preference{Name: "default"}},
+			want:       []ssh.AuthMethod{publicKeys},
+			background: true,
+			env:        map[string]string{"SSH_AUTH_SOCK": "/agent"},
+			keys:       []string{"ssh_password", "ssh_key_file"},
+		},
+		{
+			name:       "nothing",
+			args:       args{preference: Preference{Name: "default"}},
+			want:       []ssh.AuthMethod{},
+			background: true,
+			keys:       []string{"ssh_password", "ssh_key_file"},
+		},
+		{
+			name:       "key file from the environment before the password from the keyring",
+			args:       args{preference: Preference{Name: "default"}},
+			want:       []ssh.AuthMethod{publicKeys, password, interactive},
+			background: true,
+			env:        map[string]string{"DUPLICACY_SSH_KEY_FILE": "/id"},
+			keyring:    map[string]string{"ssh_password": "secret"},
+			keys:       []string{"ssh_password"},
+		},
+		{
+			name: "password from the preference before the key file from the keyring",
+			args: args{preference: Preference{Name: "default",
+				Keys: map[string]string{"ssh_password": "secret"}}},
+			want:       []ssh.AuthMethod{password, interactive, publicKeys},
+			background: true,
+			keyring:    map[string]string{"ssh_key_file": "/id"},
+			keys:       []string{"ssh_key_file"},
+		},
+		{
+			name:    "without RunInBackground",
+			args:    args{preference: Preference{Name: "default"}},
+			want:    []ssh.AuthMethod{password, interactive, publicKeys},
+			keyring: map[string]string{"ssh_key_file": "/id"},
+		},
+		{
+			name: "key file from the preference without RunInBackground",
+			args: args{preference: Preference{Name: "default",
+				Keys: map[string]string{"ssh_key_file": "/id"}}},
+			want: []ssh.AuthMethod{publicKeys, password, interactive},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			setKeyringTestGlobals(t)
+			for _, name := range []string{"DUPLICACY_SSH_PASSWORD", "DUPLICACY_SSH_KEY_FILE",
+				"DUPLICACY_OFFSITE_SSH_PASSWORD", "DUPLICACY_OFFSITE_SSH_KEY_FILE", "SSH_AUTH_SOCK"} {
+				// t.Setenv restores the variable after the test; the variable must be absent
+				t.Setenv(name, "")
+				os.Unsetenv(name)
+			}
+			for name, value := range tt.env {
+				t.Setenv(name, value)
+			}
+			RunInBackground = tt.background
+			var keys []string
+			KeyringGet = func(key string) (string, error) {
+				keys = append(keys, key)
+				return tt.keyring[key], nil
+			}
+			// The key file of the environment or the preference, as CreateStorage passes it
+			tt.args.keyFile = GetPasswordFromPreference(tt.args.preference, "ssh_key_file")
+			tt.args.passwordAuthMethods = []ssh.AuthMethod{password, interactive}
+			tt.args.keyFileAuthMethods = []ssh.AuthMethod{publicKeys}
+			got := sftpAuthMethods(tt.args.preference, tt.args.keyFile, tt.args.passwordAuthMethods,
+				tt.args.keyFileAuthMethods)
+			if sftpAuthMethodTypes(got) != sftpAuthMethodTypes(tt.want) {
+				t.Errorf("sftpAuthMethods() = %s, want %s", sftpAuthMethodTypes(got),
+					sftpAuthMethodTypes(tt.want))
+			}
+			if strings.Join(keys, ",") != strings.Join(tt.keys, ",") {
+				t.Errorf("KeyringGet keys = %v, want %v", keys, tt.keys)
+			}
+		})
+	}
+}
+
+// sftpAuthMethodTypes returns the dynamic types of the SSH authentication methods, which
+// tell the password, keyboard interactive and public key methods apart.
+func sftpAuthMethodTypes(methods []ssh.AuthMethod) string {
+	types := []string{}
+	for _, method := range methods {
+		types = append(types, fmt.Sprintf("%T", method))
+	}
+	return "[" + strings.Join(types, " ") + "]"
+}
