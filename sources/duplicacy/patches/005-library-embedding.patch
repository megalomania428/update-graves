+// samePanic reports whether an operation has panicked with the expected value.  Exceptions are compared without
+// Err, since every failure makes a new error, and then by Err: both are nil or have the same text.
+func samePanic(recovered interface{}, expected interface{}) bool {
+	got, ok := recovered.(Exception)
+	want, wantOK := expected.(Exception)
+	if !ok || !wantOK {
+		return recovered == expected
+	}
+	if (got.Err == nil) != (want.Err == nil) || got.Err != nil && got.Err.Error() != want.Err.Error() {
+		return false
+	}
+	got.Err, want.Err = nil, nil
+	return got == want
+}
