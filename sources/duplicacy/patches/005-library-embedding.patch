+func TestGetPassword(t *testing.T) {
+	type args struct {
+		preference    Preference
+		passwordType  string
+		prompt        string
+		showPassword  bool
+		resetPassword bool
+	}
+	stored := args{preference: Preference{Name: "default"}, passwordType: "password"}
+	tests := []struct {
+		name string
+		args args
+		want string
+		// background is RunInBackground of the case
+		background bool
+		// hook installs a KeyringGet that returns value and err; without it KeyringGet
+		// is nil
+		hook  bool
+		value string
+		err   error
+		// input is the standard input that the password prompt reads
+		input string
+		// keys are the keys that KeyringGet must receive
+		keys []string
+		// calls are the calls that KeyringSet must receive, as "<key>=<value>"
+		calls []string
+		// log is an entry that the log must contain; empty means no KEYRING_GET entry
+		log string
+	}{
+		{
+			name: "value of the hook",
+			args: stored, want: "secret", background: true,
+			hook: true, value: "secret", keys: []string{"password"},
+		},
+		{
+			name: "value of the hook for a named storage",
+			args: args{preference: Preference{Name: "offsite"}, passwordType: "password"},
+			want: "secret", background: true,
+			hook: true, value: "secret", keys: []string{"offsite_password"},
+		},
+		{
+			name: "nil hook",
+			args: stored, want: "", background: true,
+			log: keyringGetFailed + "KeyringGet is not set",
+		},
+		{
+			name: "error of the hook",
+			args: stored, want: "", background: true,
+			hook: true, err: errKeyringTest, keys: []string{"password"},
+			log: keyringGetFailed + "no secret service",
+		},
+		{
+			name: "value of the hook with an error",
+			args: stored, want: "stale", background: true,
+			hook: true, value: "stale", err: errKeyringTest, keys: []string{"password"},
+			log: keyringGetFailed + "no secret service",
+		},
+		{
+			name: "password reset",
+			args: args{preference: Preference{Name: "default"}, passwordType: "password",
+				showPassword: true, resetPassword: true},
+			want: "typed", hook: true, value: "secret", input: "typed\n",
+			calls: []string{"password="},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			logs := setKeyringTestGlobals(t)
+			RunInBackground = tt.background
+			setKeyringTestInput(t, tt.input)
+			var keys, calls []string
+			KeyringGet = nil
+			if tt.hook {
+				KeyringGet = func(key string) (string, error) {
+					keys = append(keys, key)
+					return tt.value, tt.err
+				}
+			}
+			KeyringSet = func(key string, value string) error {
+				calls = append(calls, key+"="+value)
+				return nil
+			}
+			if got := GetPassword(tt.args.preference, tt.args.passwordType,
+				tt.args.prompt, tt.args.showPassword,
+				tt.args.resetPassword); got != tt.want {
+				t.Errorf("GetPassword() = %v, want %v", got, tt.want)
