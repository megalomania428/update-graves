+				return "unrecognizable"
+			},
+			wantMessage: "Unrecognizable storage URL: %s",
+			check: func(url string, err error) string {
+				if err != nil {
+					return "an error for an entry without one"
+				}
+				return ""
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			savedRunInBackground := RunInBackground
+			t.Cleanup(func() {
+				RunInBackground = savedRunInBackground
+			})
+			RunInBackground = true
+			SetDuplicacyPreferencePath(t.TempDir())
+			logs := collectWorkerErrorsLogs()
+			url := tt.url(t)
+			tt.args.preference.StorageURL = url
+			var gotStorage Storage
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				gotStorage = CreateStorage(tt.args.preference, tt.args.resetPassword, tt.args.threads)
+				return true
+			})
+			if tt.checkStorage != nil {
+				if outcome.recovered != nil || gotStorage == nil {
+					t.Fatalf("CreateStorage() = %v, panicked with %#v, log:\n%s", gotStorage, outcome.recovered,
+						logs)
+				}
+				tt.checkStorage(t, gotStorage)
+				return
+			}
+			if !reflect.DeepEqual(gotStorage, tt.wantStorage) {
+				t.Errorf("CreateStorage() = %v, want %v", gotStorage, tt.wantStorage)
+			}
+			expectWorkerErrorsException(t, outcome, "STORAGE_CREATE")
+			exception := outcome.recovered.(Exception)
+			err := exception.Unwrap()
+			want := fmt.Sprintf(tt.wantMessage, url)
+			if err != nil {
+				want += err.Error()
+			}
+			if exception.Message != want {
+				t.Errorf("Exception.Message = %q, want %q", exception.Message, want)
+			}
+			if problem := tt.check(url, err); problem != "" {
+				t.Errorf("Exception.Unwrap() = %#v: %s", err, problem)
+			}
+		})
+	}
+}
