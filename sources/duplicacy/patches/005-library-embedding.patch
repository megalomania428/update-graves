+// startSFTPServer starts an SSH server with the SFTP subsystem on the loopback interface,
+// which accepts only the password login of user with password and serves the file system
+// of the process, and returns its address.  The server stops after the test.
+func startSFTPServer(t *testing.T, user string, password string) string {
+	_, privateKey, err := ed25519.GenerateKey(rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	hostKey, err := ssh.NewSignerFromKey(privateKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	config := &ssh.ServerConfig{
+		PasswordCallback: func(metadata ssh.ConnMetadata,
+			secret []byte) (*ssh.Permissions, error) {
+			if metadata.User() == user && string(secret) == password {
+				return nil, nil
+			}
+			return nil, fmt.Errorf("password rejected for %q", metadata.User())
+		},
+	}
+	config.AddHostKey(hostKey)
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var lock sync.Mutex
+	var connections []net.Conn
+	closed := false
+	var group sync.WaitGroup
+	t.Cleanup(func() {
+		listener.Close()
+		lock.Lock()
+		closed = true
+		for _, connection := range connections {
+			connection.Close()
+		}
+		lock.Unlock()
+		group.Wait()
+	})
+	group.Add(1)
+	go func() {
+		defer group.Done()
+		for {
+			connection, err := listener.Accept()
+			if err != nil {
+				return
+			}
+			lock.Lock()
+			if closed {
+				lock.Unlock()
+				connection.Close()
+				return
+			}
+			connections = append(connections, connection)
+			group.Add(1)
+			lock.Unlock()
+			go func() {
+				defer group.Done()
+				serveSFTPConnection(connection, config)
+			}()
+		}
+	}()
+	return listener.Addr().String()
+}
+
+// serveSFTPConnection serves the SFTP subsystem on the session channels of an SSH connection
+// until the connection is closed.
+func serveSFTPConnection(connection net.Conn, config *ssh.ServerConfig) {
+	defer connection.Close()
+	_, channels, requests, err := ssh.NewServerConn(connection, config)
+	if err != nil {
+		return
+	}
+	go ssh.DiscardRequests(requests)
+	for newChannel := range channels {
+		if newChannel.ChannelType() != "session" {
+			newChannel.Reject(ssh.UnknownChannelType, "unknown channel type")
+			continue
+		}
+		channel, channelRequests, err := newChannel.Accept()
+		if err != nil {
+			return
+		}
+		go func() {
+			for request := range channelRequests {
+				// The payload of a subsystem request is the name as an SSH string
+				sftpSubsystem := string(request.Payload) == "\x00\x00\x00\x04sftp"
+				request.Reply(request.Type == "subsystem" && sftpSubsystem, nil)
+			}
+		}()
+		server, err := sftp.NewServer(channel)
+		if err != nil {
+			channel.Close()
+			continue
+		}
+		server.Serve()
+		server.Close()
+	}
+}
