+// TestCreateStorage checks that the Exception of a storage that can't be created holds the
+// error of the backend, in which errors.As finds its type, and the message as before, and
+// that an entry without an error leaves the error of the Exception nil.  It also checks
+// that with RunInBackground an SFTP storage logs in with the password of the preference.
+func TestCreateStorage(t *testing.T) {
+	// A random password, so that no other process can log in to the SFTP server of a case
+	randomBytes := make([]byte, 16)
+	if _, err := rand.Read(randomBytes); err != nil {
+		t.Fatal(err)
+	}
+	sftpPassword := fmt.Sprintf("%x", randomBytes)
+	type args struct {
+		preference    Preference
