+// sftpAuthMethods returns the SSH authentication methods of an SFTP storage in the order of
+// tries: the public key methods first if keyFile, the private key file that the environment
+// or the preference sets, isn't empty, and the password methods first otherwise.  With
+// RunInBackground, which can't ask for a value, it leaves out the password methods unless
+// ssh_password is set in the environment, the preference or the keyring, and the public key
+// methods unless ssh_key_file is set in one of them or SSH_AUTH_SOCK is.
+func sftpAuthMethods(preference Preference, keyFile string,
+	passwordAuthMethods, keyFileAuthMethods []ssh.AuthMethod) []ssh.AuthMethod {
+	if RunInBackground {
+		passwordKey := "ssh_password"
+		keyFileKey := "ssh_key_file"
+		if preference.Name != "default" {
+			passwordKey = preference.Name + "_" + passwordKey
+			keyFileKey = preference.Name + "_" + keyFileKey
+		}
+		if GetPasswordFromPreference(preference, "ssh_password") == "" &&
+			keyringGet(passwordKey) == "" {
+			passwordAuthMethods = nil
+		}
+		if keyFile == "" && keyringGet(keyFileKey) == "" &&
+			os.Getenv("SSH_AUTH_SOCK") == "" {
+			keyFileAuthMethods = nil
+		}
+	}
+
+	authMethods := []ssh.AuthMethod{}
+	if keyFile != "" {
+		authMethods = append(authMethods, keyFileAuthMethods...)
+		authMethods = append(authMethods, passwordAuthMethods...)
+	} else {
+		authMethods = append(authMethods, passwordAuthMethods...)
+		authMethods = append(authMethods, keyFileAuthMethods...)
+	}
+	return authMethods
+}
