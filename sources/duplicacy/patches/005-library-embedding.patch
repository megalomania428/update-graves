+// Commercial use requires per-user licenses available from https://duplicacy.com
+
+package main
+
+import (
+	"log"
+	"testing"
+
+	"github.com/gilbertchen/duplicacy/src"
+)
+
+// TestStandardLog_Embedding checks that the init() of the CLI sends the lines of the
+// standard log to the log of Duplicacy, as the library did when it was imported.
+func TestStandardLog_Embedding(t *testing.T) {
+	tests := []struct {
+		name string
+		// line is printed through the standard log
+		line string
+		// logID and message are what LogFunction must receive at the level INFO
+		logID   string
+		message string
+	}{
+		{
+			name: "line with a log id", line: "[TEST_ID] text",
+			logID: "TEST_ID", message: "text",
+		},
+		{
+			name: "line without a log id", line: "plain text",
+			logID: "LOG_DEFAULT", message: "plain text",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saved := duplicacy.LogFunction
+			t.Cleanup(func() { duplicacy.LogFunction = saved })
+			level, logID, message := -1, "", ""
+			duplicacy.LogFunction = func(l int, id string, m string) {
+				level, logID, message = l, id, m
+			}
+			log.Printf("%s", tt.line)
+			if level != duplicacy.INFO || logID != tt.logID || message != tt.message {
+				t.Errorf("entry = %d %q %q, want %d %q %q", level, logID, message,
+					duplicacy.INFO, tt.logID, tt.message)
+			}
+		})
+	}
+}
