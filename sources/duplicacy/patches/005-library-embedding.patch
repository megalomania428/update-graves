+func TestRedirectStandardLog(t *testing.T) {
+	tests := []struct {
+		name string
+		// line is printed through the standard log
+		line string
+		// want is the entry that LogFunction must receive, as "<level> <log id> <text>"
+		want string
+	}{
+		{name: "line with a log id", line: "[TEST_ID] text", want: "INFO TEST_ID text"},
+		{
+			name: "line without a log id", line: "plain text",
+			want: "INFO LOG_DEFAULT plain text",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			saveWorkerErrorsGlobals(t)
+			savedWriter, savedFlags := log.Writer(), log.Flags()
+			t.Cleanup(func() {
+				log.SetOutput(savedWriter)
+				log.SetFlags(savedFlags)
+			})
+			logs := collectWorkerErrorsLogs()
+			RedirectStandardLog()
+			log.Printf("%s", tt.line)
+			if got := logs.String(); got != tt.want {
+				t.Errorf("log = %q, want %q", got, tt.want)
+			}
+			if got := log.Flags(); got != 0 {
+				t.Errorf("log.Flags() = %v, want 0", got)
+			}
+		})
+	}
+}
