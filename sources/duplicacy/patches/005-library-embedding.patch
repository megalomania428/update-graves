+			},
+		},
+		{
+			name: "file storage under a regular file",
+			args: args{preference: Preference{Name: "default"}, threads: 1},
+			url: func(t *testing.T) string {
+				return filepath.Join(regularFile(t), "sub")
+			},
+			wantMessage: "Failed to load the file storage at %s: ",
+			check: func(url string, err error) string {
+				var target *os.PathError
+				if !errors.As(err, &target) {
+					return "errors.As() finds no *os.PathError"
+				}
+				return ""
+			},
