+// Test_workerErrors_raise checks that the panic of a worker with an Exception whose error
+// can't be compared with == is raised in the goroutine that called the operation with the
+// same log id and error, and that wasPrinted, which CatchLogException calls on it, compares
+// it without a panic and finds it only if record has printed it with the stack trace.
+func Test_workerErrors_raise(t *testing.T) {
+	value := Exception{Level: ERROR, LogID: "RAISE_PROBE", Message: "raise probe",
+		Err: uncomparableError{lines: []string{"raise probe cause"}}}
+	tests := []struct {
+		name string
+		// stackTrace enables the stack trace, with which record prints and remembers the
+		// Exception of a worker
+		stackTrace bool
+		// wantPrinted is what wasPrinted returns for the raised Exception
+		wantPrinted bool
+	}{
+		{name: "without the stack trace"},
+		{name: "with the stack trace", stackTrace: true, wantPrinted: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			savedStackTrace := printStackTrace
+			printedPanics.Lock()
+			savedPrinted := printedPanics.values
+			printedPanics.values = nil
+			printedPanics.Unlock()
+			t.Cleanup(func() {
+				printStackTrace = savedStackTrace
+				printedPanics.Lock()
+				printedPanics.values = savedPrinted
+				printedPanics.Unlock()
+			})
+			printStackTrace = tt.stackTrace
+			failures := newWorkerErrors()
+			done := make(chan struct{})
+			go func() {
+				defer close(done)
+				defer failures.catch()
+				panic(value)
+			}()
+			<-done
+			printed := false
+			outcome := runWorkerErrorsOperation(t, func() bool {
+				defer func() {
+					recovered := recover()
+					// The frame of raise is still on the stack, as it is for CatchLogException
+					printed = wasPrinted(recovered)
+					panic(recovered)
+				}()
+				failures.raise()
+				return true
+			})
+			expectWorkerErrorsException(t, outcome, value.LogID)
+			got := outcome.recovered.(Exception).Unwrap()
+			var cause uncomparableError
+			if !errors.As(got, &cause) || !reflect.DeepEqual(got, value.Err) {
+				t.Errorf("Exception.Unwrap() = %#v, want %#v", got, value.Err)
+			}
+			if printed != tt.wantPrinted {
+				t.Errorf("wasPrinted() = %t, want %t", printed, tt.wantPrinted)
+			}
+		})
+	}
+}
+
+// TestCatchLogException_Embedding runs a child process that panics under CatchLogException
+// with an Exception whose error can't be compared with ==, as TestCatchLogException does with
+// other values, and checks that the child exits as with any other Exception and that the
+// panic of a worker raised in the goroutine that called the operation prints the stack once.
+func TestCatchLogException_Embedding(t *testing.T) {
+	tests := []struct {
+		name string
+		// mode is the mode of runCatchLogExceptionChild
+		mode string
+		// wantGoroutines is the number of the stderr lines starting with the header of a
+		// goroutine
+		wantGoroutines int
+	}{
+		{name: "MainCause", mode: "main/cause"},
+		{name: "WorkerCause", mode: "worker/cause"},
+		{name: "MainCauseStack", mode: "main/cause/stack", wantGoroutines: 1},
+		{name: "WorkerCauseStack", mode: "worker/cause/stack", wantGoroutines: 1},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			command := exec.Command(os.Args[0], "-test.run=^TestCatchLogException$")
+			command.Env = append(os.Environ(), catchLogExceptionMode+"="+tt.mode)
+			var stdout, stderr bytes.Buffer
+			command.Stdout, command.Stderr = &stdout, &stderr
+			code := 0
+			if err := command.Run(); err != nil {
+				exitError, ok := err.(*exec.ExitError)
+				if !ok {
+					t.Fatalf("Failed to run the child process: %v", err)
+				}
+				code = exitError.ExitCode()
+			}
+			goroutines := 0
+			for _, line := range strings.Split(stderr.String(), "\n") {
+				if strings.HasPrefix(line, "goroutine ") {
+					goroutines++
+				}
+			}
+			if code != 100 || goroutines != tt.wantGoroutines {
+				t.Fatalf("The child exited with %d and printed %d goroutines instead of 100 and %d:\n%s",
+					code, goroutines, tt.wantGoroutines, stderr.String())
+			}
+			if strings.Contains(stderr.String(), "comparing uncomparable") {
+				t.Fatalf("The child compared an uncomparable value:\n%s", stderr.String())
+			}
+			if runs := strings.Count(stdout.String(), "RUN_AT_ERROR\n"); runs != 1 {
+				t.Fatalf("RunAtError has been called %d times instead of once:\n%s", runs, stdout.String())
+			}
+		})
+	}
+}
