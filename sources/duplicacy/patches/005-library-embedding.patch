+// TestDownloadConfig checks that DownloadConfig returns an error of the storage itself, so
+// that errors.Is finds it, and that the errors of a wrong password, a corrupt config and an
+// invalid RSA public key wrap the errors that they are made of, with the text as before.
+func TestDownloadConfig(t *testing.T) {
+	type args struct {
+		storage  Storage
+		password string
+	}
+	saveWorkerErrorsGlobals(t)
+	injected := errors.New("injected config failure")
+	// newStorage returns a fault storage around a file storage with a config encrypted with
+	// password, or not encrypted if password is empty
+	newStorage := func(password string) *faultStorage {
+		storage, err := CreateFileStorage(t.TempDir(), false, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !ConfigStorage(storage, 16384, 100, 64*1024, 256*1024, 16*1024, password, nil, false, "",
+			0, 0) {
+			t.Fatal("ConfigStorage() failed")
+		}
+		return newFaultStorage(storage)
+	}
+	// rawStorage returns a file storage whose config file has content, not encrypted
+	rawStorage := func(content string) Storage {
+		dir := t.TempDir()
+		storage, err := CreateFileStorage(dir, false, 1)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(filepath.Join(dir, "config"), []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+		return storage
+	}
+	getFileInfo, downloadFile := newStorage(""), newStorage("")
+	getFileInfo.failWith("GetFileInfo", "config", injected)
+	downloadFile.failWith("DownloadFile", "config", injected)
+	// fail after failWith of the same or a wider prefix injects an error of its own
+	samePrefix, widerPrefix := newStorage(""), newStorage("")
+	samePrefix.failWith("GetFileInfo", "config", injected)
+	samePrefix.fail("GetFileInfo", "config")
+	widerPrefix.failWith("GetFileInfo", "config", injected)
+	widerPrefix.fail("GetFileInfo", "")
+	// The errors that the corrupt config and the invalid RSA public key are made of
+	corrupt, invalidKey := "not a JSON config", `{"rsa-public-key":"00"}`
+	var syntaxError *json.SyntaxError
+	jsonErr := json.Unmarshal([]byte(corrupt), &struct{}{})
+	if !errors.As(jsonErr, &syntaxError) {
+		t.Fatalf("json.Unmarshal(%q) = %v, want a *json.SyntaxError", corrupt, jsonErr)
+	}
+	_, keyErr := x509.ParsePKIXPublicKey([]byte{0})
+	if keyErr == nil {
+		t.Fatal("x509.ParsePKIXPublicKey() accepts a zero byte")
+	}
+	tests := []struct {
+		name            string
+		args            args
+		wantConfig      *Config
+		wantIsEncrypted bool
+		wantErr         bool
+		// wantIs is the error that errors.Is must find in the error, unless nil
+		wantIs error
+		// wantText is the text of the error
+		wantText string
+		// wantDepth is the least number of errors that errors.Unwrap finds one in another,
+		// starting from the error
+		wantDepth int
+		// wantSyntax makes errors.As find a *json.SyntaxError in the error
+		wantSyntax bool
+	}{
+		{
+			name: "failed GetFileInfo", args: args{storage: getFileInfo}, wantErr: true,
+			wantIs: injected, wantText: "injected config failure",
+		},
+		{
+			name: "failed DownloadFile", args: args{storage: downloadFile}, wantErr: true,
+			wantIs: injected, wantText: "injected config failure",
+		},
+		{
+			name: "fail after failWith", args: args{storage: samePrefix}, wantErr: true,
+			wantText: injectedFailure("GetFileInfo", "config").Error(),
+		},
+		{
+			name: "fail of a wider prefix after failWith", args: args{storage: widerPrefix},
+			wantErr: true, wantText: injectedFailure("GetFileInfo", "config").Error(),
+		},
+		{
+			name:    "wrong password",
+			args:    args{storage: newStorage("correct password"), password: "wrong password"},
+			wantErr: true, wantDepth: 1,
+			wantText: "Failed to retrieve the config file: cipher: message authentication failed",
+		},
+		{
+			name: "corrupt config", args: args{storage: rawStorage(corrupt)}, wantErr: true,
+			wantDepth: 1, wantSyntax: true,
+			wantText: "Failed to parse the config file: " + jsonErr.Error(),
+		},
+		{
+			name: "invalid RSA public key", args: args{storage: rawStorage(invalidKey)},
+			wantErr: true, wantDepth: 2,
+			wantText: "Failed to parse the config file: Invalid RSA public key in the config: " +
+				keyErr.Error(),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			gotConfig, gotIsEncrypted, err := DownloadConfig(tt.args.storage, tt.args.password)
+			if (err != nil) != tt.wantErr {
+				t.Errorf("DownloadConfig() error = %v, wantErr %v", err, tt.wantErr)
+				return
+			}
+			if !reflect.DeepEqual(gotConfig, tt.wantConfig) {
+				t.Errorf("DownloadConfig() gotConfig = %v, want %v", gotConfig, tt.wantConfig)
+			}
+			if gotIsEncrypted != tt.wantIsEncrypted {
+				t.Errorf("DownloadConfig() gotIsEncrypted = %v, want %v", gotIsEncrypted,
+					tt.wantIsEncrypted)
+			}
+			if err.Error() != tt.wantText {
+				t.Errorf("DownloadConfig() error = %q, want %q", err.Error(), tt.wantText)
+			}
+			if tt.wantIs != nil && !errors.Is(err, tt.wantIs) {
+				t.Errorf("errors.Is(%v, %v) = false", err, tt.wantIs)
+			}
+			depth := 0
+			for wrapped := errors.Unwrap(err); wrapped != nil; wrapped = errors.Unwrap(wrapped) {
+				depth++
+			}
+			if depth < tt.wantDepth {
+				t.Errorf("errors.Unwrap() finds %d errors in %v, want at least %d", depth, err,
+					tt.wantDepth)
+			}
+			var target *json.SyntaxError
+			if found := errors.As(err, &target); found != tt.wantSyntax {
+				t.Errorf("errors.As(%v, *json.SyntaxError) = %t, want %t", err, found, tt.wantSyntax)
+			}
+		})
+	}
+}
