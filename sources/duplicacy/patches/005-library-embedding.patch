+// TestStandardLog_Embedding checks that importing the package leaves the standard log as
+// the standard library sets it up: the package doesn't redirect it in an init().
+func TestStandardLog_Embedding(t *testing.T) {
+	tests := []struct {
+		name string
+		got  interface{}
+		want interface{}
+	}{
+		{name: "writer", got: log.Writer(), want: os.Stderr},
+		{name: "flags", got: log.Flags(), want: log.LstdFlags},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if tt.got != tt.want {
+				t.Errorf("%s = %v, want %v", tt.name, tt.got, tt.want)
+			}
+		})
+	}
+}
