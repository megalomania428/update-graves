+		name        string
+		args        args
+		wantStorage Storage
+		// url returns the storage URL of the case, which the preference gets
+		url func(t *testing.T) string
+		// wantMessage is the message of the Exception up to the text of its error, with %s
+		// for the storage URL
+		wantMessage string
+		// check returns what is wrong with the error of the Exception, or "" if nothing
+		check func(url string, err error) string
+		// checkStorage, if set, makes the case expect a storage instead of an Exception and
+		// checks the storage
+		checkStorage func(t *testing.T, storage Storage)
+	}{
+		{
+			name: "SFTP connection refused",
+			args: args{preference: Preference{Name: "default"}, threads: 1},
+			url: func(t *testing.T) string {
+				// A port of the loopback interface that nothing listens on
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				address := listener.Addr().String()
+				listener.Close()
+				return "sftp://" + address + "/x"
+			},
+			wantMessage: "Failed to load the SFTP storage at %s: ",
+			check: func(url string, err error) string {
+				var target *net.OpError
+				if !errors.As(err, &target) {
+					return "errors.As() finds no *net.OpError"
+				}
+				return ""
+			},
+		},
+		{
+			name: "SFTP password in the preference",
+			args: args{preference: Preference{Name: "default",
+				Keys: map[string]string{"ssh_password": sftpPassword}}, threads: 1},
+			url: func(t *testing.T) string {
+				for _, name := range []string{"DUPLICACY_SSH_PASSWORD", "DUPLICACY_SSH_KEY_FILE",
+					"SSH_AUTH_SOCK"} {
+					// t.Setenv restores the variable after the test; the variable must be absent
+					t.Setenv(name, "")
+					os.Unsetenv(name)
+				}
+				// The second slash makes the storage directory absolute
+				return "sftp://user@" + startSFTPServer(t, "user", sftpPassword) + "/" + t.TempDir()
