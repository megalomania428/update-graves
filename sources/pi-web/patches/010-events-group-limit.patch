+export interface StickyChunkTransition {
+  chunkKey: string;
+  part?: number;
+  partCount?: number;
+  wasDefaultOpen: boolean;
+  isDefaultOpen: boolean;
+}
+
+/**
+ * The sticky chunk keys that keep a limit-split chunk open after it stops being the
+ * default-open last-of-series chunk, until the user scrolls back to the bottom.
+ */
+export function nextStickyChunkKeys(options: { previousSticky: ReadonlySet<string>; pinnedToBottom: boolean; transitions: readonly StickyChunkTransition[] }): ReadonlySet<string> {
+  if (options.pinnedToBottom) return options.previousSticky.size === 0 ? options.previousSticky : new Set();
+  let next: Set<string> | undefined;
+  for (const transition of options.transitions) {
+    if (!transition.wasDefaultOpen || transition.isDefaultOpen) continue;
+    if (transition.part === undefined || transition.partCount === undefined || transition.part >= transition.partCount) continue;
+    if (options.previousSticky.has(transition.chunkKey)) continue;
+    next ??= new Set(options.previousSticky);
+    next.add(transition.chunkKey);
+  }
+  return next ?? options.previousSticky;
+}
