+export type CodeLanguage = "typescript" | "javascript" | "json" | "markdown" | "css" | "html" | "python" | "rust" | "go";
+
+export function languageForPath(path: string | undefined): CodeLanguage | undefined {
+  if (path === undefined) return undefined;
+  const ext = path.split(".").pop()?.toLowerCase();
+  const languages: Record<string, CodeLanguage | undefined> = {
+    ts: "typescript",
+    tsx: "typescript",
+    js: "javascript",
+    jsx: "javascript",
+    json: "json",
+    md: "markdown",
+    markdown: "markdown",
+    css: "css",
+    htm: "html",
+    html: "html",
+    py: "python",
+    rs: "rust",
+    go: "go",
+  };
+  return ext === undefined ? undefined : languages[ext];
+}
