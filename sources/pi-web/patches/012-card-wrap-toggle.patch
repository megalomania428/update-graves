+
+function findTextNode(element: HTMLElement): Text | undefined {
+  for (const node of Array.from(element.childNodes)) {
+    if (node instanceof Text && node.length > 0) return node;
+  }
+  return undefined;
+}
+
+function measureTextTop(element: HTMLElement, offset: number): number | undefined {
+  const node = findTextNode(element);
+  if (node === undefined || offset >= node.length) return undefined;
+  const range = document.createRange();
+  range.setStart(node, offset);
+  range.setEnd(node, offset + 1);
+  return range.getClientRects()[0]?.top;
+}
+
+function findWrapAnchor(element: HTMLElement): WrapAnchor | undefined {
+  const node = findTextNode(element);
+  if (node === undefined) return undefined;
+  const text = node.data;
+  const starts: number[] = [];
+  let start = 0;
+  while (start < text.length) {
+    const end = text.indexOf("\n", start);
+    if (end !== start) starts.push(start);
+    if (end === -1) break;
+    start = end + 1;
+  }
+  const top = element.getBoundingClientRect().top;
+  let low = 0;
+  let high = starts.length;
+  while (low < high) {
+    const middle = Math.floor((low + high) / 2);
+    const lineTop = measureTextTop(element, starts[middle] ?? 0);
+    if (lineTop === undefined || lineTop >= top - 0.5) high = middle;
+    else low = middle + 1;
+  }
+  const offset = starts[low];
+  if (offset === undefined) return undefined;
+  const lineTop = measureTextTop(element, offset);
+  if (lineTop === undefined || lineTop - top >= element.clientHeight) return undefined;
+  return { offset, distance: lineTop - top };
+}
