+function findTextNode(element: HTMLElement): Text | undefined {
+  for (const node of Array.from(element.childNodes)) {
+    if (node instanceof Text && node.length > 0) return node;
+  }
+  return undefined;
+}
+
+function measureTextTop(element: HTMLElement, offset: number): number | undefined {
+  const node = findTextNode(element);
+  if (node === undefined || offset >= node.length) return undefined;
+  const range = document.createRange();
+  range.setStart(node, offset);
+  range.setEnd(node, offset + 1);
+  return range.getClientRects()[0]?.top;
+}
+
+function measureTextBottom(element: HTMLElement, offset: number): number | undefined {
+  const node = findTextNode(element);
+  if (node === undefined || offset >= node.length) return undefined;
+  const end = node.data.indexOf("\n", offset);
+  const range = document.createRange();
+  range.setStart(node, offset);
+  range.setEnd(node, end === -1 ? node.length : end);
+  return range.getBoundingClientRect().bottom;
+}
+
+function minVisiblePart(element: HTMLElement): number {
+  const style = getComputedStyle(element);
+  const lineHeight = Number.parseFloat(style.lineHeight);
+  return (Number.isNaN(lineHeight) ? Number.parseFloat(style.fontSize) * 1.2 : lineHeight) / 2;
+}
+
+function findWrapAnchor(element: HTMLElement): WrapAnchor | undefined {
+  const lines = wrapLines(element);
+  if (lines.length > 0) return findLineAnchor(element, lines);
+  const node = findTextNode(element);
+  if (node === undefined) return undefined;
+  const text = node.data;
+  const starts: number[] = [];
+  let start = 0;
+  while (start < text.length) {
+    const end = text.indexOf("\n", start);
+    if (end !== start) starts.push(start);
+    if (end === -1) break;
+    start = end + 1;
+  }
+  const top = element.getBoundingClientRect().top;
+  let low = 0;
+  let high = starts.length;
+  while (low < high) {
+    const middle = Math.floor((low + high) / 2);
+    const lineTop = measureTextTop(element, starts[middle] ?? 0);
+    if (lineTop === undefined || lineTop >= top - 0.5) high = middle;
+    else low = middle + 1;
+  }
+  const previous = starts[low - 1];
+  const previousBottom = previous === undefined ? undefined : measureTextBottom(element, previous);
+  if (previous !== undefined && previousBottom !== undefined && previousBottom >= top + element.clientTop + minVisiblePart(element)) {
+    return { line: false, offset: previous, distance: element.clientTop };
+  }
+  const offset = starts[low];
+  if (offset === undefined) return undefined;
+  const lineTop = measureTextTop(element, offset);
+  if (lineTop === undefined || lineTop - top >= element.clientHeight) return undefined;
+  return { line: false, offset, distance: lineTop - top };
+}
+
+function wrapLines(element: HTMLElement): HTMLElement[] {
+  return Array.from(element.querySelectorAll<HTMLElement>(":scope > code > span"));
+}
+
+function measureAnchorTop(element: HTMLElement, anchor: WrapAnchor): number | undefined {
+  if (!anchor.line) return measureTextTop(element, anchor.offset);
+  return wrapLines(element)[anchor.offset]?.getBoundingClientRect().top;
+}
+
+function findLineAnchor(element: HTMLElement, lines: HTMLElement[]): WrapAnchor | undefined {
+  const top = element.getBoundingClientRect().top;
+  let low = 0;
+  let high = lines.length;
+  while (low < high) {
+    const middle = Math.floor((low + high) / 2);
+    const lineTop = lines[middle]?.getBoundingClientRect().top;
+    if (lineTop === undefined || lineTop >= top - 0.5) high = middle;
+    else low = middle + 1;
+  }
+  const previous = lines[low - 1];
+  if (previous !== undefined && previous.getBoundingClientRect().bottom >= top + element.clientTop + minVisiblePart(element)) {
+    return { line: true, offset: low - 1, distance: element.clientTop };
+  }
+  const lineTop = lines[low]?.getBoundingClientRect().top;
+  if (lineTop === undefined || lineTop - top >= element.clientHeight) return undefined;
+  return { line: true, offset: low, distance: lineTop - top };
+}
