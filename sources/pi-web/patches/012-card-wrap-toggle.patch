+  private toggleWrap(scroller: ToolScroller, event: Event): void {
+    event.preventDefault();
+    event.stopPropagation();
+    const element = this.findScroller(scroller);
+    const range = element === undefined ? 0 : element.scrollHeight - element.clientHeight;
+    this.pendingWrapScroll = {
+      scroller,
+      pinned: this.scrollerStates[scroller].pinned
+        && (range > 0 || (this.execution !== undefined && isLiveExecution(this.execution))),
+      ratio: element === undefined || range <= 0 ? 0 : element.scrollTop / range,
+      anchor: element === undefined || range <= 0 ? undefined : findWrapAnchor(element),
+    };
+    this.wrapped = { ...this.wrapped, [scroller]: !this.wrapped[scroller] };
+  }
+
+  private restoreWrapScroll(): void {
+    const pending = this.pendingWrapScroll;
+    if (pending === undefined) return;
+    this.pendingWrapScroll = undefined;
+    const element = this.findScroller(pending.scroller);
+    if (element === undefined || !this.isScrollerOpen(element)) return;
+    if (pending.pinned) {
+      this.scrollScrollerToBottom(pending.scroller, element);
+      return;
+    }
+    const anchor = pending.anchor;
+    const anchorTop = anchor === undefined ? undefined : measureAnchorTop(element, anchor);
+    if (anchor !== undefined && anchorTop !== undefined) {
+      element.scrollTop += anchorTop - element.getBoundingClientRect().top - anchor.distance;
+      return;
+    }
+    element.scrollTop = pending.ratio * Math.max(0, element.scrollHeight - element.clientHeight);
+  }
