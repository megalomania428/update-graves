+/**
+ * Split an optional pi CLI-style `:<thinking level>` suffix off a spawn-tool
+ * model spec. Model ids may themselves contain `:` (e.g. an OpenRouter
+ * `:free` variant), so the suffix is only recognized when the text after the
+ * last `:` is a known thinking level; anything else is left as part of the
+ * model spec and reported back unchanged.
+ */
+function parseThinkingLevelSuffix(spec: string): { modelSpec: string; thinkingLevel?: ClientThinkingLevel } {
+  const colon = spec.lastIndexOf(":");
+  if (colon < 0) return { modelSpec: spec };
+  const suffix = spec.slice(colon + 1);
+  if (!isKnownThinkingLevel(suffix)) return { modelSpec: spec };
+  return { modelSpec: spec.slice(0, colon), thinkingLevel: suffix };
+}
