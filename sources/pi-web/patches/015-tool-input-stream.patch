+      streamId: firstStreamId(published()),
+    });
+    await service.dispose();
+  });
+
+  it("carries one identity per answer on its start, deltas and end", async () => {
+    const { fake, service, published } = await onlineService();
+    const first = assistantStream();
+    fake.emit(first.start());
+    first.text(0, "Hi");
+    fake.emit(first.update({ type: "text_delta", contentIndex: 0, delta: "Hi" }));
+    fake.emit(first.end());
