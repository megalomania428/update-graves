+
+    it("keeps the earlier card when the answer has no card of its own", () => {
+      const ended: SessionUiEvent = { type: "message.end", message: { role: "assistant", content: [readCall], streamId: "stream-2" } };
+      expect(apply([past], [ended, readStart])).toEqual([past, { ...skillLine, streamId: "stream-2" }]);
+    });
+  });
+});
