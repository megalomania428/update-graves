+const base = { type: "tool.input", streamId: "stream-1", toolCallId: "call-1", toolName: "write" };
+
+describe("streamed tool input frames", () => {
+  it("keeps validated operations and the transport seq", () => {
+    expect(parseSessionSocketEvent({
+      ...base, revision: 2, seq: 7, extra: true, timestamp: "2026-11-27T00:00:00.000Z",
+      operation: { op: "splice", path: ["questions", 0, "question"], offset: 3, text: "x", baseRevision: 1, extra: true },
+    })).toEqual({
+      ...base, revision: 2, seq: 7, timestamp: "2026-11-27T00:00:00.000Z",
+      operation: { op: "splice", path: ["questions", 0, "question"], offset: 3, text: "x", baseRevision: 1 },
+    });
+    expect(parseSessionSocketEvent({ ...base, revision: 1, seq: 3, operation: { op: "set", args: { path: "a.txt" } } }))
+      .toEqual({ ...base, revision: 1, seq: 3, operation: { op: "set", args: { path: "a.txt" } } });
+  });
+
+  it("drops malformed frames", () => {
+    const operations: unknown[] = [
+      { op: "merge", args: {} },
+      { op: "set" },
+      { op: "splice", path: ["a", -1], offset: 0, text: "", baseRevision: 0 },
+      { op: "splice", path: ["a", 1.5], offset: 0, text: "", baseRevision: 0 },
+      { op: "splice", path: "a", offset: 0, text: "", baseRevision: 0 },
+      { op: "splice", path: ["a"], offset: -1, text: "", baseRevision: 0 },
+      { op: "splice", path: ["a"], offset: 0, text: 1, baseRevision: 0 },
+    ];
+    for (const operation of operations) {
+      expect(parseSessionSocketEvent({ ...base, revision: 1, operation })).toBeUndefined();
+    }
+    expect(parseSessionSocketEvent({ ...base, revision: 0, operation: { op: "set", args: {} } })).toBeUndefined();
+    expect(parseSessionSocketEvent({ ...base, streamId: undefined, revision: 1, operation: { op: "set", args: {} } })).toBeUndefined();
+  });
+
+  it("keeps the answer identity of starts and deltas", () => {
+    expect(parseSessionSocketEvent({ type: "assistant.start", message: { role: "assistant", content: [], streamId: "stream-1" }, seq: 1 }))
