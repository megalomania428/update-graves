+          toolCallId, toolName, revision,
+          operation: { op: "splice", path, offset, text, baseRevision: current.revision },
+        };
+      }
+    }
+    const copy = jsonCopy(args) ?? {};
+    this.blocks.set(contentIndex, { type: "toolCall", toolCallId, toolName, revision, args: copy });
