@@ -0,0 +1,86 @@
+import { describe, expect, it } from "vitest";
+import { applyToolInputSplice, diffToolInput } from "./toolInputStream";
+
+describe("diffToolInput", () => {
+  it("reports no change for equal arguments", () => {
+    expect(diffToolInput({ path: "a", content: "x" }, { path: "a", content: "x" })).toBeUndefined();
+  });
+
+  it("splices the tail of the only changed string", () => {
+    expect(diffToolInput({ path: "a.ts", content: "line 1\n" }, { path: "a.ts", content: "line 1\nline 2" }))
+      .toEqual({ op: "splice", path: ["content"], offset: 7, text: "line 2" });
+  });
+
+  it("cuts back to the common prefix when the parser rebuilt the tail", () => {
+    expect(diffToolInput({ content: "a\\" }, { content: "a\n" }))
+      .toEqual({ op: "splice", path: ["content"], offset: 1, text: "\n" });
+  });
+
+  it("splices a string nested in arrays and objects", () => {
+    const previous = { questions: [{ question: "First?" }, { question: "Sec" }] };
+    const next = { questions: [{ question: "First?" }, { question: "Second?" }] };
+    expect(diffToolInput(previous, next))
+      .toEqual({ op: "splice", path: ["questions", 1, "question"], offset: 3, text: "ond?" });
+  });
+
+  it("counts offsets in UTF-16 code units", () => {
+    expect(diffToolInput({ text: "😀a" }, { text: "😀b" }))
+      .toEqual({ op: "splice", path: ["text"], offset: 2, text: "b" });
+    expect(diffToolInput({ text: "a\uD83D" }, { text: "a😀" }))
+      .toEqual({ op: "splice", path: ["text"], offset: 2, text: "\uDE00" });
+  });
+
+  it("sets the whole arguments on any other change", () => {
+    expect(diffToolInput({ path: "a" }, { path: "a", content: "" }))
+      .toEqual({ op: "set", args: { path: "a", content: "" } });
+    expect(diffToolInput({ a: "x", b: "y" }, { a: "x1", b: "y1" }))
+      .toEqual({ op: "set", args: { a: "x1", b: "y1" } });
+    expect(diffToolInput({ items: ["a"] }, { items: ["a", ""] }))
+      .toEqual({ op: "set", args: { items: ["a", ""] } });
+    expect(diffToolInput({ count: 1 }, { count: 12 })).toEqual({ op: "set", args: { count: 12 } });
+  });
+});
+
+describe("applyToolInputSplice", () => {
+  it("cuts the target at the offset and appends without touching the input", () => {
+    const args = { questions: [{ question: "Sec" }], other: "keep" };
+    expect(applyToolInputSplice(args, ["questions", 0, "question"], 2, "cond?"))
+      .toEqual({ args: { questions: [{ question: "Second?" }], other: "keep" } });
+    expect(args.questions[0]?.question).toBe("Sec");
+  });
+
+  it("reproduces every splice diffToolInput reports", () => {
+    const pairs: [unknown, unknown][] = [
+      [{ content: "abc\\" }, { content: "abc\n" }],
+      [{ text: "a\uD83D" }, { text: "a😀" }],
+      [{ list: [{ v: "x" }] }, { list: [{ v: "xyz" }] }],
+    ];
+    for (const [previous, next] of pairs) {
+      const change = diffToolInput(previous, next);
+      if (change?.op !== "splice") throw new Error("expected a splice");
+      expect(applyToolInputSplice(previous, change.path, change.offset, change.text)).toEqual({ args: next });
+    }
+  });
+
+  it("rejects paths and offsets that leave own data", () => {
+    const args: unknown = JSON.parse('{"__proto__":{"polluted":"no"},"list":["a"],"text":"t"}');
+    expect(applyToolInputSplice(args, ["toString"], 0, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["missing"], 0, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["list", 1], 0, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["list", "0"], 0, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["list"], 0, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["text"], 2, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["text"], -1, "x")).toBeUndefined();
+    expect(applyToolInputSplice(args, ["text"], 0.5, "x")).toBeUndefined();
+  });
+
+  it("writes an own __proto__ key as data without touching any prototype", () => {
+    const args: unknown = JSON.parse('{"__proto__":{"polluted":"no"}}');
+    const expected: unknown = JSON.parse('{"__proto__":{"polluted":"yes"}}');
+    const result = applyToolInputSplice(args, ["__proto__", "polluted"], 0, "yes");
+    expect(result).toEqual({ args: expected });
+    expect(Object.getPrototypeOf(result?.args)).toBe(Object.prototype);
+    const probe: Record<string, unknown> = {};
+    expect(probe["polluted"]).toBeUndefined();
+  });
+});
