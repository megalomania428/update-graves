--- a/src/shared/toolInputStream.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/shared/toolInputStream.ts	2026-11-27 17:30:35.199128115 +0000
@@ -0,0 +1,124 @@
+import type { ToolInputPathSegment } from "./apiTypes.js";
+
+/** How streamed tool-call arguments changed: replaced whole, or one string rewritten. */
+export type ToolInputChange =
+  | { op: "set"; args: unknown }
+  | { op: "splice"; path: ToolInputPathSegment[]; offset: number; text: string };
+
+interface StringChange {
+  path: ToolInputPathSegment[];
+  previous: string;
+  next: string;
+}
+
+type Comparison = "equal" | "structural" | StringChange;
+
+/**
+ * Compare published arguments with a newer parse. A change confined to one string
+ * becomes a `splice` from the longest common prefix, so a tail the partial-JSON
+ * parser rebuilt is cut back instead of appended twice; any other change is a
+ * `set`. Offsets count UTF-16 code units, like `String.length`.
+ */
+export function diffToolInput(previous: unknown, next: unknown): ToolInputChange | undefined {
+  const comparison = compareValues(previous, next, []);
+  if (comparison === "equal") return undefined;
+  if (comparison === "structural") return { op: "set", args: next };
+  const offset = commonPrefixLength(comparison.previous, comparison.next);
+  return { op: "splice", path: comparison.path, offset, text: comparison.next.slice(offset) };
+}
+
+/**
+ * Cut the string at `path` in a copy of `args` to `offset` and append `text`.
+ * Only own keys of plain objects and in-range array indexes are followed, and
+ * copies get own data properties, so a key like `__proto__` never reaches or
+ * replaces a prototype. `undefined` when the path, target or offset does not fit.
+ */
+export function applyToolInputSplice(
+  args: unknown,
+  path: readonly ToolInputPathSegment[],
+  offset: number,
+  text: string,
+): { args: unknown } | undefined {
+  return spliceAt(args, path, 0, offset, text);
+}
+
+function spliceAt(
+  value: unknown,
+  path: readonly ToolInputPathSegment[],
+  depth: number,
+  offset: number,
+  text: string,
+): { args: unknown } | undefined {
+  if (depth === path.length) {
+    if (typeof value !== "string" || !Number.isSafeInteger(offset)) return undefined;
+    if (offset < 0 || offset > value.length) return undefined;
+    return { args: value.slice(0, offset) + text };
+  }
+  const segment = path[depth];
+  if (typeof segment === "number") {
+    if (!isUnknownArray(value) || !Number.isSafeInteger(segment)) return undefined;
+    if (segment < 0 || segment >= value.length) return undefined;
+    const child = spliceAt(value[segment], path, depth + 1, offset, text);
+    if (child === undefined) return undefined;
+    const copy = [...value];
+    copy[segment] = child.args;
+    return { args: copy };
+  }
+  if (segment === undefined || !isPlainRecord(value) || !Object.hasOwn(value, segment)) {
+    return undefined;
+  }
+  const child = spliceAt(value[segment], path, depth + 1, offset, text);
+  if (child === undefined) return undefined;
+  const copy: Record<string, unknown> = { ...value };
+  Object.defineProperty(copy, segment, {
+    value: child.args, enumerable: true, writable: true, configurable: true,
+  });
+  return { args: copy };
+}
+
+function compareValues(previous: unknown, next: unknown, path: ToolInputPathSegment[]): Comparison {
+  if (typeof previous === "string" && typeof next === "string") {
+    return previous === next ? "equal" : { path, previous, next };
+  }
+  if (isUnknownArray(previous) && isUnknownArray(next)) {
+    if (previous.length !== next.length) return "structural";
+    return compareChildren(previous.map((value, index) => [index, value, next[index]] as const), path);
+  }
+  if (isPlainRecord(previous) && isPlainRecord(next)) {
+    const keys = Object.keys(previous);
+    const nextKeys = Object.keys(next);
+    if (keys.length !== nextKeys.length) return "structural";
+    if (keys.some((key, index) => key !== nextKeys[index])) return "structural";
+    return compareChildren(keys.map((key) => [key, previous[key], next[key]] as const), path);
+  }
+  return Object.is(previous, next) ? "equal" : "structural";
+}
+
+function compareChildren(
+  children: readonly (readonly [ToolInputPathSegment, unknown, unknown])[],
+  path: ToolInputPathSegment[],
+): Comparison {
+  let change: StringChange | undefined;
+  for (const [segment, previous, next] of children) {
+    const comparison = compareValues(previous, next, [...path, segment]);
+    if (comparison === "equal") continue;
+    if (comparison === "structural" || change !== undefined) return "structural";
+    change = comparison;
+  }
+  return change ?? "equal";
+}
+
+function commonPrefixLength(left: string, right: string): number {
+  const limit = Math.min(left.length, right.length);
+  let index = 0;
+  while (index < limit && left.charCodeAt(index) === right.charCodeAt(index)) index += 1;
+  return index;
+}
+
+function isUnknownArray(value: unknown): value is unknown[] {
+  return Array.isArray(value);
+}
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
