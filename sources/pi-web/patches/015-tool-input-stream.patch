+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { SessionUiEvent } from "../../shared/apiTypes.js";
+import { PiSessionService, type PiAgentSession } from "./piSessionService.js";
+import { CapturingSessionEventHub, fakeRuntime, fakeSessionManager, runtimeCreator, sessionGateway, sessionRecord, sessionRef, testModelRuntime } from "./piSessionService.testSupport.js";
+
+const TEST_AGENT_DIR = "/tmp/pi-web-test-agent";
+
+async function onlineService(patch: Parameters<typeof fakeRuntime>[1] = {}) {
+  const fake = fakeRuntime("session-1", patch);
+  let rebindSession: ((session: PiAgentSession) => Promise<void>) | undefined;
+  fake.runtime.setRebindSession = (callback) => { rebindSession = callback; };
+  const events = new CapturingSessionEventHub();
+  const service = new PiSessionService(events, {
+    agentDir: TEST_AGENT_DIR,
+    modelRuntime: testModelRuntime,
+    createAgentRuntime: runtimeCreator(fake.runtime),
+    sessionManager: sessionGateway([sessionRecord("session-1")]),
+    heartbeatIntervalMs: 60_000,
+  });
+  await service.status(sessionRef("session-1")); // bring the session online so it publishes events
+  events.sessionEvents.length = 0;
+  events.globalEvents.length = 0;
+  const replaceRuntime = async (replacement: ReturnType<typeof fakeRuntime>) => {
+    Object.defineProperty(fake.runtime, "session", { configurable: true, value: replacement.session });
+    await rebindSession?.(replacement.session);
+  };
+  return { fake, service, replaceRuntime, published: () => events.sessionEvents.map(({ event }) => event) };
+}
+
+/** An assistant message whose content blocks the SDK replaces in place, as pi-ai does. */
+function assistantStream() {
+  const content: unknown[] = [];
+  const message = { role: "assistant", provider: "fake", model: "fake-model", content };
+  return {
+    start: () => ({ type: "message_start", message }),
+    update: (assistantMessageEvent: Record<string, unknown>) => ({
+      type: "message_update", message, assistantMessageEvent: { ...assistantMessageEvent, partial: message },
+    }),
+    end: () => ({ type: "message_end", message }),
+    text: (index: number, text: string) => { content[index] = { type: "text", text }; },
+    toolCall: (index: number, id: string, name: string, args: unknown) => {
+      content[index] = { type: "toolCall", id, name, arguments: args, partialJson: JSON.stringify(args), index };
+    },
+  };
+}
+
+function streamIdOf(message: unknown): string | undefined {
+  if (typeof message !== "object" || message === null || !("streamId" in message)) return undefined;
+  return typeof message.streamId === "string" ? message.streamId : undefined;
+}
+
+function firstStreamId(events: SessionUiEvent[]): string {
+  const start = events.find((event) => event.type === "assistant.start");
+  const streamId = start?.type === "assistant.start" ? streamIdOf(start.message) : undefined;
+  if (streamId === undefined) throw new Error("no assistant.start with a streamId");
+  return streamId;
+}
+
+function toolInputs(events: SessionUiEvent[]) {
+  return events.flatMap((event) => event.type === "tool.input" ? [event] : []);
+}
+
+function activityLabels(events: SessionUiEvent[]): string[] {
+  return events.flatMap((event) => event.type === "activity.update" ? [event.activity.label] : []);
+}
+
