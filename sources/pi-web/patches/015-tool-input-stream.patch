+    stream.toolCall(0, "call-1", "write", {});
+    fake.emit(stream.update({ type: "toolcall_start", contentIndex: 0 }));
+    stream.toolCall(0, "call-1", "write", { path: "a.txt", content: "one\n" });
+    fake.emit(stream.update({ type: "toolcall_delta", contentIndex: 0, delta: "fragment" }));
+    stream.toolCall(0, "call-1", "write", { path: "a.txt", content: "one\ntwo" });
