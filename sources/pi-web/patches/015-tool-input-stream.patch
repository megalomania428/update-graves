+/** A `tool.input` event without its stream identity and time. */
+export interface ToolInputUpdate {
+  toolCallId: string;
+  toolName: string;
+  revision: number;
+  operation: ToolInputOperation;
+}
+
+/**
+ * One assistant answer as its live events showed it to clients: text and
+ * thinking accumulated from published deltas, tool-call arguments from published
+ * `tool.input` operations. The SDK message can already hold later chunks while an
+ * event waits for extension hooks, and it carries provider-only fields, so the
+ * join snapshot uses this copy instead.
+ */
+export class PublishedAssistantStream {
+  private readonly blocks = new Map<number, PublishedBlock>();
+
+  private constructor(private readonly head: Record<string, unknown>) {}
+
+  /** Keep the `message_start` fields; its content is not published live, so it is dropped. */
+  static start(message: unknown): PublishedAssistantStream {
+    const entries = isRecord(message) ? Object.entries(message) : [];
+    return new PublishedAssistantStream(Object.fromEntries(entries.flatMap(([key, value]) => {
+      const copy = key === "content" ? undefined : jsonCopy(value);
+      return copy === undefined ? [] : [[key, copy] as const];
+    })));
+  }
+
+  appendText(contentIndex: number, text: string): void {
+    const block = this.blocks.get(contentIndex);
+    const previous = block?.type === "text" ? block.text : "";
+    this.blocks.set(contentIndex, { type: "text", text: previous + text });
+  }
+
+  appendThinking(contentIndex: number, thinking: string): void {
+    const block = this.blocks.get(contentIndex);
+    const previous = block?.type === "thinking" ? block.thinking : "";
+    this.blocks.set(contentIndex, { type: "thinking", thinking: previous + thinking });
+  }
+
+  /**
+   * Record the parsed arguments of the call at `contentIndex` and return what to
+   * publish. Call start and end always publish a `set`; a chunk publishes a
+   * `splice` when one string changed, a `set` for any other change and nothing
+   * when the parse is unchanged. Revisions of a block only grow.
+   */
+  updateToolInput(contentIndex: number, block: unknown, chunk: boolean): ToolInputUpdate | undefined {
+    const toolCallId = getString(block, "id") ?? "";
+    if (toolCallId === "") return undefined;
+    const toolName = getString(block, "name") ?? "";
