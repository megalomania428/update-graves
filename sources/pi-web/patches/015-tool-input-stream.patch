+import { describe, expect, it } from "vitest";
+import type { ToolInputOperation } from "../../shared/apiTypes";
+import { normalizeMessages } from "./chatMessages";
+import { applyToolInputEvent, applyTranscriptEvent } from "./chatTranscript";
+import { ChatTranscriptStore } from "./chatTranscriptStore";
+import type { ChatLine } from "./components/shared";
+import type { SessionUiEvent } from "./sessionSocket";
+
+const streamId = "stream-1";
+
+function input(toolCallId: string, revision: number, operation: ToolInputOperation, toolName = "write"): Extract<SessionUiEvent, { type: "tool.input" }> {
+  return { type: "tool.input", streamId, toolCallId, toolName, revision, operation };
+}
+
+function apply(messages: ChatLine[], events: SessionUiEvent[]): ChatLine[] {
+  return events.reduce((next, event) => applyTranscriptEvent(next, event) ?? next, messages);
+}
+
+function card(toolCallId: string, toolName: string, summary: string, args: unknown, inputRevision: number): ChatLine {
+  return { role: "tool", streamId, parts: [{ type: "toolExecution", toolCallId, toolName, summary, args, status: "pending", inputRevision }] };
+}
+
+const earlier: ChatLine = { role: "assistant", parts: [{ type: "text", text: "Earlier answer" }] };
+
+describe("streamed tool input", () => {
+  const written = apply([], [
+    input("call-1", 1, { op: "set", args: {} }),
+    input("call-1", 2, { op: "set", args: { path: "a.txt", content: "one\n" } }),
+    input("call-1", 3, { op: "splice", path: ["content"], offset: 4, text: "two", baseRevision: 2 }),
+    input("call-2", 1, { op: "set", args: { command: "ls" } }, "bash"),
+  ]);
+
+  it("builds one pending card per call from set and splice operations", () => {
+    expect(written).toEqual([
+      card("call-1", "write", "a.txt", { path: "a.txt", content: "one\ntwo" }, 3),
+      card("call-2", "bash", "ls", { command: "ls" }, 1),
+    ]);
+  });
+
+  it("drops repeated and older revisions", () => {
+    expect(applyTranscriptEvent(written, input("call-1", 3, { op: "splice", path: ["content"], offset: 4, text: "two", baseRevision: 2 }))).toBe(written);
+    expect(applyTranscriptEvent(written, input("call-1", 2, { op: "set", args: {} }))).toBe(written);
+  });
+
+  it("reports a gap instead of guessing", () => {
+    expect(applyToolInputEvent(written, input("call-1", 5, { op: "splice", path: ["content"], offset: 0, text: "x", baseRevision: 4 })))
+      .toEqual({ messages: written, gap: true });
+    expect(applyToolInputEvent(written, input("call-9", 2, { op: "splice", path: ["content"], offset: 0, text: "x", baseRevision: 1 })))
+      .toEqual({ messages: written, gap: true });
+    expect(applyToolInputEvent(written, input("call-1", 4, { op: "splice", path: ["missing"], offset: 0, text: "x", baseRevision: 3 })))
+      .toEqual({ messages: written, gap: true });
+    expect(applyToolInputEvent(written, input("call-1", 9, { op: "set", args: { path: "b.txt" } })).gap).toBe(false);
+  });
+
+  it("leaves a card that already started alone", () => {
+    const started = apply(written, [{ type: "tool.start", toolName: "write", toolCallId: "call-1", summary: "a.txt", args: { path: "a.txt", content: "one\ntwo\n" } }]);
+    expect(applyTranscriptEvent(started, input("call-1", 4, { op: "set", args: { path: "b.txt" } }))).toBe(started);
+  });
+});
+
+describe("call ids repeated between answers", () => {
+  const earlierCard = (status: "running" | "pending"): ChatLine => ({
+    role: "tool",
+    streamId: "stream-0",
+    parts: [{ type: "toolExecution", toolCallId: "call-1", toolName: "write", summary: "old.txt", args: { path: "old.txt" }, status, inputRevision: 2 }],
+  });
+  const setEvent = input("call-1", 1, { op: "set", args: { path: "a.txt", content: "one\n" } });
+  const spliceEvent = input("call-1", 2, { op: "splice", path: ["content"], offset: 4, text: "two", baseRevision: 1 });
+
+  it.each(["running", "pending"] as const)("grows the new answer's own card beside a %s card of the earlier answer", (status) => {
+    const before = earlierCard(status);
+    const first = applyToolInputEvent([before], setEvent);
+    const second = applyToolInputEvent(first.messages, spliceEvent);
+    expect([first.gap, second.gap]).toEqual([false, false]);
+    expect(second.messages).toEqual([before, card("call-1", "write", "a.txt", { path: "a.txt", content: "one\ntwo" }, 2)]);
+  });
+});
+
+describe("answers reconciled by identity", () => {
+  const final = {
+    role: "assistant",
+    content: [
+      { type: "thinking", thinking: "Plan" },
+      { type: "text", text: "Before" },
+      { type: "toolCall", id: "call-1", name: "write", arguments: { path: "a.txt", content: "x\n" } },
+      { type: "text", text: "After" },
+    ],
+    stopReason: "toolUse",
+    timestamp: 1_790_000_000_000,
+    completedAt: "2026-09-21T12:00:05.000Z",
+    streamId,
+  };
+  const live = apply([earlier], [
+    { type: "assistant.start", message: { role: "assistant", content: [], streamId } },
+    { type: "assistant.thinking.delta", text: "Plan", streamId },
+    { type: "assistant.delta", text: "Before", streamId },
+    input("call-1", 1, { op: "set", args: { path: "a.txt" } }),
+    { type: "assistant.delta", text: "After", streamId },
+  ]);
+
+  it("keeps text that follows a call below the call's card", () => {
+    expect(live).toEqual([
+      earlier,
+      { role: "assistant", streamId, parts: [{ type: "thinking", text: "Plan" }, { type: "text", text: "Before" }] },
+      card("call-1", "write", "a.txt", { path: "a.txt" }, 1),
+      { role: "assistant", streamId, parts: [{ type: "text", text: "After" }] },
+    ]);
+  });
+
+  it("replaces the live lines with the answer's history form without duplicates", () => {
+    const ended = apply(live, [{ type: "message.end", message: final }]);
+    expect(ended).toEqual([earlier, ...normalizeMessages([final]).map((line) => ({ ...line, streamId }))]);
+    expect(ended.filter((line) => line.parts.some((part) => part.type === "text" && part.text === "Before"))).toHaveLength(1);
+  });
+
+  it("keeps a started card's execution when the answer ends again", () => {
+    const ended = apply(live, [{ type: "message.end", message: final }]);
+    const started = apply(ended, [{ type: "tool.start", toolName: "write", toolCallId: "call-1", summary: "a.txt", args: { path: "a.txt", content: "x\n" } }]);
+    const again = apply(started, [{ type: "message.end", message: final }]);
+    expect(again.flatMap((line) => line.parts).filter((part) => part.type === "toolExecution"))
+      .toMatchObject([{ toolCallId: "call-1", status: "running", args: { path: "a.txt", content: "x\n" } }]);
+    expect(again).toHaveLength(ended.length);
+  });
+
+  it("does not consume an earlier answer when an answer ends empty, with or without identity", () => {
+    const empty = { role: "assistant", content: [], stopReason: "stop" };
+    expect(apply([earlier], [
+      { type: "assistant.start", message: { role: "assistant", content: [], streamId } },
+      { type: "message.end", message: { ...empty, streamId } },
+    ])).toEqual([earlier]);
+    expect(apply([earlier], [{ type: "message.end", message: empty }])).toEqual([earlier]);
+    expect(apply([earlier], [
+      { type: "assistant.thinking.delta", text: "hmm", streamId },
+      { type: "message.end", message: { ...empty, streamId } },
+    ])).toEqual([earlier]);
+  });
+
+  it("puts the error line of a failed answer after its cards and keeps an aborted call pending", () => {
+    const partial = [{ type: "text", text: "Partial" }, { type: "toolCall", id: "call-1", name: "write", arguments: { path: "a.txt" } }];
+    const streamed: SessionUiEvent[] = [
+      { type: "assistant.delta", text: "Partial", streamId },
+      input("call-1", 1, { op: "set", args: { path: "a.txt" } }),
+    ];
+    const failed = apply([], [...streamed, { type: "message.end", message: { role: "assistant", content: partial, stopReason: "error", errorMessage: "boom", streamId } }]);
+    expect(failed.map((line) => line.role)).toEqual(["assistant", "tool", "system"]);
+    expect(failed[2]?.parts).toEqual([{ type: "text", text: "Model response failed: boom" }]);
+    const aborted = apply([], [...streamed, { type: "message.end", message: { role: "assistant", content: partial, stopReason: "aborted", streamId } }]);
+    expect(aborted.map((line) => line.role)).toEqual(["assistant", "tool"]);
+    expect(aborted[1]?.parts).toMatchObject([{ type: "toolExecution", toolCallId: "call-1", status: "pending" }]);
+  });
+});
+
+describe("streamed skill reads", () => {
+  const skillPath = "/skills/demo/SKILL.md";
+  const reading = apply([], [input("call-r", 1, { op: "set", args: { path: skillPath } }, "read")]);
+  const skillLine: ChatLine = { role: "skill", parts: [{ type: "skillRead", name: "demo", path: skillPath, toolCallId: "call-r" }] };
+  const readStart: SessionUiEvent = { type: "tool.start", toolName: "read", toolCallId: "call-r", summary: skillPath, args: { path: skillPath } };
+  const readCall = { type: "toolCall", id: "call-r", name: "read", arguments: { path: skillPath } };
+
+  it("shows a pending read card while the path streams", () => {
+    expect(reading).toEqual([card("call-r", "read", skillPath, { path: skillPath }, 1)]);
+  });
+
+  it("keeps a snapshot's streamed skill read as a pending card", () => {
+    const store = new ChatTranscriptStore({ read: () => undefined, write: () => undefined });
+    expect(store.seedStreamingPartial([], { role: "assistant", content: [{ ...readCall, inputRevision: 1 }], streamId }))
+      .toEqual([card("call-r", "read", skillPath, { path: skillPath }, 1)]);
+  });
+
+  it("replaces the pending card with the skill line on message.end", () => {
+    const ended = apply(reading, [{ type: "message.end", message: { role: "assistant", content: [readCall], streamId } }]);
+    expect(ended).toEqual([{ ...skillLine, streamId }]);
+    expect(apply(ended, [readStart])).toEqual([{ ...skillLine, streamId }]);
+  });
+
+  it("removes the pending card by its call id on tool.start", () => {
+    expect(apply(reading, [readStart])).toEqual([skillLine]);
+  });
+
+  it("removes an untagged pending card by its call id on message.end", () => {
+    const untagged: ChatLine[] = [{ role: "tool", parts: [{ type: "toolExecution", toolCallId: "call-r", toolName: "read", summary: skillPath, args: { path: skillPath }, status: "pending" }] }];
+    expect(apply(untagged, [{ type: "message.end", message: { role: "assistant", content: [readCall] } }])).toEqual([skillLine]);
+  });
+
+  describe("with a pending card of an earlier answer under the same call id", () => {
+    const past: ChatLine = { ...card("call-r", "read", skillPath, { path: skillPath }, 1), streamId: "stream-0" };
+    const before = [past, ...reading];
+
+    it("removes only the new answer's card on tool.start", () => {
+      expect(apply(before, [readStart])).toEqual([past, skillLine]);
+    });
+
+    it("removes only the new answer's card on message.end without a matching stream", () => {
+      const untagged = reading.map(({ role, parts }): ChatLine => ({ role, parts }));
+      const ended = apply([past, ...untagged], [{ type: "message.end", message: { role: "assistant", content: [readCall], streamId: "stream-2" } }]);
+      expect(ended).toEqual([past, { ...skillLine, streamId: "stream-2" }]);
+    });
+
+    it("keeps the earlier card when the answer ends before its tool.start, as the SDK orders them", () => {
+      const ended: SessionUiEvent = { type: "message.end", message: { role: "assistant", content: [readCall], streamId: "stream-2" } };
+      const streamed = apply([past], [
+        { ...input("call-r", 1, { op: "set", args: { path: skillPath } }, "read"), streamId: "stream-2" },
