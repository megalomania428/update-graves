+    output: sum(all.map((usage) => usage.output)),
+    cacheRead: sum(all.map((usage) => usage.cacheRead)),
+    cacheWrite: sum(all.map((usage) => usage.cacheWrite)),
+    totalTokens: sum(all.map((usage) => usage.totalTokens)),
+    ...(reasoning.length === 0 ? {} : { reasoning: sum(reasoning) }),
+  };
