+
+const GENERATION_TITLE = "Generation time of this message";
+const TURN_TITLE = "Whole turn time: from the user message to the end of this answer";
+/**
+ * Pi stores a custom message delivered during a turn when it records it, right
+ * after the calls it follows; one that comes this much later waited for a person
+ * or a subsession, after a tool ended the turn.
+ */
+const CUSTOM_TURN_GAP_MS = 1000;
+
+/** Plain text of header segments, for accessible labels and tests. */
+export function metaSegmentsText(segments: readonly MetaSegment[]): string {
+  return segments.map((segment) => segment.map((piece) => piece.text).join(" ")).join(" · ");
+}
+
+/** Parse an ISO timestamp into epoch milliseconds, or undefined when absent or invalid. */
+function chatTimeMs(value: string | undefined): number | undefined {
+  if (value === undefined || value === "") return undefined;
+  const time = Date.parse(value);
+  return Number.isFinite(time) ? time : undefined;
+}
+
+function pad(part: number): string {
+  return String(part).padStart(2, "0");
+}
+
+/** Local `YYYY-MM-DD HH:mm:ss`, independent of the browser locale. */
+export function formatChatTimestamp(value: string | undefined): string | undefined {
+  const time = chatTimeMs(value);
+  if (time === undefined) return undefined;
+  const date = new Date(time);
+  return `${String(date.getFullYear())}-${pad(date.getMonth() + 1)}-${pad(date.getDate())} ${pad(date.getHours())}:${pad(date.getMinutes())}:${pad(date.getSeconds())}`;
+}
+
+/** The browser's IANA zone, resolved once: `Intl` resolution is slow and the zone does not change under a page. */
+let chatTimeZoneName: string | undefined;
+
+/** `GMT+03:00 (Europe/Moscow)`: the browser zone offset at that instant and its IANA name. */
+function formatChatTimeZone(time: number): string {
+  const offset = -new Date(time).getTimezoneOffset();
+  const sign = offset < 0 ? "-" : "+";
+  chatTimeZoneName ??= Intl.DateTimeFormat().resolvedOptions().timeZone;
+  const zone = chatTimeZoneName;
+  return `GMT${sign}${pad(Math.floor(Math.abs(offset) / 60))}:${pad(Math.abs(offset) % 60)}${zone === "" ? "" : ` (${zone})`}`;
+}
+
+/** The local date, with the zone repeated in its tooltip. */
+function chatDatePiece(value: string | undefined, title: string): MetaPiece | undefined {
+  const time = chatTimeMs(value);
+  const text = formatChatTimestamp(value);
+  if (time === undefined || text === undefined) return undefined;
+  return { text, title: `${title}: ${text} ${formatChatTimeZone(time)}` };
+}
+
+/** `45s`, `1m5s` or `1h2m3s`; undefined for a negative or non-finite span. */
+export function formatChatDuration(ms: number): string | undefined {
+  if (!Number.isFinite(ms) || ms < 0) return undefined;
+  const total = Math.round(ms / 1000);
+  const seconds = total % 60;
+  const minutes = Math.floor(total / 60) % 60;
+  const hours = Math.floor(total / 3600);
+  if (hours > 0) return `${String(hours)}h${String(minutes)}m${String(seconds)}s`;
+  if (minutes > 0) return `${String(minutes)}m${String(seconds)}s`;
+  return `${String(seconds)}s`;
+}
+
+/** Milliseconds between two ISO timestamps, when both are known and ordered. */
+function chatDurationMs(start: string | undefined, end: string | undefined): number | undefined {
+  const startMs = chatTimeMs(start);
+  const endMs = chatTimeMs(end);
+  return startMs === undefined || endMs === undefined || endMs < startMs ? undefined : endMs - startMs;
+}
+
+function durationPiece(ms: number | undefined, title: string, prefix = ""): MetaPiece | undefined {
+  const text = ms === undefined ? undefined : formatChatDuration(ms);
+  return text === undefined ? undefined : { text: `${prefix}${text}`, title };
+}
+
+/** A segment of the known pieces, or nothing when none is known. */
+function segmentOf(...pieces: (MetaPiece | undefined)[]): MetaSegment[] {
+  const known = pieces.filter((piece): piece is MetaPiece => piece !== undefined);
+  return known.length === 0 ? [] : [known];
+}
+
+/**
+ * `<duration> · <date>` for a unit of work: the date is the start when known,
+ * otherwise the end; the duration needs both. Pass no end while work runs.
