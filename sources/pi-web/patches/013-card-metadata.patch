+
+/** Only the model name: everything up to the last `/`, the provider included, is dropped. */
+function chatModelName(message: ChatLine): string | undefined {
+  const model = message.meta?.model;
+  const id = model?.responseId ?? model?.id;
+  if (id === undefined || id === "") return undefined;
+  const name = id.slice(id.lastIndexOf("/") + 1);
+  return name === "" ? undefined : name;
+}
+
+/**
+ * Header of a chat line: `<tokens> · <generation>[ Σ <turn>] · <date> · <model>[:<level>]`,
+ * every part optional. Answers and error lines time their generation, other lines their run.
+ */
+export function chatMessageMetaSegments(message: ChatLine, turnDurationMs?: number): MetaSegment[] {
+  const meta = message.meta;
+  // Only a shell line has a run time; a start and an end elsewhere are an answer's, shared by its tool and skill lines.
+  const answer = message.role !== "bash";
+  const bash = message.role === "bash";
+  const date = chatDatePiece(meta?.timestamp, bash ? "Started at" : "Message time") ?? chatDatePiece(meta?.completedAt, bash ? "Finished at" : "Message time");
+  const modelLevel = [chatModelName(message), meta?.thinkingLevel].filter((part): part is string => part !== undefined && part !== "").join(":");
+  return [
+    ...(meta?.usage === undefined ? [] : [chatTokenSegment(meta.usage)]),
+    ...segmentOf(
+      durationPiece(chatDurationMs(meta?.timestamp, meta?.completedAt), answer ? GENERATION_TITLE : "Run time"),
+      durationPiece(turnDurationMs, TURN_TITLE, "Σ "),
+    ),
+    ...segmentOf(date),
+    ...segmentOf(modelLevel === "" ? undefined : { text: modelLevel, title: "Model and reasoning level" }),
+  ];
+}
+
+/**
+ * Whole-turn durations keyed by absolute message index (`indexOffset + i`). A
+ * turn starts at a user line, no earlier than the previous turn's end, so a
+ * queued follow-up does not count its wait; a user line right after a tool or
+ * skill line of a running turn is a steer and keeps the start, unless it comes
+ * after the last known instant of that work (the turn was stopped or ended by a
+ * tool); a user line with no valid time (an optimistic `!` line) is ignored. A
+ * custom message line (ask_user answers, a subsession notice) starts a turn as
+ * well, but only when no turn runs: none yet, the last one has its final answer,
+ * or it was ended by a tool and the line comes over a second after its work (pi
+ * stores one delivered during the work right after it). A final answer
+ * has `completedAt` and a stop reason other than `toolUse`; an `error` answer
+ * that pi retries (more work follows) becomes work of the turn. Lines split from
+ * the pending answer (they share its meta object) do not close it. Turns with no
+ * other assistant, tool or skill line before the final answer are skipped, and
+ * a closed turn gets no second total until the next turn starts.
+ */
+export function chatTurnDurations(messages: readonly ChatLine[], indexOffset = 0): Map<number, number> {
+  const durations = new Map<number, number>();
+  let turnStart: number | undefined;
+  let lastEnd: number | undefined;
+  let workLines = 0;
+  let lastWorkRole: ChatLine["role"] | undefined;
+  let pending: { index: number; end: number; stopReason: string; meta: ChatLine["meta"] } | undefined;
+  // The latest known instant of the running turn's work: pi stamps a steer when it is queued, while that work runs.
+  let lastWorkTime: number | undefined;
+  const noteWork = (line: ChatLine) => {
+    const values = [line.meta?.timestamp, line.meta?.completedAt, ...line.parts.flatMap((part) => part.type === "toolExecution" ? [part.startedAt, part.endedAt] : [])];
+    let known = false;
+    for (const value of values) {
+      const time = chatTimeMs(value);
+      if (time === undefined) continue;
+      known = true;
+      if (lastWorkTime === undefined || time > lastWorkTime) lastWorkTime = time;
+    }
+    // A call of unknown time may have run until any later instant, so the end of the work is unknown. A card
+    // with its answer's times but no end is a call that never ended: those times stay its lower bound.
+    if (!known && (line.role === "tool" || line.role === "skill")) lastWorkTime = undefined;
+  };
+  const startTurn = (start: number) => {
+    turnStart = lastEnd === undefined ? start : Math.max(start, lastEnd);
+    workLines = 0;
+    lastWorkRole = undefined;
+    lastWorkTime = undefined;
+  };
+  const close = () => {
+    if (pending === undefined) return;
+    if (turnStart !== undefined && workLines > 0 && pending.end >= turnStart) durations.set(pending.index, pending.end - turnStart);
+    lastEnd = pending.end;
+    pending = undefined;
+    turnStart = undefined;
+    workLines = 0;
+    lastWorkRole = undefined;
+    lastWorkTime = undefined;
+  };
+  messages.forEach((line, index) => {
+    if (line.role === "user") {
+      const start = chatTimeMs(line.meta?.timestamp);
+      if (start === undefined) return;
+      close();
+      // A line after the work of a turn that ended without an answer (stopped, or ended by a tool) starts a new turn.
+      if (turnStart !== undefined && (lastWorkRole === "tool" || lastWorkRole === "skill") && (lastWorkTime === undefined || start <= lastWorkTime)) return;
+      startTurn(start);
+      return;
+    }
+    // An error answer without text shows only as a system error line carrying the answer's metadata.
+    const errorLine = line.role === "system" && line.meta?.stopReason === "error";
+    if (line.source !== undefined) {
+      // Pi records a message delivered during a turn after the compaction it ran between the turn's steps.
+      if (lastWorkTime !== undefined) noteWork(line);
+      return;
+    }
+    if (line.role === "system" && !errorLine) {
+      // Pi delivers ask_user answers and subsession notices as custom messages that trigger a run of their own.
+      const start = chatTimeMs(line.meta?.timestamp);
+      if (start === undefined) return;
+      const endedByTool = (lastWorkRole === "tool" || lastWorkRole === "skill") && lastWorkTime !== undefined && start - lastWorkTime > CUSTOM_TURN_GAP_MS;
+      if (pending === undefined && turnStart !== undefined && !endedByTool) return;
+      close();
+      startTurn(start);
+      return;
+    }
+    if (line.role !== "assistant" && line.role !== "tool" && line.role !== "skill" && !errorLine) return;
+    noteWork(line);
+    if (pending !== undefined && line.meta !== undefined && line.meta === pending.meta) {
+      // A tool call or the error line of the pending answer itself.
+      if (errorLine) return;
+      workLines += 1;
+      lastWorkRole = line.role;
+      return;
+    }
+    const stopReason = line.meta?.stopReason;
+    const end = chatTimeMs(line.meta?.completedAt);
+    // The error line after an answer with text repeats that answer.
+    if (errorLine && (end === undefined || (pending?.stopReason === "error" && pending.end === end))) return;
+    if (pending !== undefined) {
+      if (pending.stopReason === "error") {
+        pending = undefined;
+        workLines += 1;
+      } else {
+        close();
+      }
+    }
+    if ((line.role === "assistant" || errorLine) && stopReason !== undefined && stopReason !== "toolUse" && end !== undefined) {
+      pending = { index: indexOffset + index, end, stopReason, meta: line.meta };
+      return;
+    }
+    workLines += 1;
+    lastWorkRole = line.role;
+  });
+  close();
+  return durations;
+}
