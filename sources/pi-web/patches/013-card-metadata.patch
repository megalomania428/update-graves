+import type { ChatLine, ChatUsage } from "./components/shared";
+
+/** One hoverable piece of a card header: its visible text and tooltip. */
+interface MetaPiece {
+  text: string;
+  title: string;
+}
+
+/** Pieces shown together, separated by spaces; header segments are joined with ` · `. */
+export type MetaSegment = readonly MetaPiece[];
+
+/** Tooltips for a unit of work: its duration, its start and its end. */
+export interface ChatSpanTitles {
+  duration: string;
+  start: string;
+  end: string;
