+/**
+ * `<tokens> · <span> · <date>` for an events group: tokens of the usage inside,
+ * the span from the earliest to the latest known instant and the first date; a
+ * live group, or one with a call still running, shows no span. An answer split
+ * around its text has lines in two groups: its metadata (tokens, generation
+ * times) counts only in the group of its first line (`firstIndexes`, absolute
+ * indexes; `startIndex` is the group's); other groups keep only its end, when
+ * its calls start, and calls always add their own times.
+ */
+export function chatGroupMetaSegments(messages: readonly ChatLine[], live: boolean, startIndex = 0, firstIndexes?: ReadonlyMap<NonNullable<ChatLine["meta"]>, number>): MetaSegment[] {
+  const owned = messages.map((line, offset): ChatLine => {
+    const firstIndex = line.meta === undefined ? undefined : firstIndexes?.get(line.meta);
+    if (firstIndex === undefined || firstIndex === startIndex + offset) return line;
+    const completedAt = line.meta?.completedAt;
+    return { role: line.role, parts: line.parts, ...(completedAt === undefined ? {} : { meta: { completedAt } }) };
+  });
+  const usage = sumChatUsage(owned);
+  const tokens = usage === undefined ? [] : [chatTokenSegment(usage, " (sum in this group)")];
+  let first = Number.POSITIVE_INFINITY;
+  let last = Number.NEGATIVE_INFINITY;
+  let running = false;
+  const add = (value: string | undefined) => {
+    const time = chatTimeMs(value);
+    if (time === undefined) return;
+    first = Math.min(first, time);
+    last = Math.max(last, time);
+  };
+  for (const line of owned) {
+    add(line.meta?.timestamp);
+    add(line.meta?.completedAt);
+    for (const part of line.parts) {
+      if (part.type !== "toolExecution") continue;
+      if (part.status === "running") running = true;
+      add(part.startedAt);
+      add(part.endedAt);
+    }
+  }
+  if (first > last) return tokens;
+  const span = live || running || last === first ? undefined : durationPiece(last - first, "Time from the first to the last event of this group");
+  return [...tokens, ...segmentOf(span), ...segmentOf(chatDatePiece(new Date(first).toISOString(), "Time of the first event"))];
+}
+
+/** Absolute index of the first line carrying each metadata object, for `chatGroupMetaSegments`. */
+export function chatMetaFirstIndexes(messages: readonly ChatLine[], start: number): Map<NonNullable<ChatLine["meta"]>, number> {
+  const indexes = new Map<NonNullable<ChatLine["meta"]>, number>();
+  for (const [offset, line] of messages.entries()) {
+    if (line.meta !== undefined && !indexes.has(line.meta)) indexes.set(line.meta, start + offset);
+  }
+  return indexes;
+}
+
+/**
+ * Absolute indexes of the tool cards that carry the header of an answer made
+ * only of tool calls: the first card of each such answer. An answer with text
+ * keeps its header on the text line, which shares the metadata object; so does
+ * a streaming answer whose text or thinking arrived after its calls.
+ */
+export function chatToolAnswerHeaderIndexes(messages: readonly ChatLine[], start: number): Set<number> {
+  const firstCards = new Map<NonNullable<ChatLine["meta"]>, number>();
+  const shown = new Set<NonNullable<ChatLine["meta"]>>();
+  const lastAnswerLine = messages.reduce((last, line, offset) => line.role === "assistant" ? offset : last, -1);
+  for (const [offset, line] of messages.entries()) {
+    const meta = line.meta;
+    // An answer's metadata, streaming or finished, has a model or `completedAt`; a tool result's has neither.
+    if (meta === undefined || (meta.model === undefined && meta.completedAt === undefined)) continue;
+    // A live call line also holds the images its result returned; the call still renders as a card.
+    const toolOnly = line.role === "tool" && line.parts.some((part) => part.type === "toolExecution");
+    if (!toolOnly) shown.add(meta);
+    else if (!firstCards.has(meta)) firstCards.set(meta, start + offset);
+  }
+  // A streaming answer is the tail: an assistant line after its first card is its own and shows the header.
+  return new Set([...firstCards].flatMap(([meta, index]) => shown.has(meta) || (meta.completedAt === undefined && index - start < lastAnswerLine) ? [] : [index]));
+}
