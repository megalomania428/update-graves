+    { text: `↓${formatChatTokens(usage.output)}`, title: `Output tokens, reasoning included${scope}` },
+    { text: `⤴${formatChatTokens(usage.cacheWrite)}`, title: `Cache write tokens${scope}` },
+    { text: `⤵${formatChatTokens(usage.cacheRead)}`, title: `Cache read tokens${scope}` },
+    usage.reasoning === undefined
+      ? { text: "∴∅", title: `Reasoning tokens: not reported by the provider${scope}` }
+      : { text: `∴${formatChatTokens(usage.reasoning)}`, title: `Reasoning tokens, part of the output${scope}` },
+    { text: `Σ${formatChatTokens(usage.totalTokens)}`, title: `Total tokens${scope}` },
+  ];
+}
+
+/**
