+  if (count < 1000) return String(Math.round(count));
+  const thousands = Number((count / 1000).toFixed(2));
+  if (thousands < 1000) return `${String(thousands)}k`;
+  return `${String(Number((count / 1_000_000).toFixed(2)))}M`;
+}
+
+/** The six token counters; `∴∅` when the provider reported no reasoning breakdown. `scope` ends every tooltip. */
+export function chatTokenSegment(usage: ChatUsage, scope = ""): MetaSegment {
+  return [
