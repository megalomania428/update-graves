+import { describe, expect, it } from "vitest";
+import { chatGroupMetaSegments, chatMessageMetaSegments, chatMetaFirstIndexes, chatSpanSegments, chatTokenSegment, chatToolAnswerHeaderIndexes, chatTurnDurations, formatChatDuration, formatChatTimestamp, formatChatTokens, metaSegmentsText, sumChatUsage } from "./chatMeta";
+import type { ChatLine, ChatUsage } from "./components/shared";
+
+const local = (seconds: number) => new Date(2026, 9, 22, 14, 5, seconds).toISOString();
+const titles = { duration: "Run time", start: "Started at", end: "Finished at" };
+const usage: ChatUsage = { input: 126, output: 66, cacheRead: 63_488, cacheWrite: 1234, reasoning: 15, totalTokens: 64_914 };
+
+describe("formatChatTimestamp", () => {
+  it("formats local time as YYYY-MM-DD HH:mm:ss", () => {
+    expect(formatChatTimestamp(local(31))).toBe("2026-10-22 14:05:31");
+  });
+
+  it("returns undefined for a missing or invalid value", () => {
+    expect(formatChatTimestamp(undefined)).toBeUndefined();
+    expect(formatChatTimestamp("not a date")).toBeUndefined();
+  });
+});
+
+describe("formatChatDuration", () => {
+  it("uses seconds, minutes and hours without spaces", () => {
+    expect(formatChatDuration(0)).toBe("0s");
+    expect(formatChatDuration(45_000)).toBe("45s");
+    expect(formatChatDuration(59_500)).toBe("1m0s");
+    expect(formatChatDuration(65_000)).toBe("1m5s");
+    expect(formatChatDuration(3_723_000)).toBe("1h2m3s");
+  });
+
+  it("rejects negative spans", () => {
+    expect(formatChatDuration(-1)).toBeUndefined();
+  });
+});
+
+describe("formatChatTokens", () => {
+  it("keeps up to two decimals without trailing zeros", () => {
+    expect(formatChatTokens(126)).toBe("126");
+    expect(formatChatTokens(1234)).toBe("1.23k");
+    expect(formatChatTokens(63_488)).toBe("63.49k");
+    expect(formatChatTokens(48_000)).toBe("48k");
+    expect(formatChatTokens(4200)).toBe("4.2k");
+    expect(formatChatTokens(999_999)).toBe("1M");
+    expect(formatChatTokens(1_234_567)).toBe("1.23M");
+  });
+});
+
+describe("chatTokenSegment", () => {
+  it("shows the six counters with tooltips", () => {
+    expect(metaSegmentsText([chatTokenSegment(usage)])).toBe("↑126 ↓66 ⤴1.23k ⤵63.49k ∴15 Σ64.91k");
+    expect(chatTokenSegment(usage).map((piece) => piece.title)).toEqual([
+      "Input tokens",
+      "Output tokens, reasoning included",
+      "Cache write tokens",
+      "Cache read tokens",
+      "Reasoning tokens, part of the output",
+      "Total tokens",
+    ]);
+  });
+
+  it("marks a missing reasoning breakdown", () => {
+    const unreported: ChatUsage = { input: 126, output: 66, cacheRead: 63_488, cacheWrite: 1234, totalTokens: 64_914 };
+    const piece = chatTokenSegment(unreported, " (scope)")[4];
+    expect(piece).toEqual({ text: "∴∅", title: "Reasoning tokens: not reported by the provider (scope)" });
+  });
+});
+
+describe("sumChatUsage", () => {
+  it("counts a shared usage object once and sums reported reasoning only", () => {
+    const other: ChatUsage = { input: 1, output: 2, cacheRead: 3, cacheWrite: 4, totalTokens: 10 };
+    const meta = { usage };
+    const lines: ChatLine[] = [
+      { role: "assistant", parts: [{ type: "text", text: "a" }], meta },
+      { role: "tool", parts: [{ type: "toolExecution", toolName: "bash", summary: "ls", status: "success", usage: other }], meta },
+    ];
+    expect(sumChatUsage(lines)).toEqual({ input: 127, output: 68, cacheRead: 63_491, cacheWrite: 1238, totalTokens: 64_924, reasoning: 15 });
+    expect(sumChatUsage([{ role: "tool", parts: [{ type: "toolExecution", toolName: "bash", summary: "ls", status: "success", usage: other }] }])?.reasoning).toBeUndefined();
+    expect(sumChatUsage([{ role: "user", parts: [{ type: "text", text: "hi" }] }])).toBeUndefined();
+  });
+});
+
+describe("chatSpanSegments", () => {
+  it("puts the duration before the start date and the zone into the date tooltip", () => {
+    const segments = chatSpanSegments(local(0), local(65), titles);
+    expect(metaSegmentsText(segments)).toBe("1m5s · 2026-10-22 14:05:00");
+    expect(segments[0]?.[0]?.title).toBe("Run time");
+    expect(segments[1]?.[0]?.title).toMatch(/^Started at: 2026-10-22 14:05:00 GMT[+-]\d\d:\d\d/);
+  });
+
