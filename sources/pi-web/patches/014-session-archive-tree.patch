diff -ruN -x .git a/src/server/sessions/piSessionService.archiveDeleteSummary.test.ts b/src/server/sessions/piSessionService.archiveDeleteSummary.test.ts
--- a/src/server/sessions/piSessionService.archiveDeleteSummary.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/server/sessions/piSessionService.archiveDeleteSummary.test.ts	2026-11-10 15:55:59.834309916 +0000
@@ -0,0 +1,66 @@
+import * as fsPromises from "node:fs/promises";
+import { mkdir, mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PiSessionService } from "./piSessionService.js";
+import { CapturingSessionEventHub, sessionGateway, testModelRuntime } from "./piSessionService.testSupport.js";
+import { SessionArchiveStore } from "./sessionArchiveStore.js";
+import { SessionUnreadStore } from "./sessionUnreadStore.js";
+
+// Node's builtin namespaces are frozen; a plain copy lets vi.spyOn redefine exports.
+vi.mock("node:fs/promises", async (importOriginal) => ({ ...(await importOriginal<typeof fsPromises>()) }));
+
+const CWD = resolve("/workspace");
+const tempRoots: string[] = [];
+
+afterEach(async () => {
+  vi.restoreAllMocks();
+  await Promise.all(tempRoots.splice(0).map((root) => rm(root, { recursive: true, force: true })));
+});
+
+describe("PiSessionService bulk delete with a failing summary write", () => {
+  it("fails only the sessions of the summary that cannot be written and clears unread of the deleted ones", async () => {
+    const root = await mkdtemp(join(tmpdir(), "pi-web-service-delete-summary-"));
+    tempRoots.push(root);
+    const store = new SessionArchiveStore(join(root, "archived-projects"));
+    const created = { a: "2026-01-01T00:00:00.000Z", b: "2026-02-01T00:00:00.000Z", c: "2026-02-02T00:00:00.000Z" };
+    await mkdir(join(root, "active"), { recursive: true });
+    for (const [id, time] of Object.entries(created)) {
+      const path = join(root, "active", `2026-01-01_${id}.jsonl`);
+      await writeFile(path, `${id}\n`);
+      await store.archive({ sessionId: id, cwd: CWD, path, created: time, modified: time, messageCount: 1, firstMessage: "" });
+    }
+    const unreadStore = new SessionUnreadStore({ createCatalogId: () => "catalog-test" });
+    for (const id of ["a", "b", "c"]) {
+      unreadStore.observeActivityState(id, CWD, true);
+      unreadStore.observeActivityState(id, CWD, false);
+    }
+    const service = new PiSessionService(new CapturingSessionEventHub(), {
+      agentDir: "/tmp/pi-web-test-agent",
+      modelRuntime: testModelRuntime,
+      sessionManager: sessionGateway([]),
+      archiveStore: store,
+      heartbeatIntervalMs: 60_000,
+      unreadStore,
+    });
+    const realRename = fsPromises.rename;
+    vi.spyOn(fsPromises, "rename").mockImplementation(async (from, to) => {
+      if (String(from).endsWith(".tmp") && String(to).includes(join("2026", "02"))) throw Object.assign(new Error("ENOSPC"), { code: "ENOSPC" });
+      await realRename(from, to);
+    });
+
+    try {
+      const result = await service.deleteArchivedMany([{ id: "a", cwd: CWD }, { id: "b", cwd: CWD }]);
+
+      vi.restoreAllMocks();
+      expect(result).toMatchObject({ deletedSessionIds: ["a"], failures: [{ sessionId: "b", error: "ENOSPC" }] });
+      expect((await service.unreadCatalog()).sessions.map((session) => session.sessionId).sort()).toEqual(["b", "c"]);
+      const remaining = await store.list(CWD);
+      expect(remaining.map((record) => record.sessionId)).toEqual(["b", "c"]);
+      await expect(readFile(remaining[0]?.archivePath ?? "", "utf8")).resolves.toBe("b\n");
+    } finally {
+      await service.dispose();
+    }
+  });
+});
