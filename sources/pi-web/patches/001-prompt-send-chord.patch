+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PROMPT_ENTER_PREFERENCE_STORAGE_KEY, type PromptEnterPreference, type PromptEnterPreferenceStorage } from "../promptEnterBehavior";
+import { PromptEditor } from "./PromptEditor";
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+});
+
+describe("PromptEditor Enter with an open completion menu", () => {
+  it("sends on Ctrl/Cmd+Enter in modifier mode instead of picking a completion", () => {
+    const { pick, send } = pressEnterWithCompletions("modifier", true);
+
+    expect(pick).not.toHaveBeenCalled();
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("picks the completion on plain Enter in modifier mode", () => {
+    const { pick, send } = pressEnterWithCompletions("modifier", false);
+
+    expect(pick).toHaveBeenCalledOnce();
+    expect(send).not.toHaveBeenCalled();
+  });
+
+  it("keeps picking the completion on Ctrl/Cmd+Enter outside modifier mode", () => {
+    const { pick, send } = pressEnterWithCompletions("auto", true);
+
+    expect(pick).toHaveBeenCalledOnce();
+    expect(send).not.toHaveBeenCalled();
+  });
+});
+
+// handleEditorEnter is private and driven by CodeMirror keydown in production;
+// invoking it through Reflect mirrors the other PromptEditor test seams.
+function pressEnterWithCompletions(preference: PromptEnterPreference, modKey: boolean): { pick: ReturnType<typeof vi.fn>; send: ReturnType<typeof vi.fn> } {
+  const editor = new PromptEditor();
+  const pick = vi.fn();
+  const send = vi.fn();
+  Reflect.set(editor, "pick", pick);
+  Reflect.set(editor, "send", send);
+  Reflect.set(editor, "completions", [{ kind: "command", insertText: "/tree", replaceFrom: 0, replaceTo: 2 }]);
+  vi.stubGlobal("window", { localStorage: preferenceStorage(preference) });
+  const enter: unknown = Reflect.get(editor, "handleEditorEnter");
+  if (!isHandleEditorEnter(enter)) throw new Error("PromptEditor.handleEditorEnter is not callable");
+  expect(enter.call(editor, undefined, false, modKey)).toBe(true);
+  return { pick, send };
+}
+
+function preferenceStorage(preference: PromptEnterPreference): PromptEnterPreferenceStorage {
+  return {
+    getItem: (key) => (key === PROMPT_ENTER_PREFERENCE_STORAGE_KEY ? preference : null),
+    setItem: () => undefined,
+  };
+}
+
+function isHandleEditorEnter(value: unknown): value is (this: PromptEditor, view: undefined, shiftKey: boolean, modKey: boolean) => boolean {
+  return typeof value === "function";
+}
