@@ -40,6 +41,28 @@
   return lines.length === 0 ? messages : [...messages, ...lines];
 }
 
+/**
+ * Replay the join-time progress of still-executing tools and of a running user
+ * `!` shell command. Neither is in committed history or the partial, and the
+ * live events that carried them are at or below the snapshot watermark, so
+ * without this a running tool shows no output until its next update arrives.
+ */
+export function seedRunningWork(messages: ChatLine[], snapshot: Pick<SessionStreamSnapshot, "tools" | "shells">): ChatLine[] {
+  const seeded = (snapshot.tools ?? []).reduce((next, tool) => {
+    const updated = updateToolExecution(next, tool.toolCallId,
+      (part) => mergeToolExecutionUpdate(part, { type: "tool.update", ...tool }));
+    if (updated === next || tool.end === undefined) return updated;
+    return applyTranscriptEvent(updated, {
+      type: "tool.end", ...tool, isError: tool.end.isError,
+    }) ?? updated;
+  }, messages);
+  return (snapshot.shells ?? []).reduce((next, shell) => {
+    const started = [...next, shellStartMessage(shell.command, shell.excludeFromContext)];
+    const output = shell.output === "" ? started : appendShellChunk(started, shell.output);
+    return shell.end === undefined ? output : finalizeShellMessage(output, { type: "shell.end", ...shell.end, output: shell.output });
+  }, seeded);
+}
+
 export function applyTranscriptEvent(messages: ChatLine[], event: SessionUiEvent): ChatLine[] | undefined {
   if (event.type === "message.append") return appendNewMessage(messages, event.message);
   if (event.type === "assistant.delta") return appendText(messages, "assistant", event.text);
