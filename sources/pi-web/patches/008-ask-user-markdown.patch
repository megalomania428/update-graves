+// Select the whole inline code span; code blocks keep the native word selection.
+export function selectInlineCodeOnDoubleClick(event: MouseEvent): void {
+  if (!(event.target instanceof Element)) return;
+  const code = event.target.closest("code");
+  if (code === null || code.closest("pre") !== null) return;
+  const selection = window.getSelection();
+  if (selection === null) return;
+  selection.setBaseAndExtent(code, 0, code, code.childNodes.length);
+}
